-- graph.fk -- builds graphs of kernels for projects/funkgraph's player
-- (docs/dev/audio.md, D). A Sig is a tree of nodes: a kernel's C name, its
-- initial state as Floats (a foreign struct of Float fields), and its
-- inputs, parameters included. play writes it into a new C graph, inputs
-- first, finding each kernel in the player's libraries, and swaps it in
-- from the audio thread's next block. A named node is one node however
-- often the tree uses it, and keeps its state across plays while its
-- kernel and initial state stay the same; an unnamed one keeps it too,
-- matched by its shape (funk_graph_name in graph.h). Equal subtrees become one
-- node. A control's output is a value
-- that send changes from a given frame, such as a note's gate. Channels
-- is a signal of several channels: a node with such an input becomes one
-- node per channel, so stereo builds from mono kernels, as SuperCollider's
-- multichannel expansion does; a mono input is shared, not copied. Bus o c
-- reads channel c of orbit o of the player's events; In c, in a template,
-- reads channel c of its event's chain (docs/dev/dirt-sound.md). Link with
-- -I projects/funkgraph and the funkgraph library.
module graph where

foreign import ccall "graph.h funk_graph_new" graphNew :: CInt -> Float ->> Ptr ()
foreign import ccall "graph.h funk_graph_add" graphAdd :: Ptr () -> Ptr () -> Ptr () -> CSize -> Ptr CInt -> CInt ->> CInt
foreign import ccall "graph.h funk_graph_control" graphControl :: Ptr () -> CFloat ->> CInt
foreign import ccall "graph.h funk_player_send" playerSend :: Ptr () -> CLLong -> String -> CFloat ->> CBool
foreign import ccall "graph.h funk_player_frames" playerFrames :: Ptr () ->> CLLong
foreign import ccall "graph.h funk_graph_name" graphName :: Ptr () -> CInt -> String ->> CInt
foreign import ccall "graph.h funk_graph_memory" graphMemory :: Ptr () -> CInt -> Float ->> CInt
foreign import ccall "graph.h funk_graph_table_file" graphTableFile :: Ptr () -> CInt -> String -> CInt ->> CInt
foreign import ccall "graph.h funk_graph_table_values" graphTableValues :: Ptr () -> CInt -> Ptr () -> CLLong ->> CInt
foreign import ccall "graph.h funk_graph_table_builtin" graphTableBuiltin :: Ptr () -> CInt -> String -> CInt ->> CInt
foreign import ccall "graph.h funk_table_error" tableError :: () ->> String
foreign import ccall "graph.h funk_sample_path" samplePath :: String -> String -> CInt ->> String
foreign import ccall "graph.h funk_player_new" playerNew :: () ->> Ptr ()
foreign import ccall "graph.h funk_player_play" playerPlay :: Ptr () -> Ptr () ->> ()
foreign import ccall "graph.h funk_graph_output" graphOutput :: Ptr () -> CInt ->> CInt
foreign import ccall "graph.h funk_graph_bus" graphBus :: Ptr () -> CInt -> CInt ->> CInt
foreign import ccall "graph.h funk_graph_in" graphIn :: Ptr () -> CInt ->> CInt
foreign import ccall "graph.h funk_graph_ugen" graphUgen :: Ptr () -> CInt ->> CInt
foreign import ccall "graph.h funk_graph_outputs" graphOutputs :: Ptr () -> CInt -> CInt ->> CInt
foreign import ccall "graph.h funk_templates_new" templatesNew :: CInt ->> Ptr ()
foreign import ccall "graph.h funk_templates_add" templatesAdd :: Ptr () -> String -> Ptr () ->> CInt
foreign import ccall "graph.h funk_templates_free" templatesFree :: Ptr () ->> ()
foreign import ccall "graph.h funk_player_templates" playerTemplates :: Ptr () -> Ptr () ->> CInt
foreign import ccall "graph.h funk_player_seed" playerSeed :: Ptr () -> CUInt ->> ()
foreign import ccall "graph.h funk_player_event_begin" eventBegin :: Ptr () -> CLLong -> String ->> CBool
foreign import ccall "graph.h funk_player_event_param" eventParam :: Ptr () -> String -> CFloat ->> CBool
foreign import ccall "graph.h funk_player_event_end" eventEnd :: Ptr () ->> CBool
foreign import ccall "graph.h funk_player_event_counts" eventCounts :: Ptr () -> Ptr CInt -> Ptr CLLong -> Ptr CLLong ->> ()
foreign import ccall "graph.h funk_player_render_channels" playerRender :: Ptr () -> Ptr (Ptr CFloat) -> CInt -> CInt ->> ()
foreign import ccall "graph.h funk_player_free" playerFree :: Ptr () ->> ()
foreign import ccall "dlfcn.h dlopen" dlopen :: String -> CInt ->> Ptr ()
foreign import ccall "dlfcn.h dlsym" dlsym :: Ptr () -> String ->> Ptr ()
foreign import ccall "dlfcn.h RTLD_NOW" rtldNow :: CInt

-- Delay k secs st ins: a Node with memory for secs seconds in each channel;
-- its state starts with two zeros, which become the pointer and the size
-- Reader k src st ins: a Node that reads src; its state starts with three
-- zeros, which become the data's pointer, frames and rate. A patch names the
-- data, never its memory, so it cannot write to what other nodes read.
-- Shared k secs sts x ins: one Delay node per state in sts, each reading all of
-- x's channels (a mono x fills them all), then ins, which are mono. Its channels
-- are the nodes': the way to get several outputs from a state that one kernel owns.
-- Wide k secs src st n ins: a node with n outputs (funk_graph_outputs in graph.h),
-- a Delay if secs > 0, else a Reader if src is Just; a node that reads it reads them all.
-- Builtin name c: channel c of a WAV built into funkgraph (table.h)
data Source = File String Int | Sample String String Int Int | Values [Float] | Builtin String Int

data Sig = Silence | Node String [Float] [Sig] | Delay String Float [Float] [Sig] | Reader String Source [Float] [Sig] | Shared String Float [[Float]] Sig [Sig] | Wide String Float (Maybe Source) [Float] Int [Sig] | Named String Sig | Control Float | Channels [Sig] | Bus Int Int | In Int

-- a C player, its kernel libraries, frames per second, and the most
-- frames per kernel call
data Player = Player (Ptr ()) [Ptr ()] Float Int

named :: String -> Sig -> Sig
named n s = Named n s

-- a control named n, starting at v
control :: String -> Float -> Sig
control n v = Named n (Control v)

same :: Sig -> Sig -> Bool
same Silence Silence = True
same (Node k st ins) (Node k2 st2 ins2) = k == k2 && st == st2 && length ins == length ins2 && and (zipWith same ins ins2)
same (Delay k m st ins) (Delay k2 m2 st2 ins2) = m == m2 && same (Node k st ins) (Node k2 st2 ins2)
same (Wide k m src st w ins) (Wide k2 m2 src2 st2 w2 ins2) = m == m2 && w == w2 && sameMaybe src src2 && same (Node k st ins) (Node k2 st2 ins2)
same (Reader k src st ins) (Reader k2 src2 st2 ins2) = sameSource src src2 && same (Node k st ins) (Node k2 st2 ins2)
same (Shared k m sts x ins) (Shared k2 m2 sts2 x2 ins2) = m == m2 && sts == sts2 && same x x2 && same (Node k [] ins) (Node k2 [] ins2)
same (Named n s) (Named n2 s2) = n == n2 && same s s2
same (Control v) (Control v2) = v == v2
same (Channels ss) (Channels ss2) = length ss == length ss2 && and (zipWith same ss ss2)
same (Bus o c) (Bus o2 c2) = o == o2 && c == c2
same (In c) (In c2) = c == c2
same _ _ = False

sameSource :: Source -> Source -> Bool
sameSource (File p c) (File p2 c2) = p == p2 && c == c2
sameSource (Builtin n c) (Builtin n2 c2) = n == n2 && c == c2
sameSource (Sample d n i c) (Sample d2 n2 i2 c2) = d == d2 && n == n2 && i == i2 && c == c2
sameSource (Values v) (Values v2) = v == v2
sameSource _ _ = False

sameMaybe :: Maybe Source -> Maybe Source -> Bool
sameMaybe (Just a) (Just b) = sameSource a b
sameMaybe Nothing Nothing = True
sameMaybe _ _ = False

-- s's channels; an error if a node's inputs have different numbers of
-- channels, other than 1. Checked before a C graph is allocated.
width :: Sig -> Int
width (Channels ss) = sum (map width ss)
width (Named n s) = width s
width (Node k st ins) = case map width ins of
  ws -> case maximum (1 : ws) of
    w -> if any (\x -> x /= 1 && x /= w) ws then error ("graph: " ++ k ++ "'s inputs have " ++ show ws ++ " channels") else w
width (Delay k m st ins) = width (Node k st ins)
width (Reader k src st ins) = width (Node k st ins)
width (Wide k m src st w ins) = width (Node k st ins)
width (Shared k m sts x ins) = case width x : map width ins of
  ws -> if (head ws /= 1 && head ws /= length sts) || any (\w -> w /= 1) (tail ws) then error ("graph: " ++ k ++ "'s inputs have " ++ show ws ++ " channels") else length sts
width s = 1

-- libraries of kernels, such as `funk emit-c --kernels` output compiled
player :: [String] -> Float -> Int ->> Player
player paths rate maxBlock = Player (playerNew ()) (map library paths) rate maxBlock

library :: String ->> Ptr ()
library path = do
  h <- dlopen path rtldNow
  if h == nullPtr then error ("graph.player: cannot load " ++ path) else h

kernel :: [Ptr ()] -> String ->> Ptr ()
kernel [] name = error ("graph: no kernel " ++ name)
kernel (lib:libs) name = do
  k <- dlsym lib name
  if k == nullPtr then kernel libs name else k

pokeFloats :: Ptr () -> Int -> [Float] ->> ()
pokeFloats p i [] = ()
pokeFloats p i (x:xs) = do
  pokeByteOff p (8 * i) x
  pokeFloats p (i + 1) xs

pokeInputs :: Ptr CInt -> Int -> [Int] ->> ()
pokeInputs p i [] = ()
pokeInputs p i (x:xs) = do
  pokeByteOff p (4 * i) (fromIntegral x :: CInt)
  pokeInputs p (i + 1) xs

-- s's errors, before a C graph is allocated: two different nodes of one
-- name, then unknown kernels. names returns ns with s's names.
names :: [(String, Sig)] -> Sig -> [(String, Sig)]
names ns Silence = ns
names ns (Named n s) = case lookup n ns of
  Just s2 -> if same s s2 then ns else error ("graph: two different nodes named " ++ n)
  Nothing -> names ((n, s) : ns) s
names ns (Node k st ins) = foldl names ns ins
names ns (Delay k m st ins) = names ns (Node k st ins)
names ns (Reader k src st ins) = names ns (Node k st ins)
names ns (Wide k m src st w ins) = names ns (Node k st ins)
names ns (Shared k m sts x ins) = foldl names ns (x : ins)
names ns (Control v) = ns
names ns (Channels ss) = foldl names ns ss
names ns (Bus o c) = ns
names ns (In c) = ns

kernels :: [Ptr ()] -> Sig ->> ()
kernels libs Silence = ()
kernels libs (Named n s) = kernels libs s
kernels libs (Control v) = ()
kernels libs (Bus o c) = ()
kernels libs (In c) = ()
kernels libs (Channels ss) = mapM_ (kernels libs) ss
kernels libs (Delay k m st ins) = kernels libs (Node k st ins)
kernels libs (Reader k src st ins) = kernels libs (Node k st ins)
kernels libs (Wide k m src st w ins) = kernels libs (Node k st ins)
kernels libs (Shared k m sts x ins) = kernels libs (Node k [] (x : ins))
kernels libs (Node k st ins) = do
  kernel libs k
  mapM_ (kernels libs) ins

-- the nodes added so far: by name, and by kernel, state and inputs. The string is
-- the name the next node takes: a named node keeps its own state, so it never merges.
data Seen = Seen [(String, [Int])] Trie String

noneSeen :: Seen
noneSeen = Seen [] Empty ""

seenNamed :: Seen -> [(String, [Int])]
seenNamed (Seen n b o) = n

seenBuilt :: Seen -> Trie
seenBuilt (Seen n b o) = b

seenOwn :: Seen -> String
seenOwn (Seen n b o) = o

-- s's nodes after those in g, and those named, with the names added
-- before; s's indices, one per channel, -1 for silence. A node whose
-- inputs have w channels becomes w nodes, the kth reading each input's
-- kth channel, or its only one: an input is added once and shared. A
-- named node of several channels is named n.1, n.2 and so on.
add :: Ptr () -> [Ptr ()] -> Seen -> Sig ->> ([Int], Seen)
add g libs ns Silence = ([-1], ns)
add g libs ns (Channels ss) = do
  (iss, ns2) <- if seenOwn ns == "" then addAll g libs ns ss else addOwn g libs ns (seenOwn ns) 1 ss
  (concat iss, ns2)
add g libs (Seen named built own) (Named n s) = case lookup n named of
  Just is -> (is, Seen named built "")
  Nothing -> do
    (is, Seen named2 built2 own2) <- add g libs (Seen named built n) s
    nameAll g (if length is == 1 then [n] else map (\k -> n ++ "." ++ show k) (enumFromTo 1 (length is))) is
    (is, Seen ((n, is) : named2) built2 "")
add g libs ns (Control v) = do
  i <- graphControl g (toCFloat v)
  if i < 0 then error "graph: out of memory" else ([fromIntegral i], ns)
add g libs ns (Bus o c) = reader ns (Bus o c) (1000 + 64 * o + c) (\u -> do
  i <- graphBus g (fromIntegral o) (fromIntegral c)
  if i < 0 then error ("graph: no orbit " ++ show o ++ " channel " ++ show c) else fromIntegral i)
add g libs ns (In c) = reader ns (In c) (c + 1) (\u -> do
  i <- graphIn g (fromIntegral c)
  if i < 0 then error ("graph: no chain channel " ++ show c) else fromIntegral i)
add g libs ns (Node k st ins) = once g libs ns ins (Node k st) (expand g libs k st)
add g libs ns (Delay k m st ins) = once g libs ns ins (Delay k m st) (\iss -> do
  is <- expand g libs k st iss
  mapM_ (\i -> if graphMemory g (fromIntegral i) m < 0 then error ("graph: no memory for " ++ k) else ()) is
  is)
add g libs ns (Wide k m src st w ins) = once g libs ns ins (Wide k m src st w) (\iss -> do
  is <- expand g libs k st iss
  case src of
    Just t -> mapM_ (giveTable g k t) is
    Nothing -> ()
  mapM_ (\i -> if (m > 0.0 && graphMemory g (fromIntegral i) m < 0) || graphOutputs g (fromIntegral i) (fromIntegral w) < 0 then error ("graph: no memory for " ++ k) else ()) is
  is)
add g libs ns (Reader k src st ins) = once g libs ns ins (Reader k src st) (\iss -> do
  is <- expand g libs k st iss
  mapM_ (giveTable g k src) is
  is)
add g libs ns (Shared k m sts x ins) = once g libs ns (x : ins) (Shared k m sts Silence) (\iss -> do
  kp <- kernel libs k
  xs <- head iss
  sharedNodes g kp k m sts ((if length xs == 1 then replicate (length sts) (head xs) else xs) ++ concat (tail iss)))

-- a node of inputs ins, unless one has the same kernel, state and inputs: those
-- give the same samples, so every use of a subtree shares one node. key is the
-- node with its inputs replaced by their indices, so comparing it is shallow.
once :: Ptr () -> [Ptr ()] -> Seen -> [Sig] -> ([Sig] -> Sig) -> ([[Int]] ->> [Int]) ->> ([Int], Seen)
once g libs ns ins key make = do
  (iss, Seen named built own) <- addAll g libs (Seen (seenNamed ns) (seenBuilt ns) "") ins
  k0 <- key (map (\is -> Channels (map (\i -> Control (toFloat i)) is)) iss)
  h <- hashKey k0
  k <- if seenOwn ns == "" then k0 else Named (seenOwn ns) k0
  case findBuilt k h built of
    Just is -> (is, Seen named built "")
    Nothing -> do
      is <- make iss
      (is, Seen named (insertBuilt builtDepth h (k, is) built) "")

-- a Bus or In node, shared like any other: a UGen that reads the chain
-- twice, once through another's input, is one node. A named one is its own.
reader :: Seen -> Sig -> Int -> (() ->> Int) ->> ([Int], Seen)
reader (Seen named built own) key h make = case (if own == "" then findBuilt key h built else Nothing) of
  Just is -> (is, Seen named built own)
  Nothing -> do
    i <- make ()
    ([i], if own == "" then Seen named (insertBuilt builtDepth h (key, [i]) built) own else Seen named built own)

-- a pure hash trie of the nodes built, so a graph of n nodes takes n log n compares.
-- A hash only picks the bucket: same decides, so a collision cannot merge two nodes.
data Trie = Empty | Bucket [(Sig, [Int])] | Fork Trie Trie

builtDepth :: Int
builtDepth = 10

findBuilt :: Sig -> Int -> Trie -> Maybe [Int]
findBuilt k h Empty = Nothing
findBuilt k h (Bucket es) = case filter (\e -> same k (fst e)) es of
  [] -> Nothing
  e : rest -> Just (snd e)
findBuilt k h (Fork l r) = findBuilt k (h `div` 2) (if h `mod` 2 == 0 then l else r)

insertBuilt :: Int -> Int -> (Sig, [Int]) -> Trie -> Trie
insertBuilt d h e t = if d == 0 then (case t of
    Bucket es -> Bucket (e : es)
    _ -> Bucket [e])
  else case t of
    Fork l r -> if h `mod` 2 == 0 then Fork (insertBuilt (d - 1) (h `div` 2) e l) r else Fork l (insertBuilt (d - 1) (h `div` 2) e r)
    _ -> insertBuilt d h e (Fork Empty Empty)

mixHash :: Int -> Int -> Int
mixHash h x = (h * 31 + x) `mod` 2147483647

-- Too large a value, or NaN, hashes as 0: only its bucket suffers.
hashFloat :: Float -> Int
hashFloat x = if abs x < 1.0e9 then round (x * 1024.0) else 0

hashKey :: Sig -> Int
hashKey (Node k st ins) = hashParts k st ins
hashKey (Delay k m st ins) = hashParts k st ins
hashKey (Reader k src st ins) = hashParts k st ins
hashKey (Wide k m src st w ins) = hashParts k st ins
hashKey (Shared k m sts x ins) = hashParts k (concat sts) ins
hashKey s = 0

hashParts :: String -> [Float] -> [Sig] -> Int
hashParts k st ins = foldl mixHash (foldl mixHash (foldl mixHash 7 (map ord (unpack k))) (map hashFloat st)) (concat (map inputHash ins))

inputHash :: Sig -> [Int]
inputHash (Channels is) = map (\c -> case c of
  Control i -> round i
  _ -> 0) is
inputHash s = []

expand :: Ptr () -> [Ptr ()] -> String -> [Float] -> [[Int]] ->> [Int]
expand g libs k st iss = do
  kp <- kernel libs k
  is <- nodes g kp st iss 0 (maximum (1 : map length iss))
  -- a kernel named dsp_u_NAME is a UGen (funk_graph_ugen in graph.h)
  if take 6 (unpack k) == unpack "dsp_u_" then markUgens g is else ()
  is

markUgens :: Ptr () -> [Int] ->> ()
markUgens g [] = ()
markUgens g (i : is) = do
  r <- graphUgen g (fromIntegral i)
  markUgens g is

sharedNodes :: Ptr () -> Ptr () -> String -> Float -> [[Float]] -> [Int] ->> [Int]
sharedNodes g kp k m [] is = []
sharedNodes g kp k m (st:sts) is = do
  i <- node g kp st is
  if graphMemory g (fromIntegral i) m < 0 then error ("graph: no memory for " ++ k) else ()
  i : sharedNodes g kp k m sts is

giveTable :: Ptr () -> String -> Source -> Int ->> ()
giveTable g k (File path c) i = if graphTableFile g (fromIntegral i) path (fromIntegral c) < 0 then error ("graph: " ++ k ++ " cannot read " ++ path ++ ": " ++ tableError ()) else ()
giveTable g k (Sample dir name index c) i = case samplePath dir name (fromIntegral index) of
  "" -> error ("graph: " ++ k ++ " has no sample " ++ name ++ ":" ++ show index ++ " in " ++ dir ++ ": " ++ tableError ())
  path -> giveTable g k (File path c) i
giveTable g k (Builtin name c) i = if graphTableBuiltin g (fromIntegral i) name (fromIntegral c) < 0 then error ("graph: " ++ k ++ ": " ++ tableError ()) else ()
giveTable g k (Values vs) i = allocaBytes (8 * length vs + 8) (\p -> do
  pokeFloats p 0 vs
  if graphTableValues g (fromIntegral i) p (fromIntegral (length vs)) < 0 then error ("graph: " ++ k ++ ": " ++ tableError ()) else ())

-- channels c to w - 1 of a node: each reads its inputs' channel c, or their only one
nodes :: Ptr () -> Ptr () -> [Float] -> [[Int]] -> Int -> Int ->> [Int]
nodes g kp st iss c w = if c == w then [] else do
  i <- node g kp st (map (\is -> if length is == 1 then head is else is !! c) iss)
  i : nodes g kp st iss (c + 1) w

-- a node of kernel kp, initial state st and inputs is; its index
node :: Ptr () -> Ptr () -> [Float] -> [Int] ->> Int
node g kp st is = do
  i <- allocaBytes (8 * length st + 4 * length is) (\p -> do
    pokeFloats p 0 st
    q <- plusPtr p (8 * length st)
    pokeInputs q 0 is
    graphAdd g kp p (fromIntegral (8 * length st)) q (fromIntegral (length is)))
  if i < 0 then error "graph: out of memory" else fromIntegral i

nameAll :: Ptr () -> [String] -> [Int] ->> ()
nameAll g (n:ns) (i:is) = do
  if i >= 0 && graphName g (fromIntegral i) n < 0 then error ("graph: cannot name a named node " ++ n) else ()
  nameAll g ns is
nameAll g _ _ = ()

-- the channels of a node named n: each owns its place, as nameAll names them
addOwn :: Ptr () -> [Ptr ()] -> Seen -> String -> Int -> [Sig] ->> ([[Int]], Seen)
addOwn g libs ns n k [] = ([], ns)
addOwn g libs ns n k (s:ss) = do
  (i, Seen a b o) <- add g libs (Seen (seenNamed ns) (seenBuilt ns) (n ++ "." ++ show k)) s
  (is, ns3) <- addOwn g libs (Seen a b "") n (k + 1) ss
  (i : is, ns3)

addAll :: Ptr () -> [Ptr ()] -> Seen -> [Sig] ->> ([[Int]], Seen)
addAll g libs ns [] = ([], ns)
addAll g libs ns (s:ss) = do
  (i, ns2) <- add g libs ns s
  (is, ns3) <- addAll g libs ns2 ss
  (i : is, ns3)

-- s plays from the player's next block; Silence stops it
play :: Player -> Sig ->> ()
play (Player p libs rate maxBlock) Silence = playerPlay p nullPtr
play (Player p libs rate maxBlock) s = do
  names [] s
  w <- width s
  kernels libs s
  g <- graphNew (fromIntegral maxBlock) rate
  if g == nullPtr then error "graph: out of memory" else do
    (is, ns) <- add g libs noneSeen s
    if w > 1 then mapM_ (output g) is else ()
    playerPlay p g

-- A set of templates, each a name and a Sig, made anew for each event
-- from slots slots (funk_templates_add in graph.h): "s.KEY" a source,
-- "m.NAME" a module, run in the order given; "o.NAME" and "a.NAME" each
-- orbit's effects. Events from the next block
-- use them; events playing keep the set before. Checked as play checks a
-- graph, each built in blocks of 64 frames.
templates :: Player -> Int -> [(String, Sig)] ->> ()
templates (Player p libs rate maxBlock) slots ts = do
  mapM_ (\(n, s) -> do
    names [] s
    width s
    kernels libs s) ts
  t <- templatesNew (fromIntegral slots)
  if t == nullPtr then error "graph: out of memory" else do
    mapM_ (template t libs rate) ts
    if playerTemplates p t < 0 then error "graph: out of memory" else ()

template :: Ptr () -> [Ptr ()] -> Float -> (String, Sig) ->> ()
template t libs rate (n, s) = do
  w <- width s
  g <- graphNew 64 rate
  if g == nullPtr then error "graph: out of memory" else do
    (is, ns) <- add g libs noneSeen s
    if w > 1 then mapM_ (output g) is else ()
    if templatesAdd t n g < 0 then do
      templatesFree t
      error ("graph: cannot add template " ++ n)
    else ()

-- an event of template source from frame on, with parameters ps
-- (funk_player_event in graph.h); False if the queue is full. Events
-- must come in time order.
event :: Player -> Int -> String -> [(String, Float)] ->> Bool
event (Player p libs rate maxBlock) frame source ps = do
  b <- eventBegin p (fromIntegral frame) source /= 0
  ok <- foldl (\acc (n, v) -> acc && eventParam p n (toCFloat v) /= 0) b ps
  ok && eventEnd p /= 0

-- events playing, dropped and late (funk_player_event_counts in graph.h)
events :: Player ->> (Int, Int, Int)
events (Player p libs rate maxBlock) = allocaBytes 24 (\a -> do
  eventCounts p (castPtr a) (castPtr (plusPtr a 8)) (castPtr (plusPtr a 16))
  (fromIntegral (peekByteOff a 0 :: CInt), fromIntegral (peekByteOff a 8 :: CLLong), fromIntegral (peekByteOff a 16 :: CLLong)))

-- i as the next channel's output; a silent channel gets a control at 0
output :: Ptr () -> Int ->> ()
output g i = do
  j <- if i < 0 then fromIntegral (graphControl g (toCFloat 0.0)) else i
  if j < 0 || graphOutput g (fromIntegral j) < 0 then error "graph: out of memory" else ()

-- from frame on, the control named n outputs v; False if the queue is
-- full. Frames already rendered count as the next block's first; sends
-- must come in time order.
send :: Player -> Int -> String -> Float ->> Bool
send (Player p libs rate maxBlock) frame n v = playerSend p (fromIntegral frame) n (toCFloat v) /= 0

-- the frames rendered so far
frames :: Player ->> Int
frames (Player p libs rate maxBlock) = fromIntegral (playerFrames p)

-- the audio thread's call: n frames of the first channel
render :: Player -> Ptr CFloat -> Int ->> ()
render pl out n = renderChannels pl [out] n

-- n frames of each channel, one buffer each; a mono graph plays on all
renderChannels :: Player -> [Ptr CFloat] -> Int ->> ()
renderChannels (Player p libs rate maxBlock) outs n = allocaBytes (8 * length outs) (\a -> do
  pokeAll a 0 outs
  playerRender p a (fromIntegral (length outs)) (fromIntegral n))

pokeAll :: Ptr (Ptr CFloat) -> Int -> [Ptr CFloat] ->> ()
pokeAll a i [] = ()
pokeAll a i (x:xs) = do
  pokeByteOff a (8 * i) x
  pokeAll a (i + 1) xs

-- once render is no longer called; the libraries stay loaded
-- seeds the player's random generator from its next block, as scsynth's
-- RandSeed (funk_player_seed in graph.h)
seed :: Player -> Int ->> ()
seed (Player p libs rate maxBlock) n = playerSeed p (fromIntegral n)

close :: Player ->> ()
close (Player p libs rate maxBlock) = playerFree p
