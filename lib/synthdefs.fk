-- an input: a constant, or UGen i's output k
data In = K Float | U Int Int

-- a UGen: its class, rate (0 scalar, 1 control, 2 audio, 3 demand),
-- special index, number of outputs, and inputs
data UGen = UGen String Int Int Int [In]

-- a SynthDef: its controls by index, each a name and default, and its UGens in order
data Def = Def [(String, Float)] [UGen]

