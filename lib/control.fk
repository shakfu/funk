-- a string literal as a control pattern is a sound, as Tidal's Simple.hs:
-- "bd*2 sn" # gain 0.8
instance p.Parseable Controls where
  parseBP_E str = sound (p.parseBP_E str)

-- Tidal's grain': "0.2:0.3" is begin 0.2, end 0.3
grain' :: p.Pattern String -> p.Pattern Controls
grain' pat = grp [mF "begin", mF "end"] pat

-- a MIDI note as Tidal's note, 60 being note 0
midinote :: p.Pattern p.Note -> p.Pattern Controls
midinote pat = note (p.mapP (\x -> x - 60) pat)

-- a General MIDI drum by Tidal's two-letter name, as n: bd is 36, so n -24
drum :: p.Pattern String -> p.Pattern Controls
drum pat = n (p.mapP (\x -> drumN x - 60) pat)

-- a drum name's General MIDI note, 0 for a name not in drumNames
drumN :: Num a => String -> a
drumN name = case lookup name (zip drumNames [27 .. 87]) of
  Just k -> fromInt k
  Nothing -> 0

-- Tidal's drum names, from General MIDI's notes 27 to 87
drumNames :: [String]
drumNames =
  ["hq", "sl", "ps", "pl", "st", "sq", "ml", "mb", "ab", "bd", "rm", "sn", "cp", "es", "lf", "ch",
   "lt", "hh", "ft", "oh", "mt", "hm", "cr", "ht", "ri", "cy", "be", "ta", "sc", "cb", "cs", "vi",
   "rc", "hb", "lb", "mh", "hc", "lc", "he", "le", "ag", "la", "ca", "ma", "sw", "lw", "sg", "lg",
   "cl", "hi", "li", "mc", "oc", "tr", "ot", "sh", "jb", "bt", "ct", "ms", "os"]

-- Tidal's Simple.hs
crunch :: p.Pattern Controls -> p.Pattern Controls
crunch x = x # crush 3

scratch :: p.Pattern Controls -> p.Pattern Controls
scratch x = p.rev (chop 32 x)

louder :: p.Pattern Controls -> p.Pattern Controls
louder x = x |* gain 1.2

quieter :: p.Pattern Controls -> p.Pattern Controls
quieter x = x |* gain 0.8

silent :: p.Pattern Controls -> p.Pattern Controls
silent _ = p.silence

skip :: p.Pattern Controls -> p.Pattern Controls
skip x = p.rotL 0.25 x

left :: p.Pattern Controls -> p.Pattern Controls
left x = x # pan 0

right :: p.Pattern Controls -> p.Pattern Controls
right x = x # pan 1

higher :: p.Pattern Controls -> p.Pattern Controls
higher x = x |* speed 1.5

lower :: p.Pattern Controls -> p.Pattern Controls
lower x = x |* speed 0.75

faster :: p.Pattern Controls -> p.Pattern Controls
faster x = hurry 2 x

slower :: p.Pattern Controls -> p.Pattern Controls
slower x = hurry 0.5 x

