-- Tidal's generated state families (Params.hs): xTake cycles through a

-- list, xCount counts from 0 and xCountTo counts to a pattern's value.

-- Their buses, xbus and xrecv, wait for SuperDirt's (S2). ringCount is
-- missing: the prelude's ringCount, of a Ring, has the name; write
-- pStateF "ring" name (\m -> fromMaybe (-1.0) m + 1.0).

sTake :: String -> [String] -> p.Pattern Controls
sTake name xs = pStateListS "s" name xs

