-- control.fk -- Tidal's control patterns (docs/dev/delivery.md): events of
-- named parameters, as Tidal's ValueMap, and its operators that combine
-- them. Import every name unqualified, as Tidal's are:
--   import control (..)
-- Controls take mini-notation, as Tidal's take strings: s "bd*2" # gain "0.8".
-- pF, pI, pS and pN take a pattern instead. Notes are Tidal's: note "0" and
-- "c5" are middle C. The helpers are not exported, so (..) takes no common
-- names; the classes are exported without their methods, for the same reason.
module control
  ( Value(..), Controls(..), Unionable, Moddable, (|+|), (|+), (+|), (||+), (|-|), (|-),
    (-|), (||-), (|*|), (|*), (*|), (||*), (|/|), (|/), (/|), (||/), (|%|), (|%), (%|), (||%),
    (|**|), (|**), (**|), (||**), (|++|), (|++), (++|), (||++), (|>|), (>|), (||>), (|<|), (|<),
    (<|), (||<), (#), controlPairs, getControl, controlsFromList, pF, pI, pS, pN, grp, mF, mI, mS,
    spin, chop, striate, striateBy, striate', gap, weave, weaveWith, weave', interlace,
    slice, randslice, splice, loopAt, hurry, smash, smash', echo, echoWith, stut, stutWith,
    stut', jux, juxBy, juxcut, juxcut', jux', jux4, ghost', ghost, contrast, contrastBy, contrastRange,
    fix, unfix, fixRange, unfixRange, grain, squeezeJoinUp, chew, stackwith, splat, chopArc,
    midiOf, Record(..), recordsOf, sampleKey, writeControls, writeControlsWith, writeDirtWith, sound, cc, nrpn, nrpnn, nrpnv, accelerate, amp, attack, bandf, bandq,
    bank, begin, binshift, button0, button1, button10, button11, button12, button13, button14,
    button15, button2, button3, button4, button5, button6, button7, button8, button9, ccn, ccv,
    channel, clhatdecay, coarse, comb, control, cps, crush, ctlNum, ctranspose, cut, cutoff,
    cutoffegint, decay, degree, delay, delayfeedback, delaytime, detune, distort, djf, dry, dur,
    end, enhance, expression, fadeInTime, fadeTime, frameRate, frames, freeze, freq, from, fshift,
    fshiftnote, fshiftphase, gain, gate, harmonic, hatgrain, hbrick, hcutoff, hold, hours,
    hresonance, imag, kcutoff, krush, lagogo, lbrick, lclap, lclaves, lclhat, lcrash, legato,
    leslie, lfo, lfocutoffint, lfodelay, lfoint, lfopitchint, lfoshape, lfosync, lhitom, lkick,
    llotom, lock, loop, lophat, lrate, lsize, lsnare, metatune, midibend, midichan, midicmd,
    miditouch, minutes, modwheel, mtranspose, n, note, nudge, octave, octaveR, octer, octersub,
    octersubsub, offset, ophatdecay, orbit, overgain, overshape, pan, panorient, panspan, pansplay,
    panwidth, partials, phaserdepth, phaserrate, pitch1, pitch2, pitch3, polyTouch, portamento,
    progNum, rate, real, release, resonance, ring, ringdf, ringf, room, sagogo, sclap, sclaves,
    scram, scrash, seconds, semitone, shape, size, slide, slider0, slider1, slider10, slider11,
    slider12, slider13, slider14, slider15, slider2, slider3, slider4, slider5, slider6, slider7,
    slider8, slider9, smear, songPtr, speed, squiz, stepsPerOctave, stutterdepth, stuttertime,
    sustain, sustainpedal, timescale, timescalewin, to, toArg, tomdecay, tremolodepth, tremolorate,
    triode, tsdelay, uid, unit, val, vcfegint, vcoegint, velocity, voice, vowel, waveloss, xsdelay,
    clip, voi, vco, vcf, up, tremr, tremdp, tdecay, sz, sus, stt, std, sld, scr, scp, scl, sag, s,
    rel, por, pit3, pit2, pit1, phasr, phasdp, ohdecay, number, lsn, lpq, lpf, loh, llt, lht, lfop,
    lfoi, lfoc, lcr, lcp, lcl, lch, lbd, lag, hpq, hpf, hg, gat, fadeOutTime, dt, dfb, det, delayt,
    delayfb, ctfg, ctf, chdecay, bpq, bpf, att
  ) where
import pattern as p

data Value = VF Float | VI Int | VS String deriving (Eq, Ord, Show)

-- names and values, sorted by name, each name once
data Controls = Controls [(String, Value)] deriving (Eq, Ord, Show)

controlPairs :: Controls -> [(String, Value)]
controlPairs (Controls kvs) = kvs

-- the value of name, if any
getControl :: String -> Controls -> Maybe Value
getControl name cs = lookup name (controlPairs cs)

-- kvs sorted by name; of equal names, the first
controlsFromList :: [(String, Value)] -> Controls
controlsFromList kvs = Controls (foldl (\acc kv -> mergeWith (\x _ -> x) acc [kv]) [] kvs)

-- the names of both, f joining the values of a name in both
mergeWith :: (Value -> Value -> Value) -> [(String, Value)] -> [(String, Value)] -> [(String, Value)]
mergeWith f a b = case (a, b) of
  ([], _) -> b
  (_, []) -> a
  ((ka, va) : ra, (kb, vb) : rb) ->
    if ka < kb then (ka, va) : mergeWith f ra b
    else if kb < ka then (kb, vb) : mergeWith f a rb
    else (ka, f va vb) : mergeWith f ra rb

-- Tidal's fNum2: Ints by fi, Floats or a mix by ff; otherwise the left value
num2 :: (Int -> Int -> Int) -> (Float -> Float -> Float) -> Value -> Value -> Value
num2 fi ff x y = case (x, y) of
  (VI a, VI b) -> VI (fi a b)
  (VF a, VF b) -> VF (ff a b)
  (VI a, VF b) -> VF (ff (toFloat a) b)
  (VF a, VI b) -> VF (ff a (toFloat b))
  _ -> x

-- Tidal's applyFIS
num1 :: (Float -> Float) -> (Int -> Int) -> Value -> Value
num1 ff fi v = case v of
  VF a -> VF (ff a)
  VI a -> VI (fi a)
  _ -> v

mapValues :: (Value -> Value) -> Controls -> Controls
mapValues f cs = Controls (map (\(k, v) -> (k, f v)) (controlPairs cs))

-- As Tidal's Num ValueMap: a name in one only keeps its value, so a - b
-- negates b's own names; a literal is n.
instance Num Controls where
  a + b = Controls (mergeWith (num2 (+) (+)) (controlPairs a) (controlPairs b))
  a - b = a + negate b
  a * b = Controls (mergeWith (num2 (*) (*)) (controlPairs a) (controlPairs b))
  negate a = mapValues (num1 negate negate) a
  abs a = mapValues (num1 abs abs) a
  fromInt i = Controls [("n", VI i)]

-- as Tidal's: a float literal is a speed; recip leaves Ints alone
instance FromFloat Controls where
  fromFloat x = Controls [("speed", VF x)]

instance Fractional Controls where
  recip a = mapValues (num1 recip (\i -> i)) a

-- a left-biased union: Controls keep the left's value of a shared name;
-- any other value is the left one, as Tidal's default
class Unionable a where
  union :: a -> a -> a

instance Unionable Controls where
  union a b = Controls (mergeWith (\x _ -> x) (controlPairs a) (controlPairs b))

instance Unionable Int where
  union a _ = a

instance Unionable Float where
  union a _ = a

instance Unionable String where
  union a _ = a

-- Tidal's Moddable: mod' for Floats, a result with b's sign
class Moddable a where
  gmod :: a -> a -> a

instance Moddable Int where
  gmod a b = mod a b

instance Moddable Float where
  gmod a b = modF a b

instance Moddable Controls where
  gmod a b = Controls (mergeWith (num2 mod modF) (controlPairs a) (controlPairs b))

modF :: Float -> Float -> Float
modF a b = a - b * toFloat (floor (a / b))

-- Operators, as Tidal's (Core.hs): the bars mark where structure comes
-- from. |op| both sides, |op the left, op| the right, ||op the left with
-- the right squeezed into each of its events.
both :: (a -> b -> c) -> p.Pattern a -> p.Pattern b -> p.Pattern c
both f a b = p.apP (p.mapP f a) b

left :: (a -> b -> c) -> p.Pattern a -> p.Pattern b -> p.Pattern c
left f a b = p.apLeft (p.mapP f a) b

right :: (a -> b -> c) -> p.Pattern a -> p.Pattern b -> p.Pattern c
right f a b = p.apRight (p.mapP f a) b

squeezed :: (a -> b -> c) -> p.Pattern a -> p.Pattern b -> p.Pattern c
squeezed f a b = p.squeezeJoin (p.mapP (\x -> p.mapP (f x) b) a)

(|+|) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |+| b = both (+) a b
(|+) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |+ b = left (+) a b
(+|) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a +| b = right (+) a b
(||+) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||+ b = squeezed (+) a b

(|-|) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |-| b = both (-) a b
(|-) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |- b = left (-) a b
(-|) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a -| b = right (-) a b
(||-) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||- b = squeezed (-) a b

(|*|) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |*| b = both (*) a b
(|*) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |* b = left (*) a b
(*|) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a *| b = right (*) a b
(||*) :: Num a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||* b = squeezed (*) a b

(|/|) :: Fractional a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |/| b = both (/) a b
(|/) :: Fractional a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |/ b = left (/) a b
(/|) :: Fractional a => p.Pattern a -> p.Pattern a -> p.Pattern a
a /| b = right (/) a b
(||/) :: Fractional a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||/ b = squeezed (/) a b

(|%|) :: Moddable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |%| b = both gmod a b
(|%) :: Moddable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |% b = left gmod a b
(%|) :: Moddable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a %| b = right gmod a b
(||%) :: Moddable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||% b = squeezed gmod a b

(|**|) :: p.Pattern Float -> p.Pattern Float -> p.Pattern Float
a |**| b = both (**) a b
(|**) :: p.Pattern Float -> p.Pattern Float -> p.Pattern Float
a |** b = left (**) a b
(**|) :: p.Pattern Float -> p.Pattern Float -> p.Pattern Float
a **| b = right (**) a b
(||**) :: p.Pattern Float -> p.Pattern Float -> p.Pattern Float
a ||** b = squeezed (**) a b

(|++|) :: p.Pattern String -> p.Pattern String -> p.Pattern String
a |++| b = both (++) a b
(|++) :: p.Pattern String -> p.Pattern String -> p.Pattern String
a |++ b = left (++) a b
(++|) :: p.Pattern String -> p.Pattern String -> p.Pattern String
a ++| b = right (++) a b
(||++) :: p.Pattern String -> p.Pattern String -> p.Pattern String
a ||++ b = squeezed (++) a b

-- values from the right
(|>|) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |>| b = both (flip union) a b
(>|) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a >| b = right (flip union) a b
(||>) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||> b = squeezed (flip union) a b

-- values from the left
(|<|) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |<| b = both union a b
(|<) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a |< b = left union a b
(<|) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a <| b = right union a b
(||<) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a ||< b = squeezed union a b

-- structure from the left, values from the right: Tidal's |>, which the
-- prelude's x |> f = f x keeps from this module
(#) :: Unionable a => p.Pattern a -> p.Pattern a -> p.Pattern a
a # b = left (flip union) a b

-- Param makers, as Tidal's: a pattern of one name's values
pF :: String -> p.Pattern Float -> p.Pattern Controls
pF name pat = p.mapP (\x -> Controls [(name, VF x)]) pat

pI :: String -> p.Pattern Int -> p.Pattern Controls
pI name pat = p.mapP (\x -> Controls [(name, VI x)]) pat

pS :: String -> p.Pattern String -> p.Pattern Controls
pS name pat = p.mapP (\x -> Controls [(name, VS x)]) pat

-- a note, as Tidal's pN: its Float, as Tidal's VN plays as a float
pN :: String -> p.Pattern p.Note -> p.Pattern Controls
pN name pat = pF name (p.mapP p.unNote pat)

-- Grouped params, as Tidal's grp: a name split at ':' fills each field in
-- turn; a field that does not parse is left out. sound "bd:3" is s "bd"
-- and n 3.
grp :: [String -> [(String, Value)]] -> p.Pattern String -> p.Pattern Controls
grp fs pat = p.mapP (\name -> controlsFromList (concat (zipWith (\f v -> f v) fs (splitColons name)))) pat

splitColons :: String -> [String]
splitColons s = map pack (wordsBy (unpack s))

-- the runs between ':', empty ones dropped, as Data.List.Split's wordsBy
wordsBy :: [Char] -> [[Char]]
wordsBy cs = case dropWhile (== ':') cs of
  [] -> []
  rest -> case span (/= ':') rest of
    (w, more) -> w : wordsBy more

mF :: String -> String -> [(String, Value)]
mF name v = case vReadFloat (unpack v) of
  Just x -> [(name, VF x)]
  Nothing -> []

mI :: String -> String -> [(String, Value)]
mI name v = case vReadInt (unpack v) of
  Just x -> [(name, VI x)]
  Nothing -> []

mS :: String -> String -> [(String, Value)]
mS name v = [(name, VS v)]

-- Haskell's read for Int: an optional '-', then digits
vReadInt :: [Char] -> Maybe Int
vReadInt cs = case cs of
  '-' : ds -> (case vReadNat ds of
    Just n -> Just (negate n)
    Nothing -> Nothing)
  _ -> vReadNat cs

vReadNat :: [Char] -> Maybe Int
vReadNat ds = if not (null ds) && all isDigit ds then Just (foldl (\a d -> a * 10 + ord d - 48) 0 ds) else Nothing

-- Haskell's read for Double: an optional '-', digits, then .digits and e[-]digits
vReadFloat :: [Char] -> Maybe Float
vReadFloat cs = case cs of
  '-' : r -> (case vReadFloat r of
    Just x -> if take 1 r == ['-'] then Nothing else Just (negate x)
    Nothing -> Nothing)
  _ -> case span isDigit cs of
    ([], _) -> Nothing
    (ds, r) -> case (case r of
        '.' : r1 -> (case span isDigit r1 of
          ([], _) -> (Nothing, r)
          (fs, r2) -> (Just fs, r2))
        _ -> (Just [], r)) of
      (Nothing, _) -> Nothing
      (Just fs, r3) -> case (case r3 of
          'e' : r4 -> vReadInt r4
          [] -> Just 0
          _ -> Nothing) of
        Just e -> if r3 /= [] && vReadInt (drop 1 r3) == Nothing then Nothing else Just (digitsF ds fs * 10.0 ** toFloat e)
        Nothing -> Nothing

digitsF :: [Char] -> [Char] -> Float
digitsF ds fs = toFloat (foldl (\a d -> a * 10 + ord d - 48) 0 (ds ++ fs)) / 10.0 ** toFloat (length fs)

-- Combinators of control patterns, as Tidal's UI.hs and Control.hs
-- (docs/dev/combinators.md). Begin and end set the part of a sample to play.

-- a Float value: a VF's, or a VI's, as Tidal's getF
getF :: Value -> Maybe Float
getF v = case v of
  VF x -> Just x
  VI i -> Just (toFloat i)
  _ -> Nothing

-- name's Float value, or d
floatOf :: Float -> String -> Controls -> Float
floatOf d name cs = case getControl name cs of
  Just v -> fromMaybe d (getF v)
  Nothing -> d

-- name set to v, replacing any value it had
setControl :: String -> Value -> Controls -> Controls
setControl name v cs = union (Controls [(name, v)]) cs

-- s to e cut into n equal spans
chopArc :: p.Span -> Int -> [p.Span]
chopArc a n = map (\i -> p.Span (a.start + div ((a.stop - a.start) * i) n) (a.start + div ((a.stop - a.start) * (i + 1)) n)) [0 .. n - 1]

_stutWith :: Int -> Float -> (p.Pattern a -> p.Pattern a) -> p.Pattern a -> p.Pattern a
_stutWith count time f pat = _echoWith count time f pat

-- copies, each a further 1 / copies cycle earlier and panned that far
spin :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
spin np pat = p.innerJoin (p.mapP (\n -> _spin n pat) np)

_spin :: Int -> p.Pattern Controls -> p.Pattern Controls
_spin copies pat = p.stack (map (\i -> case toFloat i / toFloat copies of
    o -> p.rotL o pat # pF "pan" (p.atom o)) [0 .. copies - 1])

-- each event cut into n, each playing the next part of its sample
chop :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
chop np pat = p.innerJoin (p.mapP (\n -> _chop n pat) np)

_chop :: Int -> p.Pattern Controls -> p.Pattern Controls
_chop n pat = p.squeezeJoin (p.mapP (\v -> p.fastcat (map (\i -> p.atom (chopRange v (toFloat i / toFloat n) (toFloat (i + 1) / toFloat n))) [0 .. n - 1])) pat)

chopRange :: Controls -> Float -> Float -> Controls
chopRange v b e = case (getControl "begin" v, getControl "end" v) of
  (Just bv, Just ev) -> case (getF bv, getF ev) of
    (Just b', Just e') -> union (playRange (b' + b * (e' - b')) (b' + e * (e' - b'))) v
    _ -> union (playRange b e) v
  _ -> union (playRange b e) v

playRange :: Float -> Float -> Controls
playRange b e = Controls [("begin", VF b), ("end", VF e)]

-- n cycles through p, each playing the next nth of its samples
striate :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
striate np pat = p.innerJoin (p.mapP (\n -> _striate n pat) np)

_striate :: Int -> p.Pattern Controls -> p.Pattern Controls
_striate n pat = p.fastcat (map (\i -> p.mapP (mergePlayRange (toFloat i / toFloat n) (toFloat (i + 1) / toFloat n)) pat) [0 .. n - 1])

-- [b, e) of the part of the sample the event already plays
mergePlayRange :: Float -> Float -> Controls -> Controls
mergePlayRange b e cm = case (floatOf 0.0 "begin" cm, floatOf 1.0 "end" cm) of
  (b', e') -> setControl "begin" (VF (b * (e' - b') + b')) (setControl "end" (VF (e * (e' - b') + b')) cm)

-- striate, each part f long
striateBy :: p.Pattern Int -> p.Pattern Float -> p.Pattern Controls -> p.Pattern Controls
striateBy np fp pat = p.innerJoin (p.apP (p.mapP (\n f -> _striateBy n f pat) np) fp)

striate' :: p.Pattern Int -> p.Pattern Float -> p.Pattern Controls -> p.Pattern Controls
striate' np fp pat = striateBy np fp pat

_striateBy :: Int -> Float -> p.Pattern Controls -> p.Pattern Controls
_striateBy n f pat = case (1.0 - f) / toFloat (n - 1) of
  slot -> p.fastcat (map (\i -> p.mapP (mergePlayRange (slot * toFloat i) (slot * toFloat i + f)) pat) [0 .. n - 1])

-- chop, every other part silent; n set to 1 where absent, as Tidal's
gap :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
gap np pat = p.innerJoin (p.mapP (\n -> _gap n pat) np)

_gap :: Int -> p.Pattern Controls -> p.Pattern Controls
_gap n pat = p._fast n (p.cat [p.atom 1, p.silence]) |>| _chop n pat

-- each of ps with p # it, offset through t cycles
weave :: Float -> p.Pattern Controls -> [p.Pattern Controls] -> p.Pattern Controls
weave t pat ps = weaveWith t pat (map (\x y -> x # y) ps)

weaveWith :: Float -> p.Pattern a -> [p.Pattern a -> p.Pattern a] -> p.Pattern a
weaveWith t pat fs = case length fs of
  0 -> p.silence
  l -> p.slowT t (p.stack (zipWith (\i f -> p.rotL (toFloat i / toFloat l) (p.fastT t (f (p.slowT t pat)))) [0 .. l - 1] fs))

weave' :: Float -> p.Pattern a -> [p.Pattern a -> p.Pattern a] -> p.Pattern a
weave' t pat fs = weaveWith t pat fs

interlace :: p.Pattern Controls -> p.Pattern Controls -> p.Pattern Controls
interlace a b = weave 16.0 (pF "shape" (p.sine * 0.9)) [a, b]

-- the ith of n parts of each sample
slice :: p.Pattern Int -> p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
slice np ip pat = case p.apLeft (p.mapP (\i n -> toFloat (mod i n) / toFloat n) ip) np of
  b -> pF "begin" b # pF "end" (b + p.mapP (\n -> 1.0 / toFloat n) np) # pat

_slice :: Int -> Int -> p.Pattern Controls -> p.Pattern Controls
_slice n i pat = pat # pF "begin" (p.atom (toFloat i / toFloat n)) # pF "end" (p.atom (toFloat (i + 1) / toFloat n))

-- one of n parts at random
randslice :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
randslice np pat = p.innerJoin (p.mapP (\n -> p.innerJoin (p.mapP (\i -> _slice n i pat) (p._irand n))) np)

-- slice, with speed set so each part fills its event
splice :: p.Pattern Int -> p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
splice bp ip pat = p.innerJoin (p.mapP (\bits -> _splice bits ip pat) bp)

_splice :: Int -> p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
_splice bits ip pat = p.Pattern (\qst -> let q = qst.arc in map (\e -> case p.wholeOrPart e of
    w -> case (1.0 / toFloat bits) / p.cycles (w.stop - w.start) of
      d -> p.Event e.whole e.part (case getControl "speed" e.value of
        Just (VF sp) -> setControl "speed" (VF (d * sp)) e.value
        _ -> setControl "speed" (VF d) e.value)) (p.queryIn qst (slice (p.atom bits) ip pat) q)) # pS "unit" (p.atom "c")

-- p slowed to n cycles, its speed set to fit
loopAt :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
loopAt np pat = p.slow np pat |* pF "speed" (p.apP (p.mapP (\a k -> a / toFloat k) (p.atom 1.0)) np) # pS "unit" (p.atom "c")

-- fast, with speed raised to match
hurry :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
hurry xp pat = p.fast xp pat |* pF "speed" (p.mapP toFloat xp)

-- striate n p at each speed of xs in turn
smash :: p.Pattern Int -> [p.Pattern Int] -> p.Pattern Controls -> p.Pattern Controls
smash np xs pat = case striate np pat of
  s -> p.slowcat (map (\x -> p.slow x s) xs)

smash' :: Int -> [p.Pattern Int] -> p.Pattern Controls -> p.Pattern Controls
smash' n xs pat = case _chop n pat of
  s -> p.slowcat (map (\x -> p.slow x s) xs)

-- count copies, each time cycles later at feedback times the gain
echo :: p.Pattern Int -> p.Pattern Float -> p.Pattern Float -> p.Pattern Controls -> p.Pattern Controls
echo cp tp fp pat = p.innerJoin (p.apP (p.apP (p.mapP (\c t f -> _echo c t f pat) cp) tp) fp)

_echo :: Int -> Float -> Float -> p.Pattern Controls -> p.Pattern Controls
_echo count time feedback pat = _echoWith count time (\x -> x |* pF "gain" (p.atom feedback)) pat

-- count copies, each time later with f applied once more
echoWith :: p.Pattern Int -> p.Pattern Float -> (p.Pattern a -> p.Pattern a) -> p.Pattern a -> p.Pattern a
echoWith np tp f pat = p.innerJoin (p.apLeft (p.mapP (\n t -> _echoWith n t f pat) np) tp)

_echoWith :: Int -> Float -> (p.Pattern a -> p.Pattern a) -> p.Pattern a -> p.Pattern a
_echoWith count time f pat = if count <= 1 then pat else p.overlay (f (p.rotR time (_echoWith (count - 1) time f pat))) pat

-- count copies, steptime apart, their gain falling to feedback
stut :: p.Pattern Int -> p.Pattern Float -> p.Pattern Float -> p.Pattern Controls -> p.Pattern Controls
stut cp fp tp pat = p.innerJoin (p.apP (p.apP (p.mapP (\c f t -> _stut c f t pat) cp) fp) tp)

_stut :: Int -> Float -> Float -> p.Pattern Controls -> p.Pattern Controls
_stut count feedback steptime pat = p.stack (pat : map (\x -> p.rotR (toFloat x * steptime)
    (pat |* pF "gain" (p.atom (feedback + (1.0 - feedback) * ((toFloat count - toFloat x) / toFloat count))))) [1 .. count - 1])

stutWith :: p.Pattern Int -> p.Pattern Float -> (p.Pattern a -> p.Pattern a) -> p.Pattern a -> p.Pattern a
stutWith np tp f pat = p.innerJoin (p.apLeft (p.mapP (\n t -> _echoWith n t f pat) np) tp)

stut' :: p.Pattern Int -> p.Pattern Float -> (p.Pattern a -> p.Pattern a) -> p.Pattern a -> p.Pattern a
stut' np tp f pat = stutWith np tp f pat

-- p panned left and f p right, or n of the way
jux :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls
jux f pat = juxBy 1.0 f pat

juxBy :: p.Pattern Float -> (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls
juxBy np f pat = case pF "pan" (p.divP np 2.0) of
  half -> p.stack [pat |+ pF "pan" 0.5 |- half, f (pat |+ pF "pan" 0.5 |+ half)]

-- jux, each side in its own cut group
juxcut :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls
juxcut f pat = p.stack [pat # pF "pan" 0.0 # pI "cut" (p.atom (-1)), f (pat # pF "pan" 1.0 # pI "cut" (p.atom (-2)))]

juxcut' :: [a -> p.Pattern Controls] -> a -> p.Pattern Controls
juxcut' fs x = case length fs of
  l -> p.stack (map (\i -> ((fs !! i) x |+ pI "cut" (p.atom (1 - i))) # pF "pan" (p.atom (toFloat i / toFloat l))) [0 .. l - 1])

-- each function's pattern, spread across the stereo field
jux' :: [a -> p.Pattern Controls] -> a -> p.Pattern Controls
jux' fs x = case length fs of
  l -> p.stack (map (\i -> (fs !! i) x |+ pF "pan" (p.atom (toFloat i / toFloat l))) [0 .. l - 1])

jux4 :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls
jux4 f pat = p.stack [pat # pF "pan" (p.atom (5.0 / 8.0)), f (pat # pF "pan" (p.atom (1.0 / 8.0)))]

-- two quieter, shorter, higher copies after each event
ghost' :: Float -> p.Pattern Controls -> p.Pattern Controls
ghost' a pat = p.ghostWith a (\x -> ((x |*| pF "speed" 1.25) # pF "end" 0.2) |*| pF "gain" 0.7) pat

ghost :: p.Pattern Controls -> p.Pattern Controls
ghost pat = ghost' 0.125 pat

-- f on the events that match a's names and values, g on the others
contrast :: (p.Pattern Controls -> p.Pattern Controls) -> (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls -> p.Pattern Controls
contrast f g a pat = contrastBy (\x y -> x == y) f g (p.mapP controlPairs a) pat

-- contrast, matching each name's value by comp
contrastBy :: (a -> Value -> Bool) -> (p.Pattern Controls -> p.Pattern b) -> (p.Pattern Controls -> p.Pattern b) -> p.Pattern [(String, a)] -> p.Pattern Controls -> p.Pattern b
contrastBy comp f g a pat = case p.Pattern (\qst -> let q = qst.arc in map (\e -> case (p.wholeOrPart e).start of
    t -> p.Event e.whole e.part (any (\ea -> all (\(k, v) -> case getControl k e.value of
        Just x -> comp v x
        Nothing -> False) ea.value) (p.queryIn qst a (p.Span t (t + 1))), e.value)) (p.queryIn qst pat q)) of
  m -> p.overlay (f (p.mapMaybeP (\(t, v) -> if t then Just v else Nothing) m)) (g (p.mapMaybeP (\(t, v) -> if t then Nothing else Just v) m))

-- contrast, matching a value within each name's range
contrastRange :: (p.Pattern Controls -> p.Pattern b) -> (p.Pattern Controls -> p.Pattern b) -> p.Pattern [(String, (Value, Value))] -> p.Pattern Controls -> p.Pattern b
contrastRange f g a pat = contrastBy inRange f g a pat

inRange :: (Value, Value) -> Value -> Bool
inRange r v = case (r, v) of
  ((VI s, VI e), VI x) -> x >= s && x <= e
  ((VF s, VF e), VF x) -> x >= s && x <= e
  ((VS s, VS e), VS x) -> x == s && x == e
  _ -> False

-- f on the events that match a
fix :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls -> p.Pattern Controls
fix f a pat = contrast f id a pat

unfix :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern Controls -> p.Pattern Controls -> p.Pattern Controls
unfix f a pat = contrast id f a pat

fixRange :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern [(String, (Value, Value))] -> p.Pattern Controls -> p.Pattern Controls
fixRange f a pat = contrastRange f id a pat

unfixRange :: (p.Pattern Controls -> p.Pattern Controls) -> p.Pattern [(String, (Value, Value))] -> p.Pattern Controls -> p.Pattern Controls
unfixRange f a pat = contrastRange id f a pat

-- begin at s, end w later
grain :: p.Pattern Float -> p.Pattern Float -> p.Pattern Controls
grain s w = pF "begin" s # pF "end" (s + w)

-- squeezeJoin, each inner pattern's speed raised by its event's shortness
squeezeJoinUp :: p.Pattern (p.Pattern Controls) -> p.Pattern Controls
squeezeJoinUp pp = p.Pattern (\qst -> let q = qst.arc in concatMap (\eo -> case eo.whole of
    Just w -> case mod w.start p.cycleTicks of
      c -> concatMap (\ei -> case ei.whole of
          Just iw -> concatMap (\nw -> map (\np -> p.Event (Just nw) np ei.value) (p.sect eo.part ei.part)) (p.sect w iw)
          Nothing -> [])
        (p.queryIn qst (p.compressTicks c (c + w.stop - w.start) (eo.value |* pF "speed" (p.atom (1.0 / p.cycles (w.stop - w.start))))) eo.part)
    Nothing -> []) (p.queryIn qst pp q))

-- bite, changing speed with the length of each part
chew :: p.Pattern Int -> p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
chew np ip pat = p.innerJoin (p.mapP (\n -> _chew n ip pat) np)

_chew :: Int -> p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls
_chew n ip pat = squeezeJoinUp (p.mapP (\i -> case mod i n of
    k -> p.zoomTicks (div (k * p.cycleTicks) n) (div ((k + 1) * p.cycleTicks) n) pat) ip) |/ pF "speed" (p.atom (toFloat n))

-- each of ps with p's values, p offset a further 1 / length ps each
stackwith :: Unionable a => p.Pattern a -> [p.Pattern a] -> p.Pattern a
stackwith pat ps = case length ps of
  0 -> p.silence
  l -> p.stack (zipWith (\i x -> x # p.rotL (toFloat i / toFloat l) pat) [0 .. l - 1] ps)

-- chop, each part's event moved to epat's
splat :: p.Pattern Int -> p.Pattern Controls -> p.Pattern Controls -> p.Pattern Controls
splat slices epat pat = chop slices pat # p.bite 1 (p.mapP (\_ -> 0) pat) epat

-- MIDI, as SuperDirt's MIDI target plays an event (DirtEventTypes.sc,
-- DirtOrbit.sc). An event plays if it has no s or s is "midi". In order:
-- ccn and ccv's CC; nrpn and val's six CCs; progNum; midibend; miditouch;
-- then, if it has n or note, a note-on, or polyTouch's message instead;
-- then midicmd's. The note is note, else n, plus 12 * octave, octave 5
-- unless given, or freq's nearest. Velocity is amp * (min gain 2 +
-- overgain)^4 * 127, amp 0.4 unless given. The note lasts sustain seconds,
-- else legato times the event, else the event, less SuperDirt's fade:
-- min 1 ms (sustain * 0.19098). midichan counts from 0.
-- Each message is (bytes, length): bytes is status + 256 * data1 + 65536 *
-- data2 + 16777216 * size; length is the note's, in units, or -1. dur is
-- the event's length in units; ups, units per second.
midiOf :: Int -> Int -> Controls -> [(Int, Int)]
midiOf ups dur cs = if not midiTarget then [] else
    ccs ++ nrpns ++ msg2 "progNum" 192 ++ bend ++ msg2 "miditouch" 208 ++ note ++ command
  where
    midiTarget = case getControl "s" cs of
      Nothing -> True
      Just (VS x) -> x == "midi"
      Just _ -> False
    num k = case getControl k cs of
      Just (VF x) -> Just x
      Just (VI i) -> Just (toFloat i)
      _ -> Nothing
    int k = case num k of
      Just x -> Just (truncate x)
      Nothing -> Nothing
    orF k d = case num k of
      Just x -> x
      Nothing -> d
    orI k d = case int k of
      Just x -> x
      Nothing -> d
    chan = clampTo 0 15 (orI "midichan" 0)
    bytes st xs = (st + chan + sum (zipWith (\k x -> k * clampTo 0 127 x) [256, 65536] xs) + 16777216 * (length xs + 1), -1)
    cc a b = bytes 176 [a, b]
    ccs = case (int "ccn", int "ccv") of
      (Just a, Just b) -> [cc a b]
      _ -> []
    nrpns = case int "nrpn" of
      Just r -> (case orI "val" 0 of
        v -> [cc 99 (div r 128), cc 98 (mod r 128), cc 6 (div v 128), cc 38 (mod v 128), cc 101 127, cc 100 127])
      Nothing -> []
    msg2 k st = case int k of
      Just v -> [bytes st [v]]
      Nothing -> []
    bend = case int "midibend" of
      Just v -> (case clampTo 0 16383 v of
        b -> [bytes 224 [mod b 128, div b 128]])
      Nothing -> []
    hasNote = getControl "n" cs /= Nothing || getControl "note" cs /= Nothing
    midinote = clampTo 0 127 (floor (0.5 + (case num "freq" of
      Just f -> 69.0 + 12.0 * log (f / 440.0) / log 2.0
      Nothing -> (case num "note" of
        Just x -> x
        Nothing -> orF "n" 0.0) + 12.0 * orF "octave" 5.0)))
    level = orF "amp" 0.4 * fourth (min (orF "gain" 1.0) 2.0 + orF "overgain" 0.0) * 127.0
    velocity = clampTo 0 127 (truncate level)
    sustain = case num "sustain" of
      Just x -> x * toFloat ups
      Nothing -> toFloat dur * orF "legato" 1.0
    noteLength = max 1 (truncate (sustain - min (0.001 * toFloat ups) (sustain * 0.19098)))
    note = if not hasNote then [] else case int "polyTouch" of
      Just v -> [bytes 160 [midinote, v]]
      Nothing -> [(fst (bytes 144 [midinote, velocity]), noteLength)]
    -- midicmd: start, continue, stop, midiClock, allNotesOff, control
    -- (ctlNum, control), songPtr, and touch and bend by val unless
    -- miditouch or midibend sent them; program is progNum's
    command = case getControl "midicmd" cs of
      Just (VS x) -> commandOf (unpack x)
      _ -> []
    commandOf x =
      if x == unpack "start" then [realtime 250]
      else if x == unpack "continue" then [realtime 251]
      else if x == unpack "stop" then [realtime 252]
      else if x == unpack "midiClock" then [realtime 248]
      else if x == unpack "allNotesOff" then [cc 123 0]
      else if x == unpack "control" then [cc (orI "ctlNum" 0) (orI "control" 0)]
      else if x == unpack "songPtr" then (case clampTo 0 16383 (orI "songPtr" 0) of
        v -> [(242 + 256 * mod v 128 + 65536 * div v 128 + 16777216 * 3, -1)])
      else if x == unpack "touch" && int "miditouch" == Nothing then (case int "val" of
        Just v -> [bytes 208 [v]]
        Nothing -> [])
      else if x == unpack "bend" && int "midibend" == Nothing then (case int "val" of
        Just v -> (case clampTo 0 16383 v of
          b -> [bytes 224 [mod b 128, div b 128]])
        Nothing -> [])
      else []
    realtime st = (st + 16777216, -1)

fourth :: Float -> Float
fourth x = x * x * x * x

clampTo :: Int -> Int -> Int -> Int
clampTo lo hi x = max lo (min hi x)

-- What an event sends the hosts (docs/dev/delivery.md, step 3): MIDI
-- messages, a name's chunks, a parameter's value, which takes the chunks
-- before it as its name, and a sample's trigger, which takes them as its
-- key. A MIDI event's other parameters go before its messages, for its
-- voice; a sample event's parameters, then its trigger, for d.kit.
data Record = RMidi Int Int | RName Int | RParam Float | RTrigger deriving (Eq, Show)

-- the names midiOf reads, which a voice is not sent
midiNames :: [String]
midiNames = ["s", "n", "note", "octave", "freq", "amp", "gain", "overgain", "sustain", "legato", "midichan",
  "velocity", "ccn", "ccv", "nrpn", "val", "progNum", "midibend", "miditouch", "polyTouch", "midicmd", "ctlNum",
  "control", "songPtr"]

recordsOf :: Int -> Int -> Int -> Controls -> [Record]
recordsOf ups cyc dur cs = case getControl "s" cs of
  Just (VS x) -> if x == "midi" then forVoice else forSample x
  Just _ -> []
  Nothing -> forVoice
  where
    num k d = case getControl k cs of
      Just (VF x) -> x
      Just (VI i) -> toFloat i
      _ -> d
    named k v = map RName (chunks (unpack k)) ++ [RParam v]
    forVoice = concatMap (\(k, v) -> case v of
        VF x -> if elem k midiNames then [] else named k x
        VI i -> if elem k midiNames then [] else named k (toFloat i)
        VS _ -> []) (controlPairs cs)
      ++ map (\(m, l) -> RMidi m l) (midiOf ups dur cs)
    -- SuperDirt's: amp * (min gain 2 + overgain)^4, relative to amp's 0.4, so 1 by default
    level = num "amp" 0.4 / 0.4 * fourth (min (num "gain" 1.0) 2.0 + num "overgain" 0.0)
    -- SuperDirt's: sustain, else legato times the event, else -1 for the
    -- sample's own; the pitch of note and octave, or of freq; for unit "c",
    -- cycles per second; accelerate 1e30 if absent (dsp_dirt in lib/kernels.fk)
    sustain = case getControl "sustain" cs of
      Just _ -> num "sustain" 0.0
      Nothing -> case getControl "legato" cs of
        Just _ -> toFloat dur / toFloat ups * num "legato" 1.0
        Nothing -> -1.0
    pitch = case getControl "freq" cs of
      Just _ -> num "freq" 261.6255653005986 / 261.6255653005986
      Nothing -> 2.0 ** ((num "note" 0.0 + 12.0 * (num "octave" 5.0 - 5.0)) / 12.0)
    cps = if getControl "unit" cs == Just (VS "c") then toFloat ups / toFloat cyc else 0.0
    forSample x = concatMap (\(k, v) -> named k v) [("speed", num "speed" 1.0), ("level", level), ("pan", num "pan" 0.5),
        ("begin", num "begin" 0.0), ("end", num "end" 1.0), ("loop", num "loop" 1.0), ("accelerate", num "accelerate" 1.0e30),
        ("sustain", sustain), ("pitch", pitch), ("cps", cps), ("cut", num "cut" 0.0), ("orbit", num "orbit" 0.0)]
      ++ map RName (chunks (unpack (sampleKey x (truncate (num "n" 0.0))))) ++ [RTrigger]

-- a sample's key, as d.kit names its controls: "bd:3"
sampleKey :: String -> Int -> String
sampleKey name index = case p.soundParts name of
  (folder, i) -> folder ++ ":" ++ show (if i /= 0 then i else index)

-- 8 characters an Int, low byte first
chunks :: [Char] -> [Int]
chunks cs = if null cs then [] else foldr (\c acc -> acc * 256 + mod (ord c) 256) 0 (take 8 cs) : chunks (drop 8 cs)

-- For a host that owns the memory, as p.writeEvents: writes the first cap
-- records of the events that start in units [a, b), three Ints each: the
-- start, a tag, and a payload. A MIDI message's tag is midiOf's bytes and
-- its payload the note's length; a name chunk's tag is 244 (0xF4) and its
-- payload 8 characters; a parameter's tag is 245 (0xF5) and its payload
-- a Float; a trigger's tag is 253 (0xFD). cs is units per cycle, ups per
-- second. Returns how many there were.
writeControls :: Ptr Int -> Int -> p.Pattern Controls -> Int -> Int -> Int -> Int ->> Int
writeControls buf cap pat cs ups a b = writeControlsWith buf cap pat [] cs ups a b

-- writeControls, queried with the host's controls (p.readControls)
writeControlsWith :: Ptr Int -> Int -> p.Pattern Controls -> [(String, p.Ctl)] -> Int -> Int -> Int -> Int ->> Int
writeControlsWith buf cap pat ctls cs ups a b = writeRecords buf cap 0 (concatMap (\(s, d, v) -> map (\r -> (s, r)) (recordsOf ups cs d v)) (p.sampleEventsWith ctls pat cs a b))

writeRecords :: Ptr Int -> Int -> Int -> [(Int, Record)] ->> Int
writeRecords buf cap i rs = case rs of
  [] -> i
  (t, r) : rest -> do
    if i < cap then do
      poke (plusPtr buf (i * 24)) t
      case r of
        RMidi m l -> do
          poke (plusPtr buf (i * 24 + 8)) m
          poke (plusPtr buf (i * 24 + 16)) l
        RName c -> do
          poke (plusPtr buf (i * 24 + 8)) 244
          poke (plusPtr buf (i * 24 + 16)) c
        RParam x -> do
          poke (plusPtr buf (i * 24 + 8)) 245
          poke (plusPtr buf (i * 24 + 16)) x
        RTrigger -> do
          poke (plusPtr buf (i * 24 + 8)) 253
          poke (plusPtr buf (i * 24 + 16)) 0
    else ()
    writeRecords buf cap (i + 1) rest

-- For a SuperDirt target (funk-midi --dirt, docs/dev/dirt.md): the onsets
-- that start in units [a, b) and have an `s`, as Tidal's superdirtShape
-- requires, in order of start, written to buf's cap bytes. Each is its start
-- and duration in units, its cycle (ot is the pattern's tick at unit 0),
-- the number of controls, then each control's kind (0 float, 1 int, 2
-- string), name and value; a string is its length, then its bytes padded
-- to 8. A start of -1 ends them. Returns the number of events, so a result
-- above the number written means some did not fit.
writeDirtWith :: Ptr Int -> Int -> p.Pattern Controls -> [(String, p.Ctl)] -> Int -> Int -> Int -> Int ->> Int
writeDirtWith buf cap pat ctls cs ot a b = writeDirts buf cap 0 cs ot (dirtOnsets pat ctls cs a b) 0

dirtOnsets :: p.Pattern Controls -> [(String, p.Ctl)] -> Int -> Int -> Int -> [p.Event Controls]
dirtOnsets pat ctls cs a b =
  sortBy (\x y -> compare (p.wholeOrPart x).start (p.wholeOrPart y).start)
    (filter (\e -> case getControl "s" e.value of
                     Just _ -> True
                     Nothing -> False)
      (p.onsetsState pat (p.State (p.Span (p.ceilDiv (a * p.cycleTicks) cs) (p.ceilDiv (b * p.cycleTicks) cs)) ctls)))

writeDirts :: Ptr Int -> Int -> Int -> Int -> Int -> [p.Event Controls] -> Int ->> Int
writeDirts buf cap off cs ot es n = case es of
  [] -> do
    endDirt buf cap off
    n
  e : rest ->
    if off + dirtSize (controlPairs e.value) + 8 <= cap then do
      writeDirt buf off cs ot e
      writeDirts buf cap (off + dirtSize (controlPairs e.value)) cs ot rest (n + 1)
    else do
      endDirt buf cap off
      n + length es

-- ticks t in units, to the nearest, as Link rounds Tidal's times to microseconds
nearest :: Int -> Int -> Int
nearest cs t = div (2 * t * cs + p.cycleTicks) (2 * p.cycleTicks)

endDirt :: Ptr Int -> Int -> Int ->> ()
endDirt buf cap off = if off + 8 <= cap then pokeByteOff buf off (negate 1 :: Int) else ()

dirtSize :: [(String, Value)] -> Int
dirtSize kvs = 32 + sum (map (\(k, v) -> 8 + strSize k + (case v of
    VS x -> strSize x
    _ -> 8)) kvs)

strSize :: String -> Int
strSize s = 8 + 8 * p.ceilDiv (length s) 8

writeDirt :: Ptr Int -> Int -> Int -> Int -> p.Event Controls ->> ()
writeDirt buf off cs ot e = case p.wholeOrPart e of
  w -> do
    pokeByteOff buf off (nearest cs w.start)
    pokeByteOff buf (off + 8) (nearest cs w.stop - nearest cs w.start)
    pokeByteOff buf (off + 16) (toFloat (w.start + ot) / toFloat p.cycleTicks)
    pokeByteOff buf (off + 24) (length (controlPairs e.value))
    writePairs buf (off + 32) (controlPairs e.value)

writePairs :: Ptr Int -> Int -> [(String, Value)] ->> ()
writePairs buf off kvs = case kvs of
  [] -> ()
  (k, v) : rest -> do
    case v of
      VF x -> do
        pokeByteOff buf off (0 :: Int)
        pokeByteOff buf (off + 8 + strSize k) x
      VI i -> do
        pokeByteOff buf off (1 :: Int)
        pokeByteOff buf (off + 8 + strSize k) i
      VS x -> do
        pokeByteOff buf off (2 :: Int)
        pokeStr buf (off + 8 + strSize k) x
    pokeStr buf (off + 8) k
    writePairs buf (off + 8 + strSize k + (case v of
      VS x -> strSize x
      _ -> 8)) rest

pokeStr :: Ptr Int -> Int -> String ->> ()
pokeStr buf off s = do
  pokeByteOff buf off (length s)
  mapM_ (\(i, c) -> pokeByteOff buf (off + 8 + i) (fromIntegral (ord c) :: CChar)) (zip (enumFromTo 0 (length s - 1)) (unpack s))

-- Grouped controls
sound :: p.Pattern String -> p.Pattern Controls
sound pat = grp [mS "s", mF "n"] pat

cc :: p.Pattern String -> p.Pattern Controls
cc pat = grp [mF "ccn", mF "ccv"] pat

nrpn :: p.Pattern String -> p.Pattern Controls
nrpn pat = grp [mI "nrpn", mI "val"] pat

-- Tidal's other controls, generated from its Params.hs: each takes a
-- pattern of one name's values, of Tidal's type; a string literal is
-- mini-notation. Bus and recv forms are left out: there are
-- no control buses.

nrpnn :: p.Pattern Int -> p.Pattern Controls
nrpnn pat = pI "nrpn" pat

nrpnv :: p.Pattern Int -> p.Pattern Controls
nrpnv pat = pI "val" pat

accelerate :: p.Pattern Float -> p.Pattern Controls
accelerate pat = pF "accelerate" pat

amp :: p.Pattern Float -> p.Pattern Controls
amp pat = pF "amp" pat

attack :: p.Pattern Float -> p.Pattern Controls
attack pat = pF "attack" pat

bandf :: p.Pattern Float -> p.Pattern Controls
bandf pat = pF "bandf" pat

bandq :: p.Pattern Float -> p.Pattern Controls
bandq pat = pF "bandq" pat

bank :: p.Pattern String -> p.Pattern Controls
bank pat = pS "bank" pat

begin :: p.Pattern Float -> p.Pattern Controls
begin pat = pF "begin" pat

binshift :: p.Pattern Float -> p.Pattern Controls
binshift pat = pF "binshift" pat

button0 :: p.Pattern Float -> p.Pattern Controls
button0 pat = pF "button0" pat

button1 :: p.Pattern Float -> p.Pattern Controls
button1 pat = pF "button1" pat

button10 :: p.Pattern Float -> p.Pattern Controls
button10 pat = pF "button10" pat

