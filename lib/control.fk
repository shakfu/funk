button13 pat = pF "button13" pat

button14 :: p.Pattern Float -> p.Pattern Controls
button14 pat = pF "button14" pat

button15 :: p.Pattern Float -> p.Pattern Controls
button15 pat = pF "button15" pat

button2 :: p.Pattern Float -> p.Pattern Controls
button2 pat = pF "button2" pat

button3 :: p.Pattern Float -> p.Pattern Controls
button3 pat = pF "button3" pat

button4 :: p.Pattern Float -> p.Pattern Controls
button4 pat = pF "button4" pat

button5 :: p.Pattern Float -> p.Pattern Controls
button5 pat = pF "button5" pat

button6 :: p.Pattern Float -> p.Pattern Controls
button6 pat = pF "button6" pat

button7 :: p.Pattern Float -> p.Pattern Controls
button7 pat = pF "button7" pat

button8 :: p.Pattern Float -> p.Pattern Controls
button8 pat = pF "button8" pat

button9 :: p.Pattern Float -> p.Pattern Controls
button9 pat = pF "button9" pat

ccn :: p.Pattern Float -> p.Pattern Controls
ccn pat = pF "ccn" pat

ccv :: p.Pattern Float -> p.Pattern Controls
ccv pat = pF "ccv" pat

channel :: p.Pattern Int -> p.Pattern Controls
channel pat = pI "channel" pat

clhatdecay :: p.Pattern Float -> p.Pattern Controls
clhatdecay pat = pF "clhatdecay" pat

coarse :: p.Pattern Float -> p.Pattern Controls
coarse pat = pF "coarse" pat

comb :: p.Pattern Float -> p.Pattern Controls
comb pat = pF "comb" pat

control :: p.Pattern Float -> p.Pattern Controls
control pat = pF "control" pat

cps :: p.Pattern Float -> p.Pattern Controls
cps pat = pF "cps" pat

crush :: p.Pattern Float -> p.Pattern Controls
crush pat = pF "crush" pat

ctlNum :: p.Pattern Float -> p.Pattern Controls
ctlNum pat = pF "ctlNum" pat

ctranspose :: p.Pattern Float -> p.Pattern Controls
ctranspose pat = pF "ctranspose" pat

cut :: p.Pattern Int -> p.Pattern Controls
cut pat = pI "cut" pat

cutoff :: p.Pattern Float -> p.Pattern Controls
cutoff pat = pF "cutoff" pat

cutoffegint :: p.Pattern Float -> p.Pattern Controls
cutoffegint pat = pF "cutoffegint" pat

decay :: p.Pattern Float -> p.Pattern Controls
decay pat = pF "decay" pat

