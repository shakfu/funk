-- prelude.fk -- compiled before every program. Primitives live in src/prims.def.
-- Instances for Bool, () and tuples are generated (builtin_instances_src).

-- classes

class Eq a where
  (==), (/=) :: a -> a -> Bool
  x /= y = not (x == y)

class Eq a => Ord a where
  compare :: a -> a -> Ordering

class Show a where
  showPrec :: Int -> a -> String
  show :: a -> String
  showList :: [a] -> String
  showPrec _ x = show x
  show x = showPrec 0 x
  showList [] = "[]"
  showList (x:xs) = concatStrings ("[" : showPrec 0 x : map (\y -> "," ++ showPrec 0 y) xs ++ ["]"])

-- ++ and length work on lists and on String, the packed text type

class Append a where
  (++) :: a -> a -> a

class Sized a where
  length :: a -> Int

class Num a where
  (+), (-), (*) :: a -> a -> a
  negate, abs :: a -> a
  fromInt :: Int -> a

-- Int, and the C integer types of foreign imports (CInt, CSize, ...)
class Num a => Integral a where
  toInt :: a -> Int

data Maybe a = Nothing | Just a deriving (Eq, Ord, Show)
data Either a b = Left a | Right b deriving (Eq, Ord, Show)
data Ordering = LT | EQ | GT deriving (Eq, Ord, Show)

-- instances for primitive types; `x == y` at Int compiles to primEqInt directly

instance Eq Int where
  (==) = primEqInt
  (/=) = primNeInt
instance Ord Int where
  compare x y = if primLtInt x y then LT else if primEqInt x y then EQ else GT
instance Show Int where
  showPrec d n = if d > 6 && n < 0 then "(" ++ primShowInt n ++ ")" else primShowInt n
instance Num Int where
  (+) = primAddInt
  (-) = primSubInt
  (*) = primMulInt
  negate = primNegateInt
  abs = primAbsInt
  fromInt n = n
instance Integral Int where
  toInt n = n

instance Eq Float where
  (==) = primEqFloat
  (/=) = primNeFloat
instance Ord Float where
  compare x y = if primLtFloat x y then LT else if primEqFloat x y then EQ else GT
instance Show Float where
  showPrec d x = if d > 6 && x < 0.0 then "(" ++ primShowFloat x ++ ")" else primShowFloat x
instance Num Float where
  (+) = primAddFloat
  (-) = primSubFloat
  (*) = primMulFloat
  negate = primNegateFloat
  abs = primAbsFloat
  fromInt = toFloat

instance Eq Char where
  (==) = primEqChar
  (/=) = primNeChar
instance Ord Char where
  compare x y = if primLtChar x y then LT else if primEqChar x y then EQ else GT
instance Show Char where
  showPrec _ c = primShowChar c
  showList cs = primShowCharList cs

instance Eq String where
  (==) = primEqString
  (/=) = primNeString
instance Ord String where
  compare x y = if primLtString x y then LT else if primEqString x y then EQ else GT
instance Show String where
  showPrec _ s = primShowString s

instance Append String where
  (++) = primAppendString
instance Sized String where
  length = primLengthString

instance Append [a] where
  [] ++ ys = ys
  (x:xs) ++ ys = x : (xs ++ ys)
instance Sized [a] where
  length xs = foldl (\n _ -> n + 1) 0 xs

instance Eq a => Eq [a] where
  [] == [] = True
  (x:xs) == (y:ys) = x == y && xs == ys
  _ == _ = False
instance Ord a => Ord [a] where
  compare [] [] = EQ
  compare [] _ = LT
  compare _ [] = GT
  compare (x:xs) (y:ys) = case compare x y of
    EQ -> compare xs ys
    o -> o
instance Show a => Show [a] where
  showPrec _ xs = showList xs

showParen b s = if b then "(" ++ s ++ ")" else s

print x = putStrLn (show x)

-- functions

id x = x
const x _ = x
flip f x y = f y x
-- three parameters, so (f . g) x is one saturated call that can be specialized
(.) f g x = f (g x)
(>>>) f g x = g (f x)
x |> f = f x
f $ x = f x
until p f x = if p x then x else until p f (f x)

-- infix && and || short-circuit in the parser; these serve (&&) and (||)
a && b = if a then b else False
a || b = if a then True else b
not True = False
not False = True
otherwise = True

fst (a, _) = a
snd (_, b) = b
curry f a b = f (a, b)
uncurry f (a, b) = f a b

-- comparison, through compare

x < y = case compare x y of
  LT -> True
  _ -> False
x <= y = case compare x y of
  GT -> False
  _ -> True
x > y = case compare x y of
  GT -> True
  _ -> False
x >= y = case compare x y of
  LT -> False
  _ -> True
min a b = if a <= b then a else b
max a b = if a >= b then a else b

-- numbers

-- conversion between integer types; out-of-range values wrap, as in C
fromIntegral :: (Integral a, Num b) => a -> b
fromIntegral x = fromInt (toInt x)

subtract x y = y - x
even n = mod n 2 == 0
odd n = mod n 2 /= 0

gcd a b = if b == 0 then abs a else gcd b (mod a b)

x ^ n
  | n < 0 = error "^: negative exponent"
  | n == 0 = 1
  | even n = let h = x ^ div n 2 in h * h
  | otherwise = x * x ^ (n - 1)

-- lists

head (x:_) = x
head [] = error "head: empty list"
tail (_:xs) = xs
tail [] = error "tail: empty list"
last [x] = x
last (_:xs) = last xs
last [] = error "last: empty list"
init [x] = []
init (x:xs) = x : init xs
init [] = error "init: empty list"
null [] = True
null _ = False

(x:xs) !! n = if n == 0 then x else xs !! (n - 1)
[] !! _ = error "!!: index too large"

map f [] = []
map f (x:xs) = f x : map f xs
filter p [] = []
filter p (x:xs) = if p x then x : filter p xs else filter p xs
foldl f z [] = z
foldl f z (x:xs) = foldl f (f z x) xs
foldr f z [] = z
foldr f z (x:xs) = f x (foldr f z xs)
foldl1 f (x:xs) = foldl f x xs
foldl1 _ [] = error "foldl1: empty list"

sum xs = foldl (+) 0 xs
product xs = foldl (*) 1 xs
maximum xs = foldl1 max xs
minimum xs = foldl1 min xs
reverse xs = foldl (flip (:)) [] xs

concat xss = foldr (++) [] xss
concatMap f xs = concat (map f xs)

any p [] = False
any p (x:xs) = p x || any p xs
all p [] = True
all p (x:xs) = p x && all p xs
and xs = all id xs
or xs = any id xs
elem x xs = any (== x) xs
notElem x xs = not (elem x xs)

take n xs | n <= 0 = []
take _ [] = []
take n (x:xs) = x : take (n - 1) xs
drop n xs | n <= 0 = xs
drop _ [] = []
drop n (_:xs) = drop (n - 1) xs
splitAt n xs = (take n xs, drop n xs)
takeWhile p [] = []
takeWhile p (x:xs) = if p x then x : takeWhile p xs else []
dropWhile p [] = []
dropWhile p (x:xs) = if p x then dropWhile p xs else x : xs
span p xs = (takeWhile p xs, dropWhile p xs)
break p xs = span (not . p) xs

zip (x:xs) (y:ys) = (x, y) : zip xs ys
zip _ _ = []
zipWith f (x:xs) (y:ys) = f x y : zipWith f xs ys
zipWith _ _ _ = []
unzip ps = (map fst ps, map snd ps)
replicate n x = if n <= 0 then [] else x : replicate (n - 1) x

enumFromTo a b = if a > b then [] else a : enumFromTo (a + 1) b
enumFromThenTo a b c = go a
  where
    step = b - a
    go x
      | step == 0 = error "enumFromThenTo: zero step"
      | step > 0 && x > c = []
      | step < 0 && x < c = []
      | otherwise = x : go (x + step)

lookup _ [] = Nothing
lookup k ((k2, v):rest) = if k == k2 then Just v else lookup k rest

sort xs = sortBy compare xs
sortBy cmp xs = mergeAll (map (\x -> [x]) xs)
  where
    mergeAll [] = []
    mergeAll [x] = x
    mergeAll xss = mergeAll (mergePairs xss)
    mergePairs (a:b:rest) = merge a b : mergePairs rest
    mergePairs xss = xss
    merge [] ys = ys
    merge xs [] = xs
    merge (x:xs) (y:ys) = case cmp x y of
      GT -> y : merge (x:xs) ys
      _ -> x : merge xs (y:ys)

-- Maybe, Either

maybe d _ Nothing = d
maybe _ f (Just x) = f x
fromMaybe d Nothing = d
fromMaybe _ (Just x) = x
either f _ (Left a) = f a
either _ g (Right b) = g b

-- characters and strings

isSpace c = c == ' ' || c == '\n' || c == '\t' || c == '\r'
isDigit c = c >= '0' && c <= '9'
isUpper c = c >= 'A' && c <= 'Z'
isLower c = c >= 'a' && c <= 'z'
isAlpha c = isUpper c || isLower c
toUpper c = if isLower c then chr (ord c - 32) else c
toLower c = if isUpper c then chr (ord c + 32) else c

-- words, unwords, lines and unlines are primitives on String (prims.def).

-- C memory, for foreign imports (docs/dev/ffi.md). The C types' instances
-- are generated with the tuple instances.

class Storable a where
  sizeOf :: a -> Int
  peek :: Ptr a ->> a
  poke :: Ptr a -> a ->> ()

instance Storable Int where
  sizeOf _ = 8
  peek p = primPeekInt 8 p
  poke p x = primPokeInt 8 p x
instance Storable Float where
  sizeOf _ = 8
  peek p = primPeekFloat 8 p
  poke p x = primPokeFloat 8 p x
instance Storable (Ptr a) where
  sizeOf _ = 8
  peek p = primPeekPtr p
  poke p q = primPokePtr p q
instance Storable (FunPtr a) where
  sizeOf _ = 8
  peek p = castPtrToFunPtr (primPeekPtr (castPtr p))
  poke p f = primPokePtr (castPtr p) (castFunPtrToPtr f)

-- a field of a C struct, at an offset from a foreign import such as
-- "stddef.h offsetof(struct s, f)"
peekByteOff :: Storable a => Ptr b -> Int ->> a
peekByteOff p off = peek (plusPtr p off)
pokeByteOff :: Storable a => Ptr b -> Int -> a ->> ()
pokeByteOff p off x = poke (plusPtr p off) x

-- Array a: a fixed number of Storable values in C memory, freed with
-- freeArray; never moved or collected, so another thread may use one. In
-- typed code it is a C address. readArray and writeArray check the index;
-- the Wrap versions take it modulo the length and cannot fail, for a
-- foreign export (docs/dev/realtime.md).
newArray :: Storable a => Int -> a ->> Array a
newArray n x = do
  arr <- primNewArray n (sizeOf x)
  fillArray arr x
  arr

fillArray :: Storable a => Array a -> a ->> ()
fillArray arr x = mapM_ (\i -> writeArray arr i x) (enumFromTo 0 (arrayLength arr - 1))

readArray :: Storable a => Array a -> Int ->> a
readArray arr i =
  if i < 0 || i >= arrayLength arr then error ("readArray: index " ++ show i ++ " of an array of " ++ show (arrayLength arr))
  else peekByteOff (arrayPtr arr) (i * primArraySize arr)

writeArray :: Storable a => Array a -> Int -> a ->> ()
writeArray arr i x =
  if i < 0 || i >= arrayLength arr then error ("writeArray: index " ++ show i ++ " of an array of " ++ show (arrayLength arr))
  else pokeByteOff (arrayPtr arr) (i * primArraySize arr) x

readArrayWrap :: Storable a => Array a -> Int ->> a
readArrayWrap arr i = peekByteOff (arrayPtr arr) (primWrapIndex i (arrayLength arr) * primArraySize arr)

writeArrayWrap :: Storable a => Array a -> Int -> a ->> ()
writeArrayWrap arr i x = pokeByteOff (arrayPtr arr) (primWrapIndex i (arrayLength arr) * primArraySize arr) x

-- Ring a: a queue of Storable values in C memory, with one producer and
-- one consumer, which may be different threads: funk's thread and a
-- foreign export, either way round. The capacity is rounded up to a power
-- of two. ringPush returns False if the ring is full. The consumer reads
-- ringFront when ringCount is positive, then ringDrop; on an empty ring
-- ringFront returns an old slot.
newRing :: Storable a => Int -> a ->> Ring a
newRing n x = primNewRing n (sizeOf x)

ringPush :: Storable a => Ring a -> a ->> Bool
ringPush r x =
  if ringSpace r == 0 then False
  else do
    poke (primRingBack r) x
    primRingCommit r
    True

ringFront :: Storable a => Ring a ->> a
ringFront r = peek (primRingFront r)

-- an Array or a Ring stored in C memory, such as a callback's context, is its address
instance Storable (Array a) where
  sizeOf _ = 8
  peek p = primPtrToArray (primPeekPtr (castPtr p))
  poke p a = primPokePtr (castPtr p) (primArrayToPtr a)
instance Storable (Ring a) where
  sizeOf _ = 8
  peek p = primPtrToRing (primPeekPtr (castPtr p))
  poke p r = primPokePtr (castPtr p) (primRingToPtr r)

-- memory another thread reads or writes: an acquire load and a release
-- store, so a value is read whole, after what was written before it
class Atomic a where
  atomicPeek :: Ptr a ->> a
  atomicPoke :: Ptr a -> a ->> ()

instance Atomic Int where
  atomicPeek p = primAtomicPeekInt 8 p
  atomicPoke p x = primAtomicPokeInt 8 p x
instance Atomic Float where
  atomicPeek p = primAtomicPeekFloat 8 p
  atomicPoke p x = primAtomicPokeFloat 8 p x

instance Eq (Ptr a) where
  p == q = primEqPtr p q
  p /= q = not (primEqPtr p q)
instance Ord (Ptr a) where
  compare p q = let a = primPtrToInt p
                    b = primPtrToInt q
                in if primLtWord a b then LT else if a == b then EQ else GT
instance Show (Ptr a) where
  showPrec _ p = primShowPtr p

nullPtr :: Ptr a
nullPtr = primNullPtr ()

-- f gets n bytes, freed after it returns
allocaBytes :: Int -> (Ptr a ->> b) ->> b
allocaBytes n f = do
  p <- mallocBytes n
  r <- f p
  free p
  r

-- 16 bytes hold any Storable value
alloca :: (Ptr a ->> b) ->> b
alloca f = allocaBytes 16 f

-- effects run left to right; `>>` sequences them

mapM_ f xs = foldl (\_ x -> f x) () xs
