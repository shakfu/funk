-- dsp.fk -- signals built from kernels.fk's unit generators, for graph.fk
-- (docs/dev/audio.md, D). Every parameter is a Sig, so any can be
-- modulated; a number is a constant.
-- The player needs kernels.fk compiled, as CMake does into funkdsp.so:
--   tools/kernels.sh funk lib/kernels.fk funkdsp.so
module dsp where
import graph as g

dc :: Float -> g.Sig
dc x = g.Node "dsp_const" [x] []

instance Num g.Sig where
  a + b = g.Node "dsp_add" [] [a, b]
  a - b = g.Node "dsp_add" [] [a, g.Node "dsp_mul" [] [dc (-1.0), b]]
  a * b = g.Node "dsp_mul" [] [a, b]
  negate a = g.Node "dsp_mul" [] [dc (-1.0), a]
  abs a = a
  fromInt n = dc (toFloat n)

instance FromFloat g.Sig where
  fromFloat = dc

-- oscillators, from -1 to 1; frequency in Hz
sine :: g.Sig -> g.Sig
sine freq = g.Node "dsp_sine" [0.0] [freq]

saw :: g.Sig -> g.Sig
saw freq = g.Node "dsp_saw" [0.0] [freq]

-- high for width of each cycle, width in (0, 1)
pulse :: g.Sig -> g.Sig -> g.Sig
pulse freq width = g.Node "dsp_square" [0.0] [freq, width]

square :: g.Sig -> g.Sig
square freq = pulse freq (dc 0.5)

-- white noise, uniform in (-1, 1). Nodes with one seed play one signal, so
-- give each channel or voice its own; the seed picks a start, and an affine
-- map keeps two seeds' sequences from being multiples of each other.
noise :: Int -> g.Sig
noise seed = g.Node "dsp_noise" [toFloat (1 + (abs seed * 48271 + 11) `mod` 2147483646)] []

-- filters: cutoff in Hz, read once per block, then the signal
lowpass1 :: g.Sig -> g.Sig -> g.Sig
lowpass1 cutoff x = g.Node "dsp_lowpass1" [0.0] [x, cutoff]

-- state-variable filters, 12 dB per octave; q from 0.5 (no resonance) up
lowpass, bandpass, highpass :: g.Sig -> g.Sig -> g.Sig -> g.Sig
lowpass cutoff q x = g.Node "dsp_lowpass" [0.0, 0.0] [x, cutoff, q]
bandpass cutoff q x = g.Node "dsp_bandpass" [0.0, 0.0] [x, cutoff, q]
highpass cutoff q x = g.Node "dsp_highpass" [0.0, 0.0] [x, cutoff, q]

-- 0 to 1: attack, decay, sustain level, release, then the gate (above 0
-- is on); times in seconds, read once per block
adsr :: g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
adsr a d s r gate = g.Node "dsp_adsr" [0.0, 0.0, 0.0] [gate, a, d, s, r]

-- adsr with exponential segments: attack reaches 1 in its time, decay and
-- release get within 60 dB in theirs
adsrExp :: g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
adsrExp a d s r gate = g.Node "dsp_adsr_exp" [0.0, 0.0, 0.0] [gate, a, d, s, r]

-- tanh (drive * x), within (-1, 1)
saturate :: g.Sig -> g.Sig -> g.Sig
saturate drive x = g.Node "dsp_saturate" [] [x, drive]

-- threshold in dB, ratio from 1 up, attack and release time constants in
-- seconds, read once per block. A multichannel x compresses each channel
-- on its own level, which can move a stereo image.
compress :: g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
compress threshold ratio attack release x = g.Node "dsp_compress" [0.0] [x, threshold, ratio, attack, release]

-- x held to at most ceiling, in dB, with no lookahead: an instant attack
-- turns each peak down within its frame, which distorts it
limit :: g.Sig -> g.Sig -> g.Sig -> g.Sig
limit ceiling release x = compress ceiling (dc (1.0 / 0.0)) 0 release x

-- x delayed: most seconds of memory per channel (changing it restarts the
-- node), then the time in seconds, read every frame and interpolated
delay :: Float -> g.Sig -> g.Sig -> g.Sig
delay most time x = g.Delay "dsp_delay" most [0.0, 0.0, 0.0, 0.0] [x, time]

-- a feedback comb: feedback within (-1, 1), damping in [0, 1) low-passes
-- what is fed back
comb :: Float -> g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
comb most time fb damp x = g.Delay "dsp_comb" most [0.0, 0.0, 0.0, 0.0] [x, time, fb, damp]

-- gain within (-1, 1)
allpass :: Float -> g.Sig -> g.Sig -> g.Sig -> g.Sig
allpass most time gain x = g.Delay "dsp_allpass" most [0.0, 0.0, 0.0, 0.0] [x, time, gain]

-- x mixed with itself at a moving delay: rate in Hz, depth in seconds up to
-- 0.02, mix from 0 to 1. Two channels, whose delays move a quarter cycle apart.
chorus :: g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
chorus rate depth mix x = x * (1 - mix) + mix * delay 0.05 (dc 0.025 + depth * stereo (g.Node "dsp_sine" [0.0] [rate]) (g.Node "dsp_sine" [0.25] [rate])) x

-- x plus a short comb of itself at a moving delay: rate in Hz, depth in
-- seconds up to 0.005, feedback within (-1, 1)
flanger :: g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
flanger rate depth fb x = (x + comb 0.015 (dc 0.006 + depth * sine rate) fb 0 x) * dc 0.5

-- Freeverb's mono structure, in each of two channels, tuned 23 frames at
-- 44100 Hz apart: room and damp from 0 to 1, mix from 0 to 1
reverb :: g.Sig -> g.Sig -> g.Sig -> g.Sig -> g.Sig
reverb room damp mix x = x * (1 - mix) + mix * foldl (\y f -> allpass 0.03 (spread f) (dc 0.5) y) (reverbCombs (room * dc 0.28 + dc 0.7) (damp * dc 0.4) (x * dc 0.03)) [556.0, 441.0, 341.0, 225.0]

-- a time of f frames at 44100 Hz, and 23 frames more on the right
spread :: Float -> g.Sig
spread f = stereo (dc (f / 44100.0)) (dc ((f + 23.0) / 44100.0))

reverbCombs :: g.Sig -> g.Sig -> g.Sig -> g.Sig
reverbCombs fb damp x = case map (\f -> comb 0.04 (spread f) fb damp x) [1116.0, 1188.0, 1277.0, 1356.0, 1422.0, 1491.0, 1557.0, 1617.0] of
  c : cs -> foldl (+) c cs
  [] -> g.Silence

-- two channels, left and right
stereo :: g.Sig -> g.Sig -> g.Sig
stereo l r = g.Channels [l, r]

-- x placed at pos, from -1 (left) to 1 (right); linear, so the centre is
-- 6 dB down on each channel
pan :: g.Sig -> g.Sig -> g.Sig
pan pos x = x * stereo ((1 - pos) * dc 0.5) ((1 + pos) * dc 0.5)

-- n voices of f gate freq, summed; voice k reads the controls "vk.gate"
-- and "vk.freq", which the hosts send notes to (funk_voices in graph.h)
poly :: Int -> (g.Sig -> g.Sig -> g.Sig) -> g.Sig
poly n f = voicesAt "v" n f

-- poly for MIDI channel c, 1 to 16, reading "cc.vk.gate" and "cc.vk.freq";
-- that channel's notes play these instead of poly's
polyOn :: Int -> Int -> (g.Sig -> g.Sig -> g.Sig) -> g.Sig
polyOn c n f = voicesAt ("c" ++ show c ++ ".v") n f

voicesAt :: String -> Int -> (g.Sig -> g.Sig -> g.Sig) -> g.Sig
voicesAt pre n f = case map (\k -> f (g.control (pre ++ show k ++ ".gate") 0.0) (g.control (pre ++ show k ++ ".freq") 440.0)) (enumFromTo 1 n) of
  [] -> g.Silence
  v : vs -> foldl (+) v vs
