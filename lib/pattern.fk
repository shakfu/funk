-- notes from a scale, by index: 12 to an octave, or o
toScale :: Num a => [a] -> Pattern Int -> Pattern a
toScale s p = toScale' 12 s p

toScale' :: Num a => Int -> [a] -> Pattern Int -> Pattern a
toScale' o s p = if null s then silence else mapP (\x -> cyc s x + fromInt (o * div x (length s))) p

-- the second half of each of n parts later by x
swingBy :: Pattern Float -> Pattern Float -> Pattern a -> Pattern a
swingBy x n p = inside n (withinArc (0.5, 1.0) (\q -> x ~> q)) p

swing :: Pattern Float -> Pattern a -> Pattern a
swing n p = swingBy (atom (1.0 / 3.0)) n p

-- one of xs at random per cycle
cycleChoose :: [a] -> Pattern a
cycleChoose xs = segment 1 (choose xs)

_rearrangeWith :: Pattern Int -> Int -> Pattern a -> Pattern a
_rearrangeWith ip n p = innerJoin (mapP (\i -> _fastInt n (_repeatCycles n (zoomTicks (div (i * cycleTicks) n) (div ((i + 1) * cycleTicks) n) p))) ip)

-- each cycle's n parts in a random order, each once
shuffle :: Pattern Int -> Pattern a -> Pattern a
shuffle np p = innerJoin (mapP (\n -> _shuffle n p) np)

_shuffle :: Int -> Pattern a -> Pattern a
_shuffle n p = _rearrangeWith (randrun n) n p

-- n parts chosen at random, with repeats
scramble :: Pattern Int -> Pattern a -> Pattern a
scramble np p = innerJoin (mapP (\n -> _scramble n p) np)

_scramble :: Int -> Pattern a -> Pattern a
_scramble n p = _rearrangeWith (_segment (toFloat n) (_irand n)) n p

-- 0 to n - 1 in a random order each cycle
randrun :: Int -> Pattern Int
randrun n = if n == 0 then silence else pattern (\qst -> let q = qst.arc in concatMap (\s -> case div s.start cycleTicks of
    c -> case map snd (sortBy (\a b -> compare (fst a) (fst b)) (zip (timeToRands (c * cycleTicks) n) [0 .. n - 1])) of
      vs -> concatMap (\(k, v) -> case Span (c * cycleTicks + div (k * cycleTicks) n) (c * cycleTicks + div ((k + 1) * cycleTicks) n) of
        w -> map (\pt -> Event (Just w) pt v noContext) (sects s w)) (zip [0 .. n - 1] vs)) (cycleSpans q))

-- each pattern from s to e only, in cycles, as Tidal's seqP
seqP :: [(Float, Float, Pattern a)] -> Pattern a
seqP ps = stack (map (\(s, e, p) -> playFor s e (rotR (toFloat (floor s)) p)) ps)

playFor :: Float -> Float -> Pattern a -> Pattern a
playFor s e p = case Span (ticks s) (ticks e) of
  w -> pattern (\qst -> let q = qst.arc in concatMap (\a -> queryIn qst p a) (sects w q))

seqPLoop :: [(Float, Float, Pattern a)] -> Pattern a
seqPLoop ps = case (minimum (map (\(x, _, _) -> x) ps), maximum (map (\(_, x, _) -> x) ps)) of
  (lo, hi) -> timeLoop (atom (hi - lo)) (rotL lo (seqP ps))

-- the patterns named by s, each over its event
inhabit :: [(String, Pattern a)] -> Pattern String -> Pattern a
inhabit ps p = squeezeJoin (mapP (\s -> fromMaybe silence (lookup s ps)) p)

-- p played at each length of xs in turn
spaceOut :: [Float] -> Pattern a -> Pattern a
spaceOut xs p = case sum xs of
  total -> slowT total (stack (map (\(a, b) -> compress (a / total, b / total) p) (markOut 0.0 xs)))

markOut :: Float -> [Float] -> [(Float, Float)]
markOut o xs = case xs of
  [] -> []
  x : rest -> (o, o + x) : markOut (o + x) rest

flatpat :: Pattern [a] -> Pattern a
flatpat p = uncollect p

-- each function's pattern of x, stacked
layer :: [a -> Pattern b] -> a -> Pattern b
layer fs x = stack (map (\f -> f x) fs)

-- the events that share a whole, as a chord's notes, played in turn across it
arpeggiate :: Pattern a -> Pattern a
arpeggiate p = arpWith id p

arpg :: Pattern a -> Pattern a
arpg p = arpeggiate p

arpWith :: ([Event a] -> [Event b]) -> Pattern a -> Pattern b
arpWith f p = withQuery p (\qst -> let q = qst.arc in concatMap (\g -> spreadOut (f g)) (groupWholes (sortBy (\a b -> compareWhole a.whole b.whole) (queryIn qst p q))))

groupWholes :: [Event a] -> [[Event a]]
groupWholes es = case es of
  [] -> []
  e : rest -> case span (\x -> x.whole == e.whole) rest of
    (same, others) -> (e : same) : groupWholes others

spreadOut :: [Event a] -> [Event a]
spreadOut xs = concatMap (\(k, e) -> case e.whole of
    Just w -> case Span (w.start + div ((w.stop - w.start) * k) (length xs)) (w.start + div ((w.stop - w.start) * (k + 1)) (length xs)) of
        nw -> map (\pt -> Event (Just nw) pt e.value e.context) (sects nw e.part)
    Nothing -> []) (zip [0 .. length xs - 1] xs)

-- arpeggiate in a named order: up, down, updown, converge, pinkyup, ...
arp :: Pattern String -> Pattern a -> Pattern a
arp np p = patternify _arp np p

_arp :: String -> Pattern a -> Pattern a
_arp name p = arpWith (arpOrder name) p

arpOrder :: String -> [a] -> [a]
arpOrder name x = case name of
  "up" -> x
  "down" -> reverse x
  "updown" -> init x ++ init (reverse x)
  "downup" -> init (reverse x) ++ init x
  "up&down" -> x ++ reverse x
  "down&up" -> reverse x ++ x
  "converge" -> converge x
  "diverge" -> reverse (converge x)
  "disconverge" -> converge x ++ drop 1 (reverse (converge x))
  "pinkyup" -> pinkyup x
  "pinkyupdown" -> init (pinkyup x) ++ init (reverse (pinkyup x))
  "thumbup" -> thumbup x
  "thumbupdown" -> init (thumbup x) ++ init (reverse (thumbup x))
  _ -> x

converge :: [a] -> [a]
converge xs = case xs of
  [] -> []
  x : rest -> x : convergeBack rest

convergeBack :: [a] -> [a]
convergeBack xs = if null xs then [] else last xs : converge (init xs)

pinkyup :: [a] -> [a]
pinkyup xs = concatMap (\x -> [x, last xs]) (init xs)

thumbup :: [a] -> [a]
thumbup xs = concatMap (\x -> [head xs, x]) (drop 1 xs)

-- a chord's notes started in turn over the first quarter of it, or t of it
rolled :: Pattern a -> Pattern a
rolled p = rolledBy 0.25 p

rolledBy :: Pattern Float -> Pattern a -> Pattern a
rolledBy tp p = innerJoin (mapP (\t -> rolledWith t p) (segment 1 tp))

rolledWith :: Float -> Pattern a -> Pattern a
rolledWith t p = pattern (\qst -> let q = qst.arc in concatMap (rollIn t) (groupWholes ((if t > 0.0 then id else reverse) (queryIn qst p q))))

rollIn :: Float -> [Event a] -> [Event a]
rollIn t xs = if t == 0.0 then xs else concatMap (\(k, e) -> case e.whole of
    Just w -> case w.start + div ((w.stop - w.start) * ticks (abs t) * k) (cycleTicks * length xs) of
      ns -> map (\pt -> Event (Just (Span ns w.stop)) pt e.value e.context) (sects (Span ns w.stop) e.part)
    Nothing -> [e]) (zip [0 .. length xs - 1] xs)

-- each event repeated n times within itself
ply :: Pattern Float -> Pattern a -> Pattern a
ply np p = patternify' _ply np p

_ply :: Float -> Pattern a -> Pattern a
_ply n p = squeezeJoin (mapP (\v -> _fast n (atom v)) p)

-- ply, each repeat with f applied once more
plyWith :: Pattern Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
plyWith np f p = innerJoin (mapP (\n -> _plyWith n f p) np)

_plyWith :: Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
_plyWith n f p = arpeggiate (plyCompound n f p)

plyCompound :: Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
plyCompound n f p = if n <= 1 then p else overlay p (f (plyCompound (n - 1) f p))

-- each event moved to start halfway through itself, or r of the way
press :: Pattern a -> Pattern a
press p = _pressBy 0.5 p

pressBy :: Pattern Float -> Pattern a -> Pattern a
pressBy rp p = patternify' _pressBy rp p

_pressBy :: Float -> Pattern a -> Pattern a
_pressBy r p = squeezeJoin (mapP (\v -> compressTo (r, 1.0) (atom v)) p)

-- a where pb is True, b where it is False, each keeping its own structure
sew :: Pattern Bool -> Pattern a -> Pattern a -> Pattern a
sew pb a b = Pattern (\qst -> let q = qst.arc in case queryIn qst pb q of
  evs -> if null evs then [] else case Span (minimum (map (\e -> e.part.start) evs)) (maximum (map (\e -> e.part.stop) evs)) of
    sub -> case (queryIn qst a sub, queryIn qst b sub) of
      (xa, xb) -> concatMap (\ev -> concatMap (\x -> map (\pt -> Event x.whole pt x.value x.context) (sects ev.part x.part)) (if ev.value then xa else xb)) evs)
  (case pureValue pb of
    Just v -> if v then steps a else steps b
    Nothing -> Nothing) Nothing

-- a where pb is True and b where False, with pb's structure
stitch :: Pattern Bool -> Pattern a -> Pattern a -> Pattern a
stitch pb a b = overlay (struct pb a) (struct (inv pb) b)

-- f p where b is True
while :: Pattern Bool -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
while b f p = sew b (f p) p

-- n copies, each t cycles after the last
stutter :: Int -> Float -> Pattern a -> Pattern a
stutter n t p = stack (map (\i -> rotR (t * toFloat i) p) [0 .. n - 1])

-- Tidal's sample name and index, "bd:3"
pick :: String -> Int -> String
pick name n = name ++ ":" ++ show n

samples :: Pattern String -> Pattern Int -> Pattern String
samples p ip = apP (mapP pick p) ip

samples' :: Pattern String -> Pattern Int -> Pattern String
samples' p ip = apP (mapP (\n name -> pick name n) ip) p

spreadf :: [a -> Pattern b] -> a -> Pattern b
spreadf fs x = spread (\f y -> f y) fs x

-- p's values scaled from 0..1 to from..to, with p's structure
range :: Num a => Pattern a -> Pattern a -> Pattern a -> Pattern a
range fromP toP p = apRight (apRight (mapP (\from to v -> v * (to - from) + from) fromP) toP) p

_range :: Num a => a -> a -> Pattern a -> Pattern a
_range from to p = mapP (\v -> v * (to - from) + from) p

-- range, exponentially
rangex :: Float -> Float -> Pattern Float -> Pattern Float
rangex from to p = mapP exp (_range (log from) (log to) p)

-- p with f p on top, t cycles later
off :: Pattern Float -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
off tp f p = innerJoin (mapP (\t -> _off t f p) tp)

_off :: Float -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
_off t f p = superimpose (\x -> f (rotR t x)) p

offadd :: Num a => Pattern Float -> Pattern a -> Pattern a -> Pattern a
offadd tp pn p = off tp (\x -> x + pn) p

-- a sample name stepped by "x" for s and a digit for s:digit, other characters rests
sseq :: String -> String -> Pattern String
sseq s cs = fastcat (map (\c -> if c == 'x' then atom s
    else if isDigit c then atom (s ++ ":" ++ pack [c]) else silence) (unpack cs))

sseqs :: [(String, String)] -> Pattern String
sseqs xs = stack (map (\(s, cs) -> sseq s cs) xs)

sseq' :: [String] -> String -> Pattern String
sseq' ss cs = fastcat (map (\c -> if c == 'x' then atom (head ss)
    else if isDigit c then atom (ss !! digitToInt c) else silence) (unpack cs))

-- two copies of f p on top, 2.5 a and 1.5 a cycles later
ghostWith :: Float -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
ghostWith a f p = superimpose (\x -> rotR (a * 2.5) (f x)) (superimpose (\x -> rotR (a * 1.5) (f x)) p)

ghost'' :: Float -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
ghost'' a f p = ghostWith a f p

-- p and p', woven over n cycles, as Tidal's tabby
tabby :: Int -> Pattern a -> Pattern a -> Pattern a
tabby n p p' = case concatMap (\_ -> [[0 .. n - 1], reverse [0 .. n - 1]]) [0 .. div n 2 - 1] of
  weft -> stack [mask (every 2 rev (_fastR n 2 (fastcat [atom True, silence]))) (tabbyThread n (transposeP weft) p),
                 mask (every 2 rev (_fastR n 2 (fastcat [silence, atom True]))) (tabbyThread n weft p')]

tabbyThread :: Int -> [[Int]] -> Pattern a -> Pattern a
tabbyThread n xs p = _slowInt n (fastcat (map (\i -> zoomTicks (div (i * cycleTicks) n) (div ((i + 1) * cycleTicks) n) p) (concat xs)))

-- one of ps by f, from 0 to 1
select :: Pattern Float -> [Pattern a] -> Pattern a
select fp ps = innerJoin (mapP (\f -> _select f ps) fp)

_select :: Float -> [Pattern a] -> Pattern a
_select f ps = ps !! floor (max 0.0 (min 1.0 f) * toFloat (length ps - 1))

selectF :: Pattern Float -> [Pattern a -> Pattern a] -> Pattern a -> Pattern a
selectF fp fs p = innerJoin (mapP (\f -> _selectF f fs p) fp)

_selectF :: Float -> [Pattern a -> Pattern a] -> Pattern a -> Pattern a
_selectF f fs p = (fs !! floor (max 0.0 (min 0.999999 f) * toFloat (length fs))) p

-- one of fs by index, wrapping
pickF :: Pattern Int -> [Pattern a -> Pattern a] -> Pattern a -> Pattern a
pickF ip fs p = innerJoin (mapP (\i -> _pickF i fs p) ip)

_pickF :: Int -> [Pattern a -> Pattern a] -> Pattern a -> Pattern a
_pickF i fs p = (cyc fs i) p

-- values rounded to the nearest 1 / n, or down, or up
quantise :: RealFrac a => a -> Pattern a -> Pattern a
quantise n p = mapP (\v -> fromInt (round (v * n)) / n) p

qfloor :: RealFrac a => a -> Pattern a -> Pattern a
qfloor n p = mapP (\v -> fromInt (floor (v * n)) / n) p

qceiling :: RealFrac a => a -> Pattern a -> Pattern a
qceiling n p = mapP (\v -> fromInt (ceiling (v * n)) / n) p

qround :: RealFrac a => a -> Pattern a -> Pattern a
qround n p = quantise n p

inv :: Pattern Bool -> Pattern Bool
inv p = mapP not p

-- values joined linearly from each event to the next
smooth :: Pattern Float -> Pattern Float
smooth p = case mono p of
  mp -> pattern (\qst -> let q = qst.arc in case div (q.start + q.stop) 2 of
    m -> case queryIn qst mp (Span m (m + 1)) of
      [] -> []
      e : _ -> case queryIn qst mp (Span (wholeOrPart e).stop ((wholeOrPart e).stop + 1)) of
        [] -> [Event (Just q) q e.value e.context]
        n : _ -> case wholeOrPart e of
          w -> [Event (Just q) q (e.value + (n.value - e.value) * (if w.stop == w.start then 0.0 else toFloat (e.part.start - w.start) / toFloat (w.stop - w.start))) e.context])

-- the values found in things, others dropped
swap :: Eq a => [(a, b)] -> Pattern a -> Pattern b
swap things p = mapMaybeP (\v -> lookup v things) p

-- depth cycles, each combining the last with f applied once more
snowball :: Int -> (Pattern a -> Pattern a -> Pattern a) -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
snowball depth comb f p = cat (take depth (scanlP comb p (iterateN (depth - 1) f (f p))))

-- depth cycles, f applied once more each cycle
soak :: Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
soak depth f p = cat (iterateN depth f p)

-- the n steps of p's first cycle as mini-notation
deconstruct :: Int -> Pattern String -> String
deconstruct n p = unwords (map (\k -> deconstructStep (map (\e -> e.value) (query (_segment (toFloat n) p) (Span (div (k * cycleTicks) n) (div ((k + 1) * cycleTicks) n))))) [0 .. n - 1])

deconstructStep :: [String] -> String
deconstructStep xs = case xs of
  [] -> "~"
  [x] -> x
  _ -> "[" ++ foldr1P (\a b -> a ++ ", " ++ b) xs ++ "]"

-- the ith of n parts of p, i from ip, squeezed into each of ip's events
bite :: Pattern Int -> Pattern Int -> Pattern a -> Pattern a
bite np ip p = innerJoin (mapP (\n -> _bite n ip p) np)

_bite :: Int -> Pattern Int -> Pattern a -> Pattern a
_bite n ip p = squeezeJoin (mapP (\i -> case mod i n of
    k -> zoomTicks (div (k * cycleTicks) n) (div ((k + 1) * cycleTicks) n) p) ip)

-- ps indexed by ip, each squeezed into its event
squeeze :: Pattern Int -> [Pattern a] -> Pattern a
squeeze ip ps = if null ps then silence else squeezeJoin (mapP (\i -> cyc ps i) ip)

-- the n lowest bits of each value, highest first, as Trues and Falses
binaryN :: Pattern Int -> Pattern Int -> Pattern Bool
binaryN np p = patternify _binaryN np p

_binaryN :: Int -> Pattern Int -> Pattern Bool
_binaryN n p = setSteps (Just (n, 1)) (squeezeJoin (mapP (\v -> _binary n v) p))

_binary :: Int -> Int -> Pattern Bool
_binary n v = fastFromList (bitsOf n v)

bitsOf :: Int -> Int -> [Bool]
bitsOf n v = map (\i -> (shiftR v i .&. 1) == 1) (reverse [0 .. n - 1])

binary :: Pattern Int -> Pattern Bool
binary p = binaryN 8 p

ascii :: Pattern String -> Pattern Bool
ascii p = squeezeJoin (mapP (\s -> fastFromList (concatMap (\c -> bitsOf 8 (ord c)) (unpack s))) p)

-- a True then Falses for each length, perCycle steps a cycle
necklace :: Float -> [Int] -> Pattern Bool
necklace perCycle xs = slowT (toFloat (sum xs) / perCycle) (fastFromList (concatMap (\x -> True : replicate (x - 1) False) xs))

-- each value followed by the n values above it, or below, in its event
chromaticiseBy :: (Num a, Ord a, Enum a) => Pattern a -> Pattern a -> Pattern a
chromaticiseBy np p = innerJoin (mapP (\n -> _chromaticiseBy n p) np)

_chromaticiseBy :: (Num a, Ord a, Enum a) => a -> Pattern a -> Pattern a
_chromaticiseBy n p = squeezeJoin (mapP (\v -> fastcat (map atom (if n >= 0 then [v .. v + n] else reverse [v + n .. v]))) p)

chromaticizeBy :: (Num a, Ord a, Enum a) => Pattern a -> Pattern a -> Pattern a
chromaticizeBy np p = chromaticiseBy np p

-- _euclid, without its negative form, as Tidal's _euclid'
_euclid' :: Int -> Int -> Pattern a -> Pattern a
_euclid' k n p = fastcat (map (\b -> if b then p else silence) (bjorklund k n))

-- a Lindenmayer system: rules "a:ab,b:a" applied n times to s
lindenmayer :: Int -> String -> String -> String
lindenmayer n r s = pack (lsysN n (parseLMRule' r) (unpack s))

lsysN :: Int -> [(Char, [Char])] -> [Char] -> [Char]
lsysN n rules s = if n == 0 || null s then s else lsysN (n - 1) rules (concatMap (\c -> fromMaybe [c] (lookup c rules)) s)

-- lindenmayer's characters as digits
lindenmayerI :: Int -> String -> String -> [Int]
lindenmayerI n r s = map digitToInt (unpack (lindenmayer n r s))

-- a hexadecimal digit's value, as Haskell's digitToInt
digitToInt :: Char -> Int
digitToInt c = if isDigit c then ord c - 48
  else if c >= 'a' && c <= 'f' then ord c - 87
  else if c >= 'A' && c <= 'F' then ord c - 55
  else error ("pattern.digitToInt: not a digit: " ++ pack [c])

-- "a:ab,b:a" as [("a", "ab"), ("b", "a")]
parseLMRule :: String -> [(String, String)]
parseLMRule s = map (\rule -> case break (\c -> c == ':') rule of
    (a, b) -> (pack a, pack (filter (\c -> c /= ':') b))) (splitOnChar ',' (unpack s))

parseLMRule' :: String -> [(Char, [Char])]
parseLMRule' s = map (\(c, r) -> (head (unpack c), unpack r)) (parseLMRule s)

splitOnChar :: Char -> [Char] -> [[Char]]
splitOnChar sep cs = case break (\c -> c == sep) cs of
  (a, []) -> [a]
  (a, _ : rest) -> a : splitOnChar sep rest

-- a Markov chain of n steps through tp's rows of probabilities, from state
-- xi, its random values from time seed in cycles on
runMarkov :: Int -> [[Float]] -> Int -> Float -> [Int]
runMarkov n tp xi seed = markovRun n (map (\row -> zip (drop 1 (scanlP (+) 0.0 row)) [0 .. length row - 1]) tp) xi (ticks seed + div cycleTicks n) (div cycleTicks n)

markovRun :: Int -> [[(Float, Int)]] -> Int -> Int -> Int -> [Int]
markovRun n rows x t dt = if n <= 0 then [] else x : (case rows !! x of
    row -> markovRun (n - 1) rows (markovFind (toFloat (randAt t 0) / 536870912.0 * fst (last row)) row) (t + dt) dt)

-- the index of the first cumulative weight above x, else of the largest; of
-- equal weights, the first, as tidal-core 1.10.2's Map.fromListWith keeps
markovFind :: Float -> [(Float, Int)] -> Int
markovFind x row = case filter (\(w, _) -> w > x) row of
  (_, i) : _ -> i
  [] -> case filter (\(w, _) -> w == fst (last row)) row of
    (_, i) : _ -> i
    [] -> 0

markovPat :: Pattern Int -> Pattern Int -> [[Float]] -> Pattern Int
markovPat np xp tp = innerJoin (apP (mapP (\n xi -> _markovPat n xi tp) np) xp)

_markovPat :: Int -> Int -> [[Float]] -> Pattern Int
_markovPat n xi tp = pattern (\qst -> let q = qst.arc in concatMap (\s -> queryIn qst (listToPat (runMarkov n tp xi (toFloat (div s.start cycleTicks)))) s) (cycleSpans q))

-- each event squeezed into step t of d of its cycle
beat :: Pattern Float -> Pattern Float -> Pattern a -> Pattern a
beat tp dp p = innerJoin (apP (mapP (\t d -> __beat t d p) tp) dp)

__beat :: Float -> Float -> Pattern a -> Pattern a
__beat t d p = case t - d * toFloat (floor (t / d)) of
  t' -> innerJoin (mapP (\v -> compress (t' / d, min 1.0 ((t' + 1.0) / d)) (atom v)) p)

-- each of n masks of p, chosen by to, squeezed into to's events
fit' :: Pattern Float -> Int -> Pattern Int -> Pattern Int -> Pattern a -> Pattern a
fit' cycp n from to p = case (density cycp p, density cycp from) of
  (p', from') -> squeezeJoin (_fit n (map (\i -> stretch (mask (mapP (\_ -> True) (filterValues (\v -> v == i) from')) p')) [0 .. n - 1]) to)

-- things repeated by a split of nSteps, chosen by p from the most even
permstep :: Int -> [a] -> Pattern Float -> Pattern a
permstep nSteps things p = case permsort (length things) nSteps of
  ps -> joinP (mapP (\v -> fastFromList (concat (zipWith replicate (ps !! floor (v * toFloat (length ps - 1))) things))) (_segment 1 p))

permsort :: Int -> Int -> [[Int]]
permsort n total = map fst (sortBy (\a b -> compare (snd a) (snd b)) (map (\x -> (x, sum (map (\v -> abs (toFloat total / toFloat n - toFloat v)) x))) (perms n total)))

perms :: Int -> Int -> [[Int]]
perms n total = if n == 0 then [] else if n == 1 then [[total]]
  else concatMap (\x -> map (\r -> x : r) (perms (n - 1) (total - x))) [1 .. total - (n - 1)]

-- n spans of random lengths 1, 2 or 3, filling a cycle
randArcs :: Int -> Pattern [Span]
randArcs n = mapP (\rs -> case map toFloat rs of
    rats -> case sum rats of
      total -> pairUp (map (\x -> ticks x) (scanl1P (+) (map (\r -> r / total) rats))))
  (sequenceP (map (\x -> rotL (toFloat x / toFloat n) (choose [1, 2, 3])) [0 .. n - 1]))

pairUp :: [Int] -> [Span]
pairUp xs = case xs of
  [] -> []
  x : _ -> Span 0 x : pairUp' xs

pairUp' :: [Int] -> [Span]
pairUp' xs = case xs of
  [a, _] -> [Span a cycleTicks]
  a : b : rest -> Span a b : pairUp' (b : rest)
  _ -> []

-- randArcs' spans as events, numbered
randStruct :: Int -> Pattern Int
randStruct n = pattern (\qst -> let q = qst.arc in concatMap (\s -> case div s.start cycleTicks * cycleTicks of
    c -> case queryIn qst (randArcs n) (Span c (c + cycleTicks)) of
      [] -> []
      e : _ -> concatMap (\(i, a) -> case move c a of
        w -> map (\pt -> Event (Just w) pt i noContext) (sects s w)) (zip [0 .. length e.value - 1] e.value)) (cycleSpans q))

-- a cycle of p, moved by each event's value, squeezed into it
substruct' :: Pattern Int -> Pattern a -> Pattern a
substruct' s p = pattern (\qst -> let q = qst.arc in concatMap (\e -> case e.whole of
    Just w -> case length (queryIn qst s (cycleOf q.start)) of
      k -> concatMap (\x -> clipEvent q (Event x.whole x.part x.value (ctx2 e.context x.context))) (queryIn qst (compressTo (cycles w.start, cycles w.stop) (_inside (1.0 / toFloat k) (rotR (toFloat e.value)) p)) w)
    Nothing -> []) (queryIn qst s q))

-- p in n random parts of each cycle
stripe :: Pattern Int -> Pattern a -> Pattern a
stripe np p = innerJoin (mapP (\n -> _stripe n p) np)

_stripe :: Int -> Pattern a -> Pattern a
_stripe n p = substruct' (randStruct n) p

slowstripe :: Pattern Int -> Pattern a -> Pattern a
slowstripe np p = slow (mapP toFloat np) (stripe np p)

-- Tidal's ur: a pattern of named patterns over t cycles, a name:f naming a
-- function to apply too
ur :: Float -> Pattern String -> [(String, Pattern a)] -> [(String, Pattern a -> Pattern a)] -> Pattern a
ur t outer ps fs = setSteps (steps outer) (slowT t (joinP (pattern (\qst -> let q = qst.arc in concatMap (\e -> case e.whole of
    Just w -> case filter (\x -> not (null x)) (splitOnChar ':' (unpack e.value)) of
      name : rest -> [Event e.whole e.part (urTransform fs rest w (fromMaybe silence (lookup (pack name) (map (\(k, v) -> (k, fastT t v)) ps)))) e.context]
      [] -> []
    Nothing -> []) (queryIn qst outer q)))))

urTransform :: [(String, Pattern a -> Pattern a)] -> [[Char]] -> Span -> Pattern a -> Pattern a
urTransform fs rest w p = case rest of
  x : _ -> rotR (cycles w.start) (_inside (1.0 / cycles (w.stop - w.start)) (fromMaybe id (lookup (pack x) fs)) p)
  [] -> p

-- Tidal's other names
slowCat :: [Pattern a] -> Pattern a
slowCat ps = cat ps

slowAppend :: Pattern a -> Pattern a -> Pattern a
slowAppend a b = append a b

slowappend :: Pattern a -> Pattern a -> Pattern a
slowappend a b = append a b

fastappend :: Pattern a -> Pattern a -> Pattern a
fastappend a b = fastAppend a b

fastCat :: [Pattern a] -> Pattern a
fastCat ps = fastcat ps

timeCat :: [(Float, Pattern a)] -> Pattern a
timeCat wps = timecat wps

-- zoom to a span in ticks
zoomArc :: Span -> Pattern a -> Pattern a
zoomArc a p = zoomTicks a.start a.stop p

timeToRand :: Float -> Float
timeToRand t = timeToRandF t

timeToRands' :: Int -> Int -> [Float]
timeToRands' seed n = randsFrom seed n

_euclidInv :: Int -> Int -> Pattern a -> Pattern a
_euclidInv k n p = _euclid (negate k) n p

-- the span from the earliest start to the latest stop, or cycle 0
enclosingArc :: [Span] -> Span
enclosingArc as = if null as then Span 0 cycleTicks else Span (minimum (map (\a -> a.start) as)) (maximum (map (\a -> a.stop) as))

__binary :: Int -> Int -> [Bool]
__binary n v = bitsOf n v

-- Each outer event plays its inner pattern from the inner's cycle 0 (or, for
-- trigJoin, the cycle position) at the event's start, as Tidal's _trigJoin.
trigJoin :: Pattern (Pattern a) -> Pattern a
trigJoin pp = trigJoinWith False pp

trigZeroJoin :: Pattern (Pattern a) -> Pattern a
trigZeroJoin pp = trigJoinWith True pp

trigJoinWith :: Bool -> Pattern (Pattern a) -> Pattern a
trigJoinWith zero pp = pattern (\qst -> let q = qst.arc in concatMap (\eo -> case eo.whole of
    Just w -> concatMap (\ei -> concatMap (\nw -> map (\pt -> Event nw pt ei.value (ctx2 ei.context eo.context)) (sects eo.part ei.part)) (sectW eo.whole ei.whole))
      (queryIn qst (_shift (if zero then w.start else mod w.start cycleTicks) eo.value) q)
    Nothing -> []) (queryIn qst pp q))

-- p started again, from its cycle position or from cycle 0, at each True
reset :: Pattern Bool -> Pattern a -> Pattern a
reset bp p = trigJoin (mapP (\v -> if v then p else silence) bp)

restart :: Pattern Bool -> Pattern a -> Pattern a
restart bp p = trigZeroJoin (mapP (\v -> if v then p else silence) bp)

-- reset and restart, from t cycles in
resetTo :: Pattern Float -> Pattern a -> Pattern a
resetTo tp p = trigJoin (mapP (\t -> rotL t p) tp)

restartTo :: Pattern Float -> Pattern a -> Pattern a
restartTo tp p = trigZeroJoin (mapP (\t -> rotL t p) tp)

-- c cycles of p from offset, looped
ribbon :: Pattern Float -> Pattern Float -> Pattern a -> Pattern a
ribbon op cp p = innerJoin (apP (mapP (\o c -> _ribbon o c p) op) cp)

rib :: Pattern Float -> Pattern Float -> Pattern a -> Pattern a
rib op cp p = ribbon op cp p

_ribbon :: Float -> Float -> Pattern a -> Pattern a
_ribbon offset cyc p = restart (slowT cyc (atom True)) (rotL offset p)

-- each True event of pieces holding f of p looped over it, the others p
unjoinfunc :: Pattern Bool -> (Pattern a -> Pattern a) -> Pattern a -> Pattern (Pattern a)
unjoinfunc pieces f p = pattern (\qst -> let q = qst.arc in map (\e -> Event e.whole e.part (if e.value then case wholeOrPart e of
      w -> f (_ribbon (cycles w.start) (cycles (w.stop - w.start)) p)
    else p) e.context) (queryIn qst pieces q))

unjoin :: Pattern Bool -> Pattern a -> Pattern (Pattern a)
unjoin pieces p = unjoinfunc pieces id p

-- f on p within each True event of pieces, looped over it
into :: Pattern Bool -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
into pieces f p = innerJoin (unjoinfunc pieces f p)

-- f on one of n parts each cycle, moving on a part a cycle. A negative n is
-- silence, as Tidal's passes it to _iter
chunkinto :: Pattern Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
chunkinto np f p = innerJoin (mapP (\n -> _chunkinto n f p) np)

chunkInto :: Pattern Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
chunkInto np f p = chunkinto np f p

_chunkinto :: Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
_chunkinto n f p = if n == 0 then p
  else into ((if n > 0 then _iter' else _iter) n (fastcat (map atom (True : replicate (abs n - 1) False)))) f p

-- list helpers

-- xs at n, wrapping, as Tidal's !!!
cyc :: [a] -> Int -> a
cyc xs n = xs !! mod n (length xs)

-- a list of patterns as a pattern of lists, wholes from all, as Haskell's sequence
sequenceP :: [Pattern a] -> Pattern [a]
sequenceP ps = case ps of
  [] -> atom []
  p : rest -> apP (mapP (\x xs -> x : xs) p) (sequenceP rest)

scanl1P :: (a -> a -> a) -> [a] -> [a]
scanl1P f xs = case xs of
  [] -> []
  x : rest -> scanlP f x rest

scanlP :: (b -> a -> b) -> b -> [a] -> [b]
scanlP f z xs = z : (case xs of
  [] -> []
  x : rest -> scanlP f (f z x) rest)

-- x, f x, f (f x), n of them
iterateN :: Int -> (a -> a) -> a -> [a]
iterateN n f x = if n <= 0 then [] else x : iterateN (n - 1) f (f x)

foldr1P :: (a -> a -> a) -> [a] -> a
foldr1P f xs = case xs of
  [x] -> x
  x : rest -> f x (foldr1P f rest)
  [] -> error "pattern.foldr1P: empty list"

transposeP :: [[a]] -> [[a]]
transposeP xss = case filter (\xs -> not (null xs)) xss of
  [] -> []
  ys -> map head ys : transposeP (map tail ys)

-- Tidal's mini-notation, for Int values: "c4 [e4 g4]*2 ~ <c'maj e'min>". Parsed
-- when called, so a typo fails as the definition is evaluated. A note name
-- is MIDI's: c4 is 60, and a name with no octave is in octave 4.
--   a b      a sequence, in one cycle      ~ or -   a rest
--   [a b]    a sequence in one step        a . b c  steps of equal length: a, then [b c]
--   <a b>    one step per cycle            {a b c}  steps at the first sequence's rate
--   {a b}%4  4 steps per cycle             a, b     at once, inside [ ], < >, { } or at the top
--   a | b    one at random each cycle      a*k a/k  fast, slow; k a ratio, such as 1.5, or a pattern
--   a!k a !  k copies, or 1 more           a@k a _  a weight of k steps (a ratio), or 1 more
--   a(k,n,r) on k of n steps, rotated r    a? a?0.3 dropped at random, half or 0.3 of the time
--   a .. b   a to b, in one step           c'maj'ii a chord, with Tidal's names and modifiers
mini :: String -> Pattern Int
mini s = mapP mvInt (mParse MInt s)

-- mini-notation of names, such as Tidal's samples: "bd*2 [hh sn:3]". A name
-- is a letter or digit, then letters, digits and : . - _; no notes or chords.
miniS :: String -> Pattern String
miniS s = mapP mvStr (mParse MStr s)

-- mini-notation of Floats, as Tidal's for Double and Note: decimals, and
-- note names as Tidal's, c5 being 0, which SuperDirt plays as MIDI 60
miniF :: String -> Pattern Float
miniF s = mapP (\v -> case mvRat v of
    (a, b) -> toFloat a / toFloat b) (mParse MNum s)

-- mini-notation of Ints, with Tidal's note names, c5 being 0
-- miniF for notes, as Tidal's Note: "e" is note 4, where miniF reads 1/8
miniN :: String -> Pattern Float
miniN s = mapP (\v -> case mvRat v of
    (a, b) -> toFloat a / toFloat b) (mParse MNote s)

miniTI :: String -> Pattern Int
miniTI s = mapP mvInt (mParse MTInt s)

-- the types mini-notation parses into, as Tidal's Parseable; parseBP_E is
-- Tidal's name. Int's note names are Tidal's, c5 0, as miniTI's.
class Parseable a where
  parseBP_E :: String -> Pattern a

instance Parseable Int where
  parseBP_E s = miniTI s

instance Parseable Float where
  parseBP_E s = miniF s

instance Parseable String where
  parseBP_E s = miniS s

-- a letter or digit, one character each, as Tidal's pChar; a .. b is the
-- characters from a to b
instance Parseable Char where
  parseBP_E s = mapP mvChar (mParse MChar s)

-- t and 1 are True, f and 0 False, one character each, as Tidal's pBool; a
-- euclid's off steps are negated, as Tidal's euclidOffBool
instance Parseable Bool where
  parseBP_E s = mapP mvBool (mParse MBool s)

-- a note, as Tidal's Note: a Float whose mini-notation reads note names
-- first, so "e" is note 4, where a Float's reads the ratio 1/8
data Note = Note Float deriving (Eq, Ord)

unNote :: Note -> Float
unNote (Note x) = x

-- as Tidal's: 4.0n (e5)
instance Show Note where
  showPrec _ (Note x) = case round x of
    k -> show x ++ "n (" ++ pitchClassName (mod k 12) ++ show (div k 12 + 5) ++ ")"

pitchClassName :: Int -> String
pitchClassName k = case drop k ["c", "cs", "d", "ds", "e", "f", "fs", "g", "gs", "a", "as", "b"] of
  n : _ -> n
  [] -> ""

instance Num Note where
  Note a + Note b = Note (a + b)
  Note a - Note b = Note (a - b)
  Note a * Note b = Note (a * b)
  negate (Note a) = Note (negate a)
  abs (Note a) = Note (abs a)
  fromInt i = Note (toFloat i)

instance FromFloat Note where
  fromFloat x = Note x

instance Fractional Note where
  Note a / Note b = Note (a / b)
  recip (Note a) = Note (recip a)

-- as Tidal's Note, Double's: to the last value up to b + 1/2
instance Enum Note where
  succ (Note a) = Note (a + 1.0)
  pred (Note a) = Note (a - 1.0)
  toEnum i = Note (toFloat i)
  fromEnum (Note a) = truncate a
  enumFromTo a b = numericEnumFromTo a b
  enumFromThenTo a b c = numericEnumFromThenTo a b c

instance RealFrac Note where
  floor (Note a) = floor a
  ceiling (Note a) = ceiling a
  round (Note a) = round a
  truncate (Note a) = truncate a

instance Parseable Note where
  parseBP_E s = mapP Note (miniN s)

-- a string literal as mini-notation, as Tidal's IsString: "bd*2 sn"
instance Parseable a => FromString (Pattern a) where
  fromString s = parseBP_E s

mParse :: MMode -> String -> Pattern MV
mParse mode s = case unpack s of
  cs -> case mStack (length cs) mode True (0, cs) of
    (pat, (_, rest)) -> case mSkip rest of
      [] -> if any (\c -> c == '\n' || c == '\t') cs then withContext (\c -> Context (map (\(a, b) -> (mLineCol cs a, mLineCol cs b)) c.contextPosition)) pat else pat
      r -> mFail (length cs) r "unexpected character"

-- column k of one line as Parsec's (column, line): a tab moves to the
-- next column of 8k + 1
mLineCol :: [Char] -> (Int, Int) -> (Int, Int)
mLineCol cs (k, _) = foldl (\(c, l) x -> if x == '\n' then (1, l + 1) else if x == '\t' then (c + 8 - mod (c - 1) 8, l) else (c + 1, l)) (1, 1) (take (k - 1) cs)

-- what a parse yields: values, chord intervals, or chord modifiers
data MV = VInt Int | VRat Int Int | VStr [Char] | VBool Bool | VChar Char | VChord [Int] | VMods [Mod]
data Mod = Range Int | Drop Int | Invert | Open
-- MInt's note names are MIDI's, c4 60; MTInt's, MNum's and MNote's Tidal's,
-- c5 0. MNum is Tidal's Double, whose ratio letters, such as e for 1/8, come
-- before note names; MNote is its Note, whose note names come first.
data MMode = MInt | MTInt | MNum | MNote | MRat | MStr | MBool | MChar | MName | MMod deriving (Eq)

-- a mode whose atoms are numbers
mNumeric :: MMode -> Bool
mNumeric mode = mode == MInt || mode == MTInt || mode == MNum || mode == MNote || mode == MRat

mvInt :: MV -> Int
mvInt v = case v of
  VInt n -> n
  _ -> error "pattern.mini: not a number"

mvRat :: MV -> (Int, Int)
mvRat v = case v of
  VRat a b -> (a, b)
  _ -> error "pattern.mini: not a ratio"

mvStr :: MV -> String
mvStr v = case v of
  VStr cs -> pack cs
  _ -> error "pattern.mini: not a name"

mvChar :: MV -> Char
mvChar v = case v of
  VChar c -> c
  _ -> error "pattern.mini: not a character"

mvBool :: MV -> Bool
mvBool v = case v of
  VBool b -> b
  _ -> error "pattern.mini: not a Bool"

mvChord :: MV -> [Int]
mvChord v = case v of
  VChord ns -> ns
  _ -> error "pattern.mini: not a chord name"

mvMods :: MV -> [Mod]
mvMods v = case v of
  VMods ms -> ms
  _ -> error "pattern.mini: not a chord modifier"

mFail :: Int -> [Char] -> String -> a
mFail n rest what = error ("pattern.mini: " ++ what ++ " at column " ++ show (n - length rest + 1))

mSkip :: [Char] -> [Char]
mSkip cs = dropWhile isSpace cs

-- The parser's state is the next random seed and the input left: as
-- Tidal's, seeds count '?' and '|' groups in the order they are parsed.

-- sequences separated by ',' (all at once) or, if choose, '|' (one per cycle)
mStack :: Int -> MMode -> Bool -> (Int, [Char]) -> (Pattern MV, (Int, [Char]))
mStack n mode choose st = case mSeq n mode st of
  ((p, _), (sd, rest)) -> case mSkip rest of
    ',' : r -> case mSeqs n mode ',' [p] (sd, r) of
      (ps, st2) -> (stack ps, st2)
    '|' : r -> if not choose then mFail n ('|' : r) "unexpected '|'" else case mSeqs n mode '|' [p] (sd, r) of
      (ps, (sd2, r2)) -> (chooseCycle sd2 ps, (sd2 + 1, r2))
    r -> (p, (sd, r))

-- more sequences after sep, with acc those so far, reversed
mSeqs :: Int -> MMode -> Char -> [Pattern MV] -> (Int, [Char]) -> ([Pattern MV], (Int, [Char]))
mSeqs n mode sep acc st = case mSeq n mode st of
  ((p, _), (sd, rest)) -> case mSkip rest of
    c : r -> if c == sep then mSeqs n mode sep (p : acc) (sd, r) else (reverse (p : acc), (sd, c : r))
    [] -> (reverse (p : acc), (sd, []))

-- sequences separated by ',', each with its size in steps, as a ratio
mSized :: Int -> MMode -> (Int, [Char]) -> ([(Pattern MV, (Int, Int))], (Int, [Char]))
mSized n mode st = case mSeq n mode st of
  (ps, (sd, rest)) -> case mSkip rest of
    ',' : r -> case mSized n mode (sd, r) of
      (more, st2) -> (ps : more, st2)
    r -> ([ps], (sd, r))

-- a sequence and its size; feet split by '.' are steps of their own
mSeq :: Int -> MMode -> (Int, [Char]) -> ((Pattern MV, (Int, Int)), (Int, [Char]))
mSeq n mode st = case mFeet n mode [] [] st of
  (feet, st2) -> case feet of
    [steps] -> (mSteps steps, st2)
    _ -> (mSteps (map (\f -> ((1, 1), fst (mSteps f))) feet), st2)

-- feet, each its steps; acc the steps of this foot and done the feet before, reversed
mFeet :: Int -> MMode -> [((Int, Int), Pattern MV)] -> [[((Int, Int), Pattern MV)]] -> (Int, [Char]) -> ([[((Int, Int), Pattern MV)]], (Int, [Char]))
mFeet n mode acc done (sd, cs) = case mSkip cs of
  [] -> (reverse (reverse acc : done), (sd, []))
  c : more ->
    if elem c (unpack ",|]>})") then (reverse (reverse acc : done), (sd, c : more))
    else if c == '.' && take 1 more /= ['.'] then mFeet n mode [] (reverse acc : done) (sd, more)
    else case mPart n mode (sd, c : more) of
      (p, (sd2, r)) -> case mAfter n mode p (sd2, mSkip r) of
        (steps, st3) -> mFeet n mode (reverse steps ++ acc) done st3

-- after a part: '..' and a part, or weights, or copies
mAfter :: Int -> MMode -> Pattern MV -> (Int, [Char]) -> ([((Int, Int), Pattern MV)], (Int, [Char]))
mAfter n mode p (sd, cs) = case cs of
  '.' : '.' : r -> if mode == MRat || not (mNumeric mode || mode == MStr || mode == MBool || mode == MChar) then mFail n cs "'..' needs numbers or names" else case mPart n mode (sd, mSkip r) of
    (b, st2) -> ([((1, 1), if mode == MStr || mode == MBool then joinP (apP (mapP (\x y -> fastcat [atom x, atom y]) p) b) else if mode == MChar then mCharRange p b else mRange p b)], st2)
  c : _ -> if c == '@' || c == '_' then mWeights n p (1, 1) (sd, cs)
    else if c == '!' then mCopies n p 1 (sd, cs)
    else ([((1, 1), p)], (sd, cs))
  [] -> ([((1, 1), p)], (sd, cs))

mWeights :: Int -> Pattern MV -> (Int, Int) -> (Int, [Char]) -> ([((Int, Int), Pattern MV)], (Int, [Char]))
mWeights n p w (sd, cs) = case cs of
  c : r -> if c == '@' || c == '_' then (if any isDigit (take 1 r)
      then (case mRatio n r of
        (x, r2) -> mWeights n p (ratAdd w (ratAdd x (-1, 1))) (sd, mSkip r2))
      else mWeights n p (ratAdd w (1, 1)) (sd, mSkip r))
    else ([(w, p)], (sd, cs))
  [] -> ([(w, p)], (sd, cs))

mCopies :: Int -> Pattern MV -> Int -> (Int, [Char]) -> ([((Int, Int), Pattern MV)], (Int, [Char]))
mCopies n p k (sd, cs) = case cs of
  '!' : r -> if any isDigit (take 1 r)
    then (case mWhole n r of
      (m, r2) -> mCopies n p (k + m - 1) (sd, mSkip r2))
    else mCopies n p (k + 1) (sd, mSkip r)
  _ -> (replicate k ((1, 1), p), (sd, cs))

-- steps by weight, and the sequence's size
mSteps :: [((Int, Int), Pattern MV)] -> (Pattern MV, (Int, Int))
mSteps steps = case foldl ratAdd (0, 1) (map fst steps) of
  size -> case steps of
    [] -> (silence, size)
    [(_, p)] -> (p, size)
    _ -> case foldl (\m ((_, d), _) -> div (m * d) (gcd m d)) 1 steps of
        l -> (timecatInt (map (\((a, d), p) -> (div (a * l) d, p)) steps), size)

-- a term, then its modifiers, adjacent; in a numeric mode a chord may
-- follow, on the whole term, as Tidal's pPart of pNote
mPart :: Int -> MMode -> (Int, [Char]) -> (Pattern MV, (Int, [Char]))
mPart n mode st = case mBase n mode st of
  (p, st2) -> case mMods n (mode == MBool) p st2 of
    (q, (sd3, r3)) -> if mNumeric mode && mode /= MRat && take 1 r3 == unpack "'" then (case mChord n q (sd3, r3) of
        (c, st4) -> mMods n False c st4)
      else (q, (sd3, r3))

mBase :: Int -> MMode -> (Int, [Char]) -> (Pattern MV, (Int, [Char]))
mBase n mode (sd, cs) = case cs of
  '~' : r -> (silence, (sd, r))
  '^' : r -> if mode == MRat then mFail n cs "a factor cannot be '^name'" else case span (\c -> isAlpha c || isDigit c || elem c (unpack ":.-_")) r of
    (name, r2) -> (mVar mode (pack name), (sd, r2))
  '-' : r -> if any isDigit (take 1 r) && mNumeric mode then mAtom n mode (sd, cs) else (silence, (sd, r))
  '[' : r -> case mStack n mode True (sd, r) of
    (p, (sd2, r2)) -> (p, (sd2, mClose n ']' r2))
  '<' : r -> case mSized n mode (sd, r) of
    (ps, (sd2, r2)) -> (stack (map (\(p, size) -> mRate (1, 1) size p) ps), (sd2, mClose n '>' r2))
  '{' : r -> case mSized n mode (sd, r) of
    (ps, (sd2, r2)) -> case mClose n '}' r2 of
      '%' : r3 -> case mBase n MRat (sd2, r3) of
        (k, st3) -> (stack (map (\(p, size) -> patternify' (\v x -> mRate (mvRat v) size x) k p) ps), st3)
      r3 -> case ps of
        [] -> (silence, (sd2, r3))
        (_, first) : _ -> (stack (map (\(p, size) -> mRate first size p) ps), (sd2, r3))
  _ -> mAtom n mode (sd, cs)

-- ^name: a control read through the type's reader, as Tidal's pVar and
-- getControl; a Float as its ratio (toRatio), as the parser's numbers are
mVar :: MMode -> String -> Pattern MV
mVar mode name = if mode == MInt || mode == MTInt then mapP VInt (cI_ name)
  else if mode == MNum || mode == MNote then mapP (\x -> case toRatio x of
    (a, b) -> VRat a b) (cF_ name)
  else if mode == MStr then mapP (\x -> VStr (unpack x)) (cS_ name)
  else if mode == MBool then mapP VBool (cB_ name)
  else silence

-- p at rate / size steps per cycle
mRate :: (Int, Int) -> (Int, Int) -> Pattern MV -> Pattern MV
mRate (a, b) (c, d) p = if c == 0 then silence else _fastR (a * d) (b * c) p

mClose :: Int -> Char -> [Char] -> [Char]
mClose n c cs = case mSkip cs of
  d : r -> if d == c then r else mFail n (d : r) ("expected " ++ show c)
  [] -> mFail n [] ("expected " ++ show c)

-- '*', '/', '(', '?'; a factor is a term without modifiers, as Tidal's
mMods :: Int -> Bool -> Pattern MV -> (Int, [Char]) -> (Pattern MV, (Int, [Char]))
mMods n bool p (sd, cs) = case cs of
  '*' : r -> case mBase n MRat (sd, mSkip r) of
    (k, st2) -> mMods n bool (patternify (\v x -> case mvRat v of
        (a, b) -> _fastR a b x) k p) st2
  '/' : r -> case mBase n MRat (sd, mSkip r) of
    (k, st2) -> mMods n bool (patternify (\v x -> case mvRat v of
        (a, b) -> _slowR a b x) k p) st2
  '(' : r -> case mSeq n MInt (sd, r) of
    ((k, _), (sd2, r2)) -> case mSkip r2 of
      ',' : r3 -> case mSeq n MInt (sd2, r3) of
        ((m, _), (sd3, r4)) -> case mSkip r4 of
          ',' : r5 -> case mSeq n MInt (sd3, r5) of
            ((rot, _), (sd4, r6)) -> mMods n bool (mEuclid bool k m rot p) (sd4, mClose n ')' r6)
          r5 -> mMods n bool (mEuclid bool k m (atom (VInt 0)) p) (sd3, mClose n ')' r5)
      r3 -> mFail n r3 "expected ','"
  '?' : r -> case (if any isDigit (take 1 r) then mRatio n r else ((1, 2), r)) of
    ((a, b), r2) -> mMods n bool (degradeWith sd a b p) (sd + 1, r2)
  _ -> (p, (sd, cs))

mEuclid :: Bool -> Pattern MV -> Pattern MV -> Pattern MV -> Pattern MV -> Pattern MV
mEuclid bool k m r p = patternify3 (\a b c x -> if bool
    then mapP VBool (_euclidOffBool (mvInt a) (mvInt b) (mvInt c) (mapP mvBool x))
    else _euclidOff (mvInt a) (mvInt b) (mvInt c) x) k m r p

-- characters a to b, or b to a reversed, as Tidal's enumFromTo' for Char
mCharRange :: Pattern MV -> Pattern MV -> Pattern MV
mCharRange a b = joinP (apP (mapP (\x y -> case (ord (mvChar x), ord (mvChar y)) of
    (i, j) -> fastcat (map (\k -> atom (VChar (chr k))) (if i > j then reverse (enumFromTo j i) else enumFromTo i j))) a) b)

-- a to b by 1, or b to a reversed, as Tidal's enumFromTo'; ratios as
-- Haskell's for Double, up to b + 1/2
mRange :: Pattern MV -> Pattern MV -> Pattern MV
mRange a b = joinP (apP (mapP (\x y -> fastcat (map atom (case (x, y) of
    (VInt i, VInt j) -> map VInt (if i > j then reverse (enumFromTo j i) else enumFromTo i j)
    _ -> case (mvRat x, mvRat y) of
      (i, j) -> map (\(u, v) -> VRat u v) (if ratLess j i then reverse (ratSteps j i) else ratSteps i j)))) a) b)

ratLess :: (Int, Int) -> (Int, Int) -> Bool
ratLess (a, b) (c, d) = a * d < c * b

-- i, i + 1, ... up to j + 1/2
ratSteps :: (Int, Int) -> (Int, Int) -> [(Int, Int)]
ratSteps i j = if ratLess (ratAdd j (1, 2)) i then [] else i : ratSteps (ratAdd i (1, 1)) j

-- a value: a number, a note name or a chord; a chord name; or chord modifiers
mAtom :: Int -> MMode -> (Int, [Char]) -> (Pattern MV, (Int, [Char]))
mAtom n mode (sd, cs) = case mode of
  MName -> case span (\c -> isAlpha c || isDigit c) cs of
    ([], _) -> mFail n cs "expected a chord name"
    (name, r) -> case lookup name chordTable of
      Just ns -> (mAt n cs r (VChord ns), (sd, r))
      Nothing -> mFail n cs "unknown chord name"
  MMod -> case mModifiers n cs of
    (ms, r) -> (mAt n cs r (VMods ms), (sd, r))
  MRat -> case cs of
    '-' : r -> (case mRatio n r of
      ((a, b), r2) -> (mAt n cs r2 (VRat (negate a) b), (sd, r2)))
    c : r -> if elem c (unpack "whqestfx") && not (any isAlpha (take 1 r)) then (case ratChar c of
        (a, b) -> (mAt n cs r (VRat a b), (sd, r)))
      else (case mRatio n cs of
        ((a, b), r2) -> (mAt n cs r2 (VRat a b), (sd, r2)))
    [] -> mFail n cs "expected a number"
  MChar -> case cs of
    c : r -> if isAlpha c || isDigit c then (mAt n cs r (VChar c), (sd, r)) else mFail n cs "expected a letter or number"
    [] -> mFail n cs "expected a letter or number"
  MBool -> case cs of
    c : r -> if c == 't' || c == '1' then (mAt n cs r (VBool True), (sd, r))
      else if c == 'f' || c == '0' then (mAt n cs r (VBool False), (sd, r))
      else mFail n cs "expected t, f, 1 or 0"
    [] -> mFail n cs "expected t, f, 1 or 0"
  MStr -> case cs of
    c : r -> if isAlpha c || isDigit c then (case span (\x -> isAlpha x || isDigit x || elem x (unpack ":.-_")) r of
        (name, r2) -> (mAt n cs r2 (VStr (c : name)), (sd, r2)))
      else mFail n cs "expected a name, '~', '[', '<' or '{'"
    [] -> mFail n cs "expected a name"
  _ -> case cs of
    '\'' : _ -> mChord n (atom (if mode == MNum || mode == MNote then VRat 0 1 else VInt 0)) (sd, cs)
    _ -> case mNumber n mode cs of
      (v, r) -> case (if mNoteOctave (take (length cs - length r) cs) then mSkip r else r) of
        e -> (mAt n cs e v, (sd, r))

-- a note name with an octave, whose end takes the spaces after it, as
-- Parsec's natural does for Tidal's parseNote
mNoteOctave :: [Char] -> Bool
mNoteOctave t = case t of
  c : _ -> elem c (unpack "cdefgab") && any isDigit (take 1 (reverse t))
  [] -> False

-- an atom from cs up to r, with its columns, as Tidal's wrapPos; mParse
-- moves those after a newline or tab to Parsec's lines and columns
mAt :: Int -> [Char] -> [Char] -> MV -> Pattern MV
mAt n cs r v = atomC (Context [((n - length cs + 1, 1), (n - length r + 1, 1))]) v

-- MInt's and MTInt's values are Ints; MNum's and MNote's ratios, from decimals, ratio letters or note names
mNumber :: Int -> MMode -> [Char] -> (MV, [Char])
mNumber n mode cs = if mode /= MNum && mode /= MNote then (case mValue n (mode == MTInt) cs of
    (v, r) -> (VInt v, r)) else case cs of
    c : r0 -> if elem c (unpack "whqestfx") && not (any isAlpha (take 1 r0)) && (mode == MNum || not (elem c (unpack "cdefgab")))
      then (case ratChar c of
        (a, b) -> (VRat a b, r0))
      else if elem c (unpack "cdefgab") then (case mValue n True cs of
        (v, r) -> (VRat v 1, r))
      else (case (case cs of
          '-' : r -> (True, r)
          _ -> (False, cs)) of
        (neg, r) -> case mRatio n r of
          ((a, b), r2) -> (VRat (if neg then negate a else a) b, r2))
    [] -> mFail n cs "expected a number"

-- a number, or a note name: a letter, then s, f or n for sharp, flat or
-- natural, then an octave; MIDI's, c4 60 and octave 4 if none, or Tidal's,
-- c5 0 and octave 5 if none
mValue :: Int -> Bool -> [Char] -> (Int, [Char])
mValue n tidal cs = case cs of
  c : r -> if elem c (unpack "cdefgab") then (case span (\x -> elem x (unpack "sfn")) r of
      (accs, r2) -> case (if any isDigit (take 1 r2) then mDigits n r2 else (if tidal then 5 else 4, r2)) of
        (oct, r3) -> ((if tidal then 12 * (oct - 5) else 12 * (oct + 1)) + noteStep c + sum (map (\x -> if x == 's' then 1 else if x == 'f' then -1 else 0) accs), r3))
    else if c == '-' then (case mWhole n r of
      (v, r2) -> (negate v, r2))
    else mWhole n cs
  [] -> mWhole n cs

noteStep :: Char -> Int
noteStep c = case lookup c (zip (unpack "cdefgab") [0, 2, 4, 5, 7, 9, 11]) of
  Just k -> k
  Nothing -> 0

-- a chord on root: 'name, then 'modifiers, each a part of its own
mChord :: Int -> Pattern MV -> (Int, [Char]) -> (Pattern MV, (Int, [Char]))
mChord n root (sd, cs) = case cs of
  '\'' : r -> case mPart n MName (sd, r) of
    (name, st2) -> case mChordMods n [] st2 of
      (mods, st3) -> (chordOf addMV root (mapP mvChord name) (map (mapP mvMods) mods), st3)
  _ -> mFail n cs "expected '"

mChordMods :: Int -> [Pattern MV] -> (Int, [Char]) -> ([Pattern MV], (Int, [Char]))
mChordMods n acc (sd, cs) = case cs of
  '\'' : r -> case mPart n MMod (sd, r) of
    (m, st2) -> mChordMods n (m : acc) st2
  _ -> (reverse acc, (sd, cs))

-- Tidal's chord: each root, name and modifier event, joined, then a note
-- per interval; modifiers act on the intervals, which add to the root last,
-- since every modifier commutes with a transposition
chordOf :: (r -> Int -> r) -> Pattern r -> Pattern [Int] -> [Pattern [Mod]] -> Pattern r
chordOf add root names mods = uncollect (joinP (mapP (\r -> joinP (mapP (\ns -> mapP (map (add r)) (withMods ns mods)) names)) root))

addMV :: MV -> Int -> MV
addMV v k = case v of
  VInt a -> VInt (a + k)
  VRat a b -> VRat (a + k * b) b
  _ -> v

withMods :: [Int] -> [Pattern [Mod]] -> Pattern [Int]
withMods ch mods = case mods of
  [] -> atom ch
  m : rest -> joinP (mapP (\ms -> withMods (foldl (\c x -> applyMod x c) ch ms) rest) m)

applyMod :: Mod -> [Int] -> [Int]
applyMod m ds = case m of
  Range i -> take i (concatMap (\x -> map (+ x) ds) (map (* 12) (enumFromTo 0 i)))
  Invert -> (case ds of
    [] -> []
    d : rest -> rest ++ [d + 12])
  Open -> if length ds > 2 then [ds !! 0 - 12, ds !! 2 - 12, ds !! 1] ++ reverse (take (length ds - 3) (reverse ds)) else ds
  Drop i -> if i < 1 || length ds < i then ds else case length ds - i of
    s -> case splitAt s ds of
      (xs, ys) -> (ds !! s - 12) : (xs ++ drop 1 ys)

-- Tidal's: o..., dN, N, iN or i...
mModifiers :: Int -> [Char] -> ([Mod], [Char])
mModifiers n cs = case cs of
  'o' : _ -> case span (== 'o') cs of
    (os, r) -> (map (\_ -> Open) os, r)
  'd' : r -> case mWhole n r of
    (k, r2) -> ([Drop k], r2)
  'i' : r -> if any isDigit (take 1 r) then (case mWhole n r of
      (k, r2) -> (replicate k Invert, r2))
    else (case span (== 'i') cs of
      (is, r2) -> (map (\_ -> Invert) is, r2))
  _ -> case mValue n False cs of
    (k, r) -> ([Range k], r)

-- a ratio a / b: digits, a fraction and an exponent, or %d; or Tidal's w h q e s t f x
mRatio :: Int -> [Char] -> ((Int, Int), [Char])
mRatio n cs = case span isDigit cs of
  ([], _) -> mFail n cs "expected a number"
  (ds, r) -> case (case r of
      '.' : r1 -> (case span isDigit r1 of
        ([], _) -> ((digitsOf ds, 1), r)
        (fs, r2) -> ((digitsOf (ds ++ fs), 10 ^ length fs), r2))
      _ -> ((digitsOf ds, 1), r)) of
    ((a, b), r3) -> case r3 of
      'e' : r4 -> (case (case r4 of
          '-' : r5 -> (True, r5)
          _ -> (False, r4)) of
        (neg, r5) -> case span isDigit r5 of
          ([], _) -> ratNorm (a, b) r3
          (es, r6) -> if neg then ratNorm (a, b * 10 ^ digitsOf es) r6 else ratNorm (a * 10 ^ digitsOf es, b) r6)
      '%' : r4 -> (case span isDigit r4 of
        ([], _) -> mFail n r4 "expected a number"
        (es, r5) -> ratNorm (a, b * digitsOf es) r5)
      c : r4 -> if elem c (unpack "whqestfx") && not (any isAlpha (take 1 r4)) then ratNorm (ratMul (a, b) (ratChar c)) r4 else ratNorm (a, b) r3
      [] -> ratNorm (a, b) r3

ratChar :: Char -> (Int, Int)
ratChar c = case lookup c (zip (unpack "whqestfx") [(1, 1), (1, 2), (1, 4), (1, 8), (1, 16), (1, 3), (1, 5), (1, 6)]) of
  Just r -> r
  Nothing -> (1, 1)

-- a whole number; a ratio that is not one fails, since factors are Ints
mWhole :: Int -> [Char] -> (Int, [Char])
mWhole n cs = case mRatio n cs of
  ((a, b), r) -> if b == 1 then (a, r) else mFail n cs "expected a whole number"

mDigits :: Int -> [Char] -> (Int, [Char])
mDigits n cs = case span isDigit cs of
  ([], _) -> mFail n cs "expected a number"
  (ds, r) -> (digitsOf ds, r)

digitsOf :: [Char] -> Int
digitsOf ds = foldl (\a d -> a * 10 + ord d - 48) 0 ds

ratNorm :: (Int, Int) -> [Char] -> ((Int, Int), [Char])
ratNorm (a, b) r = case gcd a b of
  g -> ((div a g, div b g), r)

ratAdd :: (Int, Int) -> (Int, Int) -> (Int, Int)
ratAdd (a, b) (c, d) = case (a * d + c * b, b * d) of
  (x, y) -> case gcd x y of
    g -> (div x g, div y g)

ratMul :: (Int, Int) -> (Int, Int) -> (Int, Int)
ratMul (a, b) (c, d) = (a * c, b * d)

-- Tidal's chord table (Sound.Tidal.Chords)
-- the chord names, space-separated, as Tidal's
chordList :: String
chordList = unwords (map (\(k, _) -> pack k) chordTable)

chordTable :: [([Char], [Int])]
chordTable = map (\(k, v) -> (unpack k, v))
  [ ("major", [0, 4, 7]), ("maj", [0, 4, 7]), ("M", [0, 4, 7]), ("aug", [0, 4, 8]), ("plus", [0, 4, 8]), ("sharp5", [0, 4, 8])
  , ("six", [0, 4, 7, 9]), ("6", [0, 4, 7, 9]), ("sixNine", [0, 4, 7, 9, 14]), ("six9", [0, 4, 7, 9, 14]), ("sixby9", [0, 4, 7, 9, 14]), ("6by9", [0, 4, 7, 9, 14])
  , ("major7", [0, 4, 7, 11]), ("maj7", [0, 4, 7, 11]), ("M7", [0, 4, 7, 11]), ("major9", [0, 4, 7, 11, 14]), ("maj9", [0, 4, 7, 11, 14]), ("M9", [0, 4, 7, 11, 14])
  , ("add9", [0, 4, 7, 14]), ("major11", [0, 4, 7, 11, 14, 17]), ("maj11", [0, 4, 7, 11, 14, 17]), ("M11", [0, 4, 7, 11, 14, 17]), ("add11", [0, 4, 7, 17])
  , ("major13", [0, 4, 7, 11, 14, 21]), ("maj13", [0, 4, 7, 11, 14, 21]), ("M13", [0, 4, 7, 11, 14, 21]), ("add13", [0, 4, 7, 21])
  , ("dom7", [0, 4, 7, 10]), ("dom9", [0, 4, 7, 14]), ("dom11", [0, 4, 7, 17]), ("dom13", [0, 4, 7, 21])
  , ("sevenFlat5", [0, 4, 6, 10]), ("7f5", [0, 4, 6, 10]), ("sevenSharp5", [0, 4, 8, 10]), ("7s5", [0, 4, 8, 10]), ("sevenFlat9", [0, 4, 7, 10, 13]), ("7f9", [0, 4, 7, 10, 13])
  , ("nine", [0, 4, 7, 10, 14]), ("eleven", [0, 4, 7, 10, 14, 17]), ("11", [0, 4, 7, 10, 14, 17]), ("thirteen", [0, 4, 7, 10, 14, 17, 21]), ("13", [0, 4, 7, 10, 14, 17, 21])
  , ("minor", [0, 3, 7]), ("min", [0, 3, 7]), ("m", [0, 3, 7]), ("diminished", [0, 3, 6]), ("dim", [0, 3, 6])
  , ("minorSharp5", [0, 3, 8]), ("msharp5", [0, 3, 8]), ("mS5", [0, 3, 8]), ("minor6", [0, 3, 7, 9]), ("min6", [0, 3, 7, 9]), ("m6", [0, 3, 7, 9])
  , ("minorSixNine", [0, 3, 9, 7, 14]), ("minor69", [0, 3, 9, 7, 14]), ("min69", [0, 3, 9, 7, 14]), ("minSixNine", [0, 3, 9, 7, 14]), ("m69", [0, 3, 9, 7, 14]), ("mSixNine", [0, 3, 9, 7, 14]), ("m6by9", [0, 3, 9, 7, 14])
  , ("minor7flat5", [0, 3, 6, 10]), ("minor7f5", [0, 3, 6, 10]), ("min7flat5", [0, 3, 6, 10]), ("min7f5", [0, 3, 6, 10]), ("m7flat5", [0, 3, 6, 10]), ("m7f5", [0, 3, 6, 10])
  , ("minor7", [0, 3, 7, 10]), ("min7", [0, 3, 7, 10]), ("m7", [0, 3, 7, 10])
  , ("minor7sharp5", [0, 3, 8, 10]), ("minor7s5", [0, 3, 8, 10]), ("min7sharp5", [0, 3, 8, 10]), ("min7s5", [0, 3, 8, 10]), ("m7sharp5", [0, 3, 8, 10]), ("m7s5", [0, 3, 8, 10])
  , ("minor7flat9", [0, 3, 7, 10, 13]), ("minor7f9", [0, 3, 7, 10, 13]), ("min7flat9", [0, 3, 7, 10, 13]), ("min7f9", [0, 3, 7, 10, 13]), ("m7flat9", [0, 3, 7, 10, 13]), ("m7f9", [0, 3, 7, 10, 13])
  , ("minor7sharp9", [0, 3, 7, 10, 15]), ("minor7s9", [0, 3, 7, 10, 15]), ("min7sharp9", [0, 3, 7, 10, 15]), ("min7s9", [0, 3, 7, 10, 15]), ("m7sharp9", [0, 3, 7, 10, 15]), ("m7s9", [0, 3, 7, 10, 15])
  , ("diminished7", [0, 3, 6, 9]), ("dim7", [0, 3, 6, 9]), ("minor9", [0, 3, 7, 10, 14]), ("min9", [0, 3, 7, 10, 14]), ("m9", [0, 3, 7, 10, 14])
  , ("minor11", [0, 3, 7, 10, 14, 17]), ("min11", [0, 3, 7, 10, 14, 17]), ("m11", [0, 3, 7, 10, 14, 17])
  , ("minor13", [0, 3, 7, 10, 14, 17, 21]), ("min13", [0, 3, 7, 10, 14, 17, 21]), ("m13", [0, 3, 7, 10, 14, 17, 21])
  , ("minorMajor7", [0, 3, 7, 11]), ("minMaj7", [0, 3, 7, 11]), ("mmaj7", [0, 3, 7, 11])
  , ("one", [0]), ("1", [0]), ("five", [0, 7]), ("5", [0, 7]), ("sus2", [0, 2, 7]), ("sus4", [0, 5, 7])
  , ("sevenSus2", [0, 2, 7, 10]), ("7sus2", [0, 2, 7, 10]), ("sevenSus4", [0, 5, 7, 10]), ("7sus4", [0, 5, 7, 10])
  , ("nineSus4", [0, 5, 7, 10, 14]), ("ninesus4", [0, 5, 7, 10, 14]), ("9sus4", [0, 5, 7, 10, 14]), ("sevenFlat10", [0, 4, 7, 10, 15]), ("7f10", [0, 4, 7, 10, 15])
  , ("nineSharp5", [0, 1, 13]), ("9sharp5", [0, 1, 13]), ("9s5", [0, 1, 13])
  , ("minor9sharp5", [0, 1, 14]), ("minor9s5", [0, 1, 14]), ("min9sharp5", [0, 1, 14]), ("min9s5", [0, 1, 14]), ("m9sharp5", [0, 1, 14]), ("m9s5", [0, 1, 14])
  , ("sevenSharp5flat9", [0, 4, 8, 10, 13]), ("7s5f9", [0, 4, 8, 10, 13]), ("minor7sharp5flat9", [0, 3, 8, 10, 13]), ("m7sharp5flat9", [0, 3, 8, 10, 13])
  , ("elevenSharp", [0, 4, 7, 10, 14, 18]), ("11s", [0, 4, 7, 10, 14, 18]), ("minor11sharp", [0, 3, 7, 10, 14, 18]), ("m11sharp", [0, 3, 7, 10, 14, 18]), ("m11s", [0, 3, 7, 10, 14, 18])
  ]

-- scheduling: tempo is cs samples per cycle, an Int, so tick t sounds at
-- sample div (t * cs) cycleTicks; adjacent sample spans then partition the
-- onsets exactly.

-- the events that start in samples [a, b), as (start, duration, value), in time order
sampleEvents :: Pattern a -> Int -> Int -> Int -> [(Int, Int, a)]
sampleEvents p cs a b = sampleEventsWith [] p cs a b

-- sampleEvents, queried with controls ctls
sampleEventsWith :: [(String, Ctl)] -> Pattern a -> Int -> Int -> Int -> [(Int, Int, a)]
sampleEventsWith ctls p cs a b = sampled cs (windowOnsets ctls p cs a b)

-- the onsets in samples [a, b), queried with controls ctls
windowOnsets :: [(String, Ctl)] -> Pattern a -> Int -> Int -> Int -> [Event a]
windowOnsets ctls p cs a b = onsetsState p (State (Span (mulDivCeil a cycleTicks cs) (mulDivCeil b cycleTicks cs)) ctls)

-- events as (start, duration, value) in samples, cs a cycle, in time order
sampled :: Int -> [Event a] -> [(Int, Int, a)]
sampled cs es =
  sortBy (\(x, _, _) (y, _, _) -> compare x y)
    (map (\e -> case (wholeOrPart e, mulDiv (wholeOrPart e).start cs cycleTicks) of
            (w, s) -> (s, mulDiv w.stop cs cycleTicks - s, e.value)) es)

-- sampleEvents without durations
sampleOnsets :: Pattern a -> Int -> Int -> Int -> [(Int, a)]
sampleOnsets p cs a b = map (\(s, _, v) -> (s, v)) (sampleEvents p cs a b)

-- One Int per event on a ring, so a push cannot tear it: sample * 65536 + value.
encodeEvent :: Int -> Int -> Int
encodeEvent s v = shiftL s 16 + v

eventSample :: Int -> Int
eventSample x = shiftR x 16

eventValue :: Int -> Int
eventValue x = x .&. 65535

-- pushes sampleOnsets onto r, encoded; the number that did not fit
pushOnsets :: Ring Int -> Pattern Int -> Int -> Int -> Int ->> Int
pushOnsets r p cs a b = length (filter (\(s, v) -> not (ringPush r (encodeEvent s (checkValue v)))) (sampleOnsets p cs a b))

-- For a host that owns the memory and calls through funk_call (libfunk.h):
-- writes the first cap sampleEvents to buf, three Ints each: start,
-- duration, value. Returns how many there were, so a result above cap
-- means some were lost.
writeEvents :: Ptr Int -> Int -> Pattern Int -> Int -> Int -> Int ->> Int
writeEvents buf cap p cs a b = writeEach buf cap 0 (sampleEvents p cs a b)

-- writeEvents, queried with the host's controls (readControls)
writeEventsWith :: Ptr Int -> Int -> Pattern Int -> [(String, Ctl)] -> Int -> Int -> Int ->> Int
writeEventsWith buf cap p ctls cs a b = writeEach buf cap 0 (sampleEventsWith ctls p cs a b)

-- Where a host's controls come from, as a top-level controls lists them
-- (docs/dev/controls-in.md): Tidal's OSC /ctrl on a UDP port, MIDI CC as
-- "cc21" and "1:cc21", 0 to 1, or the plugin's parameters "p1" to "p16".
data ControlIn = Osc Int | MidiCC | Params

osc :: Int -> ControlIn
osc port = Osc port

midiCC :: ControlIn
midiCC = MidiCC

params :: ControlIn
params = Params

-- for the host: each source as an Int, a port for OSC, -1 for MIDI CC, -2
-- for parameters; at most 8; how many there were
writeControlIns :: Ptr Int -> [ControlIn] ->> Int
writeControlIns buf ins = writeInts buf 0 (take 8 (map (\c -> case c of
    Osc port -> port
    MidiCC -> -1
    Params -> -2) ins))

writeInts :: Ptr Int -> Int -> [Int] ->> Int
writeInts buf i xs = case xs of
  [] -> i
  x : rest -> do
    poke (plusPtr buf (8 * i)) x
    writeInts buf (i + 1) rest

-- A host's controls (docs/dev/controls-in.md): n entries of 128 bytes from
-- buf, each a name of up to 47 bytes and a NUL, at 48 its kind, an Int: 0 a
-- Float at 56, 1 an Int at 56, 2 a string from 64, of up to 63 bytes, 3 a
-- StablePtr to a Ctl at 56, from setF (lib/stream.fk).
readControls :: Ptr () -> Int ->> [(String, Ctl)]
readControls buf n = if n <= 0 then [] else readControl (plusPtr buf (128 * (n - 1))) : readControls buf (n - 1)

readControl :: Ptr () ->> (String, Ctl)
readControl e = case (peekByteOff e 48 :: Int) of
  0 -> (peekCString (castPtr e), CtlF (peekByteOff e 56))
  1 -> (peekCString (castPtr e), CtlI (peekByteOff e 56))
  3 -> (peekCString (castPtr e), deRefStablePtr (castPtrToStablePtr (peekByteOff e 56 :: Ptr ())))
  _ -> (peekCString (castPtr e), CtlS (peekCString (castPtr (plusPtr e 64))))

writeEach :: Ptr Int -> Int -> Int -> [(Int, Int, Int)] ->> Int
writeEach buf cap i es = case es of
  [] -> i
  (s, d, v) : rest -> do
    if i < cap then do
      poke (plusPtr buf (i * 24)) s
      poke (plusPtr buf (i * 24 + 8)) d
      poke (plusPtr buf (i * 24 + 16)) v
    else ()
    writeEach buf cap (i + 1) rest

checkValue :: Int -> Int
checkValue v = if v < 0 || v > 65535 then error ("pattern.pushOnsets: value " ++ show v ++ " outside 0..65535") else v

-- helpers

cycleOf :: Int -> Span
cycleOf t = case div t cycleTicks * cycleTicks of
  c -> Span c (c + cycleTicks)

-- q cut at cycle boundaries
cycleSpans :: Span -> [Span]
cycleSpans (Span s e) = if s >= e then [] else
  case (div s cycleTicks + 1) * cycleTicks of
    next -> Span s (min e next) : cycleSpans (Span next e)

move :: Int -> Span -> Span
move t (Span s e) = Span (s + t) (e + t)

withSpans :: (Span -> Span) -> Event a -> Event a
withSpans f e = Event (mapSpan f e.whole) (f e.part) e.value e.context

mapSpan :: (Span -> Span) -> Maybe Span -> Maybe Span
mapSpan f w = case w of
  Just s -> Just (f s)
  Nothing -> Nothing

-- the event has a whole
discrete :: Event a -> Bool
discrete e = case e.whole of
  Just _ -> True
  Nothing -> False

-- wholes intersected, as Tidal's subMaybeArc: none if either is none, and
-- nothing if both are and they do not meet
sectW :: Maybe Span -> Maybe Span -> [Maybe Span]
sectW a b = case (a, b) of
  (Just x, Just y) -> map Just (sects x y)
  _ -> [Nothing]

-- Tidal's Show.hs: a pattern's first cycle, or cycles, drawn as text.
-- showAll needs events' contexts, which funk's lack (F5).

-- the steps of a cycle: the lcm of the denominators of its onsets' part
-- times, each the fraction a tick time stands for (tickRatio)
stepcount :: Pattern a -> Int
stepcount pat = foldr (\t acc -> lcmInt (snd (tickRatio t)) acc) 1
  (concatMap (\e -> [e.part.start, e.part.stop]) (filter (.onset) (query pat (Span 0 cycleTicks))))

-- the fraction of a cycle with the smallest denominator within a tick of
-- t, as funk's times are: 1/100 for a*100's 461260 ticks and 3/100 for
-- 1383782, where ticks hold 461260/46126080
tickRatio :: Int -> (Int, Int)
tickRatio t = if t < 0 then (case tickRatio (negate t) of
    (a, b) -> (negate a, b))
  else simplestIn (t - 1, cycleTicks) (t + 1, cycleTicks)

-- the fraction with the smallest denominator in [a/b, c/d], 0 <= a/b <= c/d,
-- by the Stern-Brocot tree
simplestIn :: (Int, Int) -> (Int, Int) -> (Int, Int)
simplestIn (a, b) (c, d) = case ceilDiv (max a 0) b of
  k -> if k * d <= c then (k, 1) else case div a b of
    fl -> case simplestIn (d, c - fl * d) (b, a - fl * b) of
      (p, q) -> (fl * p + q, p)

lcmInt :: Int -> Int -> Int
lcmInt a b = if a == 0 || b == 0 then 0 else abs (div a (gcd a b) * b)

-- cycles drawn, width, and the drawing, as Tidal's Render
data Render = Render Int Int [Char]

instance Show Render where
  showPrec _ (Render cyc i r) = if i <= 1024
    then "\n[" ++ show cyc ++ (if cyc == 1 then " cycle" else " cycles") ++ "]\n" ++ pack r
    else "That pattern is too complex to draw."

drawLine :: Pattern Char -> Render
drawLine pat = drawLineSz 78 pat

-- cycles drawn side by side, while they fit in sz columns
drawLineSz :: Int -> Pattern Char -> Render
drawLineSz sz pat = joinCycles sz 0 pat

joinCycles :: Int -> Int -> Pattern Char -> Render
joinCycles n k pat = case draw (rotL (toFloat k) pat) of
  Render cyc l s -> if l > n then Render 0 0 [] else case joinCycles (n - l - 1) (k + 1) pat of
    Render cyc' l' s' -> case (textLines s, textLines s') of
      (ls, ls') -> case max (length ls) (length ls') of
        m -> Render (cyc + cyc') (l + l' + 1) (joinWith '\n' (map (\(a, b) -> a ++ b)
          (zip (padRows m (replicate l ' ') ls) (padRows m (replicate l' ' ') ls'))))

-- the first cycle, one row per level of overlapping events
draw :: Pattern Char -> Render
draw pat = case stepcount pat of
  s -> Render 1 s (if s > 1024 then [] else joinWith '\n' (map (\lv -> '|' : drawLevel s lv) (levels pat)))

drawLevel :: Int -> [Event Char] -> [Char]
drawLevel s es = case es of
  [] -> replicate s '.'
  e : rest -> map (\(a, b) -> if a == '.' then b else a)
    (zip (padDots s (drawLevel s rest)) (padDots s (drawEvent s e)))

drawEvent :: Int -> Event Char -> [Char]
drawEvent s ev = case wholeOrPart ev of
  w -> replicate (div (s * w.start) cycleTicks) '.' ++ (ev.value : replicate (div (s * (w.stop - w.start)) cycleTicks - 1) '-')

-- xs to n characters, '.' after its end, as Tidal's xs ++ repeat '.'
padDots :: Int -> [Char] -> [Char]
padDots n xs = take n (xs ++ replicate n '.')

padRows :: Int -> [Char] -> [[Char]] -> [[Char]]
padRows m blank rows = take m (rows ++ replicate m blank)

-- Haskell's lines and intercalate on [Char]
textLines :: [Char] -> [[Char]]
textLines cs = case cs of
  [] -> []
  _ -> case span (\c -> c /= '\n') cs of
    (l, rest) -> l : (case rest of
      [] -> []
      _ : more -> textLines more)

joinWith :: Char -> [[Char]] -> [Char]
joinWith c rows = case rows of
  [] -> []
  [r] -> r
  r : more -> r ++ (c : joinWith c more)

-- events in levels, each event in the first level none of whose parts it meets
levels :: Eq a => Pattern a -> [[Event a]]
levels pat = foldr addLevel [] (reverse (defragParts (query pat (Span 0 cycleTicks))))

addLevel :: Event a -> [[Event a]] -> [[Event a]]
addLevel e lvs = case lvs of
  [] -> [[e]]
  lv : rest -> if not (any (\x -> case subArc e.part x.part of
      Just _ -> True
      Nothing -> False) lv) then (e : lv) : rest else lv : addLevel e rest

-- Tidal's Pattern.hs, as funk's types have it: times and Spans in ticks.
-- Missing, with reasons in docs/dev/tidal-comparison.md (F3): contexts,
-- steps (F6), pureValue (F8) and VState (C3).
queryArc :: Pattern a -> Span -> [Event a]
queryArc p a = query p a

empty :: Pattern a
empty = silence

nothing :: Pattern a
nothing = setSteps (Just (0, 1)) silence

-- an error for a class method patterns do not have
noOv :: String -> a
noOv meth = error (meth ++ ": not supported for patterns")

-- each query split at cycle boundaries
splitQueries :: Pattern a -> Pattern a
splitQueries p = sameMeta p (\st -> concatMap (\a -> queryIn st p a) (arcCyclesZW st.arc))

withResultArc :: (Span -> Span) -> Pattern a -> Pattern a
withResultArc f pat = sameMeta pat (\st -> map (\e -> Event (mapSpan f e.whole) (f e.part) e.value e.context) (queryState pat st))

withResultTime :: (Int -> Int) -> Pattern a -> Pattern a
withResultTime f pat = withResultArc (\a -> Span (f a.start) (f a.stop)) pat

withResultStart :: (Int -> Int) -> Pattern a -> Pattern a
withResultStart f pat = withResultArc (\a -> Span (f a.start) (f a.start + (a.stop - a.start))) pat

withQueryArc :: (Span -> Span) -> Pattern a -> Pattern a
withQueryArc f pat = sameMeta pat (\st -> queryIn st pat (f st.arc))

withQueryTime :: (Int -> Int) -> Pattern a -> Pattern a
withQueryTime f pat = withQueryArc (\a -> Span (f a.start) (f a.stop)) pat

withQueryStart :: (Int -> Int) -> Pattern a -> Pattern a
withQueryStart f pat = withQueryArc (\a -> Span (f a.start) (f a.start + (a.stop - a.start))) pat

withQueryControls :: ([(String, Ctl)] -> [(String, Ctl)]) -> Pattern a -> Pattern a
withQueryControls f pat = sameMeta pat (\st -> queryState pat (State st.arc (f st.controls)))

withEvent :: (Event a -> Event b) -> Pattern a -> Pattern b
withEvent f p = withQuery p (\st -> map f (queryState p st))

withEventArc :: (Span -> Span) -> Pattern a -> Pattern a
withEventArc f pat = withEvent (\e -> Event (mapSpan f e.whole) (f e.part) e.value e.context) pat

withValue :: (a -> b) -> Pattern a -> Pattern b
withValue f pat = withEvent (\e -> Event e.whole e.part (f e.value) e.context) pat

-- each event's context set, or mapped, as Tidal's; steps and pureValue kept
setContext :: Context -> Pattern a -> Pattern a
setContext c pat = withContext (\_ -> c) pat

withContext :: (Context -> Context) -> Pattern a -> Pattern a
withContext f pat = sameMeta pat (\st -> map (\e -> Event e.whole e.part e.value (f e.context)) (queryState pat st))

-- code with each string literal s wrapped as (deltaContext column line s),
-- its position in the code, as Tidal's for an editor
deltaMini :: String -> String
deltaMini code = pack (deltaOutside 0 0 (unpack code))

deltaOutside :: Int -> Int -> [Char] -> [Char]
deltaOutside column line cs = case cs of
  [] -> []
  '"' : xs -> unpack ("(deltaContext " ++ show column ++ " " ++ show line ++ " \"") ++ deltaInside (column + 1) line xs
  '\n' : xs -> '\n' : deltaOutside 0 (line + 1) xs
  x : xs -> x : deltaOutside (column + 1) line xs

deltaInside :: Int -> Int -> [Char] -> [Char]
deltaInside column line cs = case cs of
  [] -> []
  '"' : xs -> '"' : ')' : deltaOutside (column + 1) line xs
  '\n' : xs -> '\n' : deltaInside 0 (line + 1) xs
  x : xs -> x : deltaInside (column + 1) line xs

-- each position moved by column and line, as Tidal's for a pattern
deltaContext :: Int -> Int -> Pattern a -> Pattern a
deltaContext column line pat = withEvent (\e -> Event e.whole e.part e.value (Context (map (\((bx, by), (ex, ey)) -> ((bx + column, by + line), (ex + column, ey + line))) e.context.contextPosition))) pat

withEvents :: ([Event a] -> [Event b]) -> Pattern a -> Pattern b
withEvents f p = withQuery p (\st -> f (queryState p st))

withPart :: (Span -> Span) -> Pattern a -> Pattern a
withPart f pat = withEvent (\e -> Event e.whole (f e.part) e.value e.context) pat

filterEvents :: (Event a -> Bool) -> Pattern a -> Pattern a
filterEvents f p = sameMeta p (\st -> filter f (queryState p st))

-- the pattern compressed into a's part of each cycle; empty unless a is
-- within one cycle
compressArc :: Span -> Pattern a -> Pattern a
compressArc a p = if a.start > a.stop || a.start > cycleTicks || a.stop > cycleTicks || a.start < 0 || a.stop < 0 then silence
  else rotR (fromTime a.start) (_fastGap (1.0 / fromTime (a.stop - a.start)) p)

compressArcTo :: Span -> Pattern a -> Pattern a
compressArcTo a p = compressArc (Span (mod a.start cycleTicks) (a.stop - samTicks a.start)) p

focusArc :: Span -> Pattern a -> Pattern a
focusArc a p = rotR (fromTime a.start) (_fast (1.0 / fromTime (a.stop - a.start)) (rotL (fromTime (samTicks a.start)) p))

-- each event of pb, with whether f holds for it and any event of pa at its
-- start. Tidal queries pa over Arc s s; funk's queries have width, and
-- [s, s + 1) returns the same events, those whose part covers s.
matchManyToOne :: (b -> a -> Bool) -> Pattern a -> Pattern b -> Pattern (Bool, b)
matchManyToOne f pa pb = pattern (\st -> map (\ex -> case queryIn st pa (Span (wholeOrPart ex).start ((wholeOrPart ex).start + 1)) of
    as' -> Event ex.whole ex.part (any (\a -> f ex.value a.value) as', ex.value) (combineContexts (ex.context : map (\a -> a.context) as'))) (queryState pb st))

-- reversed in time about 0
revv :: Pattern a -> Pattern a
revv pat = withEventArc (\a -> Span (negate a.stop) (negate a.start)) (withQueryArc (\a -> Span (negate a.stop) (negate a.start)) pat)

-- n patterns, the ith playing cycles i, i + n, ... of pat, one after another
separateCycles :: Int -> Pattern a -> [Pattern a]
separateCycles n pat = map (\i -> splitQueries (withResultStart (\t -> div (samTicks t) n + mod t cycleTicks)
    (withQueryStart (\t -> samTicks t * n + mod t cycleTicks) (rotL (toFloat i) pat)))) [0 .. n - 1]

-- f of each value of pa, then joined, as Tidal's patternify, without its
-- shortcut for a constant (F8)
patternify :: (a -> b -> Pattern c) -> Pattern a -> b -> Pattern c
patternify f pa b = case pureValue pa of
  Just a -> f a b
  Nothing -> innerJoin (mapP (\a -> f a b) pa)

-- patternify, with p's steps
patternify' :: (b -> Pattern c -> Pattern a) -> Pattern b -> Pattern c -> Pattern a
patternify' f pa p = setSteps (steps p) (patternify f pa p)

patternify2 :: (a -> b -> c -> Pattern d) -> Pattern a -> Pattern b -> c -> Pattern d
patternify2 f a b p = case (pureValue a, pureValue b) of
  (Just x, Just y) -> f x y p
  _ -> innerJoin (apP (mapP (\x y -> f x y p) a) b)

patternify2' :: (a -> b -> Pattern c -> Pattern d) -> Pattern a -> Pattern b -> Pattern c -> Pattern d
patternify2' f a b p = patternify2 f a b p

patternify3 :: (a -> b -> c -> Pattern d -> Pattern e) -> Pattern a -> Pattern b -> Pattern c -> Pattern d -> Pattern e
patternify3 f a b c p = case (pureValue a, pureValue b, pureValue c) of
  (Just x, Just y, Just z) -> f x y z p
  _ -> innerJoin (apP (apP (mapP (\x y z -> f x y z p) a) b) c)

patternify3' :: (a -> b -> c -> Pattern d -> Pattern e) -> Pattern a -> Pattern b -> Pattern c -> Pattern d -> Pattern e
patternify3' f a b c p = keepSteps p (patternify3 f a b c p)

patternifySqueeze :: (a -> Pattern b -> Pattern c) -> Pattern a -> Pattern b -> Pattern c
patternifySqueeze f tv p = squeezeJoin (mapP (\v -> f v p) tv)

-- f's events, each with px's over its whole or part, wholes by combine
applyPatToPat :: (Maybe Span -> Maybe Span -> Maybe (Maybe Span)) -> Pattern (a -> b) -> Pattern a -> Pattern b
applyPatToPat combine pf px = pattern (\st -> concatMap (\ef -> concatMap (\ex -> case (combine ef.whole ex.whole, subArc ef.part ex.part) of
    (Just w, Just pt) -> [Event w pt (ef.value ex.value) (ctx2 ef.context ex.context)]
    _ -> []) (queryIn st px (wholeOrPart ef))) (queryState pf st))

applyPatToPatBoth :: Pattern (a -> b) -> Pattern a -> Pattern b
applyPatToPatBoth pf px = apP pf px

applyPatToPatLeft :: Pattern (a -> b) -> Pattern a -> Pattern b
applyPatToPatLeft pf px = apLeft pf px

applyPatToPatRight :: Pattern (a -> b) -> Pattern a -> Pattern b
applyPatToPatRight pf px = apRight pf px

applyPatToPatSqueeze :: Pattern (a -> b) -> Pattern a -> Pattern b
applyPatToPatSqueeze pf px = squeezeJoin (mapP (\f -> mapP f px) pf)

unwrap :: Pattern (Pattern a) -> Pattern a
unwrap pp = joinP pp

isAnalog :: Event a -> Bool
isAnalog e = case e.whole of
  Nothing -> True
  Just _ -> False

isDigital :: Event a -> Bool
isDigital e = not (isAnalog e)

onsetIn :: Span -> Event a -> Bool
onsetIn a e = isIn a (wholeStart e)

isAdjacent :: Eq a => Event a -> Event a -> Bool
isAdjacent e e' = e.whole == e'.whole && e.value == e'.value && (e.part.stop == e'.part.start || e'.part.stop == e.part.start)

wholeStart :: Event a -> Int
wholeStart e = (wholeOrPart e).start

wholeStop :: Event a -> Int
wholeStop e = (wholeOrPart e).stop

eventPartStart :: Event a -> Int
eventPartStart e = e.part.start

eventPartStop :: Event a -> Int
eventPartStop e = e.part.stop

eventPart :: Event a -> Span
eventPart e = e.part

eventHasOnset :: Event a -> Bool
eventHasOnset e = e.onset

toEvent :: (((Int, Int), (Int, Int)), a) -> Event a
toEvent (((ws, we), (ps, pe)), v) = Event (Just (Span ws we)) (Span ps pe) v noContext

valueToPattern :: Ctl -> Pattern Ctl
valueToPattern v = ctlPattern v

sameDur :: Event a -> Event a -> Bool
sameDur e1 e2 = e1.whole == e2.whole && e1.part == e2.part

-- events grouped with those f relates to the group's first, in order
groupEventsBy :: Eq a => (Event a -> Event a -> Bool) -> [Event a] -> [[Event a]]
groupEventsBy f es = case es of
  [] -> []
  e : rest -> case e : filter (\x -> f e x) rest of
    eqs -> eqs : groupEventsBy f (deleteAll eqs rest)

-- xs without the first copy of each of ds, as Haskell's \\
deleteAll :: Eq a => [a] -> [a] -> [a]
deleteAll ds xs = foldl (\acc d -> deleteFirst d acc) xs ds

deleteFirst :: Eq a => a -> [a] -> [a]
deleteFirst d xs = case xs of
  [] -> []
  x : rest -> if x == d then rest else x : deleteFirst d rest

collectEvent :: [Event a] -> Maybe (Event [a])
collectEvent l = case l of
  [] -> Nothing
  e : _ -> Just (Event e.whole e.part (map (\x -> x.value) l) (combineContexts (map (\x -> x.context) l)))

collectEventsBy :: Eq a => (Event a -> Event a -> Bool) -> [Event a] -> [Event [a]]
collectEventsBy f es = concatMap (\g -> case collectEvent g of
    Just c -> [c]
    Nothing -> []) (groupEventsBy f es)

collectBy :: Eq a => (Event a -> Event a -> Bool) -> Pattern a -> Pattern [a]
collectBy f p = withEvents (collectEventsBy f) p

-- events with the same whole and part, as one event of their values
collect :: Eq a => Pattern a -> Pattern [a]
collect p = collectBy sameDur p

uncollectEvent :: Event [a] -> [Event a]
uncollectEvent e = map (\(i, v) -> Event e.whole e.part v (Context (take 1 (drop i e.context.contextPosition)))) (zip [0 .. length e.value - 1] e.value)

uncollectEvents :: [Event [a]] -> [Event a]
uncollectEvents es = concatMap uncollectEvent es

-- Tidal's Stepwise.hs (F6): patterns joined, cut and stretched by their
-- steps, exact ratios as Tidal's Rationals
pace :: Float -> Pattern a -> Pattern a
pace target p = case steps p of
  Just t -> case ratDiv (toRatio target) t of
    (n, d) -> setSteps (Just (toRatio target)) (_fastR n d p)
  Nothing -> error "pattern.pace: the pattern has no steps"

ratDiv :: (Int, Int) -> (Int, Int) -> (Int, Int)
ratDiv (a, b) (c, d) = if c == 0 then error "pattern: a ratio's denominator is 0" else ratReduce (a * d) (b * c)

-- as patternify, joined by steps (stepJoin)
s_patternify :: (a -> Pattern b -> Pattern c) -> Pattern a -> Pattern b -> Pattern c
s_patternify f pa p = case pureValue pa of
  Just a -> f a p
  Nothing -> stepJoin (mapP (\a -> f a p) pa)

s_patternify2 :: (a -> b -> c -> Pattern d) -> Pattern a -> Pattern b -> c -> Pattern d
s_patternify2 f a b p = stepJoin (apP (mapP (\x y -> f x y p) a) b)

-- each cycle's slices of inner patterns, between the outer events' part
-- edges, played one after another, each for its steps; a slice without
-- steps for its share of the steps of those with them
stepJoin :: Pattern (Pattern a) -> Pattern a
stepJoin pp = Pattern (\st -> case samTicks st.arc.start of
    c -> queryState (stepSlices (queryIn st (_shift (negate c) pp) (Span 0 cycleTicks))) st) (steps (stepSlices (query pp (Span 0 cycleTicks)))) Nothing

stepSlices :: [Event (Pattern a)] -> Pattern a
stepSlices evs = timecatRat (stepRetime (map (\(b, e) -> (ratReduce (e - b) cycleTicks, stack (map (\x -> x.value) (filter (\x -> case subArc (Span b e) x.part of
    Just _ -> True
    Nothing -> False) evs)))) (pairsOf (dedupSorted (sort (0 : cycleTicks : concatMap (\x -> [x.part.start, x.part.stop]) evs))))))

stepRetime :: [((Int, Int), Pattern a)] -> [((Int, Int), Pattern a)]
stepRetime xs = case (foldr (\(d, x) acc -> if hasSteps x then ratAdd d acc else acc) (0, 1) xs,
    foldr (\(_, x) acc -> case steps x of
      Just t -> ratAdd t acc
      Nothing -> acc) (0, 1) xs) of
  (perc, tactus) -> map (\(d, x) -> case steps x of
    Just t -> (t, x)
    Nothing -> (ratTimes d (ratDiv tactus perc), x)) xs

pairsOf :: [a] -> [(a, a)]
pairsOf xs = case xs of
  a : b : rest -> (a, b) : pairsOf (b : rest)
  _ -> []

dedupSorted :: Eq a => [a] -> [a]
dedupSorted xs = case xs of
  a : b : rest -> if a == b then dedupSorted (b : rest) else a : dedupSorted (b : rest)
  _ -> xs

-- each pattern for its steps, 1 if it has none
stepcat :: [Pattern a] -> Pattern a
stepcat pats = timecatRat (map (\x -> (fromMaybe (1, 1) (steps x), x)) pats)

-- the first n steps, or the last if n is negative
_take :: Float -> Pattern a -> Pattern a
_take n pat = case steps pat of
  Nothing -> pat
  Just t -> case toRatio n of
    r -> case (if fst r >= 0 then ((0, 1), ratDiv r t) else (ratAdd (1, 1) (ratDiv r t), (1, 1))) of
      (b, e) -> setSteps (Just (if ratLess (absRat r) t then absRat r else t)) (zoomTicks (ratTicks b) (ratTicks e) pat)

absRat :: (Int, Int) -> (Int, Int)
absRat (a, b) = (abs a, b)

-- a ratio of a cycle in ticks, to the nearest
ratTicks :: (Int, Int) -> Int
ratTicks (a, b) = div (2 * a * cycleTicks + b) (2 * b)

steptake :: Pattern Float -> Pattern a -> Pattern a
steptake np pat = s_patternify _take np pat

_stepdrop :: Float -> Pattern a -> Pattern a
_stepdrop n pat = case steps pat of
  Nothing -> pat
  Just (a, b) -> case toFloat a / toFloat b of
    t -> steptake (atom (if n >= 0.0 then t - n else negate (t + n))) pat

stepdrop :: Pattern Float -> Pattern a -> Pattern a
stepdrop np pat = s_patternify _stepdrop np pat

_expand :: Float -> Pattern a -> Pattern a
_expand factor pat = withSteps (ratTimes (toRatio factor)) pat

_contract :: Float -> Pattern a -> Pattern a
_contract factor pat = withSteps (\t -> ratDiv t (toRatio factor)) pat

expand :: Pattern Float -> Pattern a -> Pattern a
expand fp pat = s_patternify _expand fp pat

contract :: Pattern Float -> Pattern a -> Pattern a
contract fp pat = s_patternify _contract fp pat

_extend :: Float -> Pattern a -> Pattern a
_extend factor pat = _expand factor (_fast factor pat)

extend :: Pattern Float -> Pattern a -> Pattern a
extend fp pat = s_patternify _extend fp pat

-- the groups' patterns in turn, one from each group each step
stepalt :: [[Pattern a]] -> Pattern a
stepalt groups = case foldl1 lcmInt (map length groups) of
  c -> stepcat (concatMap (\i -> map (\g -> g !! mod i (length g)) groups) [0 .. c * length groups - 1])

-- the patterns with steps, a cycle each at one step a cycle, then all as
-- fast as the lcm of their steps
stepzip :: [Pattern a] -> Pattern a
stepzip pats = case foldl1 lcmr (concatMap (\x -> case steps x of
    Just t -> [t]
    Nothing -> []) pats) of
  (n, d) -> setSteps (Just (n, d)) (_fastR n d (slowcat (map (pace 1.0) (filter hasSteps pats))))

-- Tidal's Time.hs. A time argument is a Float of cycles, as elsewhere; a
-- Span, Tidal's Arc, holds ticks, as events and queries do. Tidal's lcmr
-- needs Rational.
sam :: Float -> Float
sam x = toFloat (floor x)

nextSam :: Float -> Float
nextSam x = sam x + 1.0

cyclePos :: Float -> Float
cyclePos x = x - sam x

-- cycles to ticks, to the nearest
toTime :: Float -> Int
toTime x = round (x * toFloat cycleTicks)

-- ticks to cycles
fromTime :: Int -> Float
fromTime t = toFloat t / toFloat cycleTicks

-- the start of a tick time's cycle
samTicks :: Int -> Int
samTicks t = t - mod t cycleTicks

hull :: Span -> Span -> Span
hull a b = Span (min a.start b.start) (max a.stop b.stop)

-- the intersection, empty or reversed if they do not meet
sect :: Span -> Span -> Span
sect a b = Span (max a.start b.start) (min a.stop b.stop)

-- the intersection, Nothing if they do not meet; a zero-width one at the
-- end of a span that is not itself zero-width does not count
subArc :: Span -> Span -> Maybe Span
subArc a b = case sect a b of
  Span s e -> if s == e && s == a.stop && a.start < a.stop then Nothing
    else if s == e && s == b.stop && b.start < b.stop then Nothing
    else if s <= e then Just (Span s e) else Nothing

subMaybeArc :: Maybe Span -> Maybe Span -> Maybe (Maybe Span)
subMaybeArc ma mb = case (ma, mb) of
  (Just a, Just b) -> case subArc a b of
    Just s -> Just (Just s)
    Nothing -> Nothing
  _ -> Just Nothing

-- the cycle a tick time is in
timeToCycleArc :: Int -> Span
timeToCycleArc t = Span (samTicks t) (samTicks t + cycleTicks)

-- the span moved to start in cycle 0
cycleArc :: Span -> Span
cycleArc a = Span (mod a.start cycleTicks) (mod a.start cycleTicks + (a.stop - a.start))

-- the numbers of the cycles a span touches
cyclesInArc :: Span -> [Int]
cyclesInArc a = if a.start > a.stop then [] else if a.start == a.stop then [div a.start cycleTicks]
  else [div a.start cycleTicks .. ceilDiv a.stop cycleTicks - 1]

cycleArcsInArc :: Span -> [Span]
cycleArcsInArc a = map (\c -> timeToCycleArc (c * cycleTicks)) (cyclesInArc a)

-- the span split at cycle boundaries
arcCycles :: Span -> [Span]
arcCycles a = if a.start >= a.stop then [] else if samTicks a.start == samTicks a.stop then [a]
  else Span a.start (samTicks a.start + cycleTicks) : arcCycles (Span (samTicks a.start + cycleTicks) a.stop)

-- as arcCycles, but a zero-width span is itself
arcCyclesZW :: Span -> [Span]
arcCyclesZW a = if a.start == a.stop then [a] else arcCycles a

-- f on the span's times within its first cycle, in ticks
mapCycle :: (Int -> Int) -> Span -> Span
mapCycle f a = case samTicks a.start of
  s0 -> Span (s0 + f (a.start - s0)) (s0 + f (a.stop - s0))

isIn :: Span -> Int -> Bool
isIn a t = t >= a.start && t < a.stop

-- the intersection, if not empty
sects :: Span -> Span -> [Span]
sects a b = case (max a.start b.start, min a.stop b.stop) of
  (s, t) -> if s < t then [Span s t] else []

-- e's part inside q, if any
clipEvent :: Span -> Event a -> [Event a]
clipEvent q e = case (max e.part.start q.start, min e.part.stop q.stop) of
  (s, t) -> if s < t then [Event e.whole (Span s t) e.value e.context] else []

ceilDiv :: Int -> Int -> Int
ceilDiv a k = negate (div (negate a) k)

-- floor and ceiling of x * m / d, for m >= 0 and d > 0, without forming
-- x * m: ticks times samples per cycle pass Int's range after 55 hours
mulDiv :: Int -> Int -> Int -> Int
mulDiv x m d = div x d * m + div (mod x d * m) d

mulDivCeil :: Int -> Int -> Int -> Int
mulDivCeil x m d = div x d * m + ceilDiv (mod x d * m) d
