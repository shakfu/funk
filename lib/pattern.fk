-- pattern.fk -- events over musical time (docs/dev/patterns.md). A pattern
-- is a query: given a span of time, the events that overlap it.
module pattern where

-- Time is in ticks. A cycle is 64 * lcm 1..16 ticks, so it divides exactly
-- into 2 to 16 steps, their products while the factors last, and 64ths.
cycleTicks :: Int
cycleTicks = 46126080

-- [start, stop)
data Span = Span { start, stop :: Int } deriving (Eq, Show)

-- whole is the event's extent; part is the fragment inside the query. An
-- event with no whole is continuous, as a sine's: it has no onset.
data Event a = Event { whole :: Maybe Span, part :: Span, value :: a, context :: Context } deriving (Eq, Show)

-- the mini-notation atoms an event came from, as Tidal's: each a
-- ((column, line), (column, line)) of its start and end, from 1
data Context = Context { contextPosition :: [((Int, Int), (Int, Int))] } deriving (Eq, Ord, Show)

noContext :: Context
noContext = Context []

combineContexts :: [Context] -> Context
combineContexts cs = Context (concatMap (\c -> c.contextPosition) cs)

-- combineContexts [a, b], without copying when one is empty
ctx2 :: Context -> Context -> Context
ctx2 a b = case b.contextPosition of
  [] -> a
  bs -> case a.contextPosition of
    [] -> b
    as -> Context (as ++ bs)

-- each event's context followed by oc, as a join's
addContext :: Context -> [Event a] -> [Event a]
addContext oc es = case oc.contextPosition of
  [] -> es
  _ -> map (\e -> Event e.whole e.part e.value (ctx2 e.context oc)) es

-- The event starts in this query: the scheduler triggers it here.
Event.onset :: Event a -> Bool
Event.onset e = case e.whole of
  Just w -> w.start == e.part.start
  Nothing -> False

-- the whole, or for a continuous event its part, as Tidal's
wholeOrPart :: Event a -> Span
wholeOrPart e = fromMaybe e.part e.whole

-- What a query asks: the span, and the values of controls from outside
-- the pattern, by name, as Tidal's State (docs/dev/controls-in.md).
data State = State { arc :: Span, controls :: [(String, Ctl)] }

-- a control's value, as Tidal's VF, VI, VS, VB and VPattern: setF's
data Ctl = CtlF Float | CtlI Int | CtlS String | CtlB Bool | CtlP (Pattern Ctl) | CtlL [Ctl]

-- as Tidal's: a Float equals an Int of its value; a pattern equals nothing
instance Eq Ctl where
  a == b = case (a, b) of
    (CtlF x, CtlF y) -> x == y
    (CtlI x, CtlI y) -> x == y
    (CtlS x, CtlS y) -> x == y
    (CtlB x, CtlB y) -> x == y
    (CtlF x, CtlI y) -> x == toFloat y
    (CtlI x, CtlF y) -> toFloat x == y
    (CtlL x, CtlL y) -> x == y
    _ -> False

instance Show Ctl where
  showPrec d v = showParen (d > 10) (case v of
    CtlF x -> "CtlF " ++ showPrec 11 x
    CtlI i -> "CtlI " ++ showPrec 11 i
    CtlS x -> "CtlS " ++ show x
    CtlB b -> "CtlB " ++ show b
    CtlP _ -> "CtlP <pattern>"
    CtlL xs -> "CtlL " ++ show xs)

-- Tidal's Pattern: a query, and two facts kept beside it. steps is the
-- number of steps a cycle, a ratio (F6); pureValue the value of a pattern
-- that is one value each cycle, as atom's, which lets a function take it
-- without a join (F8). Nothing for either is unknown.
-- pureValue is held as a function of (), so a value whose computation fails
-- fails when it is used, as Tidal's lazy field does.
data Pattern a = Pattern (State -> [Event a]) (Maybe (Int, Int)) (Maybe (() -> a))

-- a pattern of a query, neither fact known, as Tidal's pattern
pattern :: (State -> [Event a]) -> Pattern a
pattern f = Pattern f Nothing Nothing

-- Tidal's steps and pureValue, and its functions on them (F6, F8)
steps :: Pattern a -> Maybe (Int, Int)
steps (Pattern _ s _) = s

pureValue :: Pattern a -> Maybe a
pureValue (Pattern _ _ v) = case v of
  Just th -> Just (th ())
  Nothing -> Nothing

pureThunk :: Pattern a -> Maybe (() -> a)
pureThunk (Pattern _ _ v) = v

setSteps :: Maybe (Int, Int) -> Pattern a -> Pattern a
setSteps s (Pattern f _ v) = Pattern f s v

setStepsFrom :: Pattern b -> Pattern a -> Pattern a
setStepsFrom a b = setSteps (steps a) b

withSteps :: ((Int, Int) -> (Int, Int)) -> Pattern a -> Pattern a
withSteps f p = setSteps (mapMaybe1 f (steps p)) p

hasSteps :: Pattern a -> Bool
hasSteps p = case steps p of
  Just _ -> True
  Nothing -> False

keepSteps :: Pattern a -> Pattern b -> Pattern b
keepSteps from to = setSteps (steps from) to

keepMeta :: Pattern a -> Pattern a -> Pattern a
keepMeta from (Pattern f _ _) = Pattern f (steps from) (pureThunk from)

-- the query of p, with p's steps and no pureValue, as Tidal's p {query = ...,
-- pureValue = Nothing}
withQuery :: Pattern b -> (State -> [Event a]) -> Pattern a
withQuery p f = Pattern f (steps p) Nothing

-- the query, with both of p's facts, as Tidal's p {query = ...}
sameMeta :: Pattern a -> (State -> [Event a]) -> Pattern a
sameMeta p f = Pattern f (steps p) (pureThunk p)

mapMaybe1 :: (a -> b) -> Maybe a -> Maybe b
mapMaybe1 f m = case m of
  Just x -> Just (f x)
  Nothing -> Nothing

-- both, or Nothing, combined by f
both2 :: (a -> b -> c) -> Maybe a -> Maybe b -> Maybe c
both2 f a b = case (a, b) of
  (Just x, Just y) -> Just (f x y)
  _ -> Nothing

-- ratios as (n, d), d positive and in lowest terms
ratTimes :: (Int, Int) -> (Int, Int) -> (Int, Int)
ratTimes (a, b) (c, d) = ratReduce (a * c) (b * d)

ratReduce :: Int -> Int -> (Int, Int)
ratReduce n d = case gcd n d of
  0 -> (0, 1)
  g -> if d < 0 then (negate (div n g), negate (div d g)) else (div n g, div d g)

-- Tidal's lcmr: the lcm of the numerators over the gcd of the denominators
lcmr :: (Int, Int) -> (Int, Int) -> (Int, Int)
lcmr (a, b) (c, d) = ratReduce (lcmInt a c) (gcd b d)

-- the events over q, with no controls
query :: Pattern a -> Span -> [Event a]
query p q = queryState p (State q [])

queryState :: Pattern a -> State -> [Event a]
queryState (Pattern f _ _) st = f st

-- the events over q, with st's controls
queryIn :: State -> Pattern a -> Span -> [Event a]
queryIn st p q = queryState p (State q st.controls)

-- the events that start in q
onsets :: Pattern a -> Span -> [Event a]
onsets p q = filter (.onset) (query p q)

-- onsets, with st's controls
onsetsState :: Pattern a -> State -> [Event a]
onsetsState p st = filter (.onset) (queryState p st)

silence :: Pattern a
silence = Pattern (\_ -> []) (Just (1, 1)) Nothing

-- v once per cycle
atom :: a -> Pattern a
atom v = atomC noContext v

-- atom, its events from c, as Tidal's setContext c (pure v)
atomC :: Context -> a -> Pattern a
atomC c v = Pattern (\qst -> let q = qst.arc in map (\s -> Event (Just (cycleOf s.start)) s v c) (cycleSpans q)) (Just (1, 1)) (Just (\_ -> v))

-- f must be pure: Pattern's field holds a pure function
mapP :: (a -> b) -> Pattern a -> Pattern b
mapP f p = Pattern (\qst -> let q = qst.arc in map (\e -> Event e.whole e.part (f e.value) e.context) (queryIn qst p q)) (steps p) (case pureThunk p of
  Just th -> Just (\_ -> f (th ()))
  Nothing -> Nothing)

-- all at once
stack :: [Pattern a] -> Pattern a
stack ps = Pattern (\qst -> let q = qst.arc in concatMap (\p -> queryIn qst p q) ps)
  (if null ps then Nothing else foldl1 (both2 lcmr) (map steps ps)) Nothing

-- one per cycle, in turn; each pattern sees its own cycles in order
cat :: [Pattern a] -> Pattern a
cat [] = silence
cat [p] = p
cat ps = pattern (\qst -> let q = qst.arc in concatMap (one qst) (cycleSpans q))
  where
    n = length ps
    one qst s = case div s.start cycleTicks of
      c -> case (c - div c n) * cycleTicks of
        off -> map (withSpans (move off)) (queryIn qst (ps !! mod c n) (move (negate off) s))

-- all in one cycle, in equal steps
fastcat :: [Pattern a] -> Pattern a
fastcat ps = case ps of
  [] -> setSteps (Just (0, 1)) silence
  [p] -> p
  _ -> setSteps (foldl1 (both2 ratAdd) (map steps ps)) (_fastInt (length ps) (cat ps))

-- k times as fast. Times that do not divide by k round down. A part cut
-- at q's start is at q.start * k and rounds to q.start, above its whole's
-- start, so each event is still an onset in exactly one query.
_fastInt :: Int -> Pattern a -> Pattern a
_fastInt k p
  | k <= 0 = error "pattern.fast: factor must be positive"
  | otherwise = sameMeta p (\qst -> let q = qst.arc in map (withSpans (\s -> Span (div s.start k) (div s.stop k))) (queryIn qst p (Span (q.start * k) (q.stop * k))))

-- k times as slow; exact
_slowInt :: Int -> Pattern a -> Pattern a
_slowInt k p
  | k <= 0 = error "pattern.slow: factor must be positive"
  | otherwise = sameMeta p (\qst -> let q = qst.arc in concatMap (clipEvent q . withSpans (\s -> Span (s.start * k) (s.stop * k))) (queryIn qst p (Span (div q.start k) (ceilDiv q.stop k))))

-- later by t ticks
_shift :: Int -> Pattern a -> Pattern a
_shift t p = sameMeta p (\qst -> let q = qst.arc in map (withSpans (move t)) (queryIn qst p (move (negate t) q)))

-- n / d times as fast or as slow, by _fastInt and _slowInt, so times round
-- as _fastInt's do. As Tidal's, 0 is silence and a negative factor reverses.
_fastR :: Int -> Int -> Pattern a -> Pattern a
_fastR n d p
  | n == 0 = silence
  | d <= 0 = error "pattern.fast: a ratio's denominator must be positive"
  | n < 0 = rev (_fastR (negate n) d p)
  | otherwise = case gcd n d of
      g -> _fastInt (div n g) (_slowInt (div d g) p)

_slowR :: Int -> Int -> Pattern a -> Pattern a
_slowR n d p
  | n == 0 = silence
  | n < 0 = rev (_fastR d (negate n) p)
  | otherwise = _fastR d n p

-- x as n / d, with d from 1 to 65536: the first continued-fraction
-- convergent within 1e-12 of x, relative, else the last within the bound.
-- Tidal's factors are Rationals; this gives 3 / 2 for 1.5 and 3 / 5 for
-- 0.6. The bound keeps ticks times n within Int, to about 3e6 / x cycles.
toRatio :: Float -> (Int, Int)
toRatio x
  | not (x == x) = error "pattern: a factor is NaN"
  | x < 0.0 = case toRatio (negate x) of
      (n, d) -> (negate n, d)
  | otherwise = ratioFrom x x 1 0 0 1

ratioFrom :: Float -> Float -> Int -> Int -> Int -> Int -> (Int, Int)
ratioFrom x y h1 k1 h0 k0 = case floor y of
  a -> case (a * h1 + h0, a * k1 + k0) of
    (h, k) -> if k > 65536 then (h1, k1)
              else if y == toFloat a || abs (toFloat h / toFloat k - x) <= 1.0e-12 * x then (h, k)
              else ratioFrom x (1.0 / (y - toFloat a)) h k h1 k1

-- Tidal's: k times as fast or as slow, by k's ratio (toRatio)
_fast :: Float -> Pattern a -> Pattern a
_fast k p = case toRatio k of
  (n, d) -> _fastR n d p

_slow :: Float -> Pattern a -> Pattern a
_slow k p = case toRatio k of
  (n, d) -> _slowR n d p

-- Patterned arguments, as Tidal's: each factor's event applies its value
-- during its part. A literal is an atom, by Num (Pattern a). A factor of 0
-- is silence and a negative one reverses, as Tidal's.
fast :: Pattern Float -> Pattern a -> Pattern a
fast kp p = patternify' _fast kp p

slow :: Pattern Float -> Pattern a -> Pattern a
slow kp p = patternify _slow kp p

shift :: Pattern Int -> Pattern a -> Pattern a
shift tp p = innerJoin (mapP (\t -> _shift t p) tp)

-- each cycle backwards, as Tidal's rev
rev :: Pattern a -> Pattern a
rev p = sameMeta p (\qst -> let q = qst.arc in concatMap (\s -> case cycleOf s.start of
    c -> map (withSpans (reflect c)) (queryIn qst p (reflect c s))) (cycleSpans q))

-- s mirrored within cycle c
reflect :: Span -> Span -> Span
reflect c s = Span (c.start + c.stop - s.stop) (c.start + c.stop - s.start)

-- arithmetic on values, with wholes from both, as Tidal's
instance Num a => Num (Pattern a) where
  x + y = apP (mapP (+) x) y
  x - y = apP (mapP (-) x) y
  x * y = apP (mapP (*) x) y
  negate x = mapP negate x
  abs x = mapP abs x
  fromInt n = atom (fromInt n)

-- k onsets spread as evenly as possible over n steps, the first on step 0;
-- each argument a pattern, as Tidal's
euclid :: Pattern Int -> Pattern Int -> Pattern a -> Pattern a
euclid kp np a = patternify2 _euclid kp np a

-- Applying a pattern of functions to a pattern of values, as Tidal's <*>,
-- <* and *>: where fragments overlap, f's value applies to x's.

-- wholes from both: each is the intersection of an f's and an x's, or
-- none where either is continuous. As Tidal's, a discrete f meets only
-- discrete xs over its whole, and a continuous one any x over its part.
apP :: Pattern (a -> b) -> Pattern a -> Pattern b
apP pf px = Pattern (\qst -> let q = qst.arc in concatMap (\ef -> case ef.whole of
      Just w -> concatMap (apBoth ef) (filter discrete (queryIn qst px w))
      Nothing -> concatMap (apBoth ef) (queryIn qst px ef.part)) (queryIn qst pf q)
  ++ concatMap (\ex -> concatMap (\ef -> apBoth ef ex) (filter discrete (queryIn qst pf ex.part))) (filter (not . discrete) (queryIn qst px q)))
  (both2 lcmr (steps pf) (steps px)) Nothing

apBoth :: Event (a -> b) -> Event a -> [Event b]
apBoth ef ex = concatMap (\w -> map (\s -> Event w s ((ef.value) (ex.value)) (ctx2 ef.context ex.context)) (sects ef.part ex.part)) (sectW ef.whole ex.whole)

-- wholes from f
apLeft :: Pattern (a -> b) -> Pattern a -> Pattern b
apLeft pf px = withQuery pf (\qst -> let q = qst.arc in concatMap (\ef -> concatMap (\ex ->
    map (\s -> Event ef.whole s ((ef.value) (ex.value)) (ctx2 ef.context ex.context)) (sects ef.part ex.part))
  (queryIn qst px (wholeOrPart ef))) (queryIn qst pf q))

-- wholes from x
apRight :: Pattern (a -> b) -> Pattern a -> Pattern b
apRight pf px = withQuery px (\qst -> let q = qst.arc in concatMap (\ex -> concatMap (\ef ->
    map (\s -> Event ex.whole s ((ef.value) (ex.value)) (ctx2 ef.context ex.context)) (sects ef.part ex.part))
  (queryIn qst pf (wholeOrPart ex))) (queryIn qst px q))

-- Tidal's Functor, Applicative and Monad names, for patterns alone, as
-- funk has no higher-kinded classes (docs/dev/tidal-comparison.md, L3).
-- <* and *> are Tidal's, not base's: wholes from the left or the right.
infixl 4 <$>, <$, <*>, <*, *>, <<*
infixl 1 >>=

fmap :: (a -> b) -> Pattern a -> Pattern b
fmap f pat = mapP f pat

(<$>) :: (a -> b) -> Pattern a -> Pattern b
f <$> pat = mapP f pat

(<$) :: a -> Pattern b -> Pattern a
x <$ pat = mapP (\_ -> x) pat

pure :: a -> Pattern a
pure x = atom x

return :: a -> Pattern a
return x = atom x

(<*>) :: Pattern (a -> b) -> Pattern a -> Pattern b
pf <*> px = apP pf px

(<*) :: Pattern (a -> b) -> Pattern a -> Pattern b
pf <* px = apLeft pf px

(*>) :: Pattern (a -> b) -> Pattern a -> Pattern b
pf *> px = apRight pf px

-- wholes from the left: each f's event plays x squeezed into it
(<<*) :: Pattern (a -> b) -> Pattern a -> Pattern b
pf <<* px = setSteps (both2 ratTimes (steps pf) (steps px)) (squeezeJoin (mapP (\f -> mapP f px) pf))

liftA2 :: (a -> b -> c) -> Pattern a -> Pattern b -> Pattern c
liftA2 f pa pb = apP (mapP f pa) pb

-- Tidal's: unwrap, wholes from both
(>>=) :: Pattern a -> (a -> Pattern b) -> Pattern b
pat >>= f = joinP (mapP f pat)

-- Flattening a pattern of patterns, as Tidal's unwrap, innerJoin,
-- outerJoin and squeezeJoin. Each outer event plays its inner pattern
-- during the outer event's part.

-- wholes from both, intersected
joinP :: Pattern (Pattern a) -> Pattern a
joinP pp = withQuery pp (\qst -> let q = qst.arc in concatMap (\eo -> concatMap (\ei ->
    map (\w -> Event w ei.part ei.value (ctx2 ei.context eo.context)) (sectW eo.whole ei.whole))
  (queryIn qst eo.value eo.part)) (queryIn qst pp q))

-- wholes from the inner pattern
innerJoin :: Pattern (Pattern a) -> Pattern a
innerJoin pp = withQuery pp (\qst -> let q = qst.arc in concatMap (\eo -> addContext eo.context (queryIn qst eo.value eo.part)) (queryIn qst pp q))

-- wholes from the outer pattern; values from the inner one at the outer
-- whole's start
outerJoin :: Pattern (Pattern a) -> Pattern a
outerJoin pp = withQuery pp (\qst -> let q = qst.arc in concatMap (\eo ->
    case (wholeOrPart eo).start of
      t -> map (\ei -> Event eo.whole eo.part ei.value (ctx2 eo.context ei.context)) (queryIn qst eo.value (Span t (t + 1))))
  (queryIn qst pp q))

-- Each outer event plays one cycle of its inner pattern within its whole:
-- the cycle its whole starts in, as Tidal's. Times round down.
squeezeJoin :: Pattern (Pattern a) -> Pattern a
squeezeJoin pp = withQuery pp (\qst -> let q = qst.arc in concatMap (squeezeOne qst) (queryIn qst pp q))

squeezeOne :: State -> Event (Pattern a) -> [Event a]
squeezeOne qst eo = concatMap fit (queryIn qst eo.value (Span (back eo.part.start) (ceilDiv ((eo.part.stop - ws) * cycleTicks) n + c)))
  where
    ws = (wholeOrPart eo).start
    n = (wholeOrPart eo).stop - ws
    c = div ws cycleTicks * cycleTicks
    back t = div ((t - ws) * cycleTicks) n + c
    out (Span s e) = Span (ws + div ((s - c) * n) cycleTicks) (ws + div ((e - c) * n) cycleTicks)
    fit ei = concatMap (\w -> map (\s -> Event w s ei.value (ctx2 ei.context eo.context)) (sects eo.part (out ei.part))) (sectW eo.whole (mapSpan out ei.whole))

-- Each pattern in turn within a cycle, for its weight's share of it, as
-- Tidal's timeCat: cycle c of each plays in its share of cycle c.
-- Weights are Floats, as Tidal's Times, each taken as its ratio (toRatio).
timecat :: [(Float, Pattern a)] -> Pattern a
timecat wps = timecatRat (map (\(w, v) -> (toRatio w, v)) wps)

-- timecat of exact ratio weights; its steps are their sum, as Tidal's
timecatRat :: [((Int, Int), Pattern a)] -> Pattern a
timecatRat rs = case rs of
  [(_, p)] -> p
  _ -> case foldr (\((_, d), _) l -> div l (gcd l d) * d) 1 rs of
    l -> setSteps (Just (foldr (\(r, _) acc -> ratAdd r acc) (0, 1) rs)) (timecatInt (map (\((n, d), v) -> (n * div l d, v)) rs))

timecatInt :: [(Int, Pattern a)] -> Pattern a
timecatInt wps = case wps of
  [(_, p)] -> p
  _ -> Pattern (\qst -> let q = qst.arc in concatMap (\s -> concatMap (squeezeInto qst s) segs) (cycleSpans q)) (Just (sum (map fst wps), 1)) Nothing
  where
    w = sum (map fst wps)
    segs = edges 0 (filter (\(k, _) -> k > 0) wps)
    edges o [] = []
    edges o ((k, v) : rest) = (div (o * cycleTicks) w, div ((o + k) * cycleTicks) w, v) : edges (o + k) rest

-- the part of s inside [a, b) of its cycle, with p's cycle mapped onto [a, b)
squeezeInto :: State -> Span -> (Int, Int, Pattern a) -> [Event a]
squeezeInto qst s (a, b, p) = concatMap one (sects (Span (c + a) (c + b)) s)
  where
    c = div s.start cycleTicks * cycleTicks
    lo = c + a
    n = b - a
    -- each span from its own cycle, as Tidal's _fastGap maps it
    out (Span x y) = case div x cycleTicks * cycleTicks of
      cx -> Span (cx + a + div ((x - cx) * n) cycleTicks) (cx + a + div ((y - cx) * n) cycleTicks)
    one qs = concatMap (\e -> map (\pt -> Event (mapSpan out e.whole) pt e.value e.context) (sects (out e.part) qs))
      (queryIn qst p (Span (c + div ((qs.start - lo) * cycleTicks) n) (c + ceilDiv ((qs.stop - lo) * cycleTicks) n)))

-- pat on k of n steps, by Bjorklund's algorithm as Tidal's; a negative k plays the others
_euclid :: Int -> Int -> Pattern a -> Pattern a
_euclid k n pat = setSteps (Just (n, 1)) (case (if k >= 0 then bjorklund k n else map not (bjorklund (negate k) n)) of
  [] -> silence
  bs -> fastcat (map (\b -> if b then pat else silence) bs))

-- _euclid, earlier by r of its n steps
_euclidOff :: Int -> Int -> Int -> Pattern a -> Pattern a
_euclidOff k n r pat = if n == 0 then silence else setSteps (Just (n, 1)) (_shift (negate (div (r * cycleTicks) n)) (_euclid k n pat))

bjorklund :: Int -> Int -> [Bool]
bjorklund i n = case bjStep (i, n - i) (replicate i [True], replicate (n - i) [False]) of
  (xs, ys) -> concat xs ++ concat ys

bjStep :: (Int, Int) -> ([[Bool]], [[Bool]]) -> ([[Bool]], [[Bool]])
bjStep (i, j) (xs, ys) =
  if min i j <= 1 then (xs, ys)
  else if i > j then (case splitAt j xs of
    (a, b) -> bjStep (j, i - j) (zipWith (++) a ys, b))
  else case splitAt i ys of
    (a, b) -> bjStep (i, j - i) (zipWith (++) xs a, b)

-- Tidal's timeToRand at tick t, after its rotL by seed / 10000 cycles,
-- as an Int in [0, 2^29): t / 300 cycles' fraction, by 2^29, then an
-- xorshift. 300 cycles are 3e6 * cycleTicks units of 1/10000 tick, and
-- 2^29 / that is 8192 / 2111484375.
randAt :: Int -> Int -> Int
randAt t seed = case t * 10000 + seed * cycleTicks of
  0 -> 268435456
  x -> mod (xorwise (quot (rem x 138378240000000 * 8192) 2111484375)) 536870912

xorwise :: Int -> Int
xorwise x = case xor (shiftL x 13) x of
  a -> case xor (shiftR a 17) a of
    b -> xor (shiftL b 5) b

-- the events whose random value at their start is at least a / b, as Tidal's degradeBy
degradeWith :: Int -> Int -> Int -> Pattern a -> Pattern a
degradeWith seed a b p = pattern (\qst -> let q = qst.arc in filter (\e -> randAt (wholeOrPart e).start seed * b >= a * 536870912) (queryIn qst p q))

-- one of ps per cycle, chosen at random, as Tidal's '|'
chooseCycle :: Int -> [Pattern a] -> Pattern a
chooseCycle seed ps = setSteps (Just (1, 1)) (joinP (pattern (\qst -> let q = qst.arc in map (\s -> case cycleOf s.start of
    w -> Event (Just w) s (ps !! mod (div (randAt w.start seed * length ps) 536870912) (length ps)) noContext) (cycleSpans q))))

-- the events whose value f maps to Just, with that value
mapMaybeP :: (a -> Maybe b) -> Pattern a -> Pattern b
mapMaybeP f p = pattern (\qst -> let q = qst.arc in concatMap (\e -> case f e.value of
    Just v -> [Event e.whole e.part v e.context]
    Nothing -> []) (queryIn qst p q))

-- a Tidal sample name's folder and index: "sn:3" is ("sn", 3), "bd" ("bd", 0)
soundParts :: String -> (String, Int)
soundParts s = case span (/= ':') (unpack s) of
  (name, ':' : ds) -> (pack name, if not (null ds) && all isDigit ds then digitsOf ds else 0)
  (name, _) -> (pack name, 0)

-- each event's list, as events of its own
uncollect :: Pattern [a] -> Pattern a
uncollect p = pattern (\qst -> let q = qst.arc in concatMap uncollectEvent (queryIn qst p q))

-- Tidal's Core.hs, with what it needs from Pattern.hs. Times in cycles are
-- Floats, rounded to the nearest tick (docs/dev/combinators.md).

-- a float literal as an atom, as Tidal's fromRational
instance FromFloat a => FromFloat (Pattern a) where
  fromFloat x = atom (fromFloat x)

-- as Tidal's: x / y is x * recip y
instance Fractional a => Fractional (Pattern a) where
  recip x = mapP recip x

-- Tidal's signals are Fractional a => Pattern a, so n (range 0 7 sine)
-- is a Note. Each here is its Float form, xF, at any FromFloat type.
sine :: FromFloat a => Pattern a
sine = mapP fromFloat sineF
sine2 :: FromFloat a => Pattern a
sine2 = mapP fromFloat sine2F
cosine :: FromFloat a => Pattern a
cosine = mapP fromFloat cosineF
cosine2 :: FromFloat a => Pattern a
cosine2 = mapP fromFloat cosine2F
saw :: FromFloat a => Pattern a
saw = mapP fromFloat sawF
saw2 :: FromFloat a => Pattern a
saw2 = mapP fromFloat saw2F
isaw :: FromFloat a => Pattern a
isaw = mapP fromFloat isawF
isaw2 :: FromFloat a => Pattern a
isaw2 = mapP fromFloat isaw2F
tri :: FromFloat a => Pattern a
tri = mapP fromFloat triF
tri2 :: FromFloat a => Pattern a
tri2 = mapP fromFloat tri2F
square :: FromFloat a => Pattern a
square = mapP fromFloat squareF
square2 :: FromFloat a => Pattern a
square2 = mapP fromFloat square2F
rand :: FromFloat a => Pattern a
rand = mapP fromFloat randF
perlin :: FromFloat a => Pattern a
perlin = mapP fromFloat perlinF
perlinWith :: FromFloat a => Pattern Float -> Pattern a
perlinWith p = mapP fromFloat (perlinWithF p)
normal :: FromFloat a => Pattern a
normal = mapP fromFloat normalF

pi :: Float
pi = 3.141592653589793

-- tick t in cycles
cycles :: Int -> Float
cycles t = toFloat t / toFloat cycleTicks

-- c cycles in ticks, to the nearest
ticks :: Float -> Int
ticks c = round (c * toFloat cycleTicks)

-- x past its floor, as Haskell's mod' x 1
fract :: Float -> Float
fract x = x - toFloat (floor x)

-- continuous: one event over the query, with no whole, f of its start
sig :: (Float -> a) -> Pattern a
sig f = pattern (\qst -> let q = qst.arc in if q.start > q.stop then [] else [Event Nothing q (f (cycles q.start)) noContext])

-- 0 to 1 and back once a cycle; the forms ending in 2 run from -1 to 1
sineF :: Pattern Float
sineF = sig (\t -> (sin (pi * 2.0 * t) + 1.0) / 2.0)

sine2F :: Pattern Float
sine2F = sig (\t -> sin (pi * 2.0 * t))

cosineF :: Pattern Float
cosineF = rotR 0.25 sineF

cosine2F :: Pattern Float
cosine2F = rotR 0.25 sine2F

sawF :: Pattern Float
sawF = sig fract

saw2F :: Pattern Float
saw2F = sig (\t -> fract t * 2.0 - 1.0)

isawF :: Pattern Float
isawF = mapP (\x -> 1.0 - x) sawF

isaw2F :: Pattern Float
isaw2F = mapP (\x -> x * (-1.0)) saw2F

triF :: Pattern Float
triF = fastAppend sawF isawF

tri2F :: Pattern Float
tri2F = fastAppend saw2F isaw2F

squareF :: Pattern Float
squareF = sig (\t -> toFloat (floor (fract t * 2.0)))

square2F :: Pattern Float
square2F = sig (\t -> toFloat (floor (fract t * 2.0) * 2 - 1))

-- 0 to 1 over the first cycle, then 1; R reversed, Eq at equal power
envL :: Pattern Float
envL = sig (\t -> max 0.0 (min t 1.0))

envLR :: Pattern Float
envLR = mapP (\x -> 1.0 - x) envL

envEq :: Pattern Float
envEq = sig (\t -> sqrt (sin (pi / 2.0 * max 0.0 (min (1.0 - t) 1.0))))

envEqR :: Pattern Float
envEqR = sig (\t -> sqrt (cos (pi / 2.0 * max 0.0 (min (1.0 - t) 1.0))))

-- one value per cycle
fromList :: [a] -> Pattern a
fromList xs = cat (map atom xs)

-- all in one cycle
fastFromList :: [a] -> Pattern a
fastFromList xs = fastcat (map atom xs)

listToPat :: [a] -> Pattern a
listToPat xs = fastFromList xs

-- in one cycle, Nothing a rest
fromMaybes :: [Maybe a] -> Pattern a
fromMaybes ms = fastcat (map (\m -> case m of
    Just x -> atom x
    Nothing -> silence) ms)

-- 0 to n - 1 in a cycle, at any number type, as Tidal's
run :: (Num a, Ord a, Enum a) => Pattern a -> Pattern a
run np = setSteps (mapMaybe1 (\n -> (length (enumFromTo 0 (n - 1)), 1)) (pureValue np)) (joinP (mapP _run np))

_run :: (Num a, Ord a, Enum a) => a -> Pattern a
_run n = fastFromList (enumFromTo 0 (n - 1))

-- run 1, then run 2, up to run n, a cycle each
scan :: (Num a, Ord a, Enum a) => Pattern a -> Pattern a
scan np = joinP (mapP _scan np)

_scan :: (Num a, Ord a, Enum a) => a -> Pattern a
_scan n = cat (map _run (enumFromTo 1 n))

append :: Pattern a -> Pattern a -> Pattern a
append a b = cat [a, b]

slowcat :: [Pattern a] -> Pattern a
slowcat ps = cat ps

fastAppend :: Pattern a -> Pattern a -> Pattern a
fastAppend a b = _fastInt 2 (append a b)

overlay :: Pattern a -> Pattern a -> Pattern a
overlay a b = pattern (queryState (stack [a, b]))

-- as Tidal's: <> overlays
instance Semigroup (Pattern a) where
  a <> b = overlay a b

-- one event at a time: an event starting while another sounds starts when
-- it ends, as Tidal's mono
mono :: Pattern a -> Pattern a
mono p = pattern (\qst -> let q = qst.arc in concatMap monoPart (monoCut (sortBy (\a b -> compareWhole a.whole b.whole) (queryIn qst p q))))

monoCut :: [Event a] -> [Event a]
monoCut es = case es of
  [] -> []
  e : rest -> e : monoCut (concatMap (monoSnip e) rest)

monoSnip :: Event a -> Event a -> [Event a]
monoSnip a b = case (wholeOrPart a, wholeOrPart b) of
  (wa, wb) -> if wb.start >= wa.stop then [b]
    else if wb.stop <= wa.stop then []
    else [Event (Just (Span wa.stop wb.stop)) b.part b.value b.context]

monoPart :: Event a -> [Event a]
monoPart e = map (\s -> Event e.whole s e.value e.context) (sects (wholeOrPart e) e.part)

-- Maybe Span's order, as Haskell's derived one
compareWhole :: Maybe Span -> Maybe Span -> Ordering
compareWhole a b = case (a, b) of
  (Nothing, Nothing) -> EQ
  (Nothing, _) -> LT
  (_, Nothing) -> GT
  (Just x, Just y) -> compare (x.start, x.stop) (y.start, y.stop)

-- earlier or later by c cycles
rotL :: Float -> Pattern a -> Pattern a
rotL c p = _shift (negate (ticks c)) p

rotR :: Float -> Pattern a -> Pattern a
rotR c p = _shift (ticks c) p

-- rotL and rotR with patterned times, as Tidal's 0.25 <~ p
(<~) :: Pattern Float -> Pattern a -> Pattern a
tp <~ p = patternify' rotL tp p

(~>) :: Pattern Float -> Pattern a -> Pattern a
tp ~> p = patternify' rotR tp p

-- fast and slow, each factor's event playing a whole cycle of p
fastSqueeze :: Pattern Float -> Pattern a -> Pattern a
fastSqueeze kp p = squeezeJoin (mapP (\k -> _fast k p) kp)

slowSqueeze :: Pattern Float -> Pattern a -> Pattern a
slowSqueeze kp p = squeezeJoin (mapP (\k -> _slow k p) kp)

density :: Pattern Float -> Pattern a -> Pattern a
density kp p = fast kp p

sparsity :: Pattern Float -> Pattern a -> Pattern a
sparsity kp p = slow kp p

-- [s, e) of each cycle, stretched over the cycle
zoom :: (Float, Float) -> Pattern a -> Pattern a
zoom (s, e) p = zoomTicks (ticks s) (ticks e) p

zoompat :: Pattern Float -> Pattern Float -> Pattern a -> Pattern a
zoompat sp ep p = innerJoin (apP (mapP (\s e -> zoom (s, e) p) sp) ep)

-- As Tidal's zoomArc, each span maps within the cycle its start is in.
zoomTicks :: Int -> Int -> Pattern a -> Pattern a
zoomTicks s e p = if s >= e then nothing else withSteps (ratTimes (ratReduce (e - s) cycleTicks)) (sameMeta p (\qst -> let q = qst.arc in concatMap (\qs ->
    concatMap (clipEvent qs . withSpans (zoomOut s (e - s))) (queryIn qst p (zoomIn s (e - s) qs))) (cycleSpans q)))

zoomIn :: Int -> Int -> Span -> Span
zoomIn s d (Span a b) = case div a cycleTicks * cycleTicks of
  c -> Span (c + s + div ((a - c) * d) cycleTicks) (c + s + ceilDiv ((b - c) * d) cycleTicks)

zoomOut :: Int -> Int -> Span -> Span
zoomOut s d (Span x y) = case div x cycleTicks * cycleTicks of
  c -> Span (c + div ((x - c - s) * cycleTicks) d) (c + div ((y - c - s) * cycleTicks) d)

-- k times as fast, then silent for the rest of each cycle
fastGap :: Pattern Float -> Pattern a -> Pattern a
fastGap kp p = patternify _fastGap kp p

densityGap :: Pattern Float -> Pattern a -> Pattern a
densityGap kp p = fastGap kp p

_fastGap :: Float -> Pattern a -> Pattern a
_fastGap k p = case toRatio k of
  (n, d) -> _fastGapR n d p

-- n / d times as fast, at least 1, from each cycle's start, as Tidal's _fastGap
_fastGapR :: Int -> Int -> Pattern a -> Pattern a
_fastGapR n d p = if n == 0 then silence else if n < d then gapBy 1 1 p else gapBy n d p

gapBy :: Int -> Int -> Pattern a -> Pattern a
gapBy n d p = sameMeta p (\qst -> let q = qst.arc in concatMap (\qs -> case div qs.start cycleTicks * cycleTicks of
    c -> case c + min cycleTicks (div ((qs.start - c) * n) d) of
      a -> if a == c + cycleTicks then []
        else concatMap (clipEvent qs . withSpans (gapOut n d)) (queryIn qst p (Span a (c + min cycleTicks (ceilDiv ((qs.stop - c) * n) d))))) (cycleSpans q))

gapOut :: Int -> Int -> Span -> Span
gapOut n d (Span x y) = case div x cycleTicks * cycleTicks of
  c -> Span (c + div ((x - c) * d) n) (c + div ((y - c) * d) n)

-- each cycle squeezed into [s, e) of it, silent elsewhere; 0 <= s < e <= 1
compress :: (Float, Float) -> Pattern a -> Pattern a
compress (s, e) p = compressTicks (ticks s) (ticks e) p

compressTicks :: Int -> Int -> Pattern a -> Pattern a
compressTicks s e p = if s >= e || s < 0 || e > cycleTicks then silence
  else _shift s (_fastGapR cycleTicks (e - s) p)

-- compress, with s in any cycle and e relative to that cycle's start
compressTo :: (Float, Float) -> Pattern a -> Pattern a
compressTo (s, e) p = compress (fract s, e - toFloat (floor s)) p

-- cycle c is n copies of p's cycle c div n
repeatCycles :: Pattern Int -> Pattern a -> Pattern a
repeatCycles np p = innerJoin (mapP (\n -> _repeatCycles n p) np)

_repeatCycles :: Int -> Pattern a -> Pattern a
_repeatCycles n p = cat (replicate n p)

fastRepeatCycles :: Int -> Pattern a -> Pattern a
fastRepeatCycles n p = cat (replicate n p)

-- f p in every nth cycle, the first included
every :: Pattern Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
every np f p = innerJoin (mapP (\n -> _every n f p) np)

_every :: Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
_every n f p = if n == 0 then p else when (\c -> mod c n == 0) f p

-- every, from cycle o of each n
every' :: Pattern Int -> Pattern Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
every' np op f p = joinP (mapP (\n -> joinP (mapP (\o -> _every' n o f p) op)) np)

_every' :: Int -> Int -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
_every' n o f p = when (\c -> mod c n == o) f p

-- f applied once for each n that divides the cycle
foldEvery :: [Int] -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
foldEvery ns f p = foldr (\n acc -> _every n f acc) p ns

-- f p in the cycles whose number passes test
when :: (Int -> Bool) -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
when test f p = case f p of
  fp -> sameMeta p (\qst -> let q = qst.arc in concatMap (\s -> if test (div s.start cycleTicks) then queryIn qst fp s else queryIn qst p s) (cycleSpans q))

-- when, testing the time in cycles where each cycle's queryIn qst starts
whenT :: (Float -> Bool) -> (Pattern a -> Pattern a) -> Pattern a -> Pattern a
whenT test f p = case f p of
  fp -> sameMeta p (\qst -> let q = qst.arc in concatMap (\s -> if test (cycles s.start) then queryIn qst fp s else queryIn qst p s) (cycleSpans q))

-- Controls from outside the pattern, as Tidal's (Core.hs): cF d name is
-- name's value at each query, once a cycle, or d where it is absent or of
-- another kind; the _ forms are silent there, the 0 forms 0. A value set
-- by setF is a pattern, queried with no controls, as Tidal's queryArc.
_cX :: a -> (Ctl -> Maybe a) -> String -> Pattern a
_cX d f name = pattern (\qst -> query (case lookup name qst.controls of
    Just v -> mapP (\x -> fromMaybe d (f x)) (ctlPattern v)
    Nothing -> atom d) qst.arc)

_cX_ :: (Ctl -> Maybe a) -> String -> Pattern a
_cX_ f name = pattern (\qst -> case lookup name qst.controls of
  Just v -> query (mapMaybeP f (ctlPattern v)) qst.arc
  Nothing -> [])

-- Tidal's valueToPattern
ctlPattern :: Ctl -> Pattern Ctl
ctlPattern v = case v of
  CtlP pat -> pat
  _ -> atom v

ctlF :: Ctl -> Maybe Float
ctlF v = case v of
  CtlF x -> Just x
  CtlI i -> Just (toFloat i)
  _ -> Nothing

ctlI :: Ctl -> Maybe Int
ctlI v = case v of
  CtlI i -> Just i
  CtlF x -> Just (floor x)
  _ -> Nothing

ctlS :: Ctl -> Maybe String
ctlS v = case v of
  CtlS x -> Just x
  _ -> Nothing

ctlB :: Ctl -> Maybe Bool
ctlB v = case v of
  CtlB b -> Just b
  _ -> Nothing

cF :: Float -> String -> Pattern Float
cF d name = _cX d ctlF name

cF_ :: String -> Pattern Float
cF_ name = _cX_ ctlF name

cF0 :: String -> Pattern Float
cF0 name = _cX 0.0 ctlF name

cN :: Float -> String -> Pattern Float
cN d name = _cX d ctlF name

cN_ :: String -> Pattern Float
cN_ name = _cX_ ctlF name

cN0 :: String -> Pattern Float
cN0 name = _cX 0.0 ctlF name

cI :: Int -> String -> Pattern Int
cI d name = _cX d ctlI name

cI_ :: String -> Pattern Int
cI_ name = _cX_ ctlI name

cI0 :: String -> Pattern Int
cI0 name = _cX 0 ctlI name

cB :: Bool -> String -> Pattern Bool
cB d name = _cX d ctlB name

cB_ :: String -> Pattern Bool
cB_ name = _cX_ ctlB name

cB0 :: String -> Pattern Bool
cB0 name = _cX False ctlB name

cR :: Float -> String -> Pattern Float
cR d name = _cX d ctlF name

cR_ :: String -> Pattern Float
cR_ name = _cX_ ctlF name

cR0 :: String -> Pattern Float
cR0 name = _cX 0.0 ctlF name

cT :: Float -> String -> Pattern Float
cT d name = cR d name

cT0 :: String -> Pattern Float
cT0 name = cR0 name

cT_ :: String -> Pattern Float
cT_ name = cR_ name

cS :: String -> String -> Pattern String
cS d name = _cX d ctlS name

cS_ :: String -> Pattern String
cS_ name = _cX_ ctlS name

cS0 :: String -> Pattern String
cS0 name = _cX "" ctlS name

