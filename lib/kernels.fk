-- kernels.fk -- the unit generators behind dsp.fk (docs/dev/audio.md, D),
-- compiled ahead of time with `funk emit-c --kernels lib/kernels.fk`.
-- Each has projects/funkgraph's kernel signature: state, inputs, output, frames,
-- context. Inputs read every frame are audio rate; those read once per
-- call, from their first frame, are marked "per call".
foreign export ccall "dsp_const" constK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_add" addK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_mul" mulK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_sine" sineK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_saw" sawK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_square" squareK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_lowpass1" lowpass1K :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_lowpass" lowpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_bandpass" bandpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_highpass" highpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_adsr" adsrK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_noise" noiseK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_saturate" saturateK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_compress" compressK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_adsr_exp" adsrExpK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_delay" delayK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_comb" combK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign export ccall "dsp_allpass" allpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
foreign import ccall "math.h sin" csin :: Float -> Float
foreign import ccall "math.h tan" ctan :: Float -> Float
foreign import ccall "math.h exp" cexp :: Float -> Float
foreign import ccall "math.h tanh" ctanh :: Float -> Float
foreign import ccall "math.h pow" cpow :: Float -> Float -> Float
foreign import ccall "math.h floor" cfloor :: Float -> Float
foreign import ccall "math.h lrint" clrint :: Float -> CLong

-- projects/funkgraph's funk_context
foreign struct Context { rate :: Float }

foreign struct Phase { phase :: Float }
foreign struct Const { value :: Float }
foreign struct Pole { y :: Float }
foreign struct Noise { seed :: Float }
foreign struct Follower { level :: Float }
-- mem and frames come from funk_graph_memory (graph.h); y is comb's damping
foreign struct Line { mem :: Ptr CFloat, frames :: Int, pos :: Int, y :: Float }
foreign struct Svf { ic1 :: Float, ic2 :: Float }
-- stage: 0 idle, 1 attack, 2 decay or sustain, 3 release
foreign struct Env { stage :: Float, level :: Float, gate :: Float }

pi2 :: Float
pi2 = 6.283185307179586

input :: Ptr (Ptr CFloat) -> Int ->> Ptr CFloat
input ins j = peekByteOff ins (8 * j)

at :: Ptr CFloat -> Int ->> Float
at buf i = fromCFloat (peekByteOff buf (4 * i))

put :: Ptr CFloat -> Int -> Float ->> ()
put out i x = pokeByteOff out (4 * i) (toCFloat x)

rateOf :: Ptr Context ->> Float
rateOf cx = readField cx Context.rate

-- a phase in [0, 1) after a step of less than one cycle either way
wrap :: Float -> Float
wrap x = if x >= 1.0 then x - 1.0 else if x < 0.0 then x + 1.0 else x

-- the phase before this frame's step; advances it by freq / rate
step :: Ptr Phase -> Float -> Float ->> Float
step s freq rate = do
  ph <- readField s Phase.phase
  writeField s Phase.phase (wrap (ph + freq / rate))
  ph

-- polyBLEP: the correction near a unit step at phase 0, for a phase
-- advancing dt per frame
blep :: Float -> Float -> Float
blep t dt =
  if dt <= 0.0 then 0.0
  else if t < dt then (let x = t / dt in x + x - x * x - 1.0)
  else if t > 1.0 - dt then (let x = (t - 1.0) / dt in x * x + x + x + 1.0)
  else 0.0

constLoop :: Ptr CFloat -> Float -> Int -> Int ->> ()
constLoop out v i n = if i == n then () else do
  put out i v
  constLoop out v (i + 1) n

-- state: value
constK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
constK st ins out n cx = constLoop out (readField (castPtr st) Const.value) 0 (fromIntegral n)

addLoop :: Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Int -> Int ->> ()
addLoop a b out i n = if i == n then () else do
  put out i (at a i + at b i)
  addLoop a b out (i + 1) n

-- inputs: a, b
addK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
addK st ins out n cx = addLoop (input ins 0) (input ins 1) out 0 (fromIntegral n)

mulLoop :: Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Int -> Int ->> ()
mulLoop a b out i n = if i == n then () else do
  put out i (at a i * at b i)
  mulLoop a b out (i + 1) n

-- inputs: a, b
mulK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
mulK st ins out n cx = mulLoop (input ins 0) (input ins 1) out 0 (fromIntegral n)

sineLoop :: Ptr Phase -> Ptr CFloat -> Ptr CFloat -> Float -> Int -> Int ->> ()
sineLoop s freq out rate i n = if i == n then () else do
  ph <- step s (at freq i) rate
  put out i (csin (pi2 * ph))
  sineLoop s freq out rate (i + 1) n

-- state: phase; inputs: frequency
sineK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
sineK st ins out n cx = sineLoop (castPtr st) (input ins 0) out (rateOf cx) 0 (fromIntegral n)

sawLoop :: Ptr Phase -> Ptr CFloat -> Ptr CFloat -> Float -> Int -> Int ->> ()
sawLoop s freq out rate i n = if i == n then () else do
  dt <- at freq i / rate
  ph <- step s (at freq i) rate
  put out i (2.0 * ph - 1.0 - blep ph dt)
  sawLoop s freq out rate (i + 1) n

-- band-limited by polyBLEP; state: phase; inputs: frequency
sawK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
sawK st ins out n cx = sawLoop (castPtr st) (input ins 0) out (rateOf cx) 0 (fromIntegral n)

squareLoop :: Ptr Phase -> Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Float -> Int -> Int ->> ()
squareLoop s freq width out rate i n = if i == n then () else do
  dt <- at freq i / rate
  w <- at width i
  ph <- step s (at freq i) rate
  v <- if ph < w then 1.0 else -1.0
  put out i (v + blep ph dt - blep (wrap (ph + 1.0 - w)) dt)
  squareLoop s freq width out rate (i + 1) n

-- a pulse, high for width of each cycle, band-limited by polyBLEP; state:
-- phase; inputs: frequency, width in (0, 1)
squareK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
squareK st ins out n cx = squareLoop (castPtr st) (input ins 0) (input ins 1) out (rateOf cx) 0 (fromIntegral n)

poleLoop :: Ptr Pole -> Ptr CFloat -> Float -> Ptr CFloat -> Int -> Int ->> ()
poleLoop s x c out i n = if i == n then () else do
  y <- readField s Pole.y
  y2 <- y + c * (at x i - y)
  writeField s Pole.y y2
  put out i y2
  poleLoop s x c out (i + 1) n

-- a one-pole low-pass; state: y; inputs: signal, cutoff in Hz (per call)
lowpass1K :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
lowpass1K st ins out n cx = do
  c <- 1.0 - cexp (0.0 - pi2 * at (input ins 1) 0 / rateOf cx)
  poleLoop (castPtr st) (input ins 0) c out 0 (fromIntegral n)

-- Cytomic's trapezoidal state-variable filter; mode 0 low-pass, 1
-- band-pass, 2 high-pass
svfLoop :: Ptr Svf -> Int -> Ptr CFloat -> Float -> Float -> Float -> Float -> Ptr CFloat -> Int -> Int ->> ()
svfLoop s mode x k a1 a2 a3 out i n = if i == n then () else do
  v0 <- at x i
  ic1 <- readField s Svf.ic1
  ic2 <- readField s Svf.ic2
  v3 <- v0 - ic2
  v1 <- a1 * ic1 + a2 * v3
  v2 <- ic2 + a2 * ic1 + a3 * v3
  writeField s Svf.ic1 (2.0 * v1 - ic1)
  writeField s Svf.ic2 (2.0 * v2 - ic2)
  put out i (if mode == 0 then v2 else if mode == 1 then v1 else v0 - k * v1 - v2)
  svfLoop s mode x k a1 a2 a3 out (i + 1) n

-- inputs: signal, cutoff in Hz, below half the rate, and Q above 0 (both
-- per call)
svf :: Int -> Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
svf mode st ins out n cx = do
  rate <- rateOf cx
  fc <- min (at (input ins 1) 0) (0.49 * rate)
  g <- ctan (3.141592653589793 * max fc 0.0 / rate)
  k <- 1.0 / max (at (input ins 2) 0) 0.01
  a1 <- 1.0 / (1.0 + g * (g + k))
  svfLoop (castPtr st) mode (input ins 0) k a1 (g * a1) (g * g * a1) out 0 (fromIntegral n)

lowpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
lowpassK st ins out n cx = svf 0 st ins out n cx

bandpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
bandpassK st ins out n cx = svf 1 st ins out n cx

highpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
highpassK st ins out n cx = svf 2 st ins out n cx

-- one frame of the envelope from stage and level: writes both, returns
-- the level; up, down and rel are steps per frame, sus the sustain level
envStep :: Ptr Env -> Float -> Float -> Float -> Float -> Float -> Float ->> Float
envStep s stage level up down sus rel = do
  st2 <- if stage == 1.0 then (if level + up >= 1.0 then 2.0 else 1.0)
         else if stage == 3.0 then (if level - rel <= 0.0 then 0.0 else 3.0)
         else stage
  l2 <- if stage == 1.0 then min 1.0 (level + up)
        else if stage == 2.0 then max sus (level - down)
        else if stage == 3.0 then max 0.0 (level - rel)
        else 0.0
  writeField s Env.stage st2
  writeField s Env.level l2
  l2

-- the stage after the gate's change, if any; records the gate
gateStage :: Ptr Env -> Float ->> Float
gateStage s g = do
  was <- readField s Env.gate
  stage <- readField s Env.stage
  writeField s Env.gate g
  if g > 0.0 && was <= 0.0 then 1.0 else if g <= 0.0 && was > 0.0 then 3.0 else stage

envLoop :: Ptr Env -> Ptr CFloat -> Float -> Float -> Float -> Float -> Ptr CFloat -> Int -> Int ->> ()
envLoop s gate up down sus rel out i n = if i == n then () else do
  g <- at gate i
  st <- gateStage s g
  put out i (envStep s st (readField s Env.level) up down sus rel)
  envLoop s gate up down sus rel out (i + 1) n

-- seconds to a step per frame; an instant step for 0
perFrame :: Float -> Float -> Float -> Float
perFrame span secs rate = if secs <= 0.0 then 2.0 else span / (secs * rate)

-- linear attack, decay and release, restarted by a rising gate; state:
-- stage, level, gate; inputs: gate (above 0 is on), attack and decay in
-- seconds, sustain level, release in seconds from full scale (the last
-- four per call)
adsrK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
adsrK st ins out n cx = do
  rate <- rateOf cx
  sus <- min 1.0 (max 0.0 (at (input ins 3) 0))
  up <- perFrame 1.0 (at (input ins 1) 0) rate
  down <- perFrame (1.0 - sus) (at (input ins 2) 0) rate
  rel <- perFrame 1.0 (at (input ins 4) 0) rate
  envLoop (castPtr st) (input ins 0) up down sus rel out 0 (fromIntegral n)

-- how far an exponential segment gets in its time: to within 1/1000 of its
-- span, 60 dB
expEnd :: Float
expEnd = 0.001

-- below this a decaying level is 0, so it never reaches subnormal numbers
tiny :: Float
tiny = 1.0e-20

-- one frame's factor for a segment of secs seconds to within end of its span
expCoef :: Float -> Float -> Float -> Float
expCoef end secs rate = if secs <= 0.0 then 0.0 else cpow end (1.0 / (secs * rate))

-- as envStep; c* is the distance left after one frame
expStep :: Ptr Env -> Float -> Float -> Float -> Float -> Float -> Float ->> Float
expStep s stage level cup cdown sus crel = do
  top <- 1.0 / (1.0 - expEnd)
  up <- top + (level - top) * cup
  rel <- level * crel
  st2 <- if stage == 1.0 then (if up >= 1.0 then 2.0 else 1.0)
         else if stage == 3.0 then (if rel <= expEnd then 0.0 else 3.0)
         else stage
  l2 <- if stage == 1.0 then min 1.0 up
        else if stage == 2.0 then (let d = (level - sus) * cdown in if d < tiny then sus else sus + d)
        else if stage == 3.0 then (if rel <= expEnd then 0.0 else rel)
        else 0.0
  writeField s Env.stage st2
  writeField s Env.level l2
  l2

expLoop :: Ptr Env -> Ptr CFloat -> Float -> Float -> Float -> Float -> Ptr CFloat -> Int -> Int ->> ()
expLoop s gate cup cdown sus crel out i n = if i == n then () else do
  st <- gateStage s (at gate i)
  put out i (expStep s st (readField s Env.level) cup cdown sus crel)
  expLoop s gate cup cdown sus crel out (i + 1) n

-- adsr's state and inputs, with exponential segments: attack reaches 1 in
-- its time, decay and release get within 60 dB in theirs, and release then
-- drops to 0
adsrExpK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
adsrExpK st ins out n cx = do
  rate <- rateOf cx
  sus <- min 1.0 (max 0.0 (at (input ins 3) 0))
  cup <- expCoef expEnd (at (input ins 1) 0) rate
  cdown <- expCoef expEnd (at (input ins 2) 0) rate
  crel <- expCoef expEnd (at (input ins 4) 0) rate
  expLoop (castPtr st) (input ins 0) cup cdown sus crel out 0 (fromIntegral n)

noiseLoop :: Ptr Noise -> Ptr CFloat -> Int -> Int ->> ()
noiseLoop s out i n = if i == n then () else do
  p <- readField s Noise.seed * 16807.0
  x <- p - 2147483647.0 * cfloor (p / 2147483647.0)
  writeField s Noise.seed x
  put out i (x / 1073741823.5 - 1.0)
  noiseLoop s out (i + 1) n

-- white, uniform in (-1, 1): MINSTD, x' = 16807 x mod (2^31 - 1), whose
-- products stay below 2^46, exact in a Float; state: seed, from 1 to 2^31 - 2
noiseK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
noiseK st ins out n cx = noiseLoop (castPtr st) out 0 (fromIntegral n)

saturateLoop :: Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Int -> Int ->> ()
saturateLoop x drive out i n = if i == n then () else do
  put out i (ctanh (at drive i * at x i))
  saturateLoop x drive out (i + 1) n

-- tanh (drive * signal), within (-1, 1); inputs: signal, drive
saturateK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
saturateK st ins out n cx = saturateLoop (input ins 0) (input ins 1) out 0 (fromIntegral n)

compressLoop :: Ptr Follower -> Ptr CFloat -> Float -> Float -> Float -> Float -> Ptr CFloat -> Int -> Int ->> ()
compressLoop s x thr slope cup cdown out i n = if i == n then () else do
  v <- at x i
  a <- abs v
  was <- readField s Follower.level
  fall <- was * cdown
  -- never below a at an instant attack, which is limit's ceiling
  l <- if a > fall then a + (was - a) * cup else fall
  l2 <- if l < tiny then 0.0 else l
  writeField s Follower.level l2
  put out i (if l2 > thr then v * cpow (l2 / thr) slope else v)
  compressLoop s x thr slope cup cdown out (i + 1) n

-- a feedforward compressor of a peak level; state: level; inputs: signal,
-- threshold in dB, ratio, attack and release time constants in seconds (the
-- last four per call)
compressK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
compressK st ins out n cx = do
  rate <- rateOf cx
  thr <- cpow 10.0 (at (input ins 1) 0 / 20.0)
  slope <- 1.0 / max (at (input ins 2) 0) 1.0 - 1.0
  cup <- expCoef 0.36787944117144233 (at (input ins 3) 0) rate
  cdown <- expCoef 0.36787944117144233 (at (input ins 4) 0) rate
  compressLoop (castPtr st) (input ins 0) thr slope cup cdown out 0 (fromIntegral n)

-- the line's value d frames before pos, between frames by linear
-- interpolation; d is in [1, frames - 2], so both frames read are written ones
tap :: Ptr CFloat -> Int -> Int -> Float ->> Float
tap mem size pos d = do
  -- clamped as an Int: a NaN time must not read outside the memory
  whole <- max 1 (min (size - 2) (fromIntegral (clrint (cfloor d))))
  f <- d - toFloat whole
  a <- pos - whole
  a2 <- if a < 0 then a + size else a
  b <- if a2 == 0 then size - 1 else a2 - 1
  at mem a2 * (1.0 - f) + at mem b * f

-- seconds to frames a tap can read
tapFrames :: Int -> Float -> Float -> Float
tapFrames size secs rate = min (max (secs * rate) 1.0) (toFloat size - 2.0)

-- x stored at pos, in the line's memory; a small value is stored as 0, so a
-- decaying tail never reaches subnormal numbers
store :: Ptr Line -> Ptr CFloat -> Int -> Int -> Float ->> ()
store s mem size pos x = do
  put mem pos (if abs x < tiny then 0.0 else x)
  writeField s Line.pos (if pos + 1 == size then 0 else pos + 1)

-- a gain that keeps feedback stable
stable :: Float -> Float
stable g = min (max g (-0.999)) 0.999

delayLoop :: Ptr Line -> Ptr CFloat -> Ptr CFloat -> Float -> Ptr CFloat -> Int -> Int ->> ()
delayLoop s x time rate out i n = if i == n then () else do
  mem <- readField s Line.mem
  size <- readField s Line.frames
  pos <- readField s Line.pos
  put out i (tap mem size pos (tapFrames size (at time i) rate))
  store s mem size pos (at x i)
  delayLoop s x time rate out (i + 1) n

-- inputs: signal, time in seconds; at least one frame
delayK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
delayK st ins out n cx = delayLoop (castPtr st) (input ins 0) (input ins 1) (rateOf cx) out 0 (fromIntegral n)

combLoop :: Ptr Line -> Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Float -> Ptr CFloat -> Int -> Int ->> ()
combLoop s x time fb damp rate out i n = if i == n then () else do
  mem <- readField s Line.mem
  size <- readField s Line.frames
  pos <- readField s Line.pos
  v <- tap mem size pos (tapFrames size (at time i) rate)
  d <- min (max (at damp i) 0.0) 0.999
  y <- v * (1.0 - d) + readField s Line.y * d
  writeField s Line.y (if abs y < tiny then 0.0 else y)
  put out i v
  store s mem size pos (at x i + stable (at fb i) * y)
  combLoop s x time fb damp rate out (i + 1) n

-- a feedback comb, with a one-pole low-pass in its loop; inputs: signal,
-- time in seconds, feedback within (-1, 1), damping in [0, 1)
combK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
combK st ins out n cx = combLoop (castPtr st) (input ins 0) (input ins 1) (input ins 2) (input ins 3) (rateOf cx) out 0 (fromIntegral n)

allpassLoop :: Ptr Line -> Ptr CFloat -> Ptr CFloat -> Ptr CFloat -> Float -> Ptr CFloat -> Int -> Int ->> ()
allpassLoop s x time gain rate out i n = if i == n then () else do
  mem <- readField s Line.mem
  size <- readField s Line.frames
  pos <- readField s Line.pos
  z <- tap mem size pos (tapFrames size (at time i) rate)
  g <- stable (at gain i)
  w <- at x i + g * z
  put out i (z - g * w)
  store s mem size pos w
  allpassLoop s x time gain rate out (i + 1) n

-- Schroeder's allpass; inputs: signal, time in seconds, gain within (-1, 1)
allpassK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
allpassK st ins out n cx = allpassLoop (castPtr st) (input ins 0) (input ins 1) (input ins 2) (rateOf cx) out 0 (fromIntegral n)
