-- MembraneHexagon (sc3-plugins' Membrane.cpp): a waveguide mesh of 19
-- junctions, the excitation spread over the first 9, the output junction
-- 0's. Inputs excitation (audio), tension, loss. The constructor runs a
-- frame. Slots (lib/scsynth.fk's membraneState): started; per junction
-- its input count, self loop, 6 input and 6 output delays; per delay a, b
-- and c; per delay whether it inverts, a rim's.
uMembraneK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uMembraneK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    membraneRun st b ins out 1
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else membraneRun st b ins out (fromIntegral n)

membraneRun :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr CFloat -> Int ->> ()
membraneRun st b ins out n = do
  t0 <- in0 ins 1
  t <- if t0 == 0.0 then f32 0.0001 else t0
  -- 2 DELTA^2 / (tension^2 GAMMA^2), DELTA 6 and GAMMA 8
  yj <- f32 (72.0 / f32 (f32 (f32 (t * t) * 8.0) * 8.0))
  loss <- if in0 ins 2 >= 1.0 then f32 0.99999 else in0 ins 2
  membraneLoop st b (input ins 0) yj (f32 (1.0 / yj)) loss out 0 n

membraneLoop :: Ptr () -> Int -> Ptr CFloat -> Float -> Float -> Float -> Ptr CFloat -> Int -> Int ->> ()
membraneLoop st b x yj yjr loss out k n = if k == n then () else do
  put out k (membraneJunctions st b (at x k) yj yjr loss 0 0.0)
  membraneCirculate st b 0
  membraneLoop st b x yj yjr loss out (k + 1) n

-- delay d's slot: a, b or c by j
mdel :: Int -> Int -> Int -> Int
mdel b d j = b + 267 + 3 * d + j

-- cycle's junctions: the output is junction 0's total
membraneJunctions :: Ptr () -> Int -> Float -> Float -> Float -> Float -> Int -> Float ->> Float
membraneJunctions st b input yj yjr loss i result = if i == 19 then result else do
  jb <- b + 1 + 14 * i
  nin <- cInt (slot st jb)
  self <- cInt (slot st (jb + 1))
  sum <- membraneSum st b jb 0 nin 0.0
  yc <- f32 (yj - toFloat nin)
  t1 <- f32 (f32 (2.0 * fromCFloat (cfmaf (toCFloat yc) (toCFloat (slot st (mdel b self 1))) (toCFloat sum))) * yjr)
  t2 <- f32 ((if i < 9 then f32 (t1 + f32 (input / 9.0)) else t1) * loss)
  membraneOuts st b jb 0 nin t2
  setSlot st (mdel b self 0) (f32 (t2 - slot st (mdel b self 1)))
  membraneJunctions st b input yj yjr loss (i + 1) (if i == 0 then t2 else result)

membraneSum :: Ptr () -> Int -> Int -> Int -> Int -> Float ->> Float
membraneSum st b jb j nin acc = if j == nin then acc
  else membraneSum st b jb (j + 1) nin (f32 (acc + slot st (mdel b (cInt (slot st (jb + 2 + j))) 1)))

membraneOuts :: Ptr () -> Int -> Int -> Int -> Int -> Float ->> ()
membraneOuts st b jb j nin total = if j == nin then () else do
  setSlot st (mdel b (cInt (slot st (jb + 8 + j))) 0) (f32 (total - slot st (mdel b (cInt (slot st (jb + 2 + j))) 1)))
  membraneOuts st b jb (j + 1) nin total

-- the unit delays step; a rim's inverts through RIMFILTER's average
membraneCirculate :: Ptr () -> Int -> Int ->> ()
membraneCirculate st b d = if d == 115 then () else do
  a <- slot st (mdel b d 0)
  if slot st (b + 612 + d) /= 0.0 then do
    setSlot st (mdel b d 1) (f32 (f32 (f32 (0.0 - a) + slot st (mdel b d 2)) * 0.5))
    setSlot st (mdel b d 2) (f32 (0.0 - a))
  else setSlot st (mdel b d 1) a
  membraneCirculate st b (d + 1)

-- AY (sc3-plugins' AYUGens: libayemu 0.9's ay8912.c), mono and 8-bit as
-- AY_Ctor sets it, in integers. Inputs tonea, toneb, tonec, noise, control,
-- vola, volb, volc, envfreq, envstyle, chiptype (1 YM, else AY). Each call
-- writes the registers, which restarts the envelope unless envstyle is
-- 255, and generates scsynth's 64 frames whatever n is: the constructor's
-- call too. Slots: started; counters a, b, c, noise and envelope; bits a,
-- b, c and noise; the envelope's position; the noise seed, an int32; the
-- envelope's style; chip tacts per frame; Amp_Global; the left mix's
-- volumes of A, B and C, 32 each; then this call's registers: tones a, b
-- and c, noise, tone and noise enables of a, b and c, volumes, envelope
-- flags, envelope period.
uAYK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uAYK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    ayInit st b (cInt (in0 ins 10) == 1) (cInt (rateOf cx))
    ayBlock st b ins out (fromIntegral n)
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else ayBlock st b ins out (fromIntegral n)

-- the volume tables (c) V_Soft and Lion 17
ayLion :: Int -> Int
ayLion i = case i of
  0 -> 0
  1 -> 513
  2 -> 828
  3 -> 1239
  4 -> 1923
  5 -> 3238
  6 -> 4926
  7 -> 9110
  8 -> 10344
  9 -> 17876
  10 -> 24682
  11 -> 30442
  12 -> 38844
  13 -> 47270
  14 -> 56402
  _ -> 65535

ymLion :: Int -> Int
ymLion i = case i of
  0 -> 0
  1 -> 0
  2 -> 190
  3 -> 286
  4 -> 375
  5 -> 470
  6 -> 560
  7 -> 664
  8 -> 866
  9 -> 1130
  10 -> 1515
  11 -> 1803
  12 -> 2253
  13 -> 2848
  14 -> 3351
  15 -> 3862
  16 -> 4844
  17 -> 6058
  18 -> 7290
  19 -> 8559
  20 -> 10474
  21 -> 12878
  22 -> 15297
  23 -> 17787
  24 -> 21500
  25 -> 26172
  26 -> 30866
  27 -> 35676
  28 -> 42664
  29 -> 50986
  30 -> 58842
  _ -> 65535

-- default_layout's ABC, the stereo ayemu_gen_sound defaults to: A_l, A_r,
-- B_l, B_r, C_l, C_r
ayEq :: Bool -> Int -> Int
ayEq ym m = case m of
  0 -> 100
  1 -> if ym then 5 else 33
  2 -> 70
  3 -> 70
  4 -> if ym then 5 else 33
  _ -> 100

-- vols[m][n], an int of a double
ayVol :: Bool -> Int -> Int -> Int
ayVol ym m i = cInt (toFloat (if ym then ymLion i else ayLion (div i 2)) * toFloat (ayEq ym m) / 100.0)

-- ayemu_init, ayemu_set_chip_type and prepare_generation
ayInit :: Ptr () -> Int -> Bool -> Int ->> ()
ayInit st b ym rate = do
  ayZero st (b + 1) 10
  setSlot st (b + 11) 65535.0
  setSlot st (b + 12) 0.0
  -- ChipFreq / freq / 8, in ints
  tacts <- div (cInt (cfloor (1773400.0 / toFloat rate))) 8
  setSlot st (b + 13) (toFloat tacts)
  -- max_l reads vols[3], as ay8912.c does
  ml <- ayVol ym 0 31 + ayVol ym 2 31 + ayVol ym 3 31
  mr <- ayVol ym 1 31 + ayVol ym 3 31 + ayVol ym 5 31
  setSlot st (b + 14) (toFloat (div (tacts * max ml mr) 24575))
  ayVols st b ym 0

ayZero :: Ptr () -> Int -> Int ->> ()
ayZero st k c = if c == 0 then () else do
  setSlot st k 0.0
  ayZero st (k + 1) (c - 1)

ayVols :: Ptr () -> Int -> Bool -> Int ->> ()
ayVols st b ym i = if i == 32 then () else do
  setSlot st (b + 15 + i) (toFloat (ayVol ym 0 i))
  setSlot st (b + 47 + i) (toFloat (ayVol ym 2 i))
  setSlot st (b + 79 + i) (toFloat (ayVol ym 4 i))
  ayVols st b ym (i + 1)

ayClamp :: Int -> Int -> Float -> Int
ayClamp lo hi x = max lo (min (cInt x) hi)

-- AY_next and ayemu_set_regs, then ayemu_gen_sound's 64 frames
ayBlock :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr CFloat -> Int ->> ()
ayBlock st b ins out n = do
  setSlot st (b + 111) (toFloat (ayClamp 0 4095 (in0 ins 0)))
  setSlot st (b + 112) (toFloat (ayClamp 0 4095 (in0 ins 1)))
  setSlot st (b + 113) (toFloat (ayClamp 0 4095 (in0 ins 2)))
  setSlot st (b + 114) (toFloat (cInt (in0 ins 3) .&. 31))
  control <- cInt (in0 ins 4)
  setSlot st (b + 115) (toFloat (control .&. 1))
  setSlot st (b + 116) (toFloat (control .&. 2))
  setSlot st (b + 117) (toFloat (control .&. 4))
  setSlot st (b + 118) (toFloat (control .&. 8))
  setSlot st (b + 119) (toFloat (control .&. 16))
  setSlot st (b + 120) (toFloat (control .&. 32))
  va <- ayClamp 0 31 (in0 ins 5)
  vb <- ayClamp 0 31 (in0 ins 6)
  vc <- ayClamp 0 31 (in0 ins 7)
  setSlot st (b + 121) (toFloat (va .&. 15))
  setSlot st (b + 122) (toFloat (vb .&. 15))
  setSlot st (b + 123) (toFloat (vc .&. 15))
  setSlot st (b + 124) (toFloat (va .&. 16))
  setSlot st (b + 125) (toFloat (vb .&. 16))
  setSlot st (b + 126) (toFloat (vc .&. 16))
  setSlot st (b + 127) (toFloat (ayClamp 0 4095 (in0 ins 8)))
  style <- cInt (in0 ins 9) .&. 255
  if style /= 255 then do
    setSlot st (b + 12) (toFloat (style .&. 15))
    setSlot st (b + 10) 0.0
    setSlot st (b + 5) 0.0
  else ()
  ayFrames st b out 0 n (cInt (slot st (b + 13))) (cInt (slot st (b + 14)))

ayFrames :: Ptr () -> Int -> Ptr CFloat -> Int -> Int -> Int -> Int ->> ()
ayFrames st b out i n tacts amp = if i == 64 then () else do
  mix <- ayTacts st b tacts 0
  -- mix_l / Amp_Global of non-negative ints, then the 8-bit sample
  v <- cInt (cfloor (toFloat mix / toFloat amp))
  byte <- (shiftR v 8 .|. 128) .&. 255
  if i < n then put out i (f32 (toFloat (byte - 128) * 0.0078125)) else ()
  ayFrames st b out (i + 1) n tacts amp

-- a counter's step: 1 when it reaches its period, and restarts
ayCount :: Ptr () -> Int -> Int ->> Bool
ayCount st k period = do
  c <- cInt (slot st k) + 1
  if c >= period then do
    setSlot st k 0.0
    True
  else do
    setSlot st k (toFloat c)
    False

ayFlip :: Ptr () -> Int ->> ()
ayFlip st k = setSlot st k (if slot st k == 0.0 then 1.0 else 0.0)

ayTacts :: Ptr () -> Int -> Int -> Int ->> Int
ayTacts st b m mix = if m == 0 then mix else do
  if ayCount st (b + 1) (cInt (slot st (b + 111))) then ayFlip st (b + 6) else ()
  if ayCount st (b + 2) (cInt (slot st (b + 112))) then ayFlip st (b + 7) else ()
  if ayCount st (b + 3) (cInt (slot st (b + 113))) then ayFlip st (b + 8) else ()
  if ayCount st (b + 4) (cInt (slot st (b + 114)) * 2) then do
    seed <- cInt (slot st (b + 11))
    next <- ayInt32 (xor (seed * 2 + 1) ((xor (shiftR seed 16) (shiftR seed 13)) .&. 1))
    setSlot st (b + 11) (toFloat next)
    setSlot st (b + 9) (toFloat (shiftR next 16 .&. 1))
  else ()
  if ayCount st (b + 5) (cInt (slot st (b + 127))) then do
    pos <- cInt (slot st (b + 10)) + 1
    setSlot st (b + 10) (toFloat (if pos > 127 then 64 else pos))
  else ()
  env <- ayEnvelope (cInt (slot st (b + 12))) (cInt (slot st (b + 10)))
  ayTacts st b (m - 1) (mix + ayChannel st b 0 env + ayChannel st b 1 env + ayChannel st b 2 env)

-- channel c's left volume this tact, or 0 when its tone or noise gates it
ayChannel :: Ptr () -> Int -> Int -> Int ->> Int
ayChannel st b c env = do
  tone <- slot st (b + 6 + c) /= 0.0 || slot st (b + 115 + c) == 0.0
  noise <- slot st (b + 9) /= 0.0 || slot st (b + 118 + c) == 0.0
  if tone && noise then cInt (slot st (b + 15 + 32 * c + (if slot st (b + 124 + c) /= 0.0 then env else cInt (slot st (b + 121 + c)) * 2 + 1)))
  else 0

-- an int32's wrap of x
ayInt32 :: Int -> Int
ayInt32 x = case x .&. 4294967295 of
  w -> if w >= 2147483648 then w - 4294967296 else w

-- gen_env's Envelope[style][pos], closed form: the first 32 positions ramp
-- up (style bit 4) or down; then 0 without continue (8); hold (1) keeps
-- the end, alternate (2) flips each later ramp
ayEnvelope :: Int -> Int -> Int
ayEnvelope style pos = if pos < 32 then (if style .&. 4 /= 0 then pos else 31 - pos)
  else if style .&. 8 == 0 then 0
  else if style .&. 1 /= 0 then (if (style .&. 4 /= 0) /= (style .&. 2 /= 0) then 31 else 0)
  else case pos .&. 31 of
    p -> if (style .&. 4 /= 0) /= (style .&. 2 /= 0 && (shiftR pos 5) .&. 1 == 1) then p else 31 - p

-- FM7 (sc3-plugins' SkUGens/FM7.cpp): six phase-modulated sine operators,
-- output j at out + j n (funk_graph_outputs). Inputs: each operator's freq,
-- phase and amp, then the 6 x 6 modulation matrix, row i operator i's.
-- next_kk ramps the matrix over a call, next_ki, for a scalar matrix, keeps
-- the constructor's; both ramp freq, phase and amp. The constructor runs
-- next_ki for one frame. Slots: started; per operator phase (a uint32),
-- freq, phasemod, amp, mem; the matrix; per operator the three slopes; the
-- matrix's slopes; each operator's phase modulation this frame.
uFM7K :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uFM7K st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    fm7Init st b ins 0
    fm7Block st b ins cx out 1 False
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else fm7Block st b ins cx out (fromIntegral n) (fm7Ramps st 18)

-- whether a matrix input is not scalar: next_kk
fm7Ramps :: Ptr () -> Int ->> Bool
fm7Ramps st j = if j == 54 then False else if ugInRate st j /= 0.0 then True else fm7Ramps st (j + 1)

fm7Init :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Int ->> ()
fm7Init st b ins i = if i == 6 then fm7Copy st (b + 31) ins 18 36 else do
  o <- b + 1 + 5 * i
  setSlot st o 0.0
  setSlot st (o + 1) (in0 ins (3 * i))
  setSlot st (o + 2) (in0 ins (3 * i + 1))
  setSlot st (o + 3) (in0 ins (3 * i + 2))
  setSlot st (o + 4) 0.0
  fm7Init st b ins (i + 1)

fm7Copy :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Int -> Int ->> ()
fm7Copy st k ins j c = if c == 0 then () else do
  setSlot st k (in0 ins j)
  fm7Copy st (k + 1) ins (j + 1) (c - 1)

fm7Block :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr Context -> Ptr CFloat -> Int -> Bool ->> ()
fm7Block st b ins cx out n kk = do
  -- the constructor's doubles, read as floats
  cps <- f32 (8192.0 * (1.0 / rateOf cx) * 65536.0)
  rad <- f32 (8192.0 * (1.0 / 6.283185307179586) * 65536.0)
  fm7Slopes st b ins 0
  if kk then fm7ModSlopes st b ins 0 else ()
  fm7Loop (tables cx) st b cps rad kk out 0 n

-- CALCSLOPE of freq, phase and amp
fm7Slopes :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Int ->> ()
fm7Slopes st b ins i = if i == 6 then () else do
  o <- b + 1 + 5 * i
  setSlot st (b + 67 + 3 * i) (f32 (f32 (in0 ins (3 * i) - slot st (o + 1)) * slopeFactor))
  setSlot st (b + 68 + 3 * i) (f32 (f32 (in0 ins (3 * i + 1) - slot st (o + 2)) * slopeFactor))
  setSlot st (b + 69 + 3 * i) (f32 (f32 (in0 ins (3 * i + 2) - slot st (o + 3)) * slopeFactor))
  fm7Slopes st b ins (i + 1)

fm7ModSlopes :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Int ->> ()
fm7ModSlopes st b ins k = if k == 36 then () else do
  setSlot st (b + 85 + k) (f32 (f32 (in0 ins (18 + k) - slot st (b + 31 + k)) * slopeFactor))
  fm7ModSlopes st b ins (k + 1)

fm7Loop :: Ptr () -> Ptr () -> Int -> Float -> Float -> Bool -> Ptr CFloat -> Int -> Int ->> ()
fm7Loop tb st b cps rad kk out s n = if s == n then () else do
  fm7Mods st b 0
  fm7Ops tb st b cps rad out s n 0
  if kk then fm7ModStep st b 0 else ()
  fm7Loop tb st b cps rad kk out (s + 1) n

-- FM7_MOD_NEXT: phasemod plus the matrix row times the last frame's mems
fm7Mods :: Ptr () -> Int -> Int ->> ()
fm7Mods st b i = if i == 6 then () else do
  setSlot st (b + 121 + i) (fm7Sum st b i 0 (slot st (b + 3 + 5 * i)))
  fm7Mods st b (i + 1)

fm7Sum :: Ptr () -> Int -> Int -> Int -> Float ->> Float
fm7Sum st b i j acc = if j == 6 then acc
  else fm7Sum st b i (j + 1) (f32 (acc + f32 (slot st (b + 31 + 6 * i + j) * slot st (b + 5 + 5 * j))))

-- FM7_OP_NEXT
fm7Ops :: Ptr () -> Ptr () -> Int -> Float -> Float -> Ptr CFloat -> Int -> Int -> Int ->> ()
fm7Ops tb st b cps rad out s n i = if i == 6 then () else do
  o <- b + 1 + 5 * i
  ph <- slot st o
  m <- f32 (slot st (o + 3) * sineOsc tb (wrap32 (ph + toFloat (cInt (f32 (slot st (b + 121 + i) * rad))))))
  setSlot st (o + 4) m
  put out (i * n + s) m
  setSlot st o (wrap32 (ph + toFloat (cInt (f32 (slot st (o + 1) * cps)))))
  setSlot st (o + 1) (f32 (slot st (o + 1) + slot st (b + 67 + 3 * i)))
  setSlot st (o + 2) (f32 (slot st (o + 2) + slot st (b + 68 + 3 * i)))
  setSlot st (o + 3) (f32 (slot st (o + 3) + slot st (b + 69 + 3 * i)))
  fm7Ops tb st b cps rad out s n (i + 1)

fm7ModStep :: Ptr () -> Int -> Int ->> ()
fm7ModStep st b k = if k == 36 then () else do
  setSlot st (b + 31 + k) (f32 (slot st (b + 31 + k) + slot st (b + 85 + k)))
  fm7ModStep st b (k + 1)

-- GVerb (ReverbUGens.cpp), output 0 the left, 1 the right at out + n
-- (funk_graph_outputs): Juhan Nasa's reverb, its
-- delay lines in the node's memory: the tap delay's 44000 frames, four
-- of (int) maxdelay + 1000, then eight diffusers. Its first call runs
-- every setter, since its constructor zeroes the levels; set_roomsize
-- truncates the lengths its constructor rounded, and set_revtime then
-- recomputes alpha in floats. Inputs in, roomsize, revtime, damping,
-- inputbw, spread, drylevel, earlyreflevel, taillevel, maxroomsize. The
-- state starts with the memory's two slots, then the header; slots
-- (gvSlot): started, the parameters, lengths, gains, slopes, taps,
-- u, f, d, dampers, delay indices and sizes, the diffusers.
uGVerbK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uGVerbK st ins out n cx = do
  mem <- readField (castPtr st :: Ptr Memory) Memory.mem
  b <- 7 + cInt (slot st 6)
  rate <- rateOf cx
  if slot st b == 0.0 then do
    gverbCtor st b mem ins rate
    put out 0 0.0
    put out (fromIntegral n) 0.0
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else do
    if in0 ins 1 /= slot st (b + 1) || in0 ins 2 /= slot st (b + 2) || in0 ins 3 /= slot st (b + 3) || in0 ins 4 /= slot st (b + 4)
      || in0 ins 6 /= slot st (b + 5) || in0 ins 7 /= slot st (b + 6) || in0 ins 8 /= slot st (b + 7) then gverbSet st b ins rate
    else do
      -- unchanged, the levels are the inputs'
      setSlot st (b + 102) (slot st (b + 5))
      setSlot st (b + 103) (slot st (b + 6))
      setSlot st (b + 104) (slot st (b + 7))
    gverbLoop st b mem (input ins 0) (slot st (b + 102)) (slot st (b + 103)) (slot st (b + 104)) out 0 (fromIntegral n)
    gvZero st (b + 19) 4
    gvZero st (b + 31) 4
    setSlot st (b + 99) 0.0
    setSlot st (b + 100) 0.0
    setSlot st (b + 101) 0.0

gvZero :: Ptr () -> Int -> Int ->> ()
gvZero st k c = if c == 0 then () else do
  setSlot st k 0.0
  gvZero st (k + 1) (c - 1)

-- f_round: to nearest, ties to even, as the float trick does
fRound :: Float -> Int
fRound x = cInt (clrintF x)

clrintF :: Float -> Float
clrintF x = toFloat (fromIntegral (clrint x))

isPrime :: Int -> Bool
isPrime m = if m == 2 then True else if mod m 2 == 0 then False else primeFrom m 3 (cInt (f32 (csqrt (toFloat m))))

primeFrom :: Int -> Int -> Int -> Bool
primeFrom m i lim = if i > lim then True else if m - i * cInt (cfloor (toFloat m / toFloat i)) == 0 then False else primeFrom m (i + 2) lim

nearestPrime :: Int -> Int ->> Int
nearestPrime m bound = if isPrime m then m else primeNear m 1 bound

primeNear :: Int -> Int -> Int ->> Int
primeNear m k bound = if k > bound then -1 else if isPrime (m + k) then m + k else if isPrime (m - k) then m - k else primeNear m (k + 1) bound

gverbCtor :: Ptr () -> Int -> Ptr CFloat -> Ptr (Ptr CFloat) -> Float ->> ()
gverbCtor st b mem ins rate = do
  setSlot st (b + 1) (in0 ins 1)
  setSlot st (b + 2) (in0 ins 2)
  setSlot st (b + 3) (in0 ins 3)
  setSlot st (b + 4) 0.0
  spread <- in0 ins 5
  setSlot st (b + 5) 0.0
  setSlot st (b + 6) 0.0
  setSlot st (b + 7) 0.0
  setSlot st (b + 8) (in0 ins 9)
  maxd <- f32 (rate * in0 ins 9 / f32 340.0)
  ld <- f32 (rate * in0 ins 1 / f32 340.0)
  setSlot st (b + 9) ld
  setSlot st (b + 47) 1.0
  setSlot st (b + 48) 0.0
  n0 <- f32 (rate * in0 ins 2)
  alpha <- cpow (f32 0.001) (1.0 / n0)
  setSlot st (b + 10) alpha
  setSlot st (b + 11) (toFloat (nearestPrime (cInt (f32 (1.0 * ld))) (cInt (toFloat (cInt (f32 (1.0 * ld))) * 0.5))))
  setSlot st (b + 12) (toFloat (fRound (f32 (f32 0.81649 * ld))))
  setSlot st (b + 13) (toFloat (fRound (f32 (f32 0.7071 * ld))))
  setSlot st (b + 14) (toFloat (fRound (f32 (f32 0.63245 * ld))))
  gvGains st b 0 alpha False
  -- the fdn lines: sized by their lengths, in memory of maxdelay + 1000
  setSlot st (b + 66) (toFloat (cInt maxd + 1000))
  gvLines st b 0
  gvDamps st b 0 (in0 ins 3)
  diffscale <- f32 (slot st (b + 14) / 1341.0)
  base <- 44000 + 4 * cInt (slot st (b + 66))
  aL1 <- cInt (f32 (spread * f32 0.125541))
  aL2 <- cInt (f32 (f32 (3.0 * spread) * f32 0.854046))
  aR1 <- cInt (f32 (spread * f32 (-0.568366)))
  aR2 <- cInt (f32 (f32 (3.0 * spread) * f32 (-0.126815)))
  o1 <- gvDiff st b 0 base (fRound (f32 (diffscale * 210.0))) 0.75
  o2 <- gvDiff st b 1 o1 (fRound (f32 (diffscale * toFloat (369 + aL1 - 210)))) 0.75
  o3 <- gvDiff st b 2 o2 (fRound (f32 (diffscale * toFloat (931 + aL2 - (369 + aL1))))) 0.625
  o4 <- gvDiff st b 3 o3 (fRound (f32 (diffscale * toFloat (1341 - (931 + aL2))))) 0.625
  o5 <- gvDiff st b 4 o4 (fRound (f32 (diffscale * 210.0))) 0.75
  o6 <- gvDiff st b 5 o5 (fRound (f32 (diffscale * toFloat (369 + aR1 - 210)))) 0.75
  o7 <- gvDiff st b 6 o6 (fRound (f32 (diffscale * toFloat (931 + aR2 - (369 + aR1))))) 0.625
  o8 <- gvDiff st b 7 o7 (fRound (f32 (diffscale * toFloat (1341 - (931 + aR2))))) 0.625
  gvTaps st b ld
  gvTapGains st b 0 alpha False
  setSlot st (b + 57) 0.0
  setSlot st (b + 99) 0.0
  setSlot st (b + 100) 0.0
  setSlot st (b + 101) 0.0
  silence mem 0 (o8 - 0)

gvTaps :: Ptr () -> Int -> Float ->> ()
gvTaps st b ld = do
  setSlot st (b + 23) (toFloat (5 + cInt (0.41 * ld)))
  setSlot st (b + 24) (toFloat (5 + cInt (0.3 * ld)))
  setSlot st (b + 25) (toFloat (5 + cInt (0.155 * ld)))
  setSlot st (b + 26) 5.0

-- the fdn gains -(alpha ^ len), each slope the change from the last
gvGains :: Ptr () -> Int -> Int -> Float -> Bool ->> ()
gvGains st b j alpha slope = if j == 4 then () else do
  old <- slot st (b + 15 + j)
  -- in doubles: scsynth's powf of an int exponent rounds as pow does, where libm's powf can miss
  g <- f32 (0.0 - f32 (cpow (f32 alpha) (slot st (b + 11 + j))))
  setSlot st (b + 15 + j) g
  if slope then setSlot st (b + 19 + j) (f32 (f32 (g - old) * f32 slopeFactor)) else ()
  gvGains st b (j + 1) alpha slope

gvTapGains :: Ptr () -> Int -> Int -> Float -> Bool ->> ()
gvTapGains st b j alpha slope = if j == 4 then () else do
  old <- slot st (b + 27 + j)
  g <- f32 (cpow alpha (slot st (b + 23 + j)))
  setSlot st (b + 27 + j) g
  if slope then setSlot st (b + 31 + j) (f32 (f32 (g - old) * f32 slopeFactor)) else ()
  gvTapGains st b (j + 1) alpha slope

gvLines :: Ptr () -> Int -> Int ->> ()
gvLines st b j = if j == 4 then () else do
  setSlot st (b + 58 + j) 0.0
  setSlot st (b + 62 + j) (slot st (b + 11 + j))
  gvLines st b (j + 1)

gvDamps :: Ptr () -> Int -> Int -> Float ->> ()
gvDamps st b j d = if j == 4 then () else do
  setSlot st (b + 49 + j) d
  setSlot st (b + 53 + j) 0.0
  gvDamps st b (j + 1) d

-- diffuser k at memory offset off: offset, size, coef, idx; the next offset
gvDiff :: Ptr () -> Int -> Int -> Int -> Int -> Float ->> Int
gvDiff st b k off size coef = do
  setSlot st (b + 67 + 4 * k) (toFloat off)
  setSlot st (b + 68 + 4 * k) (toFloat size)
  setSlot st (b + 69 + 4 * k) coef
  setSlot st (b + 70 + 4 * k) 0.0
  off + size

-- GVerb_next's setters, in its order
gverbSet :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Float ->> ()
gverbSet st b ins rate = do
  a <- in0 ins 1
  maxr <- slot st (b + 8)
  room <- if a <= 1.0 || not (a == a) then 1.0 else if a >= maxr then f32 (maxr - 1.0) else a
  setSlot st (b + 1) room
  ld <- f32 (rate * room / 340.0)
  setSlot st (b + 9) ld
  setSlot st (b + 12) (toFloat (cInt (0.81649 * ld)))
  setSlot st (b + 13) (toFloat (cInt (0.7071 * ld)))
  setSlot st (b + 14) (toFloat (cInt (0.63245 * ld)))
  gvGains st b 0 (slot st (b + 10)) True
  gvTaps st b ld
  gvTapGains st b 0 (slot st (b + 10)) True
  rt <- in0 ins 2
  setSlot st (b + 2) rt
  alpha <- powf (f32 0.001) (f32 (1.0 / (rate * rt)))
  setSlot st (b + 10) alpha
  gvGains st b 0 alpha True
  setSlot st (b + 3) (in0 ins 3)
  gvSetDamp st b 0 (in0 ins 3)
  setSlot st (b + 4) (in0 ins 4)
  setSlot st (b + 47) (f32 (1.0 - in0 ins 4))
  -- the levels ramp from their last values, which the loop starts from
  setSlot st (b + 102) (slot st (b + 5))
  setSlot st (b + 103) (slot st (b + 6))
  setSlot st (b + 104) (slot st (b + 7))
  setSlot st (b + 101) (f32 (f32 (in0 ins 6 - slot st (b + 5)) * f32 slopeFactor))
  setSlot st (b + 99) (f32 (f32 (in0 ins 7 - slot st (b + 6)) * f32 slopeFactor))
  setSlot st (b + 100) (f32 (f32 (in0 ins 8 - slot st (b + 7)) * f32 slopeFactor))
  setSlot st (b + 5) (in0 ins 6)
  setSlot st (b + 6) (in0 ins 7)
  setSlot st (b + 7) (in0 ins 8)

gvSetDamp :: Ptr () -> Int -> Int -> Float ->> ()
gvSetDamp st b j d = if j == 4 then () else do
  setSlot st (b + 49 + j) d
  gvSetDamp st b (j + 1) d

-- damper_do of the damper whose damping and delay are slots k and k + 1
gvDamper :: Ptr () -> Int -> Int -> Float ->> Float
gvDamper st k kd x = do
  d <- slot st k
  y <- f32 (x * (1.0 - d) + f32 (slot st kd * d))
  setSlot st kd (zap y)
  y

-- diffuser_do of diffuser k
gvDiffuse :: Ptr () -> Int -> Ptr CFloat -> Int -> Float ->> Float
gvDiffuse st b mem k x = do
  off <- cInt (slot st (b + 67 + 4 * k))
  size <- cInt (slot st (b + 68 + 4 * k))
  coef <- slot st (b + 69 + 4 * k)
  idx <- cInt (slot st (b + 70 + 4 * k))
  v <- at mem (off + idx)
  w0 <- f32 (x - f32 (v * coef))
  w <- if abs w0 < 3.8518598887744717e-34 then 0.0 else w0
  y <- f32 (v + f32 (w * coef))
  put mem (off + idx) (zap w)
  setSlot st (b + 70 + 4 * k) (toFloat (if idx + 1 >= size then 0 else idx + 1))
  y

-- fixeddelay_read and _write of the line at offset off, size, index slot ki
gvRead :: Ptr CFloat -> Int -> Int -> Int -> Int ->> Float
gvRead mem off size idx m = at mem (off + wrapIndex (idx - m + size) size)

gvWrite :: Ptr () -> Ptr CFloat -> Int -> Int -> Int -> Float ->> ()
gvWrite st mem off size ki x = do
  idx <- cInt (slot st ki)
  put mem (off + idx) (zap x)
  setSlot st ki (toFloat (if idx + 1 >= size then 0 else idx + 1))

gverbLoop :: Ptr () -> Int -> Ptr CFloat -> Ptr CFloat -> Float -> Float -> Float -> Ptr CFloat -> Int -> Int ->> ()
gverbLoop st b mem xin dry early tail out i n = if i == n then do
    setSlot st (b + 102) dry
    setSlot st (b + 103) early
    setSlot st (b + 104) tail
  else do
    v <- at xin i
    x <- if v == v then v else 0.0
    z0 <- gvDamper st (b + 47) (b + 48) x
    z <- gvDiffuse st b mem 0 z0
    tidx <- cInt (slot st (b + 57))
    gvU st b mem tidx 0
    gvWrite st mem 0 44000 (b + 57) z
    ln <- cInt (slot st (b + 66))
    gvD st b mem ln 0
    s0 <- gvSum st b tail early 0 0.0 1.0
    sum <- f32 (s0 + f32 (x * early))
    d0 <- slot st (b + 43)
    d1 <- slot st (b + 44)
    d2 <- slot st (b + 45)
    d3 <- slot st (b + 46)
    -- gverb_fdnmatrix
    setSlot st (b + 39) (f32 (0.5 * f32 (f32 (f32 (d0 + d1) - d2) - d3)))
    setSlot st (b + 40) (f32 (0.5 * f32 (f32 (f32 (d0 - d1) - d2) + d3)))
    setSlot st (b + 41) (f32 (0.5 * f32 (f32 (f32 (0.0 - d0 + d1) - d2) + d3)))
    setSlot st (b + 42) (f32 (0.5 * f32 (f32 (f32 (d0 + d1) + d2) + d3)))
    gvFeed st b mem ln 0
    l1 <- gvDiffuse st b mem 1 sum
    l2 <- gvDiffuse st b mem 2 l1
    l3 <- gvDiffuse st b mem 3 l2
    r1 <- gvDiffuse st b mem 5 sum
    r2 <- gvDiffuse st b mem 6 r1
    r3 <- gvDiffuse st b mem 7 r2
    xd <- f32 (x * dry)
    put out i (f32 (l3 + xd))
    put out (n + i) (f32 (r3 + xd))
    gvStep st b 0
    gverbLoop st b mem xin (f32 (dry + slot st (b + 101))) (f32 (early + slot st (b + 99))) (f32 (tail + slot st (b + 100))) out (i + 1) n

gvU :: Ptr () -> Int -> Ptr CFloat -> Int -> Int ->> ()
gvU st b mem tidx j = if j == 4 then () else do
  setSlot st (b + 35 + j) (f32 (slot st (b + 27 + j) * gvRead mem 0 44000 tidx (cInt (slot st (b + 23 + j)))))
  gvU st b mem tidx (j + 1)

gvD :: Ptr () -> Int -> Ptr CFloat -> Int -> Int ->> ()
gvD st b mem ln j = if j == 4 then () else do
  off <- 44000 + j * ln
  r <- gvRead mem off (cInt (slot st (b + 62 + j))) (cInt (slot st (b + 58 + j))) (cInt (slot st (b + 11 + j)))
  y <- gvDamper st (b + 49 + j) (b + 53 + j) (f32 (slot st (b + 15 + j) * r))
  setSlot st (b + 43 + j) y
  gvD st b mem ln (j + 1)

gvSum :: Ptr () -> Int -> Float -> Float -> Int -> Float -> Float ->> Float
gvSum st b tail early j acc sign = if j == 4 then acc else
  gvSum st b tail early (j + 1) (f32 (acc + f32 (sign * f32 (f32 (tail * slot st (b + 43 + j)) + f32 (early * slot st (b + 35 + j)))))) (0.0 - sign)

gvFeed :: Ptr () -> Int -> Ptr CFloat -> Int -> Int ->> ()
gvFeed st b mem ln j = if j == 4 then () else do
  gvWrite st mem (44000 + j * ln) (cInt (slot st (b + 62 + j))) (b + 58 + j) (f32 (slot st (b + 35 + j) + slot st (b + 39 + j)))
  gvFeed st b mem ln (j + 1)

gvStep :: Ptr () -> Int -> Int ->> ()
gvStep st b j = if j == 4 then () else do
  setSlot st (b + 15 + j) (f32 (slot st (b + 15 + j) + slot st (b + 19 + j)))
  setSlot st (b + 27 + j) (f32 (slot st (b + 27 + j) + slot st (b + 31 + j)))
  gvStep st b (j + 1)

-- Limiter (FilterUGens.cpp): in delayed two buffers of dur, its gain
-- ramped each buffer to amp over the larger of the last two peaks; its
-- three buffers in the node's memory. Inputs in, level, dur. The state
-- starts with the memory's two slots, then the header; slots: started,
-- then limiterAt's, from b + 1.
uLimiterK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uLimiterK st ins out n cx = do
  mem <- readField (castPtr st :: Ptr Memory) Memory.mem
  b <- 7 + cInt (slot st 6)
  if slot st b == 0.0 then do
    bs <- cceil (in0 ins 2 * rateOf cx)
    setSlot st (b + 1) bs
    setSlot st (b + 2) (f32 (1.0 / bs))
    setSlot st (b + 3) 0.0
    setSlot st (b + 4) 0.0
    setSlot st (b + 5) 1.0
    setSlot st (b + 6) 0.0
    setSlot st (b + 7) 0.0
    setSlot st (b + 8) 0.0
    setSlot st (b + 9) 0.0
    setSlot st (b + 10) 1.0
    setSlot st (b + 11) 2.0
    put out 0 (limiterAt st (b + 1) mem (in0 ins 1) (in0 ins 0))
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else limitLoop st (b + 1) mem (in0 ins 1) (input ins 0) out 0 (fromIntegral n)

limitLoop :: Ptr () -> Int -> Ptr CFloat -> Float -> Ptr CFloat -> Ptr CFloat -> Int -> Int ->> ()
limitLoop st k mem amp x out i n = if i == n then () else do
  put out i (limiterAt st k mem amp (at x i))
  limitLoop st k mem amp x out (i + 1) n

-- Limiter_next's frame: slots k frames per buffer, k + 1 their inverse,
-- k + 2 position, k + 3 slope, k + 4 level, k + 5 this buffer's peak,
-- k + 6 the last's, k + 7 flips, k + 8..10 the in, mid and out buffers
limiterAt :: Ptr () -> Int -> Ptr CFloat -> Float -> Float ->> Float
limiterAt st k mem amp v = do
  bs <- cInt (slot st k)
  pos <- cInt (slot st (k + 2))
  put mem (cInt (slot st (k + 8)) * bs + pos) v
  level <- slot st (k + 4)
  y <- if slot st (k + 7) >= 2.0 then f32 (level * at mem (cInt (slot st (k + 10)) * bs + pos)) else 0.0
  setSlot st (k + 4) (f32 (level + slot st (k + 3)))
  if abs v > slot st (k + 5) then setSlot st (k + 5) (abs v) else ()
  if pos + 1 >= bs then do
    setSlot st (k + 2) 0.0
    peak <- max (slot st (k + 6)) (slot st (k + 5))
    setSlot st (k + 6) (slot st (k + 5))
    setSlot st (k + 5) 0.0
    next <- if peak > amp then f32 (amp / peak) else 1.0
    setSlot st (k + 3) (f32 (f32 (next - slot st (k + 4)) * slot st (k + 1)))
    o <- slot st (k + 10)
    setSlot st (k + 10) (slot st (k + 9))
    setSlot st (k + 9) (slot st (k + 8))
    setSlot st (k + 8) o
    setSlot st (k + 7) (slot st (k + 7) + 1.0)
  else setSlot st (k + 2) (toFloat (pos + 1))
  y

-- PanAz (PanUGens.cpp) for pos not at audio rate, output k of its
-- count: in times level times a sine window of the channel's distance
-- from pos; a changed gain ramps in nova's lanes. Inputs in, pos, level,
-- width, orientation. Slots: started, outputs (the builder's), amp,
-- then a ramp's five.
uPanAzK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uPanAzK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    put out 0 0.0
    setSlot st (b + 2) (panAzAmp (tables cx) st b ins)
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else do
    amp <- slot st (b + 2)
    next <- panAzAmp (tables cx) st b ins
    if next == amp then mulConst (input ins 0) amp out 0 (fromIntegral n)
    else do
      rampSet st (b + 3) amp next
      pan2ak st (b + 3) (input ins 0) out 0 (fromIntegral n)
      setSlot st (b + 2) next

panAzAmp :: Ptr () -> Ptr () -> Int -> Ptr (Ptr CFloat) ->> Float
panAzAmp tb st b ins = do
  nout <- slot st (b + 1)
  w <- in0 ins 3
  rw <- f32 (1.0 / w)
  range <- f32 (nout * rw)
  rr <- f32 (1.0 / range)
  pos <- f32 (f32 (f32 (f32 (in0 ins 1 * 0.5) * nout) + f32 (w * 0.5)) + in0 ins 4)
  cp0 <- f32 (f32 (pos - ugOutput st) * rw)
  cp <- f32 (cp0 - f32 (range * cfloor (f32 (rr * cp0))))
  if cp >= 1.0 then 0.0 else f32 (in0 ins 2 * sineAt tb (cInt (f32 (4096.0 * cp))))

-- Phasor (TriggerUGens.cpp): from start by rate a frame, wrapped into
-- [start, end), reset to resetPos by a rising trig; at control rate, or
-- for trig at audio rate, Phasor_next_ak. Inputs trig, rate, start, end,
-- resetPos. Slots: started, level (a double), previn.
uPhasorK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uPhasorK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    setSlot st (b + 2) (in0 ins 0)
    setSlot st (b + 1) (in0 ins 2)
    put out 0 (in0 ins 2)
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else
    if ugRate st /= 2.0 then do
      phasorAk st b ins out 0 1
      ugSpread st out (fromIntegral n)
    else if ugInRate st 0 == 2.0 then phasorAk st b ins out 0 (fromIntegral n)
    else do
      cur <- in0 ins 0
      if slot st (b + 2) <= 0.0 && cur > 0.0 then setSlot st (b + 1) (in0 ins 4) else ()
      setSlot st (b + 2) cur
      phasorKk st b ins out 0 (fromIntegral n)

phasorKk :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr CFloat -> Int -> Int ->> ()
phasorKk st b ins out i n = if i == n then () else do
  lv <- scWrap (slot st (b + 1)) (in0 ins 2) (in0 ins 3)
  put out i (f32 lv)
  setSlot st (b + 1) (lv + in0 ins 1)
  phasorKk st b ins out (i + 1) n

phasorAk :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr CFloat -> Int -> Int ->> ()
phasorAk st b ins out i n = if i == n then () else do
  cur <- at (input ins 0) i
  prev <- slot st (b + 2)
  rate <- in0 ins 1
  if prev <= 0.0 && cur > 0.0 then setSlot st (b + 1) (in0 ins 4 + f32 (1.0 - f32 (prev / f32 (cur - prev))) * rate) else ()
  put out i (f32 (slot st (b + 1)))
  setSlot st (b + 1) (scWrap (slot st (b + 1) + rate) (in0 ins 2) (in0 ins 3))
  setSlot st (b + 2) cur
  phasorAk st b ins out (i + 1) n

-- Duty (DemandUGens.cpp) at control rate, its dur and reset not demand
-- rate, its level a Dseq of constants, which the builder folds into its
-- state: Duty_next_dk. Inputs dur, reset, doneAction. Slots: started,
-- count, prevreset, prevout, Dseq's index, its repeat count, repeats,
-- the number of values, then the values.
uDutyK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uDutyK st ins out n cx = do
  b <- ugBase st
  sr <- f32 (ugSampleRate st cx)
  if slot st b == 0.0 then do
    setSlot st (b + 4) 0.0
    setSlot st (b + 5) 0.0
    setSlot st (b + 2) 0.0
    setSlot st (b + 1) (f32 (in0 ins 0 * ugSampleRate st cx))
    setSlot st (b + 3) (dseqNext st b)
    put out 0 (slot st (b + 3))
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else do
    reset <- in0 ins 1
    if reset > 0.0 && slot st (b + 2) <= 0.0 then do
      setSlot st (b + 4) 0.0
      setSlot st (b + 5) 0.0
      setSlot st (b + 1) 0.0
    else ()
    if slot st (b + 1) <= 0.0 then do
      setSlot st (b + 1) (f32 (f32 (in0 ins 0 * sr) + slot st (b + 1)))
      x <- dseqNext st b
      if x == x then setSlot st (b + 3) x else doneAction (cInt (in0 ins 2)) cx
    else ()
    setSlot st (b + 1) (f32 (slot st (b + 1) - 1.0))
    setSlot st (b + 2) reset
    ugFill st out (slot st (b + 3)) (fromIntegral n)

-- Dseq_next of constants: the next value, or NaN after its repeats
dseqNext :: Ptr () -> Int ->> Float
dseqNext st b = do
  k <- cInt (slot st (b + 7))
  if cInt (slot st (b + 4)) >= k then do
    setSlot st (b + 4) 0.0
    setSlot st (b + 5) (slot st (b + 5) + 1.0)
  else ()
  if slot st (b + 5) >= slot st (b + 6) then do
    setSlot st (b + 4) 0.0
    0.0 / 0.0
  else do
    i <- cInt (slot st (b + 4))
    setSlot st (b + 4) (toFloat (i + 1))
    slot st (b + 8 + i)

-- MdaPiano (sc3-plugins' MdaUGens.cpp, Paul Kellett's mda Piano): one voice
-- of pianoData, a Builtin table, then mda's stereo comb; outputs left at i,
-- right at n + i. Inputs freq, gate, vel, decay, release, hard, velhard,
-- muffle, velmuff, velcurve, stereo, tune, random, stretch, sustain. The
-- constructor's call makes one frame. Slots, after the table and header:
-- started, prevgate, note, cpos; the voice's delta, frac, pos, end, loop,
-- env, dec, f0, f1, ff, outl, outr and note; cdep, cmax; the 256-frame comb.
uMdaPianoK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uMdaPianoK st ins out n cx = do
  b <- 8 + cInt (slot st 7)
  if slot st b == 0.0 then do
    setSlot st (b + 10) (f32 0.99)
    setSlot st (b + 18) (if rateOf cx > 64000.0 then 255.0 else 127.0)
    mdaBlock st b ins out (1.0 / rateOf cx) 1 (fromIntegral n)
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else mdaBlock st b ins out (1.0 / rateOf cx) (fromIntegral n) (fromIntegral n)

mdaBlock :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr CFloat -> Float -> Int -> Int ->> ()
mdaBlock st b ins out dur n stride = do
  gate <- in0 ins 1
  prev <- slot st (b + 1)
  if not (prev > 0.0) && gate > 0.0 then mdaNoteOn st b ins dur
  else if prev > 0.0 && not (gate > 0.0) then do
    note <- cInt (slot st (b + 2))
    if in0 ins 14 > 0.0 then setSlot st (b + 16) 128.0
    else if note < 94 || note == 0 then setSlot st (b + 10) (f32 (cexp (0.0 - dur * cexp (2.0 + 0.017 * toFloat note - 2.0 * in0 ins 4))))
    else ()
  else ()
  mdaLoop st b (readField (castPtr st :: Ptr Table) Table.dat) out 0 n stride (cInt (slot st (b + 3)))
  setSlot st (b + 1) gate

-- the note-on of MdaPiano_next and mdaPiano::noteOn, in float32 as they are
mdaNoteOn :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Float ->> ()
mdaNoteOn st b ins dur = do
  vel <- cInt (in0 ins 2)
  m <- f32 (f32 (fromCFloat (clog2f (toCFloat (f32 (in0 ins 0 * f32 0.0022727272727))))) * 12.0)
  n0 <- cInt (f32 (f32 (m + 69.0) + 0.5))
  note <- if n0 > 0 then n0 else 0
  setSlot st (b + 2) (toFloat note)
  p6 <- in0 ins 9
  vs0 <- f32 (f32 (1.0 + p6) + p6)
  velsens <- if p6 < 0.25 then f32 (vs0 - f32 (0.75 - f32 (3.0 * p6))) else vs0
  random <- f32 (f32 (f32 0.077 * in0 ins 12) * in0 ins 12)
  stretch <- f32 (f32 0.000434 * f32 (in0 ins 13 - 0.5))
  cdep <- f32 (in0 ins 10 * in0 ins 10)
  setSlot st (b + 17) cdep
  trim <- f32 (1.5 - f32 (f32 0.79 * cdep))
  width <- min (f32 (f32 0.04 * in0 ins 10)) (f32 0.03)
  k <- (note - 60) * (note - 60)
  l0 <- f32 (f32 (in0 ins 11 - 0.5) + f32 (random * f32 (toFloat (mod k 13) - 6.5)))
  l1 <- if note > 60 then f32 (l0 + f32 (stretch * toFloat k)) else l0
  size <- cInt (f32 (f32 (12.0 * in0 ins 5) - 6.0))
  s <- if vel > 40 then size + cInt (f32 (f32 (f32 0.12 * in0 ins 6) * toFloat (vel - 40))) else size
  g <- mdaGroup note s 0
  l2 <- f32 (l1 + toFloat (note - mdaKgrp g 0))
  l3 <- f32 (22050.0 * dur * f32 (cexp (0.05776226505 * l2)))
  setSlot st (b + 4) (toFloat (cInt (f32 (65536.0 * l3))))
  setSlot st (b + 5) 0.0
  setSlot st (b + 6) (toFloat (mdaKgrp g 2))
  setSlot st (b + 7) (toFloat (mdaKgrp g 3))
  setSlot st (b + 8) (toFloat (mdaKgrp g 4))
  setSlot st (b + 9) (f32 (f32 (0.5 + velsens) * fromCFloat (cpowf (toCFloat (f32 (f32 0.0078 * toFloat vel))) (toCFloat velsens))))
  muffvel <- f32 (f32 (in0 ins 8 * in0 ins 8) * 5.0)
  m0 <- f32 (f32 (50.0 + f32 (f32 (in0 ins 7 * in0 ins 7) * 160.0)) + f32 (muffvel * toFloat (vel - 64)))
  m1 <- min (max m0 (f32 (55.0 + f32 (0.25 * toFloat note)))) 210.0
  setSlot st (b + 13) (f32 (f32 (m1 * m1) * dur))
  setSlot st (b + 11) 0.0
  setSlot st (b + 12) 0.0
  setSlot st (b + 16) (toFloat note)
  pn <- min (max note 12) 108
  v <- f32 (f32 0.2 * trim)
  outr <- f32 (v + f32 (f32 (v * width) * toFloat (pn - 60)))
  setSlot st (b + 15) outr
  setSlot st (b + 14) (f32 (f32 (v + v) - outr))
  p0 <- in0 ins 3
  d0 <- f32 (2.0 * p0)
  d1 <- if d0 < 1.0 then f32 (d0 + f32 (0.25 - f32 (0.5 * p0))) else d0
  setSlot st (b + 10) (f32 (cexp (0.0 - dur * cexp (-0.6 + 0.033 * toFloat (max pn 44) - d1))))

-- the keygroup of note: the first whose highest note plus s reaches it
mdaGroup :: Int -> Int -> Int -> Int
mdaGroup note s k = if k < 14 && note > mdaKgrp k 1 + s then mdaGroup note s (k + 1) else k

-- mdaPiano_sc3.h's kgrp: root, high, pos, end, loop
mdaKgrp :: Int -> Int -> Int
mdaKgrp k f = case k of
  0 -> mdaField f 36 37 0 36275 14774
  1 -> mdaField f 40 41 36278 83135 16268
  2 -> mdaField f 43 45 83137 146756 33541
  3 -> mdaField f 48 49 146758 204997 21156
  4 -> mdaField f 52 53 204999 244908 17191
  5 -> mdaField f 55 57 244910 290978 23286
  6 -> mdaField f 60 61 290980 342948 18002
  7 -> mdaField f 64 65 342950 391750 19746
  8 -> mdaField f 67 69 391752 436915 22253
  9 -> mdaField f 72 73 436917 468807 8852
  10 -> mdaField f 76 77 468809 492772 9693
  11 -> mdaField f 79 81 492774 532293 10596
  12 -> mdaField f 84 85 532295 560192 6011
  13 -> mdaField f 88 89 560194 574121 3414
  _ -> mdaField f 93 999 574123 586343 2399

mdaField :: Int -> Int -> Int -> Int -> Int -> Int -> Int
mdaField f a b c d e = case f of
  0 -> a
  1 -> b
  2 -> c
  3 -> d
  _ -> e

-- pianoData[i], a 16-bit sample
mdaData :: Ptr CFloat -> Int ->> Int
mdaData dat i = cInt (at dat i * 32768.0)

mdaLoop :: Ptr () -> Int -> Ptr CFloat -> Ptr CFloat -> Int -> Int -> Int -> Int ->> ()
mdaLoop st b dat out i n stride cpos = if i == n then setSlot st (b + 3) (toFloat cpos) else do
  frac0 <- cInt (slot st (b + 5)) + cInt (slot st (b + 4))
  pos0 <- cInt (slot st (b + 6)) + shiftR frac0 16
  frac <- frac0 .&. 65535
  pos <- if pos0 > cInt (slot st (b + 7)) then pos0 - cInt (slot st (b + 8)) else pos0
  setSlot st (b + 5) (toFloat frac)
  setSlot st (b + 6) (toFloat pos)
  d <- mdaData dat pos
  s <- d + shiftR (frac * (mdaData dat (pos + 1) - d)) 16
  env <- slot st (b + 9)
  x <- f32 (f32 (env * toFloat s) / 32768.0)
  setSlot st (b + 9) (f32 (env * slot st (b + 10)))
  f0 <- f32 (slot st (b + 11) + f32 (slot st (b + 13) * f32 (f32 (x + slot st (b + 12)) - slot st (b + 11))))
  setSlot st (b + 11) f0
  setSlot st (b + 12) x
  l <- f32 (slot st (b + 14) * f0)
  r <- f32 (slot st (b + 15) * f0)
  setSlot st (b + 19 + cpos) (f32 (l + r))
  next <- (cpos + 1) .&. cInt (slot st (b + 18))
  c <- f32 (slot st (b + 17) * slot st (b + 19 + next))
  put out i (f32 (l + c))
  put out (stride + i) (f32 (r - c))
  mdaLoop st b dat out (i + 1) n stride next

-- DC (LFUGens.cpp): its input. Slots: started.
uDCK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uDCK st ins out n cx = do
  setSlot st (ugBase st) 1.0
  ugFill st out (in0 ins 0) (if ugCtorOnly cx then 1 else fromIntegral n)

-- ToggleFF (TriggerUGens.cpp): flips between 0 and 1 at each rising
-- trigger. Its constructor writes 0 and reads nothing. Slots: started,
-- level, prevtrig.
uToggleFFK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uToggleFFK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    put out 0 0.0
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else toggleLoop st b (input ins 0) out 0 (fromIntegral n)

toggleLoop :: Ptr () -> Int -> Ptr CFloat -> Ptr CFloat -> Int -> Int ->> ()
toggleLoop st b trig out i n = if i == n then () else do
  cur <- at trig i
  if slot st (b + 2) <= 0.0 && cur > 0.0 then setSlot st (b + 1) (1.0 - slot st (b + 1)) else ()
  put out i (slot st (b + 1))
  setSlot st (b + 2) cur
  toggleLoop st b trig out (i + 1) n

-- WaveLoss (sc3-plugins' MCLDDistortionUGens.cpp): at each rising zero
-- crossing, a segment is kept or silenced: at random, drop of outof
-- dropped, in mode 2, else the first drop of each outof. Inputs in, drop,
-- outof, mode. Slots: started, on, pos, prevval.
uWaveLossK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uWaveLossK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    setSlot st (b + 1) 1.0
    waveLossLoop st b ins cx out 0 1
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else waveLossLoop st b ins cx out 0 (fromIntegral n)

waveLossLoop :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr Context -> Ptr CFloat -> Int -> Int ->> ()
waveLossLoop st b ins cx out i n = if i == n then () else do
  cur <- at (input ins 0) i
  drop <- cInt (in0 ins 1)
  outof <- cInt (in0 ins 2)
  if slot st (b + 3) < 0.0 && cur >= 0.0 then do
    p0 <- cInt (slot st (b + 2)) + 1
    pos <- if p0 >= outof then 0 else p0
    setSlot st (b + 2) (toFloat pos)
    on <- if cInt (in0 ins 3) == 2 then frand cx >= f32 (toFloat drop / toFloat outof) else pos >= drop
    setSlot st (b + 1) (if on then 1.0 else 0.0)
  else ()
  put out i (if slot st (b + 1) /= 0.0 then cur else 0.0)
  setSlot st (b + 3) cur
  waveLossLoop st b ins cx out (i + 1) n

-- Squiz (sc3-plugins' MCLDDistortionUGens.cpp): each chunk of zcperchunk
-- rising zero crossings, or of the buffer, read back faster by the pitch
-- ratio. Inputs in, pitchratio, zcperchunk, memlen (seconds). Slots after
-- the memory: started, buflen, writepos, readpos, prevval, zcsofar.
uSquizK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uSquizK st ins out n cx = do
  mem <- readField (castPtr st :: Ptr Memory) Memory.mem
  b <- 7 + cInt (slot st 6)
  if slot st b == 0.0 then do
    setSlot st (b + 1) (toFloat (min (cInt (in0 ins 3 * rateOf cx)) (readField (castPtr st :: Ptr Memory) Memory.frames)))
    squizLoop st b mem ins out 0 1
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else squizLoop st b mem ins out 0 (fromIntegral n)

squizLoop :: Ptr () -> Int -> Ptr CFloat -> Ptr (Ptr CFloat) -> Ptr CFloat -> Int -> Int ->> ()
squizLoop st b mem ins out i n = if i == n then () else do
  len <- cInt (slot st (b + 1))
  ratio <- min (max (in0 ins 1) 1.0) (toFloat len)
  rp <- slot st (b + 3)
  ri <- cInt rp
  v <- if ri >= len then 0.0 else at mem ri
  if ri >= len then () else setSlot st (b + 3) (f32 (rp + ratio))
  cur <- at (input ins 0) i
  w <- cInt (slot st (b + 2)) + 1
  zc <- slot st (b + 4) < 0.0 && cur >= 0.0
  z <- if zc then cInt (slot st (b + 5)) + 1 else cInt (slot st (b + 5))
  if w == len || (zc && z >= cInt (in0 ins 2)) then do
    setSlot st (b + 2) 0.0
    setSlot st (b + 3) 0.0
    setSlot st (b + 5) 0.0
  else do
    setSlot st (b + 2) (toFloat w)
    setSlot st (b + 5) (toFloat z)
  if len > 0 then put mem (cInt (slot st (b + 2))) cur else ()
  put out i v
  setSlot st (b + 4) cur
  squizLoop st b mem ins out (i + 1) n

-- CrossoverDistortion (sc3-plugins' DistortionUGens.cpp): |x| - amp, and
-- below 0 bent by smooth; x's sign. A changed amp or smooth ramps over
-- the call. Inputs in, amp, smooth. Slots: started, amp, smooth, rfade.
uCrossoverDistortionK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uCrossoverDistortionK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    setSlot st (b + 1) (in0 ins 1)
    setSlot st (b + 2) (in0 ins 2)
    setSlot st (b + 3) (f32 (1.0 / abs (f32 (in0 ins 1 * in0 ins 2))))
    crossBlock st b ins out 1
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else crossBlock st b ins out (fromIntegral n)

crossBlock :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr CFloat -> Int ->> ()
crossBlock st b ins out n = do
  amp <- slot st (b + 1)
  smooth <- slot st (b + 2)
  rfade <- slot st (b + 3)
  na <- in0 ins 1
  ns <- in0 ins 2
  if na /= amp || ns /= smooth then do
    -- the old fade's reciprocal, as the C computes it
    fresh <- f32 (1.0 / abs (f32 (amp * smooth)))
    setSlot st (b + 3) fresh
    setSlot st (b + 1) na
    setSlot st (b + 2) ns
    crossLoop (input ins 0) out na ns amp smooth rfade (f32 (f32 (fresh - rfade) * slopeFactor)) (f32 (f32 (na - amp) * slopeFactor))
      (f32 (f32 (ns - smooth) * slopeFactor)) 0 n
  else crossLoop (input ins 0) out na ns amp smooth rfade 0.0 0.0 0.0 0 n

-- a frame steps amp, smooth and rfade while amp or smooth differs from its next
crossLoop :: Ptr CFloat -> Ptr CFloat -> Float -> Float -> Float -> Float -> Float -> Float -> Float -> Float -> Int -> Int ->> ()
crossLoop x out na ns amp smooth rfade dr da ds i n = if i == n then () else do
  v <- at x i
  s0 <- f32 (abs v - amp)
  s <- if s0 < 0.0 then f32 (s0 * f32 (f32 (1.0 + f32 (s0 * rfade)) * smooth)) else s0
  put out i (if v < 0.0 then 0.0 - s else s)
  if na /= amp || ns /= smooth then crossLoop x out na ns (f32 (amp + da)) (f32 (smooth + ds)) (f32 (rfade + dr)) dr da ds (i + 1) n
  else crossLoop x out na ns amp smooth rfade dr da ds (i + 1) n

-- FreqShift (FilterUGens.cpp) with control-rate shift and phase
-- (FreqShift_next_kk): a Hilbert pair of 6 allpasses each, times the sine
-- table's quadrature oscillator. Inputs in, freq, phase. Slots: started,
-- phase (an int32), phasein, the 12 coefficients, the 12 y1s.
uFreqShiftK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uFreqShiftK st ins out n cx = do
  b <- ugBase st
  if slot st b == 0.0 then do
    setSlot st (b + 1) (toFloat (cInt (fsRadToInc * in0 ins 2)))
    setSlot st (b + 2) (in0 ins 2)
    g <- 15.0 * 3.141592653589793 / rateOf cx
    fsCoefs st b g 0
    fsBlock st b ins cx out 1
    setSlot st b 1.0
  else ()
  if ugCtorOnly cx then () else fsBlock st b ins cx out (fromIntegral n)

-- the sine table's size times 65536 / 2 pi
fsRadToInc :: Float
fsRadToInc = 8192.0 * ((1.0 / 6.283185307179586) * 65536.0)

fsCoefs :: Ptr () -> Int -> Float -> Int ->> ()
fsCoefs st b g k = if k == 12 then () else do
  gm <- g * f32 (fsGamma k)
  setSlot st (b + 3 + k) (f32 ((gm - 1.0) / (gm + 1.0)))
  fsCoefs st b g (k + 1)

-- the allpasses' gammas over 15 pi / rate
fsGamma :: Int -> Float
fsGamma k = case k of
  0 -> 0.3609
  1 -> 2.7412
  2 -> 11.1573
  3 -> 44.7581
  4 -> 179.6242
  5 -> 798.4578
  6 -> 1.2524
  7 -> 5.5671
  8 -> 22.3423
  9 -> 89.6271
  10 -> 364.7914
  _ -> 2770.1114

fsBlock :: Ptr () -> Int -> Ptr (Ptr CFloat) -> Ptr Context -> Ptr CFloat -> Int ->> ()
fsBlock st b ins cx out n = do
  ph <- in0 ins 2
  freq <- cInt (8192.0 * (1.0 / rateOf cx) * 65536.0 * in0 ins 1)
  inc <- ayInt32 (freq + cInt (f32 (f32 (ph - slot st (b + 2)) * slopeFactor) * fsRadToInc))
  setSlot st (b + 2) ph
  fsLoop st b (tables cx) (input ins 0) (cInt (fsRadToInc * (0.5 * 3.141592653589793))) inc out 0 n
  fsZap st (b + 15) 12

fsZap :: Ptr () -> Int -> Int ->> ()
fsZap st k c = if c == 0 then () else do
  setSlot st k (f32 (zap (slot st k)))
  fsZap st (k + 1) (c - 1)

-- allpasses c .. c + 5 of the chain from x, their states at slots b + 15 + c
fsChain :: Ptr () -> Int -> Int -> Int -> Float ->> Float
fsChain st b c m x = if m == 0 then x else do
  k <- b + 3 + c
  y1 <- slot st (k + 12)
  y0 <- x - slot st k * y1
  setSlot st (k + 12) y0
  fsChain st b (c + 1) (m - 1) (slot st k * y0 + y1)

-- the sine table at an int32 phase
fsSine :: Ptr () -> Int ->> Float
fsSine tb p = sineOsc tb (toFloat (p .&. 4294967295))

fsLoop :: Ptr () -> Int -> Ptr () -> Ptr CFloat -> Int -> Int -> Ptr CFloat -> Int -> Int ->> ()
fsLoop st b tb x half inc out i n = if i == n then () else do
  v <- at x i
  c <- f32 (fsChain st b 0 6 v)
  s <- f32 (fsChain st b 6 6 v)
  p <- cInt (slot st (b + 1))
  put out i (f32 (f32 (c * fsSine tb (p + half)) + f32 (fsSine tb p * s)))
  setSlot st (b + 1) (toFloat (ayInt32 (p + inc)))
  fsLoop st b tb x half inc out (i + 1) n

-- FFT, one PV_ UGen and IFFT (FFT_UGens.cpp, PV_UGens.cpp, PV_ThirdParty.cpp,
-- sc3-plugins' JoshPVUGens.cpp) as one node: lib/scsynth.fk fuses each
-- channel's chain, since a node's output cannot carry a spectrum. Sine
-- window, hop of half the size, as scsynth's macOS build scales vDSP's
-- transforms: the buffer holds the windowed frame's DFT, IFFT's output is
-- the window times its inverse over the size. The transforms run in double;
-- the buffer and the frames are float, as scsynth's. Polar bins use
-- SC_Complex.h's table approximations. Inputs: the audio, then the PV_
-- UGen's after its chain. Slots after the memory and header: started,
-- kind, size, FFT's pos, IFFT's pos, polar, Freeze's stage, dc and nyq,
-- BinScramble's prevtrig, triggered and chosen, 4 spare, then size doubles
-- of complex scratch. Memory, in floats of the size n: the input frame,
-- the buffer, the overlap-add, a temporary buffer, then the PV_ UGen's
-- 3 n / 2.
uSpectralK :: Ptr () -> Ptr (Ptr CFloat) -> Ptr CFloat -> CInt -> Ptr Context ->> ()
uSpectralK st ins out n cx = do
  mem <- readField (castPtr st :: Ptr Memory) Memory.mem
  b <- 7 + cInt (slot st 6)
  size <- cInt (slot st (b + 2))
  if readField (castPtr st :: Ptr Memory) Memory.frames < 6 * size then ugFill st out 0.0 (fromIntegral n) else do
    if slot st b == 0.0 then do
      put out 0 0.0
      setSlot st b 1.0
    else ()
    if ugCtorOnly cx then () else specBlock st b mem size ins cx out (fromIntegral n)

specBlock :: Ptr () -> Int -> Ptr CFloat -> Int -> Ptr (Ptr CFloat) -> Ptr Context -> Ptr CFloat -> Int ->> ()
specBlock st b mem size ins cx out n = do
  hop <- div size 2
  pos <- cInt (slot st (b + 3))
  ip0 <- cInt (slot st (b + 4))
  -- PV_BinScramble reads its trigger every block
  if slot st (b + 1) == 5.0 then do
    trig <- in0 ins 3
    if trig > 0.0 && slot st (b + 9) <= 0.0 then setSlot st (b + 10) 1.0 else ()
    setSlot st (b + 9) trig
  else ()
  specCopy (input ins 0) mem (hop + pos) 0 n
  if pos + n == hop then do
    setSlot st (b + 3) 0.0
    fftForward st b mem size
    setSlot st (b + 5) 0.0
    specMove mem hop 0 hop
    pvApply st b mem size ins cx
    if slot st (b + 5) /= 0.0 then toComplexApx (tables cx) mem size else ()
    fftInverse st b mem size
    -- the overlap-add moves down by IFFT's position, and the frame adds on
    specOla mem size (min ip0 size) 0
  else do
    setSlot st (b + 3) (toFloat (pos + n))
  ip <- if pos + n == hop then 0 else ip0
  if ip >= size then ugFill st out 0.0 n else do
    specCopyOut mem (2 * size + ip) out 0 n
    setSlot st (b + 4) (toFloat (ip + n))

specCopy :: Ptr CFloat -> Ptr CFloat -> Int -> Int -> Int ->> ()
specCopy x mem k i n = if i == n then () else do
  put mem (k + i) (at x i)
  specCopy x mem k (i + 1) n

specCopyOut :: Ptr CFloat -> Int -> Ptr CFloat -> Int -> Int ->> ()
specCopyOut mem k out i n = if i == n then () else do
  put out i (at mem (k + i))
  specCopyOut mem k out (i + 1) n

-- mem[to + i] = mem[from + i] for i < count, from above to
specMove :: Ptr CFloat -> Int -> Int -> Int ->> ()
specMove mem from to count = if count == 0 then () else do
  put mem to (at mem from)
  specMove mem (from + 1) (to + 1) (count - 1)

-- IFFT_next: the overlap-add moves down by hop and the buffer's first
-- size - hop frames add to it; the rest of the buffer follows
specOla :: Ptr CFloat -> Int -> Int -> Int ->> ()
specOla mem size hop i = if i == size then () else do
  o <- 2 * size
  if i < size - hop then put mem (o + i) (f32 (at mem (o + hop + i) + at mem (size + i)))
  else put mem (o + i) (at mem (size + i))
  specOla mem size hop (i + 1)

-- the sine window's point i of n (SC_fftlib.cpp: pi as a float over n)
specWin :: Int -> Int -> Float
specWin i n = f32 (csin (toFloat i * f32 (f32 3.1415926535898 / toFloat n)))

-- scratch complex k
scRe, scIm :: Ptr () -> Int -> Int ->> Float
scRe st b k = slot st (b + 16 + 2 * k)
scIm st b k = slot st (b + 17 + 2 * k)

scSet :: Ptr () -> Int -> Int -> Float -> Float ->> ()
scSet st b k re im = do
  setSlot st (b + 16 + 2 * k) re
  setSlot st (b + 17 + 2 * k) im

-- the windowed frame times 0.5, as pairs into the scratch
fwdLoad :: Ptr () -> Int -> Ptr CFloat -> Int -> Int ->> ()
fwdLoad st b mem n k = if k == div n 2 then () else do
  a <- f32 (f32 (at mem (2 * k) * specWin (2 * k) n) * 0.5)
  c <- f32 (f32 (at mem (2 * k + 1) * specWin (2 * k + 1) n) * 0.5)
  scSet st b k a c
  fwdLoad st b mem n (k + 1)

-- vDSP_fft_zrip forward of the frame: twice its DFT, packed with the
-- Nyquist bin's real part beside the DC's
fftForward :: Ptr () -> Int -> Ptr CFloat -> Int ->> ()
fftForward st b mem n = do
  m <- div n 2
  fwdLoad st b mem n 0
  cfft st b m (-1.0)
  fwdPost st b mem n m 0

fwdPost :: Ptr () -> Int -> Ptr CFloat -> Int -> Int -> Int ->> ()
fwdPost st b mem n m k = if k > m then () else do
  -- Z_k and Z_(m - k), Z_m being Z_0
  ka <- if k == m then 0 else k
  kb <- if k == 0 then 0 else m - k
  zr <- scRe st b ka
  zi <- scIm st b ka
  yr <- scRe st b kb
  yi <- 0.0 - scIm st b kb
  er <- (zr + yr) * 0.5
  ei <- (zi + yi) * 0.5
  -- (Z_k - conj Z_(m-k)) / 2i
  or <- (zi - yi) * 0.5
  oi <- 0.0 - (zr - yr) * 0.5
  ang <- 0.0 - pi2 * toFloat k / toFloat n
  c <- ccos ang
  s <- csin ang
  xr <- er + (c * or - s * oi)
  xi <- ei + (c * oi + s * or)
  if k == 0 then put mem n (f32 (2.0 * xr))
  else if k == m then put mem (n + 1) (f32 (2.0 * xr))
  else do
    put mem (n + 2 * k) (f32 (2.0 * xr))
    put mem (n + 2 * k + 1) (f32 (2.0 * xi))
  fwdPost st b mem n m (k + 1)

-- vDSP_fft_zrip inverse of the buffer, the full Hermitian sum, then the
-- window and 1 / n, into the buffer
fftInverse :: Ptr () -> Int -> Ptr CFloat -> Int ->> ()
fftInverse st b mem n = do
  m <- div n 2
  invLoad st b mem n m 0
  cfft st b m 1.0
  invStore st b mem n 0

-- bin k of the buffer, the DC and Nyquist real
binRe, binIm :: Ptr CFloat -> Int -> Int -> Int ->> Float
binRe mem n m k = if k == 0 then at mem n else if k == m then at mem (n + 1) else at mem (n + 2 * k)
binIm mem n m k = if k == 0 || k == m then 0.0 else at mem (n + 2 * k + 1)

invLoad :: Ptr () -> Int -> Ptr CFloat -> Int -> Int -> Int ->> ()
invLoad st b mem n m k = if k == m then () else do
  xr <- binRe mem n m k
  xi <- binIm mem n m k
  yr <- binRe mem n m (m - k)
  yi <- 0.0 - binIm mem n m (m - k)
  ar <- xr + yr
  ai <- xi + yi
  dr <- xr - yr
  di <- xi - yi
  ang <- pi2 * toFloat k / toFloat n
  c <- ccos ang
  s <- csin ang
  -- i e^(i ang) d
  scSet st b k (ar - (s * dr + c * di)) (ai + (c * dr - s * di))
  invLoad st b mem n m (k + 1)

invStore :: Ptr () -> Int -> Ptr CFloat -> Int -> Int ->> ()
invStore st b mem n j = if j == div n 2 then () else do
  r <- 1.0 / toFloat n
  put mem (n + 2 * j) (f32 (f32 (f32 (scRe st b j) * specWin (2 * j) n) * r))
  put mem (n + 2 * j + 1) (f32 (f32 (f32 (scIm st b j) * specWin (2 * j + 1) n) * r))
  invStore st b mem n (j + 1)

-- an m-point complex FFT of the scratch in place, sign -1 forward, 1 inverse,
-- unnormalized
cfft :: Ptr () -> Int -> Int -> Float ->> ()
cfft st b m sign = do
  bits <- log2Of m 0 1
  cfftSwap st b m bits 0
  cfftStage st b m sign 2

log2Of :: Int -> Int -> Int -> Int
log2Of m k p = if p >= m then k else log2Of m (k + 1) (2 * p)

bitRev :: Int -> Int -> Int -> Int
bitRev x bits r = if bits == 0 then r else bitRev (shiftR x 1) (bits - 1) (shiftL r 1 .|. (x .&. 1))

cfftSwap :: Ptr () -> Int -> Int -> Int -> Int ->> ()
cfftSwap st b m bits i = if i == m then () else do
  j <- bitRev i bits 0
  if j > i then do
    ar <- scRe st b i
    ai <- scIm st b i
    scSet st b i (scRe st b j) (scIm st b j)
    scSet st b j ar ai
  else ()
  cfftSwap st b m bits (i + 1)

cfftStage :: Ptr () -> Int -> Int -> Float -> Int ->> ()
cfftStage st b m sign len = if len > m then () else do
  cfftTwiddle st b m sign len 0
  cfftStage st b m sign (2 * len)

cfftTwiddle :: Ptr () -> Int -> Int -> Float -> Int -> Int ->> ()
cfftTwiddle st b m sign len j = if j == div len 2 then () else do
  ang <- sign * pi2 * toFloat j / toFloat len
  cfftFly st b m (ccos ang) (csin ang) len j j
  cfftTwiddle st b m sign len (j + 1)

cfftFly :: Ptr () -> Int -> Int -> Float -> Float -> Int -> Int -> Int ->> ()
cfftFly st b m wr wi len j s = if s >= m then () else do
  h <- s + div len 2
  ur <- scRe st b s
  ui <- scIm st b s
  vr0 <- scRe st b h
  vi0 <- scIm st b h
  vr <- vr0 * wr - vi0 * wi
  vi <- vr0 * wi + vi0 * wr
  scSet st b s (ur + vr) (ui + vi)
  scSet st b h (ur - vr) (ui - vi)
  cfftFly st b m wr wi len j (s + len)

-- SC_Complex.h's ToPolarApx of each bin, in place: phases from about -pi/4
specPolar :: Ptr () -> Int -> Ptr CFloat -> Int ->> ()
specPolar st b mem n = if slot st (b + 5) /= 0.0 then () else do
  polarBins mem n 0 (div (n - 2) 2)
  setSlot st (b + 5) 1.0

polarBins :: Ptr CFloat -> Int -> Int -> Int ->> ()
polarBins mem n i bins = if i == bins then () else do
  k <- n + 2 + 2 * i
  re <- at mem k
  im <- at mem (k + 1)
  ar <- abs re
  ai <- abs im
  if ar > ai then do
    x <- lutIndex (f32 (im / re))
    put mem k (f32 (magLUT x * ar))
    put mem (k + 1) (if re > 0.0 then phaseLUT x else f32 (3.141592653589793 + phaseLUT x))
  else if ai > 0.0 then do
    x <- lutIndex (f32 (re / im))
    put mem k (f32 (magLUT x * ai))
    put mem (k + 1) (f32 ((if im > 0.0 then 1.5707963267948966 else 4.71238898038469) - phaseLUT x))
  else do
    put mem k 0.0
    put mem (k + 1) 0.0
  polarBins mem n (i + 1) bins

-- (int32)(kPolarLUTSize2 + kPolarLUTSize2 * slope), in float
lutIndex :: Float -> Int
lutIndex slope = cInt (f32 (1024.0 + f32 (1024.0 * slope)))

phaseLUT, magLUT :: Int -> Float
phaseLUT i = f32 (catan (toFloat (i - 1024) * (1.0 / 1024.0)))
magLUT i = f32 (1.0 / ccos (catan (toFloat (i - 1024) * (1.0 / 1024.0))))

-- ToComplexApx of each bin, in place, from the sine table
toComplexApx :: Ptr () -> Ptr CFloat -> Int ->> ()
toComplexApx tb mem n = complexBins tb mem n 0 (div (n - 2) 2)

complexBins :: Ptr () -> Ptr CFloat -> Int -> Int -> Int ->> ()
complexBins tb mem n i bins = if i == bins then () else do
  k <- n + 2 + 2 * i
  mag <- at mem k
  ph <- at mem (k + 1)
  si <- cInt ((8192.0 / pi2) * ph) .&. 8191
  ci <- (si + 2048) .&. 8191
  put mem k (f32 (mag * sineAt tb ci))
  put mem (k + 1) (f32 (mag * sineAt tb si))
  complexBins tb mem n (i + 1) bins

-- the PV_ UGen on the buffer at mem n, of (n - 2) / 2 bins after dc and nyq
pvApply :: Ptr () -> Int -> Ptr CFloat -> Int -> Ptr (Ptr CFloat) -> Ptr Context ->> ()
pvApply st b mem n ins cx = do
  kind <- cInt (slot st (b + 1))
  bins <- div (n - 2) 2
  if kind == 1 then pvBrickWall mem n bins (cInt (f32 (in0 ins 1 * toFloat bins)))
  else if kind == 2 then pvRectComb mem n bins (f32 (in0 ins 1 / toFloat (bins + 1))) (in0 ins 2) (in0 ins 3)
  else if kind == 3 then do
    specPolar st b mem n
    w <- max 0 (min (cInt (in0 ins 1)) (bins - 1))
    smearBins mem n bins w (f32 (1.0 / toFloat (2 * w + 1))) 0
    specMove mem (3 * n + 2) (n + 2) (2 * bins)
  else if kind == 4 then do
    zeroBins mem (3 * n + 2) (2 * bins)
    shiftBins mem n bins (in0 ins 1) (in0 ins 3 > 0.0) 0 (in0 ins 2)
    specMove mem (3 * n + 2) (n + 2) (2 * bins)
  else if kind == 5 then pvBinScramble st b mem n bins ins cx
  else if kind == 6 then conformBins mem n bins (in0 ins 1) (in0 ins 2) 0
  else if kind == 7 then pvFreeze st b mem n bins (in0 ins 1)
  else if kind == 8 then do
    specPolar st b mem n
    nb <- cInt (f32 (toFloat bins / in0 ins 2))
    enhanceFrom mem n bins (in0 ins 1) (in0 ins 2) (in0 ins 3) nb
  else ()

-- PV_BrickWall: wipe > 0 zeroes the lowest wipe bins, < 0 the highest
pvBrickWall :: Ptr CFloat -> Int -> Int -> Int ->> ()
pvBrickWall mem n bins wipe = if wipe > 0 then do
    w <- min wipe bins
    put mem n 0.0
    zeroBins mem (n + 2) (2 * w)
    if w == bins then put mem (n + 1) 0.0 else ()
  else if wipe < 0 then do
    w <- max wipe (0 - bins)
    if w == 0 - bins then put mem n 0.0 else ()
    zeroBins mem (n + 2 + 2 * (bins + w)) (0 - 2 * w)
    put mem (n + 1) 0.0
  else ()

zeroBins :: Ptr CFloat -> Int -> Int ->> ()
zeroBins mem k c = if c <= 0 then () else do
  put mem k 0.0
  zeroBins mem (k + 1) (c - 1)

-- PV_RectComb: a bin whose comb phase passes width is zeroed
pvRectComb :: Ptr CFloat -> Int -> Int -> Float -> Float -> Float ->> ()
pvRectComb mem n bins freq phase width = do
  if phase > width then put mem n 0.0 else ()
  combBins mem n bins freq width (combStep phase freq) 0

combStep :: Float -> Float -> Float
combStep phase freq = case f32 (phase + freq) of
  p -> if p >= 1.0 then f32 (p - 1.0) else if p < 0.0 then f32 (p + 1.0) else p

combBins :: Ptr CFloat -> Int -> Int -> Float -> Float -> Float -> Int ->> ()
combBins mem n bins freq width phase i = if i == bins then (if phase > width then put mem (n + 1) 0.0 else ()) else do
  if phase > width then do
    put mem (n + 2 + 2 * i) 0.0
    put mem (n + 3 + 2 * i) 0.0
  else ()
  combBins mem n bins freq width (combStep phase freq) (i + 1)

-- PV_MagSmear: each magnitude the mean of its 2 w + 1 neighbours', into the
-- temporary buffer at 3 n
smearBins :: Ptr CFloat -> Int -> Int -> Int -> Float -> Int ->> ()
smearBins mem n bins w scale j = if j == bins then () else do
  put mem (3 * n + 2 + 2 * j) (f32 (smearSum mem n bins (j - w) (j + w) 0.0 * scale))
  put mem (3 * n + 3 + 2 * j) (at mem (n + 3 + 2 * j))
  smearBins mem n bins w scale (j + 1)

smearSum :: Ptr CFloat -> Int -> Int -> Int -> Int -> Float ->> Float
smearSum mem n bins p hi sum = if p > hi then sum else
  smearSum mem n bins (p + 1) hi (if p >= 0 && p < bins then f32 (sum + at mem (n + 2 + 2 * p)) else sum)

-- PV_BinShift: bin i to fpos = shift + i stretch, between two bins if interp
shiftBins :: Ptr CFloat -> Int -> Int -> Float -> Bool -> Int -> Float ->> ()
shiftBins mem n bins stretch interp i fpos = if i == bins then () else do
  re <- at mem (n + 2 + 2 * i)
  im <- at mem (n + 3 + 2 * i)
  if interp then do
    p0 <- cInt (cfloor fpos)
    beta <- f32 (fpos - cfloor fpos)
    alpha <- f32 (1.0 - beta)
    shiftAdd mem n bins p0 (f32 (alpha * re)) (f32 (alpha * im))
    shiftAdd mem n bins (p0 + 1) (f32 (beta * re)) (f32 (beta * im))
  else shiftAdd mem n bins (cInt (fpos + 0.5)) re im
  shiftBins mem n bins stretch interp (i + 1) (f32 (fpos + stretch))

shiftAdd :: Ptr CFloat -> Int -> Int -> Int -> Float -> Float ->> ()
shiftAdd mem n bins p re im = if p >= 0 && p < bins then do
    k <- 3 * n + 2 + 2 * p
    put mem k (f32 (at mem k + re))
    put mem (k + 1) (f32 (at mem (k + 1) + im))
  else ()

-- PV_BinScramble: to and from, bins each, at 4 n; chosen at the first
-- frame and at each rising trig
pvBinScramble :: Ptr () -> Int -> Ptr CFloat -> Int -> Int -> Ptr (Ptr CFloat) -> Ptr Context ->> ()
pvBinScramble st b mem n bins ins cx = do
  if slot st (b + 11) == 0.0 || slot st (b + 10) /= 0.0 then do
    setSlot st (b + 11) 1.0
    setSlot st (b + 10) 0.0
    scrambleIdentity mem (4 * n) 0 bins
    scrambleSwap mem (4 * n) cx 0 bins
    scrambleFrom mem (4 * n) cx (cInt (f32 (in0 ins 2 * toFloat bins))) 0 bins
  else ()
  sb <- cInt (f32 (toFloat bins * min (max (in0 ins 1) 0.0) 1.0))
  scrambleCopy mem n bins sb 0
  specMove mem (3 * n + 2) (n + 2) (2 * bins)

scrambleIdentity :: Ptr CFloat -> Int -> Int -> Int ->> ()
scrambleIdentity mem k i bins = if i == bins then () else do
  put mem (k + i) (toFloat i)
  scrambleIdentity mem k (i + 1) bins

scrambleSwap :: Ptr CFloat -> Int -> Ptr Context -> Int -> Int ->> ()
scrambleSwap mem k cx i bins = if i == bins then () else do
  j <- cInt (f32 (frand cx * toFloat (bins - i)))
  t <- at mem (k + i)
  put mem (k + i) (at mem (k + j))
  put mem (k + j) t
  scrambleSwap mem k cx (i + 1) bins

scrambleFrom :: Ptr CFloat -> Int -> Ptr Context -> Int -> Int -> Int ->> ()
scrambleFrom mem k cx width i bins = if i == bins then () else do
  t <- cInt (at mem (k + i))
  lo <- max 0 (t - width)
  hi <- min (bins - 1) (t + width)
  put mem (k + bins + i) (toFloat (cInt (f32 (f32 (frand cx * toFloat (hi - lo)) + toFloat lo))))
  scrambleFrom mem k cx width (i + 1) bins

scrambleCopy :: Ptr CFloat -> Int -> Int -> Int -> Int ->> ()
scrambleCopy mem n bins sb j = if j == bins then () else do
  t <- cInt (at mem (4 * n + j))
  f <- if j < sb then cInt (at mem (4 * n + bins + j)) else t
  put mem (3 * n + 2 + 2 * t) (at mem (n + 2 + 2 * f))
  put mem (3 * n + 3 + 2 * t) (at mem (n + 3 + 2 * f))
  scrambleCopy mem n bins sb (j + 1)

-- PV_ConformalMap: z to (z - a) / (1 - z conj a), a = real + i imag, with
-- the C's numi computed from the new numr
conformBins :: Ptr CFloat -> Int -> Int -> Float -> Float -> Int ->> ()
conformBins mem n bins r2 i2 i = if i == bins then () else do
  k <- n + 2 + 2 * i
  r1 <- at mem k
  i1 <- at mem (k + 1)
  nr0 <- f32 (r1 - r2)
  ni0 <- f32 (i1 - i2)
  dr0 <- f32 (1.0 - f32 (f32 (r1 * r2) + f32 (i1 * i2)))
  di <- f32 (f32 (r1 * i2) - f32 (r2 * i1))
  nr <- f32 (f32 (nr0 * dr0) + f32 (ni0 * di))
  ni <- f32 (f32 (ni0 * dr0) - f32 (nr * di))
  d2 <- max (f32 (f32 (dr0 * dr0) + f32 (di * di))) (f32 0.001)
  rd <- f32 (1.0 / d2)
  put mem k (f32 (nr * rd))
  put mem (k + 1) (f32 (ni * rd))
  conformBins mem n bins r2 i2 (i + 1)

-- PV_Freeze: mags, prevPhases and difPhases at 4 n, bins each
pvFreeze :: Ptr () -> Int -> Ptr CFloat -> Int -> Int -> Float ->> ()
pvFreeze st b mem n bins freeze = do
  specPolar st b mem n
  stage <- cInt (slot st (b + 6))
  if stage == 0 then setSlot st (b + 6) 1.0
  else if stage == 1 then do
    freezeSave mem n bins 0
    setSlot st (b + 7) (at mem n)
    setSlot st (b + 8) (at mem (n + 1))
    setSlot st (b + 6) 2.0
  else do
    if freeze > 0.0 then do
      freezeHold mem n bins (stage == 2) 0
      put mem n (slot st (b + 7))
      put mem (n + 1) (slot st (b + 8))
    else do
      freezeTrack mem n bins 0
      setSlot st (b + 7) (at mem n)
      setSlot st (b + 8) (at mem (n + 1))
    setSlot st (b + 6) 3.0

freezeSave :: Ptr CFloat -> Int -> Int -> Int ->> ()
freezeSave mem n bins i = if i == bins then () else do
  put mem (4 * n + i) (at mem (n + 2 + 2 * i))
  put mem (4 * n + bins + i) (at mem (n + 3 + 2 * i))
  freezeSave mem n bins (i + 1)

-- not frozen: the new mags, and phase differences
freezeTrack :: Ptr CFloat -> Int -> Int -> Int ->> ()
freezeTrack mem n bins i = if i == bins then () else do
  ph <- at mem (n + 3 + 2 * i)
  put mem (4 * n + i) (at mem (n + 2 + 2 * i))
  put mem (4 * n + 2 * bins + i) (f32 (ph - at mem (4 * n + bins + i)))
  put mem (4 * n + bins + i) ph
  freezeTrack mem n bins (i + 1)

-- frozen: the old mags; at stage 2 the phases as they come, else each
-- advanced by its difference and wrapped
freezeHold :: Ptr CFloat -> Int -> Int -> Bool -> Int ->> ()
freezeHold mem n bins second i = if i == bins then () else do
  put mem (n + 2 + 2 * i) (at mem (4 * n + i))
  if second then do
    ph <- at mem (n + 3 + 2 * i)
    put mem (4 * n + 2 * bins + i) (f32 (ph - at mem (4 * n + bins + i)))
    put mem (4 * n + bins + i) ph
  else do
    p0 <- f32 (at mem (4 * n + bins + i) + at mem (4 * n + 2 * bins + i))
    p1 <- if p0 > 3.141592653589793 then f32 (p0 - pi2) else p0
    p2 <- if p1 < -3.141592653589793 then f32 (p1 + pi2) else p1
    put mem (4 * n + bins + i) p2
    put mem (n + 3 + 2 * i) p2
  freezeHold mem n bins second (i + 1)

-- PV_SpectralEnhance: from bin j = bins / ratio down, partials i j ratio
-- below numPartials gain strength / i of bin j's magnitude
enhanceFrom :: Ptr CFloat -> Int -> Int -> Float -> Float -> Float -> Int ->> ()
enhanceFrom mem n bins parts ratio strength j = if j <= 0 then () else do
  -- the C reads bin bins, past the buffer, when ratio is 1: here silence
  cur <- if j < bins then at mem (n + 2 + 2 * j) else 0.0
  enhancePartial mem n bins parts ratio strength j cur 1
  enhanceFrom mem n bins parts ratio strength (j - 1)

enhancePartial :: Ptr CFloat -> Int -> Int -> Float -> Float -> Float -> Int -> Float -> Int ->> ()
enhancePartial mem n bins parts ratio strength j cur i = do
  p <- cInt (fromCFloat (croundf (toCFloat (f32 (toFloat (i * j) * ratio)))))
  if p < bins && toFloat i < parts then do
    k <- n + 2 + 2 * p
    -- sc3-plugins builds with contraction: one fmaf, as MembraneHexagon's
    put mem k (fromCFloat (cfmaf (toCFloat cur) (toCFloat (f32 (strength / toFloat i))) (toCFloat (at mem k))))
    enhancePartial mem n bins parts ratio strength j cur (i + 1)
  else ()
