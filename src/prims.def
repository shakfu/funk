/* P(c_name, funk_name, arity, type) -- primitives implemented in rt.c.
   One C function may serve several typed names: the Num, Eq, Ord and Show
   instances for Int, Float and Char in the prelude are built from them. */
P(addi, "primAddInt", 2, "Int -> Int -> Int")
P(addf, "primAddFloat", 2, "Float -> Float -> Float")
P(subi, "primSubInt", 2, "Int -> Int -> Int")
P(subf, "primSubFloat", 2, "Float -> Float -> Float")
P(muli, "primMulInt", 2, "Int -> Int -> Int")
P(mulf, "primMulFloat", 2, "Float -> Float -> Float")
P(negi, "primNegateInt", 1, "Int -> Int")
P(negf, "primNegateFloat", 1, "Float -> Float")
P(absi, "primAbsInt", 1, "Int -> Int")
P(absf, "primAbsFloat", 1, "Float -> Float")
P(fdiv, "/", 2, "Float -> Float -> Float")
P(div, "div", 2, "Int -> Int -> Int")
P(mod, "mod", 2, "Int -> Int -> Int")
P(quot, "quot", 2, "Int -> Int -> Int")
P(rem, "rem", 2, "Int -> Int -> Int")
P(eqw, "primEqInt", 2, "Int -> Int -> Bool")
P(eqf, "primEqFloat", 2, "Float -> Float -> Bool")
P(eqw, "primEqChar", 2, "Char -> Char -> Bool")
P(new, "primNeInt", 2, "Int -> Int -> Bool")
P(nef, "primNeFloat", 2, "Float -> Float -> Bool")
P(new, "primNeChar", 2, "Char -> Char -> Bool")
P(ltw, "primLtInt", 2, "Int -> Int -> Bool")
P(ltf, "primLtFloat", 2, "Float -> Float -> Bool")
P(ltw, "primLtChar", 2, "Char -> Char -> Bool")
P(lew, "primLeInt", 2, "Int -> Int -> Bool")
P(lef, "primLeFloat", 2, "Float -> Float -> Bool")
P(lew, "primLeChar", 2, "Char -> Char -> Bool")
P(gtw, "primGtInt", 2, "Int -> Int -> Bool")
P(gtf, "primGtFloat", 2, "Float -> Float -> Bool")
P(gtw, "primGtChar", 2, "Char -> Char -> Bool")
P(gew, "primGeInt", 2, "Int -> Int -> Bool")
P(gef, "primGeFloat", 2, "Float -> Float -> Bool")
P(gew, "primGeChar", 2, "Char -> Char -> Bool")
P(tofloat, "toFloat", 1, "Int -> Float")
P(floor, "floor", 1, "Float -> Int")
P(ceiling, "ceiling", 1, "Float -> Int")
P(round, "round", 1, "Float -> Int")
P(truncate, "truncate", 1, "Float -> Int")
P(sqrt, "sqrt", 1, "Float -> Float")
P(exp, "exp", 1, "Float -> Float")
P(log, "log", 1, "Float -> Float")
P(sin, "sin", 1, "Float -> Float")
P(cos, "cos", 1, "Float -> Float")
P(pow, "**", 2, "Float -> Float -> Float")
P(ord, "ord", 1, "Char -> Int")
P(chr, "chr", 1, "Int -> Char")
P(show, "primShowInt", 1, "Int -> String")
P(show, "primShowFloat", 1, "Float -> String")
P(show, "primShowChar", 1, "Char -> String")
P(showstr, "primShowString", 1, "String -> String")
P(showchars, "primShowCharList", 1, "[Char] -> String")
P(streq, "primEqString", 2, "String -> String -> Bool")
P(strne, "primNeString", 2, "String -> String -> Bool")
P(strlt, "primLtString", 2, "String -> String -> Bool")
P(strle, "primLeString", 2, "String -> String -> Bool")
P(strgt, "primGtString", 2, "String -> String -> Bool")
P(strge, "primGeString", 2, "String -> String -> Bool")
P(strappend, "primAppendString", 2, "String -> String -> String")
P(strlength, "primLengthString", 1, "String -> Int")
P(pack, "pack", 1, "[Char] -> String")
P(unpack, "unpack", 1, "String -> [Char]")
P(words, "words", 1, "String -> [String]")
P(unwords, "unwords", 1, "[String] -> String")
P(lines, "lines", 1, "String -> [String]")
P(unlines, "unlines", 1, "[String] -> String")
P(concatstr, "concatStrings", 1, "[String] -> String")
P(print, "primPrintInt", 1, "Int -> ()")
P(print, "primPrintFloat", 1, "Float -> ()")
P(print, "primPrintChar", 1, "Char -> ()")
P(contag, "primConTag", 1, "a -> Int")
P(putstr, "putStr", 1, "String -> ()")
P(putstrln, "putStrLn", 1, "String -> ()")
P(getline, "getLine", 1, "() -> String")
P(readint, "readInt", 1, "String -> Int")
P(readfloat, "readFloat", 1, "String -> Float")
P(error, "error", 1, "String -> a")
P(trace, "trace", 2, "String -> a -> a")
P(then, ">>", 2, "a -> b -> b")
