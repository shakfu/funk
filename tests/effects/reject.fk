-- Each binding below must be rejected by E (typed-effects.md): an effect reaches pure code.
apply f x = f x
r1 = apply print 3                                  -- higher-order argument
outer x = go x
  where go y = print y
r2 = outer 1                                        -- local function
data H = H (Int -> ())
r3 = H print                                        -- effectful function into a pure field
fs = [print]
r4 = head fs 1                                      -- function taken from a list
p = putStrLn
r5 = p "x"                                          -- a function value, called
r6 = let ap f x = f x in ap print 1                 -- local polymorphic function
twiceEff :: (Int -> ()) -> ()
twiceEff f = f 1
r7 = twiceEff print                                 -- argument of a signature's shared effect
wrap :: (Int -> ()) -> Int -> ()
wrap f n = print n                                  -- signature says pure, body prints
r8 = print 1 >> print 2                             -- sequencing
data R = R { act :: Int -> () }
r9 = R { act = print }                              -- effectful function into a record field
f1 n = g1 n
g1 n = if n == 0 then print n else f1 (n - 1)
r10 = f1 3                                          -- mutual recursion
r11 = map print [1, 2]                              -- effectful map, in a value
showAll :: Show a => [a] -> ()
showAll xs = mapM_ print xs                         -- class-constrained signature
class Shout a where
  shout :: a -> ()
instance Shout Bool where
  shout b = print b                                 -- instance of a pure method
mk n = \x -> print (x + n)
r12 = mk 1 2                                        -- returned function, called
main = ()
