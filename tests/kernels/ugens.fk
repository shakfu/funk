-- lib/dsp.fk over lib/kernels.fk, in the interpreter and compiled. Samples
-- print in units of 1e-4, so the C library's last bit cannot change them.
-- $KERNELS names the kernel library.
import graph as g
import dsp

foreign import ccall "stdlib.h getenv" getenv :: String ->> Ptr CChar

-- the next n frames, at most 64
frames :: g.Player -> Int ->> [Int]
frames p n = allocaBytes 256 (\out -> do
  g.render p out n
  map (\i -> round (10000.0 * fromCFloat (peekByteOff out (4 * i) :: CFloat))) (enumFromTo 0 (n - 1)))

-- the first n frames of s's channels, at most 64 each
channels :: g.Player -> Int -> Int -> g.Sig ->> [[Int]]
channels p k n s = do
  g.play p s
  allocaBytes (256 * k) (\out -> do
    bufs <- map (\c -> plusPtr out (256 * c)) (enumFromTo 0 (k - 1))
    g.renderChannels p bufs n
    map (\b -> map (\i -> round (10000.0 * fromCFloat (peekByteOff b (4 * i) :: CFloat))) (enumFromTo 0 (n - 1))) bufs)

both :: g.Player -> Int -> g.Sig ->> [[Int]]
both p n s = channels p 2 n s

-- skips n frames
skip :: g.Player -> Int ->> ()
skip p n = if n <= 0 then () else do
  frames p (min n 64)
  skip p (n - 64)

-- s's first n frames on a fresh graph: after silence, no state carries over
first :: g.Player -> Int -> g.Sig ->> [Int]
first p n s = do
  g.play p g.Silence
  frames p 0
  next p n s

-- s's next n frames: its nodes keep the states of the graph before's
next :: g.Player -> Int -> g.Sig ->> [Int]
next p n s = do
  g.play p s
  frames p n

-- the largest magnitude in s's frames from skipped to skipped + n
peak :: g.Player -> Int -> Int -> g.Sig ->> Int
peak p skipped n s = do
  g.play p s
  skip p skipped
  maximum (map abs (frames p n))

-- frame n of noise from seed 1, a state dsp.noise's map would not choose
noiseAt :: g.Player -> Int ->> Int
noiseAt p n = do
  g.play p g.Silence
  frames p 0
  g.play p (g.Node "dsp_noise" [1.0] [])
  skip p (n - 1)
  head (frames p 1)

-- [largest magnitude, mean, variance, correlation of two seeds, correlation
-- of neighbouring frames] over 6400 frames
noiseStats :: g.Player ->> [Int]
noiseStats p = do
  g.play p g.Silence
  frames p 0
  xs <- concat (map (\i -> both p 64 (dsp.stereo (dsp.noise 1) (dsp.noise 2))) (enumFromTo 1 100))
  ls <- concat (evens xs)
  rs <- concat (evens (drop 1 xs))
  n <- toFloat (length ls)
  u <- map (\x -> toFloat x / 10000.0) ls
  v <- map (\x -> toFloat x / 10000.0) rs
  dot <- \a b -> sum (zipWith (*) a b) / n
  scaled <- \x -> round (x * 10000.0)
  [maximum (map abs ls), scaled (sum u / n), scaled (dot u u), scaled (dot u v), scaled (dot u (drop 1 u ++ [0.0]))]

evens :: [a] -> [a]
evens xs = case xs of
  [] -> []
  x : rest -> x : evens (drop 1 rest)

-- 8 frames after a loud frame, with a 1 ms release at 8000 Hz: the level is
-- 1/e. At infinite ratio the gain is threshold / level, so 0.2 comes out
-- as 0.2 * 0.1 / 0.3679.
followed :: g.Player ->> Int
followed p = do
  g.play p g.Silence
  frames p 0
  c <- \x -> g.named "cmp" (dsp.compress (dsp.dc (-20.0)) (dsp.dc (1.0 / 0.0)) 0 (dsp.dc 0.001) x)
  g.play p (c 1)
  frames p 1
  g.play p (c (dsp.dc 0.2))
  head (drop 7 (frames p 8))

main = do
  k <- peekCString (getenv "KERNELS")
  p <- g.player [k] 8000.0 64
  -- 1000 Hz at 8000: eight frames a cycle. The saw's and square's jumps
  -- are smoothed over the frame on each side (polyBLEP); elsewhere exact.
  print (first p 8 (dsp.sine 1000))
  print (first p 8 (dsp.saw 1000))
  print (first p 8 (dsp.square 1000))
  print (first p 8 (dsp.pulse 1000 (dsp.dc 0.25)))
  -- arithmetic on signals, an Int literal as a constant
  print (first p 4 (dsp.dc 0.25 * 2 + 1 - dsp.dc 0.5))
  -- one-pole low-pass of a step: 1 - exp(-2 pi fc n / rate) at frame n
  print (first p 4 (dsp.lowpass1 1000 1))
  -- state-variable filters of a step, settled: gain 1, 0 and 0
  print (map (peak p 4000 8) [dsp.lowpass 1000 (dsp.dc 0.7) 1, dsp.bandpass 1000 (dsp.dc 0.7) 1, dsp.highpass 1000 (dsp.dc 0.7) 1])
  -- at the cutoff, a low-pass's gain is q: 0.7071 and 2, sampled within
  -- cos (pi / 8) of the peak
  print (map (\q -> peak p 4000 8 (dsp.lowpass 1000 (dsp.dc q) (dsp.sine 1000))) [0.7071, 2.0])
  -- frequency modulation: within [-1, 1]
  print (peak p 0 64 (dsp.sine (440 + dsp.sine 5 * 100)))
  -- an envelope at 1000 frames a second: 10 frames up, 10 down to 0.5,
  -- released 20 frames later over 5 (0.5 of a full scale in 10). The gate
  -- changes by playing again; the envelope is named, so it keeps its state.
  q <- g.player [k] 1000.0 64
  env <- \gate -> g.named "env" (dsp.adsr (dsp.dc 0.01) (dsp.dc 0.01) (dsp.dc 0.5) (dsp.dc 0.01) gate)
  print (first q 30 (env 1))
  print (next q 8 (env 0))
  -- a frequency changed: the saw keeps its phase, 3/8 of a cycle, and
  -- steps by 1/4 from there, named or not; unnamed, also inside a new node,
  -- as when a filter is put around it; after silence it starts again at 0
  osc <- \f -> g.named "osc" (dsp.saw f)
  first p 3 (osc 1000)
  print (next p 3 (osc 2000))
  first p 3 (dsp.saw 1000)
  print (next p 3 (dsp.saw 2000))
  first p 3 (dsp.saw 1000)
  print (next p 3 (dsp.saw 2000 * 1))
  print (first p 3 (dsp.saw 2000))
  -- two of one shape keep theirs in order: 1/8 and 1/4 of a cycle a frame
  first p 3 (dsp.saw 1000 + dsp.saw 2000 * 0)
  print (next p 1 (dsp.saw 1000 + dsp.saw 2000 * 0))
  -- a control: a gate on at frame 5 and off at 10, at 1000 frames a
  -- second; the envelope rises over 3 frames from frame 5 and falls over 2
  -- from frame 10
  r <- g.player [k] 1000.0 64
  g.play r (dsp.adsr (dsp.dc 0.003) 0 1 (dsp.dc 0.002) (g.control "gate" 0.0))
  g.send r 5 "gate" 1.0
  g.send r 10 "gate" 0.0
  print (frames r 14)
  print (g.frames r)
  -- channels: a node of a stereo input becomes two; a mono graph plays on
  -- both; pan; a named node of two channels keeps each one's phase (1/8
  -- and 1/4 of a cycle a frame, after 3 frames); a third channel wraps
  print (both p 4 (dsp.dc 0.5 * dsp.stereo 1 (dsp.dc 0.25)))
  print (both p 2 (dsp.dc 0.5))
  print (both p 2 (dsp.pan (dsp.dc 0.5) 1))
  oscs <- \f -> g.named "osc" (dsp.saw (dsp.stereo 1000 2000 * f))
  first p 3 (oscs 1)
  print (both p 2 (oscs (dsp.dc 1.0)))
  print (channels p 3 1 (dsp.stereo 1 2))
  -- noise: MINSTD's published 10,000th value from seed 1, 1043618065, in
  -- units of the output
  print (noiseAt p 10000)
  -- noise: within (-1, 1), mean near 0, variance near 1/3, and seeds and
  -- neighbouring frames uncorrelated; each in units of 1e-4
  print (noiseStats p)
  -- a saturator: tanh of 0, 0.5 and 100
  print (map (\x -> head (first p 1 (dsp.saturate 1 (dsp.dc x)))) [0.0, 0.5, 100.0, -100.0])
  -- 1 at threshold -20 dB, ratio 2, instant attack: 20 dB over goes in, 10 dB
  -- over comes out, 0.3162, on every frame; below the threshold, unchanged
  print (first p 2 (dsp.compress (dsp.dc (-20.0)) 2 0 (dsp.dc 0.1) 1))
  print (first p 2 (dsp.compress (dsp.dc (-20.0)) 2 0 (dsp.dc 0.1) (dsp.dc 0.05)))
  -- attack: one time constant, 8 frames at 8000 Hz, puts the level at
  -- 1 - 1/e, so at infinite ratio 1 comes out as 0.1 / 0.6321; release
  -- falls the same way
  print (head (drop 7 (first p 8 (dsp.compress (dsp.dc (-20.0)) (dsp.dc (1.0 / 0.0)) (dsp.dc 0.001) 0 1))))
  print (followed p)
  -- a limiter at -6 dB, 0.5012, of a full-scale sine and one at twice that
  -- and of that with a release too short to span one frame
  print (map (peak p 4000 64) [dsp.limit (dsp.dc (-6.0)) (dsp.dc 0.05) (dsp.sine 440), dsp.limit (dsp.dc (-6.0)) (dsp.dc 0.05) (dsp.sine 440 * 2), dsp.limit (dsp.dc (-6.0)) (dsp.dc 0.00005) (dsp.sine 440 * 2)])
  -- an exponential envelope at 1000 frames a second: attack in 5 frames to
  -- 1, then 60 dB of the way to 0.5 in 5, then release from 0.5
  envx <- \gate -> g.named "envx" (dsp.adsrExp (dsp.dc 0.005) (dsp.dc 0.005) (dsp.dc 0.5) (dsp.dc 0.005) gate)
  print (first q 12 (envx 1))
  print (next q 6 (envx 0))
  g.close p
  g.close q
  g.close r
