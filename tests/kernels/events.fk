-- The event layer (docs/dev/dirt-sound.md) on lib/kernels.fk, in the
-- interpreter and compiled: templates made per event from a pool, their
-- output delayed to the event's frame, modules in order, cut groups, a
-- global effect's parameter, late and dropped events, dirt_gate, and a
-- set replaced while its events play. tests/hosts/kitSounds, at 8000 Hz:
-- bd:0 is 0.25 and bd:1 0.5, 800 frames each, mono, so centred each
-- channel gets Pan2's 0.7071 of it: 0.1768 and 0.3535. Samples print in units of
-- 1e-4. $KERNELS names the kernel library.
import graph as g
import dsp as d
import control (..)
import pattern as pt

foreign import ccall "stdlib.h getenv" getenv :: String ->> Ptr CChar

-- the next n frames, at most 64, of channel 0 and channel 1
blockOf :: g.Player -> Int ->> ([Int], [Int])
blockOf p n = allocaBytes 512 (\out -> do
  l <- out
  r <- plusPtr out 256
  g.renderChannels p [l, r] n
  (map (\i -> round (10000.0 * fromCFloat (peekByteOff l (4 * i) :: CFloat))) (enumFromTo 0 (n - 1)),
   map (\i -> round (10000.0 * fromCFloat (peekByteOff r (4 * i) :: CFloat))) (enumFromTo 0 (n - 1))))

-- the next n frames of channel 0, in blocks of 64
chan0 :: g.Player -> Int ->> [Int]
chan0 p n = if n <= 0 then [] else do
  (l, r) <- blockOf p (min n 64)
  l ++ chan0 p (n - 64)

-- frames from at on, of channel 0: the first n
framesAt :: g.Player -> Int -> Int ->> [Int]
framesAt p at n = do
  f <- g.frames p
  skip <- chan0 p (at - f)
  chan0 p n

-- renders on to the next multiple of 64: the event layer renders whole
-- blocks, so an event for a frame before that is late
alignTo :: g.Player ->> ()
alignTo p = do
  f <- g.frames p
  chan0 p ((64 - mod f 64) `mod` 64)
  ()

kitSounds :: d.Dirt
kitSounds = d.loadSoundFiles "tests/hosts/samples" ["bd", "bd:1"] d.noDirt

always :: Controls -> Bool
always cs = True

-- x plus 0.1, and x times 2
plus :: d.Dirt -> d.Dirt
plus dt = d.addModule "plus" (\param x -> x + d.dc 0.1) always dt

double :: d.Dirt -> d.Dirt
double dt = d.addModule "double" (\param x -> x * d.dc 2.0) always dt

sample :: [(String, Float)]
sample = [("level", 1.0), ("pan", 0.5), ("speed", 1.0), ("begin", 0.0), ("end", 1.0), ("loop", 1.0),
  ("accelerate", 1.0e30), ("sustain", -1.0), ("unitCps", 0.0), ("~dirt_gate", 1.0)]

-- plays on to frame at, then prints the counts: playing, dropped, late
countsAt :: g.Player -> Int ->> ()
countsAt p at = do
  f <- g.frames p
  chan0 p (at - f)
  print (g.events p)

main = do
  k <- peekCString (getenv "KERNELS")
  p <- g.player [k] 8000.0 64
  d.playDirt p 8 kitSounds
  -- With no graph, the orbits play as they are. An event at frame 10: 10
  -- frames of silence, then bd:0, on both channels
  print (g.event p 10 "s.bd:0" sample)
  print (blockOf p 14)
  -- it ends with its sound: dirt_gate's sustain, 0.099 s as a float, is
  -- 791 frames, then 8 of fade
  print (framesAt p 802 8)
  countsAt p 900
  -- in a later block: frame 70 of the next 128, rendered in calls of 64
  alignTo p
  f <- g.frames p
  print (g.event p (f + 70) "s.bd:1" sample)
  print (framesAt p (f + 68) 4)
  countsAt p (f + 1000)
  -- modules, in the order added, run when "~NAME" is nonzero: (0.25 + 0.1) * 2
  d.playDirt p 8 (double (plus kitSounds))
  alignTo p
  f2 <- g.frames p
  print (g.event p f2 "s.bd:0" (sample ++ [("~plus", 1.0), ("~double", 1.0)]))
  print (framesAt p f2 2)
  countsAt p (f2 + 900)
  -- only those set: 0.25 * 2
  print (g.event p (f2 + 1000) "s.bd:0" (sample ++ [("~double", 1.0)]))
  print (framesAt p (f2 + 1000) 2)
  countsAt p (f2 + 1900)
  -- orderModules, as SuperDirt's: double, then plus, 0.25 * 2 + 0.1
  print (d.moduleNames (d.orderModules ["double", "plus"] (plus (double kitSounds))))
  print (d.moduleNames (d.orderModules ["double", "plus"] (double (plus kitSounds))))
  d.playDirt p 8 (d.orderModules ["double", "plus"] (double (plus kitSounds)))
  alignTo p
  f3 <- g.frames p
  print (g.event p (f3 + 5) "s.bd:0" (sample ++ [("~plus", 1.0), ("~double", 1.0)]))
  print (framesAt p (f3 + 5) 2)
  countsAt p (f3 + 1000)
  -- a full pool drops the newest event: the sound and dirt_gate, each in
  -- its size class of 4 slots, so the fifth is dropped
  d.playDirt p 4 kitSounds
  alignTo p
  f4 <- g.frames p
  print (map (\i -> g.event p (f4 + 1) "s.bd:0" sample) [1, 2, 3, 4, 5])
  print (framesAt p (f4 + 1) 1)
  countsAt p (f4 + 900)
  -- a source the set lacks is dropped too
  print (g.event p (f4 + 1000) "s.nosuch" sample)
  countsAt p (f4 + 1100)
  -- a cut group: the second event of cut 1 stops the first. As
  -- DirtGateCutGroup's, the first plays on through that block, then fades
  -- linearly over the next
  d.playDirt p 8 kitSounds
  alignTo p
  f5 <- g.frames p
  print (g.event p f5 "s.bd:0" (sample ++ [("cut", 1.0)]))
  print (g.event p (f5 + 128) "s.bd:1" (sample ++ [("cut", 1.0)]))
  print (framesAt p (f5 + 126) 4)
  print (framesAt p (f5 + 192) 3)
  print (framesAt p (f5 + 255) 2)
  countsAt p (f5 + 1100)
  -- a negative cut stops only its own source
  f6 <- g.frames p
  print (g.event p (f6 + 64) "s.bd:0" (sample ++ [("cut", -1.0)]))
  print (g.event p (f6 + 192) "s.bd:1" (sample ++ [("cut", -1.0)]))
  print (framesAt p (f6 + 256) 1)
  countsAt p (f6 + 1200)
  -- an event sets the graph's control oORBIT.NAME from its frame, a global
  -- effect's parameter; a graph that reads an orbit gets no orbits added
  g.play p (d.orbit 1 * d.dc 0.0 + g.control "o1.room" 0.0)
  alignTo p
  f7 <- g.frames p
  print (g.event p (f7 + 3) "s.bd:0" (sample ++ [("orbit", 1.0), ("room", 0.3)]))
  print (framesAt p f7 5)
  -- its orbit, read back: bd:0 on orbit 1
  g.play p (d.orbit 1)
  print (framesAt p (f7 + 64) 1)
  countsAt p (f7 + 1000)
  g.play p g.Silence
  -- an event that comes after its block rendered is late: it starts at the
  -- next block, without delay
  alignTo p
  f8 <- g.frames p
  chan0 p 64
  print (g.event p (f8 + 10) "s.bd:0" sample)
  print (framesAt p (f8 + 64) 2)
  countsAt p (f8 + 1000)
  -- a synth through dirt_gate: sustain 0.01 is 80 frames of 1.0, then 8 a
  -- sine's half, then it ends
  d.playDirt p 8 (d.addSynth "one" (\param -> d.dc 1.0) kitSounds)
  alignTo p
  f9 <- g.frames p
  print (g.event p f9 "s.one" [("sustain", 0.01), ("fadeTime", 0.001), ("fadeInTime", 0.0), ("level", 1.0), ("~dirt_gate", 1.0)])
  print (framesAt p (f9 + 70) 12)
  countsAt p (f9 + 200)
  -- a set replaced while its event plays: the event plays on to its end,
  -- and the new set's events play
  alignTo p
  f10 <- g.frames p
  print (g.event p f10 "s.bd:0" sample)
  chan0 p 100
  d.playDirt p 8 (d.loadSoundFiles "tests/hosts/samples" ["bd:1"] d.noDirt)
  print (g.event p (f10 + 200) "s.bd:1" sample)
  print (framesAt p (f10 + 199) 2)
  print (framesAt p (f10 + 801) 2)
  countsAt p (f10 + 1100)
  -- d.prepare marks what a Dirt plays: a sample, with the modules whose
  -- tests pass; a synth, with dirt_gate; a sound it lacks, unchanged
  dt <- d.addModule "lpf" (\param x -> x) (\cs -> case getControl "cutoff" cs of
      Just _ -> True
      Nothing -> False) (d.addSynth "one" (\param -> d.dc 1.0) kitSounds)
  print (controlPairs (d.prepare dt (controlsFromList [("s", VS "bd"), ("cutoff", VF 300.0)])))
  print (controlPairs (d.prepare dt (controlsFromList [("s", VS "one"), ("n", VF 3.0)])))
  print (controlPairs (d.prepare dt (controlsFromList [("s", VS "nosuch")])))
  print (map fst (d.templatesOf dt))
  -- and the records the hosts get: every number for the modules; a
  -- synth's key, sustain from legato, fades and freq from n
  print (recordsOf 1000 1000 500 (d.prepare dt (controlsFromList [("s", VS "bd"), ("cutoff", VF 300.0)])))
  print (recordsOf 1000 1000 500 (d.prepare dt (controlsFromList [("s", VS "one"), ("n", VF 9.0), ("legato", VF 0.5)])))
  -- a synth event's cycle is Tidal's: its whole's start, plus the ticks
  -- the pattern was shifted by, unless it has its own; a sample's has none
  print (cycles dt (s "one one bd") 0)
  print (cycles dt (s "one one bd") (3 * pt.cycleTicks))
  print (cycles dt (s "one" # pF "cycle" "7") 0)
  g.close p

-- the cycle parameter of each event the records of a cycle of pat carry,
-- written as funk-midi's slots write them for a pattern shifted ot ticks
cycles :: d.Dirt -> pt.Pattern Controls -> Int ->> [Float]
cycles dt pat ot = allocaBytes (24 * 256) (\buf -> do
  n <- writeControlEventsAt ot (d.prepare dt) buf 256 (pt.windowOnsets [] pat 1000 0 1000) 1000 1000
  paramsNamed "cycle" buf 0 (min n 256) [])

-- the values of the parameter called name, in order: a name's chunks
-- (tag 244) then its value (tag 245), a Float in the payload
paramsNamed :: String -> Ptr Int -> Int -> Int -> [Char] ->> [Float]
paramsNamed name buf i n acc = if i == n then [] else do
  tag <- (peekByteOff buf (i * 24 + 8) :: Int)
  if tag == 244 then paramsNamed name buf (i + 1) n (acc ++ unchunk (peekByteOff buf (i * 24 + 16) :: Int) 8)
  else if tag == 245 then (if acc == unpack name then [(peekByteOff buf (i * 24 + 16) :: Float)] else []) ++ paramsNamed name buf (i + 1) n []
  else paramsNamed name buf (i + 1) n []

-- a chunk's characters, low byte first, without its zero padding
unchunk :: Int -> Int -> [Char]
unchunk c k = if k == 0 || c == 0 then [] else chr (mod c 256) : unchunk (div c 256) (k - 1)
