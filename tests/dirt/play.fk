-- play.fk -- tests/dirt/oracle.py's cases through funk's event layer, with
-- SuperDirt's synths, core modules and global effects: each case on a player of
-- its own, seeded; its controls through d.prepare and control.fk's
-- soundParams, as the hosts send them, then g.event at its frame. Writes
-- both channels to $OUT/NAME.funk.wav, in blocks of 64 frames, each event
-- sent ahead of its frame as a host sends a window's, and prints
-- "case NAME CPU", CPU the renders' nanoseconds. $KERNELS names the kernel
-- library; the cases module is oracle.py's. A case loads its names from its
-- folder; an event plays its own sound, or the case's if "".
import graph as g
import dsp as d
import control (..)
import cases (..)

foreign import ccall "stdlib.h getenv" getenv :: String ->> Ptr CChar

-- oracle.py's vowel index as the vowel
vowelName :: Int -> String
vowelName i = case i of
  0 -> "a"
  1 -> "e"
  2 -> "i"
  3 -> "o"
  _ -> "u"

caseNumber :: String -> Float -> [(String, Float)] -> Float
caseNumber k v ps = case lookup k ps of
  Just x -> x
  Nothing -> v

-- an event of its sound, or else s, at frame f, after t seconds
playEvent :: g.Player -> d.Dirt -> String -> Int -> (Float, String, [(String, Float)]) ->> Bool
playEvent p dt s0 f (t, own, ps) = do
  s <- if own == "" then s0 else own
  ups <- 1000000
  cs <- d.prepare dt (controlsFromList (("s", VS s) : map (\(k, v) -> if k == "unitc" then ("unit", VS "c") else if k == "units" then ("unit", VS "s") else if k == "vowel" then (k, VS (vowelName (round v))) else (k, VF v)) ps))
  g.event p (f + round (t * 44100.0)) ("s." ++ (if getControl "_synth" cs /= Nothing then s else sampleKey s (truncate (caseNumber "n" 0.0 ps)))) (soundParams ups (round (toFloat ups / caseNumber "cps" 1.0 ps)) (round (toFloat ups * caseNumber "delta" 1.0 ps)) cs)

-- frames rendered to path before each event: up to AHEAD frames before its
-- frame, on the 64-frame grid, so the host's queue holds a window's events
ahead :: Int
ahead = 4096

-- es sent in turn, rendering to path between them: the frames rendered, their
-- CPU nanoseconds or -1, and whether every event was taken
sendAll :: g.Player -> d.Dirt -> String -> String -> Int -> Int -> Bool -> [(Float, String, [(String, Float)])] ->> (Int, Int, Bool)
sendAll p dt s path done cpu ok [] = (done, cpu, ok)
sendAll p dt s path done cpu ok ((t, own, ps) : rest) = do
  target <- max done (((round (t * 44100.0) - ahead) `div` 64) * 64)
  c <- if target > done then g.renderWav p path (target - done) (done > 0) else 0
  sent <- playEvent p dt s 0 (t, own, ps)
  sendAll p dt s path target (if cpu < 0 || c < 0 then -1 else cpu + c) (ok && sent) rest

-- a case on a player of its own, seeded, so its effects start fresh, as
-- render.scd's orbits do: the frames of secs seconds from the start
playCase :: String -> String -> (String, String, Float, [(Float, String, [(String, Float)])], Bool, String, [String]) ->> ()
playCase k out (name, s, secs, es, core, dir, names) = do
  p <- g.player [k] 44100.0 64
  g.seed p seed
  dt <- d.loadSoundFiles dir names (if core then d.superDirtCore else d.superDirt)
  d.playDirt p 256 dt
  (done, cpu, ok) <- sendAll p dt s (out ++ "/" ++ name ++ ".funk.wav") 0 0 True es
  c <- g.renderWav p (out ++ "/" ++ name ++ ".funk.wav") (round (secs * 44100.0) - done) (done > 0)
  cpu <- if cpu < 0 || c < 0 then -1 else cpu + c
  putStrLn ("case " ++ name ++ (if not ok then " refused" else if cpu < 0 then " unwritten" else " " ++ show cpu))
  g.close p

main = do
  k <- peekCString (getenv "KERNELS")
  out <- peekCString (getenv "OUT")
  mapM_ (playCase k out) cases
