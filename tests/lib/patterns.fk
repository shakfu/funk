-- lib/pattern.fk (docs/dev/patterns.md): combinators, a 3:5:7 polyrhythm
-- exact over 1000 cycles, and onsets queried in blocks equal, as a set, to one query;
-- in ticks, and in samples at 12345 samples per cycle, which rounds. Then
-- application and joins, as Tidal's, patterned arguments, mini-notation,
-- and their onsets in blocks.
import pattern as p

t = p.cycleTicks

brief :: p.Event a -> (Int, Int, a)
brief e = (e.whole.start, e.whole.stop, e.value)

starts :: p.Pattern a -> Int -> Int -> [(Int, Int, a)]
starts pat a b = map brief (p.onsets pat (p.Span a b))

-- the onsets of [a, b) queried in blocks of n ticks
blocked :: p.Pattern a -> Int -> Int -> Int -> [(Int, Int, a)]
blocked pat n a b = if a >= b then [] else starts pat a (min b (a + n)) ++ blocked pat n (a + n) b

poly = p.stack [p.fastcat (replicate 3 (p.atom 3)), p.fastcat (replicate 5 (p.atom 5)), p.fastcat (replicate 7 (p.atom 7))]

-- a step of 720720 / 17 ticks rounds; the others are exact
mixed = p.stack [p.fast 17 (p.atom 'r'), p.slow 3 (p.fastcat (map p.atom (unpack "abcde"))), p.shift 1000 (p.euclid 3 8 'e')]

fs = p.fastcat [p.atom (+ 10), p.atom (+ 20)]
xs = p.fastcat [p.atom 1, p.atom 2, p.atom 3]
pp = p.fastcat [p.atom (p.fastcat (map p.atom (unpack "abc"))), p.atom (p.fastcat (map p.atom (unpack "xy")))]

-- onsets over 20 cycles, and whether blocks of 7919 ticks give the same
same :: Ord a => p.Pattern a -> (Int, Bool)
same pat = case starts pat 0 (20 * t) of
  w -> (length w, sort (blocked pat 7919 0 (20 * t)) == sort w)

abc = p.fastcat (map p.atom (unpack "abc"))
-- the values of the onsets in the first c cycles
vals :: String -> Int -> [Int]
vals s c = map (\(_, _, v) -> v) (starts (p.mini s) 0 (c * t))

-- a fragment's part
frag :: p.Event a -> (Int, Int)
frag e = (e.part.start, e.part.stop)

-- a step of 1/17 cycle rounds, and squeezes a third of it
nested = p.stack [p.fast 17 (p.atom abc), p.slow 3 (p.atom (p.fast 5 (p.atom 'z')))]

-- the sample onsets of [a, b) in blocks of n samples
sblocked :: p.Pattern a -> Int -> Int -> Int -> [(Int, a)]
sblocked pat n a b = if a >= b then [] else p.sampleOnsets pat 12345 a (min b (a + n)) ++ sblocked pat n (a + n) b

main = do
  print (starts (p.fastcat (map p.atom (unpack "abc"))) 0 t)
  print (starts (p.euclid 3 8 'x') 0 t)
  print (starts (p.cat [p.atom 'a', p.slow 2 (p.atom 'b')]) 0 (4 * t))
  print (map brief (p.query (p._slow 2 (p.atom 'b')) (p.Span (div t 2) (t + div t 2))))
  print (starts (p.mapP (* 2) (p.shift (-10) (p.fast 2 (p.atom 1)))) 0 t)
  print (starts (p.fastcat [p.atom 'a', p.silence]) t (2 * t))
  let es = starts poly 0 (1000 * t)
  print (length es, all (\(s, e, n) -> mod s (div t n) == 0 && e - s == div t n) es)
  let whole = starts mixed 0 (20 * t)
  print (length whole, sort (blocked mixed 7919 0 (20 * t)) == sort whole)
  let ss = p.sampleOnsets poly 12345 0 (20 * 12345)
  print (length ss, sblocked poly 64 0 (20 * 12345) == ss, take 4 ss)
  print (map (\x -> (p.eventSample x, p.eventValue x)) [p.encodeEvent 0 7, p.encodeEvent 123456789 65535])
  print (starts (p.apP fs xs) 0 t)
  print (starts (p.apLeft fs xs) 0 t)
  print (starts (p.apRight fs xs) 0 t)
  print (starts (p.joinP pp) 0 t)
  print (starts (p.innerJoin pp) 0 t)
  print (starts (p.outerJoin pp) 0 t)
  print (starts (p.squeezeJoin pp) 0 t)
  print (starts (p.squeezeJoin (p.atom (p.cat [p.atom 'a', p.atom 'b']))) 0 (2 * t))
  print (map same [p.joinP nested, p.innerJoin nested, p.outerJoin nested, p.squeezeJoin nested])
  print (map same [p.apP (p.fast 17 (p.atom id)) abc, p.apLeft (p.fast 17 (p.atom id)) abc, p.apRight (p.fast 17 (p.atom id)) abc])
  print (starts (p.fast (p.fastcat [1, 3]) (p.atom 'a')) 0 t)
  print (starts (p.fast 0 (p.atom 'a')) 0 t, starts (p.fast (1 + 1) (p.atom 'a')) 0 t)
  print (starts (p.shift (p.fastcat [0, 1000]) (p.fastcat (map p.atom (unpack "ab")))) 0 t)
  print (starts (p.fastcat [1, 2] + 10) 0 t)
  print (map frag (p.query (p.slow 2 (p.atom 'b')) (p.Span (div t 2) (t + div t 2))))
  print (same (p.fast (p.cat [1, 17, 3]) abc))
  print (starts (p.mini "60 [64 67] ~") 0 t)
  print (starts (p.mini "<60 62> 64") 0 (2 * t))
  print (starts (p.mini "60*2 64/2") 0 (2 * t))
  print (starts (p.mini "60@3 64") 0 t == starts (p.mini "60 _ _ 64") 0 t, starts (p.mini "60@3 64") 0 t)
  print (starts (p.mini "60!3 64") 0 t, starts (p.mini "60 ! 64") 0 t)
  print (starts (p.mini "60(3,8)") 0 t == starts (p.euclid 3 8 60) 0 t, starts (p.mini "60, 64 67") 0 t)
  print (starts (p.mini "60*<2 3>") 0 (2 * t))
  print (starts (p.mini "<60@2 64>") 0 (3 * t), starts (p.mini "") 0 t, starts (p.mini " -1 ") 0 t)
  print (same (p.mini "<60 [62 64]*17> 67(5,8) [72, 74@2 76]/3"))
  print (vals "c e g a4 cs5 ef3 bn" 1, vals "c'maj e4'min7 'dim" 1)
  print (vals "c'maj'ii c'maj'o c'maj'5 c'major7'd1" 1, vals "c'<maj min>" 2)
  print (vals "0 .. 3 5 .. 2" 1, starts (p.mini "60 61 . 62 63 64") 0 t)
  print (starts (p.mini "{60 61 62, 70 71}") 0 t, starts (p.mini "{60 61 62}%4") 0 t)
  print (map (\m -> map (\(s, _, _) -> div s 90090) (starts (p.mini m) 0 t)) ["60(5,8)", "60(5,8,2)", "60(-3,8)"], p.bjorklund 7 12)
  print (starts (p.mini "60(<3 5>,8)") 0 (2 * t))
  print (starts (p.mini "60@1.5 61") 0 t, starts (p.mini "60 - 61") 0 t)
  print (map (\x -> p.randAt x 3) [0, 720720, -5000, 123457, 1000000000], p.randAt 0 0)
  print (length (starts (p.mini "60*16?") 0 (8 * t)), length (starts (p.mini "60*16?0.25") 0 (8 * t)), vals "60 | 61 | 62" 12)
  print (same (p.mini "60*16? [61 | 62 63](3,8,<0 1>) {64 65 66}%<4 5> c'<maj min7>'<ii o> 0 .. 5 . 70@1.5 _ 71"))
