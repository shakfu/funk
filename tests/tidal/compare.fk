  outC "rtrigger" 2 rS [("_t_pattern", p.CtlF 1.6)] (p.rtrigger (p.slow 4 abcd))
  outC "ftrigger" 2 rS [("_t_pattern", p.CtlF 1.6)] (p.ftrigger (p.slow 4 abcd))
  outC "mtrigger" 2 rS [("_t_pattern", p.CtlF 5.5)] (p.mtrigger 4 (p.slow 4 abcd))
  outC "fastcI" 1 rS [("f", p.CtlI 2)] (p.fast (toFloat <$> p.cI 1 "f") abcd)
  outC "rangecF" 1 rF [("x", p.CtlF 0.5)] (p.segment 2 (p.range 1.0 (p.cF 3.0 "y") (p.cF 0.0 "x")))
  outC "everytrig" 4 rS [("_t_pattern", p.CtlF 1.0)] (p.every 2 (p.fast 2) (p.trigger (p.slow 2 abcd)))
  outC "juxcF" 1 rC [("p", p.CtlF 0.25)] (jux p.rev (pS "s" (p.fastFromList ["a", "b"]) # pF "pan" (p.cF 0.0 "p")))
  out "fastFrac" 2 rS (p.fast 1.5 abcd)
  out "slowFrac" 3 rS (p.slow 1.5 abcd)
  out "slowPat" 4 rS (p.slow "<1.5 0.75>" abcd)
  out "slowLit" 4 rS (p.slow (p.cat [1.5, 0.6]) abcd)
  out "fastNeg" 1 rS (p.fast (-1.5) abcd)
  out "slowNeg" 2 rS (p.slow (-2) abcd)
  out "fastZero" 1 rS (p.fast "0 1" abcd)
  out "fastThird" 3 rS (p.fast (1/3) abcd)
  out "fastSeg" 2 rS (p.fast (p.segment 2 (p.range 1 2 p.saw)) abcd)
  out "plyFrac" 2 rS (p.ply 1.5 (p.fastFromList ["a", "b"]))
  out "segmentFrac" 2 rI (p.segment 1.5 (p.atom 1))
  out "fastGapFrac" 2 rS (p.fastGap 1.5 abcd)
  out "fastSqueezeFrac" 1 rS (p.fastSqueeze (p.fastFromList [1, 1.5]) abcd)
  out "hurryFrac" 2 rC (hurry 1.5 bdsn)
  out "loopAtFrac" 3 rC (loopAt 1.5 (chop 2 (sa "break")))
  out "smashFrac" 3 rC (smash 2 [1.5, 0.5] (sa "a"))
  out "timeCatFrac" 2 rS (p.timeCat [(1.5, p.fastFromList ["a", "b"]), (0.5, abcd)])
  out "fmapOp" 1 rI ((+ 1) <$> nums)
  out "fmap" 1 rI (p.fmap (* 2) nums)
  out "constOp" 1 rS ("x" <$ abcd)
  out "pure" 2 rI (p.pure 3)
  out "apBothOp" 2 rI ((+) <$> p.fastFromList [1, 2] <*> p.fastFromList [10, 20, 30])
  out "apLeftOp" 2 rI ((+) <$> p.fastFromList [1, 2] <* p.fastFromList [10, 20, 30])
  out "apRightOp" 2 rI ((+) <$> p.fastFromList [1, 2] *> p.fastFromList [10, 20, 30])
  out "apSqueezeOp" 2 rI ((+) <$> p.fastFromList [1, 2] <<* p.fastFromList [10, 20, 30])
  out "apLeftSine" 1 rF ((+) <$> p.fastFromList [1.0, 2.0] <* p.sine)
  out "liftA2" 1 rI (p.liftA2 (+) (p.fastFromList [1, 2]) (p.fastFromList [10, 20, 30]))
  out "bindOp" 2 rI (p.slow 2 (p.fastFromList [1, 2]) >>= \x -> p.fastFromList [x, x * 10, x * 100])
  out "opsChain" 2 rI ((+) <$> p.slow 2 nums <* p.fastFromList [10, 20] + p.pure 1)
  outC "cFpat" 2 rF [("x", p.CtlP (p.mapP p.CtlF (p.fastFromList [0.25, 0.5])))] (p.cF 0.0 "x")
  outC "cFpatfast" 1 rF [("x", p.CtlP (p.mapP p.CtlF (p.slow 2 (p.fastFromList [0.25, 0.5]))))] (p.fast 2 (p.cF 0.0 "x"))
  outC "cFpatseg" 1 rF [("x", p.CtlP (p.mapP p.CtlF (p.fastFromList [0.25, 0.5])))] (p.segment 1 (p.cF 0.0 "x"))
  outC "cIpat" 1 rI [("x", p.CtlP (p.mapP p.CtlF (p.fastFromList [1.5, 2.7])))] (p.cI 0 "x")
  outC "cSpat" 1 rS [("x", p.CtlP (p.fastFromList [p.CtlS "a", p.CtlF 1.0, p.CtlS "b"]))] (p.cS "d" "x")
  outC "cSpat_" 1 rS [("x", p.CtlP (p.fastFromList [p.CtlS "a", p.CtlF 1.0, p.CtlS "b"]))] (p.cS_ "x")
  outC "cBpat" 1 rS [("b", p.CtlP (p.mapP p.CtlB (p.fastFromList [True, False, True])))] (p.struct (p.cB_ "b") abcd)
  outC "cBpat0" 1 rS [("b", p.CtlP (p.mapP p.CtlB (p.fastFromList [True, False])))] (p.struct (p.cB0 "b") abcd)
  outC "cFpatctl" 1 rF [("x", p.CtlP (p.mapP p.CtlF (p.cF 7.0 "y"))), ("y", p.CtlF 1.0)] (p.cF 0.0 "x")
  out "litFast" 2 rS (p.fast "<2 4>" "a b")
  out "litEvery" 3 rI (p.every "<2 3>" p.rev "0 1 2")
  out "litShift" 2 rS ("<0 0.25>" <~ "bd sn")
  out "litInt" 1 rI "c e g'maj ~ -3"
  out "litFloat" 1 rF "0.5 e 1%4 -2.25"
  out "litString" 1 rS "bd*2 [hh sn:3] . cp"
