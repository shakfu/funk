  out "ctxTimeCat" 1 rS (p.timecat [(1, "a b"), (2, "c")])
  out "ctxChop" 1 rC (chop "<2 3>" (s "a b"))
  out "ctxStriate" 1 rC (striate 2 (s "a b"))
  out "ctxSplice" 1 rC (splice 4 "0 2" (s "a"))
  out "ctxJux" 1 rC (jux p.rev (s "a b"))
  out "ctxSuperimpose" 1 rS (p.superimpose (p.fast "2") "a b")
  out "ctxInside" 1 rS (p.inside 2 p.rev "a b c d")
  out "ctxStruct" 1 rS (p.struct "t f t(3,8)" "a")
  out "ctxMask" 1 rS (p.mask "1 0 1" "a*6")
  out "ctxEuclidFull" 1 rS (p.euclidFull 3 8 "a" "b")
  out "ctxWhile" 1 rS (p.while "1 0" (p.fast 2) "a b")
  out "ctxBind" 1 rS ("a b" >>= (\v -> if v == "a" then "x y" else "z"))
  out "ctxSetContext" 1 rS (p.setContext (p.Context [((9, 9), (10, 9))]) "a b")
  out "ctxWithContext" 1 rS (p.withContext (\c -> p.Context (reverse c.contextPosition)) ("a b" |< "c d e" :: p.Pattern String))
  out "ctxDelta" 1 rS (p.deltaContext 2 3 "a b")
  out "ctxVar" 1 rS (("^x a" :: p.Pattern String))
  out "ctxWchoose" 2 rS (p.segment 2 (p.wchoose [("a", 1), ("b", 2)]))
  putStrLn ("ctxDeltaMini " ++ p.deltaMini "d1 $ s \"a b\"\n  # n \"1\"")
