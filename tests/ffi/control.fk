-- A ring from funk's thread to a foreign export and one back, and a
-- wavetable Array (docs/dev/realtime.md), with tests/ffi/fkt.h's audio host.
-- funk pushes 50 gains before the host starts; the export takes one per
-- block, plays the wavetable through readArrayWrap, and every 100 blocks
-- pushes the block's number back. funk's thread collects meanwhile.
foreign export ccall "fk_voice" voice :: Ptr () -> Ptr CFloat -> CInt ->> ()
foreign import ccall "fkt.h &fk_voice" voicePtr :: FunPtr (Ptr () -> Ptr CFloat -> CInt ->> ())
foreign import ccall "fkt.h fkt_audio_start" audioStart :: FunPtr (Ptr () -> Ptr CFloat -> CInt ->> ()) -> Ptr () -> CInt -> CInt ->> CInt
foreign import ccall "fkt.h fkt_audio_join" audioJoin :: () ->> Float

-- the context, laid out by C
foreign struct Voice
  { gains :: Ring CFloat     -- from funk
  , blocks :: Ring CInt      -- to funk
  , table :: Array CFloat
  , gain :: CFloat
  , count :: Int             -- blocks played
  , pos :: Int               -- in the wavetable
  }

blockSamples :: Ptr CFloat -> Array CFloat -> Int -> Int -> Int -> CFloat ->> Int
blockSamples out table pos i n gain =
  if i == n then pos
  else do
    pokeByteOff out (i * 4) (gain * readArrayWrap table pos)
    blockSamples out table (pos + 1) (i + 1) n gain

voice :: Ptr () -> Ptr CFloat -> CInt ->> ()
voice ctx out n = do
  st <- (castPtr ctx :: Ptr Voice)
  gains <- readField st Voice.gains
  if ringCount gains > 0 then do
    writeField st Voice.gain (ringFront gains)
    ringDrop gains
  else ()
  writeField st Voice.pos (blockSamples out (readField st Voice.table) (readField st Voice.pos) 0 (fromIntegral n) (readField st Voice.gain))
  k <- readField st Voice.count
  writeField st Voice.count (k + 1)
  if mod k 100 == 0 then ringPush (readField st Voice.blocks) (fromIntegral k) else False
  ()

churn :: Int -> Int -> Int
churn k acc = if k == 0 then acc else churn (k - 1) (acc + length (reverse (enumFromTo 1 1000)))

drain :: Ring CInt -> [CInt] ->> [CInt]
drain r acc = if ringCount r == 0 then reverse acc else do
  x <- ringFront r
  ringDrop r
  drain r (x : acc)

main = do
  gains <- newRing 64 (toCFloat 0.0)
  blocks <- newRing 64 (0 :: CInt)
  table <- newArray 100 (toCFloat 0.0)
  mapM_ (\i -> writeArray table i (toCFloat (toFloat i * 0.01))) (enumFromTo 0 99)
  print (length (filter (\g -> ringPush gains (toCFloat g)) (map (\k -> toFloat k * 0.5) (enumFromTo 1 50))))
  st <- (mallocBytes Voice.size :: Ptr Voice)
  writeField st Voice.gains gains
  writeField st Voice.blocks blocks
  writeField st Voice.table table
  writeField st Voice.gain (toCFloat 0.0)
  writeField st Voice.count 0
  writeField st Voice.pos 0
  print (audioStart voicePtr (castPtr st) 64 2000)
  print (churn 3000 0)
  print (audioJoin ())
  print (drain blocks [])
  print (ringCount gains)
