-- The queued-callback ring (realtime.md, R3), with tests/ffi/fkt.h: 5000
-- messages sent before funk reads any fill the 4096 slots and drop the
-- rest, counted; messages of 300 bytes do not fit a slot and are copied
-- outside it.
-- the header's struct, its layout from C, with members inside an anonymous union
foreign struct "fkt.h fkt_config" Config
  { version :: CInt
  , context "on_message.context" :: Ptr ()
  , callback "on_message.callback" :: FunPtr (Ptr () -> CLLong -> CStringLen -> ())
  , count :: CInt
  , length :: CInt
  }
foreign import ccall "fkt.h FKT_V1" v1 :: CInt
foreign import ccall "fkt.h fkt_start" start :: Ptr () ->> CInt
foreign import ccall "fkt.h fkt_join" join :: () ->> ()
foreign import ccall "queue" messageCb :: FunPtr (Ptr () -> CLLong -> CStringLen -> ())

-- send count messages of length bytes from the library's thread, and wait for it
send :: Ptr () -> CInt -> CInt ->> CInt
send ctx count len = allocaBytes Config.size (\cfg -> do
  writeField cfg Config.version v1
  writeField cfg Config.context ctx
  writeField cfg Config.callback messageCb
  writeField cfg Config.count count
  writeField cfg Config.length len
  rc <- start (castPtr cfg)
  join ()
  rc)

ignore :: CLLong -> String ->> ()
ignore _ _ = ()

describe :: CLLong -> String ->> ()
describe ts bytes = print (ts, length bytes, sum (map ord (unpack bytes)))

-- run the queued events, counting them
drain :: Int ->> Int
drain k = if pollEvent () then drain (k + 1) else k

main = do
  quiet <- newStablePtr ignore
  print (send (castStablePtrToPtr quiet) 5000 0)
  print (drain 0, droppedEvents ())
  loud <- newStablePtr describe
  print (send (castStablePtrToPtr loud) 2 300)
  print (drain 0, droppedEvents ())
