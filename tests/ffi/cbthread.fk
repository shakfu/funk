-- expect: callback `cb` was called on a thread other than funk's
-- A direct callback called from another thread ends the program.
foreign import ccall "fkt.h fkt_other_thread" other :: Ptr () -> FunPtr (Ptr () -> CInt ->> ()) ->> ()
foreign import ccall "callback" cb :: FunPtr (Ptr () -> CInt ->> ())

main = do
  sp <- newStablePtr (\i -> print (i :: CInt))
  other (castStablePtrToPtr sp) cb
