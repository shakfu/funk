-- The C types of foreign imports: arithmetic wraps to the C width; CSize and
-- CULong compare and show unsigned; CFloat shows float digits.
main = do
  print (fromIntegral (-1 :: Int) :: CUInt, fromIntegral (-1 :: Int) :: CSize, fromIntegral (-1 :: Int) :: CULong)
  print ((0 :: CSize) - 1 > 5, (0 :: CInt) - 1 < 5, (2147483647 :: CInt) + 1)
  print (toCFloat 0.1, fromCFloat (toCFloat 0.1), toCFloat 0.1 * 3, negate (toCFloat 2.5))
  print (map (\x -> x * x) [1, 2, 3 :: CLong], sum [1, 2, 3 :: CUInt], abs (-4 :: CInt))
  print (show (Just (-3 :: CInt)), toInt (7 :: CSize) + 1, fromIntegral (65 :: CInt) == (65 :: Int))
  -- atomic peek and poke round-trip each width
  print (alloca (\p -> do { atomicPoke p (-5 :: CInt); atomicPeek p }), alloca (\p -> do { atomicPoke p (4000000000 :: CUInt); atomicPeek p }))
  print (alloca (\p -> do { atomicPoke p (toCFloat 0.1); atomicPeek p }), alloca (\p -> do { atomicPoke p (-4611686018427387905 :: Int); atomicPeek p }))
  print (alloca (\p -> do { atomicPoke p 2.5e300; atomicPeek p }), alloca (\p -> do { atomicPoke p (100 :: CChar); atomicPeek p }))
  print (truncateSat 2.9, truncateSat (-2.9), truncateSat 1.0e30, truncateSat (-1.0e30), truncateSat (0.0 / 0.0))
  -- atomic read-modify-write: the old value, and whether a swap happened
  print (alloca (\p -> do { atomicPoke p (5 :: CInt); old <- atomicAdd p 3; (old, atomicPeek p) }))
  print (alloca (\p -> do { atomicPoke p (2147483647 :: CInt); atomicAdd p 1; atomicPeek p }))
  print (alloca (\p -> do { atomicPoke p (toCFloat 1.5); old <- atomicAdd p (toCFloat 0.25); (old, atomicPeek p) }))
  print (alloca (\p -> do { atomicPoke p (7 :: Int); a <- atomicCompareSwap p 6 9; b <- atomicCompareSwap p 7 9; (a, b, atomicPeek p) }))
  print (alloca (\p -> do { atomicPoke p 0.5; a <- atomicCompareSwap p 0.5 2.0; (a, atomicPeek p) }))
