f x = case x of Just y -> y; Nothing -> 0
g x = let a = 1; b = 2 in a + b + x
h x = (case x of [] -> "empty"; _ -> "full", 42)
k x = if x > 0 then case x of 1 -> "one"; _ -> "many" else "none"
m x =
  let y = x * 2
      z = y + 1
  in z * z
n x = go x
  where go 0 = "done"
        go i = go (i - 1)
secs = (map (subtract 1) [1, 2], map (`div` 2) [7, 9], map (2 -) [1], (- 5), map (: []) (unpack "ab"))
negs = (-3 + 4, - 2 ^ 2, abs (-7), negate 2.5)
dollar = show $ sum $ map (* 2) [1, 2, 3]
strs = ("tab\there", 'q', "quote\"s", show "nested", "\65\66")
chain = [1..5] |> map (\x -> x * x) |> filter odd |> foldr (+) 0
ranges = ([1, 3..11], [10, 8..1], [1.0..3.0])
-- Top-level values are pure, so effects run from main, in its order.
main = early () >> results () >> print "main runs last"
early () = print "top-level value"
main' () = mapM_ print [show (f (Just 3), f Nothing), show (g 10), show (h []), show (k 1, k 5, k 0), show (m 3), n 100000]
results () = main' () >> print secs >> print negs >> print dollar >> print strs >> print chain >> print ranges
