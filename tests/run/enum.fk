-- Haskell's Enum (docs/dev/tidal-comparison.md, L8): ranges at Int, Float
-- (to the last value up to b + 1/2), Char, Bool, Ordering and a derived type;
-- succ, pred, toEnum and fromEnum. The output is GHC's for the same program.
data Colour = Red | Green | Blue deriving (Eq, Show, Enum)

main = do
  print [1 .. 5 :: Int]
  print [1, 3 .. 10 :: Int]
  print [5, 3 .. 0 :: Int]
  print [1.0 .. 2.5 :: Float]
  print [1.0 .. 2.4 :: Float]
  print [0.0, 0.25 .. 1.0 :: Float]
  print [1.0, 0.5 .. 0.0 :: Float]
  print ['a' .. 'e']
  print ['a', 'c' .. 'i']
  print [False .. True]
  print [LT .. GT]
  print [Red .. Blue]
  print [Blue, Green .. Red]
  print (succ Red, pred Blue, fromEnum Blue, toEnum 1 :: Colour)
  print (succ 'a', pred 10 :: Int, fromEnum 'A', toEnum 66 :: Char, fromEnum 2.9, succ 1.5)
  print (map fromEnum [False, True], fromEnum GT, fromEnum ())
