-- Specialization on function arguments: calls with closed function arguments
-- call copies of the callee. The results must not change.

-- A local named like a global that the argument uses: the copy must still
-- call the global `double`.
double x = x * 2
applyTwice f x = let double = 0 in f (f x) + double

-- The argument grows with each recursive call; specialization must stop.
grow :: Int -> (Int -> Int) -> Int
grow n f = if n == 0 then f 1 else grow (n - 1) (f . (+ 1))

-- A closed lambda, a section, a composition, a partial application.
main = do
  print (map (\x -> x * x + 1) [1, 2, 3])
  print (map (* 3) [1, 2, 3], filter even [1 .. 10])
  print (map (show . (+ 1)) [1, 2], map (max 2) [1, 3])
  print (applyTwice double 5)
  print (grow 50 (* 2))
  print (words " a  bc d ", foldl (flip (:)) [] (unpack "abc"))
  -- a lambda capturing a local is not closed: called as before
  let k = 10
  print (map (\x -> x + k) [1, 2])
