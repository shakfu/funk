-- List fusion (docs/dev/fusion.md). The expected output is the unfused
-- program's (FK_NOFUSE=1); fuse.fuse lists the functions that get a loop.

-- fused: every stage is total, or at most one can fail
pipeline n = sum (map (* 3) (filter even (enumFromTo 1 n)))
counted xs = length (filter odd (map (* 2) xs))
member x xs = elem x (map (+ 1) xs)
firsts n = take 3 (map (* 2) (enumFromTo 1 n))
pairs n = concatMap (\x -> map (\y -> (x, y)) (filter (> x) (enumFromTo 1 n))) (enumFromTo 1 n)
boards n bs = concatMap (\qs -> map (: qs) (filter (\q -> notElem' q qs) (enumFromTo 1 n))) bs
small xs = takeWhile (< 10) (map (* 2) xs)
allEven n = all even (map (* 2) (enumFromTo 1 n))
hashed = foldl (\acc x -> acc * 31 + x) 7 (replicate 5 2)
flat = sum (concat [[1, 2], [], [3]])
lazySource n = sum (map (* 2) ys) where ys = enumFromTo 1 n
recursive n = sum (map (\k -> length (go k)) (enumFromTo 1 n))
  where go k = if k == 0 then [] else k : go (k - 1)

notElem' q [] = True
notElem' q (c:cs) = q /= c && notElem' q cs

-- not fused
viaParam h xs = sum (map h xs)                -- h unknown
shadowed xs = let map f ys = ys in sum (map (+ 1) xs)
printing () = length (map (\x -> print x) [1, 2])
twoFailing = sum (map half (filter big [1, 2, 3, 4]))
  where
    half x = if x == 0 then error "half" else div x 2
    big x = notElem' x [3] && x > 1

main = do
  print (pipeline 10, counted [1, 2, 3], member 3 [1, 2], member 9 [1, 2])
  print (firsts 10, firsts 2, pairs 3, boards 3 [[1], [2]])
  print (small [1, 2, 3, 4, 5, 6], allEven 5, hashed, flat, lazySource 4, recursive 4)
  print (viaParam (* 2) [1, 2], shadowed [1, 2], twoFailing)
  print (printing ())
