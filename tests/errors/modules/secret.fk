module secret (Pub, mkPub, mkSecret, Sealed, mkSealed) where

data Pub = Pub { pv :: Int }
data Secret = Secret { sv :: Int }
data Sealed = Sealed { hv :: Int }

mkPub :: Int -> Pub
mkPub = Pub
mkSecret :: Int -> Secret
mkSecret = Secret
mkSealed :: Int -> Sealed
mkSealed = Sealed

Secret.reveal :: Secret -> Int
Secret.reveal s = s.sv * 100

helper :: Int -> Int
helper x = x + 1
