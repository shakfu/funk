-- expect: foreign export `total` is not safe to call from a foreign thread: `enumFromTo@Int,Int` returns `[Int]`, a heap value
foreign export ccall "fk_total" total :: CInt -> CInt
total :: CInt -> CInt
total n = fromIntegral (length (reverse (enumFromTo 1 (fromIntegral n :: Int))))
main = print (total 3)
