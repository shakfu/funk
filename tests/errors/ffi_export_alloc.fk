-- expect: foreign export `total` may allocate, which code called from a foreign thread must not: `enumFromTo@Int,Int` returns `[Int]`, a heap value
foreign export ccall "fk_total" total :: CInt -> CInt
total :: CInt -> CInt
total n = fromIntegral (length (reverse (enumFromTo 1 (fromIntegral n :: Int))))
main = print (total 3)
