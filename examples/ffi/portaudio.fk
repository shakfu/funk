-- A wavetable synth through PortAudio (docs/dev/realtime.md, R4). The
-- audio callback is a foreign export: compiled code that cannot allocate
-- or fail, run on PortAudio's thread. It plays a sine from an Array,
-- takes frequency changes from a Ring that funk's thread fills, and reads
-- the gain with atomicPeek; funk's thread collects garbage meanwhile. Its
-- state is a foreign struct, laid out by C. The callback times itself and
-- counts underflows. It reads the gain from
-- standard input; 0 is silent:
--
--   funk build examples/ffi/portaudio.fk -o synth -I /opt/homebrew/include -L /opt/homebrew/lib
--   echo 0.1 | ./synth
foreign library "portaudio"

data Stream

foreign export ccall "fk_synth" synth :: Ptr () -> Ptr CFloat -> CULong -> Ptr () -> CULong -> Ptr () ->> CInt
foreign import ccall "portaudio.h &fk_synth" synthPtr :: FunPtr (Ptr () -> Ptr CFloat -> CULong -> Ptr () -> CULong -> Ptr () ->> CInt)

foreign import ccall "portaudio.h Pa_Initialize" paInitialize :: () ->> CInt
foreign import ccall "portaudio.h Pa_Terminate" paTerminate :: () ->> CInt
foreign import ccall "portaudio.h Pa_OpenDefaultStream" paOpenDefaultStream ::
  Ptr (Ptr Stream) -> CInt -> CInt -> CULong -> Float -> CULong -> FunPtr (Ptr () -> Ptr CFloat -> CULong -> Ptr () -> CULong -> Ptr () ->> CInt) -> Ptr () ->> CInt
foreign import ccall "portaudio.h Pa_StartStream" paStartStream :: Ptr Stream ->> CInt
foreign import ccall "portaudio.h Pa_StopStream" paStopStream :: Ptr Stream ->> CInt
foreign import ccall "portaudio.h Pa_CloseStream" paCloseStream :: Ptr Stream ->> CInt
foreign import ccall "portaudio.h Pa_GetErrorText" paErrorText :: CInt ->> String
foreign import ccall "portaudio.h Pa_Sleep" paSleep :: CLong ->> ()
foreign import ccall "portaudio.h paFloat32" paFloat32 :: CULong

foreign import ccall "time.h clock_gettime" clockGettime :: CUInt -> Ptr Timespec ->> CInt
foreign import ccall "time.h CLOCK_MONOTONIC" monotonic :: CUInt
foreign struct "time.h struct timespec" Timespec { sec "tv_sec" :: CLong, nsec "tv_nsec" :: CLong }

sampleRate :: Float
sampleRate = 48000.0

frames :: CULong
frames = 64

-- The callback's state, at its context pointer, laid out by C
foreign struct Synth
  { freq :: CFloat           -- the callback's, from changes
  , gain :: CFloat           -- written by funk's thread, atomically
  , phase :: Float           -- in table entries: the callback's own
  , changes :: Ring Float    -- frequency changes from funk's thread
  , table :: Array CFloat    -- one period of a sine
  , calls :: CLLong          -- written by the callback with atomicAdd,
  , underflows :: CLLong     --   read by funk's thread
  , longest :: CLLong        -- in ns
  , total :: CLLong
  , before :: Timespec       -- by value
  , after :: Timespec
  }

tableSize :: Int
tableSize = 1024

wrap :: Float -> Float
wrap p = if p >= toFloat tableSize then wrap (p - toFloat tableSize) else p

-- samples i to n of the buffer, from the table; the phase after them
render :: Ptr CFloat -> Array CFloat -> Int -> Int -> Float -> Float -> CFloat ->> Float
render out table i n phase step gain =
  if i == n then phase
  else do
    pokeByteOff out (i * 4) (gain * readArrayWrap table (truncateSat phase))
    render out table (i + 1) n (wrap (phase + step)) step gain

-- frequency changes from funk's thread, the last one wins
takeChanges :: Ptr Synth -> Ring Float ->> ()
takeChanges st r =
  if ringCount r == 0 then ()
  else do
    writeField st Synth.freq (toCFloat (ringFront r))
    ringDrop r
    takeChanges st r

nanos :: Ptr Timespec ->> Int
nanos t = fromIntegral (readField t Timespec.sec) * 1000000000 + fromIntegral (readField t Timespec.nsec)

synth :: Ptr () -> Ptr CFloat -> CULong -> Ptr () -> CULong -> Ptr () ->> CInt
synth input out n timeInfo flags ctx = do
  st <- (castPtr ctx :: Ptr Synth)
  clockGettime monotonic (fieldPtr st Synth.before)
  takeChanges st (readField st Synth.changes)
  gain <- atomicPeek (fieldPtr st Synth.gain)
  step <- toFloat tableSize * fromCFloat (readField st Synth.freq) / sampleRate
  writeField st Synth.phase (render out (readField st Synth.table) 0 (fromIntegral n) (readField st Synth.phase) step gain)
  atomicAdd (fieldPtr st Synth.underflows) (fromIntegral (mod (div (fromIntegral flags) 4) 2)) -- paOutputUnderflow, bit 2
  clockGettime monotonic (fieldPtr st Synth.after)
  took <- (fromIntegral (nanos (fieldPtr st Synth.after) - nanos (fieldPtr st Synth.before)) :: CLLong)
  if took > atomicPeek (fieldPtr st Synth.longest) then atomicPoke (fieldPtr st Synth.longest) took else ()
  atomicAdd (fieldPtr st Synth.total) took
  atomicAdd (fieldPtr st Synth.calls) 1
  0

check :: String -> CInt ->> ()
check what rc = if rc /= 0 then error (what ++ ": " ++ paErrorText rc) else ()

churn :: Int -> Int -> Int
churn k acc = if k == 0 then acc else churn (k - 1) (acc + length (reverse (enumFromTo 1 1000)))

-- play each frequency for 250 ms, allocating meanwhile
play :: Ring Float -> [Float] ->> ()
play changes fs = mapM_ (\f -> do
  ringPush changes f
  churn 3000 0
  paSleep 250) fs

stat :: Ptr Synth -> Field Synth CLLong ->> Int
stat st f = fromIntegral (atomicPeek (fieldPtr st f))

main = do
  gain <- readFloat (getLine ())
  st <- (mallocBytes Synth.size :: Ptr Synth)
  changes <- newRing 16 0.0
  table <- newArray tableSize (toCFloat 0.0)
  mapM_ (\i -> writeArray table i (toCFloat (sin (6.283185307179586 * toFloat i / toFloat tableSize)))) (enumFromTo 0 (tableSize - 1))
  writeField st Synth.freq (toCFloat 440.0)
  atomicPoke (fieldPtr st Synth.gain) (toCFloat gain)
  writeField st Synth.phase 0.0
  writeField st Synth.changes changes
  writeField st Synth.table table
  mapM_ (\f -> writeField st f 0) [Synth.calls, Synth.underflows, Synth.longest, Synth.total]
  check "Pa_Initialize" (paInitialize ())
  stream <- alloca (\cell -> do
    check "Pa_OpenDefaultStream" (paOpenDefaultStream cell 0 1 paFloat32 sampleRate frames synthPtr (castPtr st))
    peek cell)
  check "Pa_StartStream" (paStartStream stream)
  play changes [440.0, 550.0, 660.0, 880.0]
  check "Pa_StopStream" (paStopStream stream)
  check "Pa_CloseStream" (paCloseStream stream)
  check "Pa_Terminate" (paTerminate ())
  let calls = stat st Synth.calls
  putStrLn ("callbacks " ++ show calls ++ ", underflows " ++ show (stat st Synth.underflows))
  putStrLn ("callback time: longest " ++ show (div (stat st Synth.longest) 1000) ++ " us, mean " ++ show (div (div (stat st Synth.total) (max calls 1)) 1000)
            ++ " us, of a " ++ show (div (fromIntegral frames * 1000000) 48000) ++ " us buffer")
  freeRing changes
  freeArray table
  free st
