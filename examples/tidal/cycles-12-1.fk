-- Tidal's old/examples/cycles.tidal, # 12.1, ported to funk (README.md):
--
-- d1 $ (jux (spread' (<~) (toRational <$> (slow 2 sinewave1))) $ striate 2 $ sound (samples "odx*2" (slow 3 $ run 4)))

import pattern (atom, run, samples, sine, slow, spread', (<~))
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["odx", "odx:1", "odx:2", "odx:3"] dsp.superDirt
sig = dsp.orbit 0

pat = (jux (spread' ((<~) . atom) (slow 2 sine)) $ striate 2 $ sound (samples ("odx*2") (slow 3 $ run 4)))
