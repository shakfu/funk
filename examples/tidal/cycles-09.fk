-- Tidal's old/examples/cycles.tidal, # 9, ported to funk (README.md):
--
-- d1 $ every 2 (density 2) $ jux (spread' (striate) "[1 16 4 8]/3") $ sound (samples "[drum bd*12]" "[1 2 3 0]") |+| speed "[2 1.5 1]/4"

import pattern as p
import control (..)
import dsp as d

-- where scripts/dirt-samples.py puts Dirt-Samples
dirt = "~/.local/share/funk/Dirt-Samples"

sig = d.kit dirt ["bd", "bd:3", "drum:1", "drum:2"]

pat = p.every 2 (p.density 2) $ jux (p.spread' (striate . p.atom) ("[1 16 4 8]/3")) $ sound (p.samples ("[drum bd*12]") ("[1 2 3 0]")) # speed "[2 1.5 1]/4"
