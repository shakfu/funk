-- Tidal's old/examples/cycles.tidal, # 9, ported to funk (README.md):
--
-- d1 $ every 2 (density 2) $ jux (spread' (striate) "[1 16 4 8]/3") $ sound (samples "[drum bd*12]" "[1 2 3 0]") |+| speed "[2 1.5 1]/4"

import pattern (atom, density, every, samples, spread')
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bd", "bd:3", "drum:1", "drum:2"] dsp.superDirt
sig = dsp.orbit 0

pat = every 2 (density 2) $ jux (spread' (striate . atom) ("[1 16 4 8]/3")) $ sound (samples ("[drum bd*12]") ("[1 2 3 0]")) # speed "[2 1.5 1]/4"
