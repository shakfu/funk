-- Tidal's old/examples/cycles.tidal, # 16, ported to funk (README.md):
--
-- d1 $ slow 2$weave 16(pan sine1)$map sound["[[odx*4[odx*2odx*8],[hh*4,~odx/12]*4],[blue/1]/2~~[~odx/13*2]]",(1/16)~>samples"jvbass*16""2 2[3 4]1"]

import pattern (samples, sine, slow, (~>))
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["blue", "hh", "jvbass:1", "jvbass:2", "jvbass:3", "jvbass:4", "odx"] dsp.superDirt
sig = dsp.orbit 0

pat = slow 2 $ weave 16.0 (pan sine) $ map sound ["[[odx*4[odx*2odx*8],[hh*4,~odx/12]*4],[blue/1]/2~~[~[odx/13]*2]]", 0.0625 ~> samples ("jvbass*16") ("2 2[3 4]1")]
