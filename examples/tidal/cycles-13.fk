-- Tidal's old/examples/cycles.tidal, # 13, ported to funk (README.md):
--
-- let sinerat1 = fmap toRational sinewave1 in stack [smash 4 [1..16] $ (jux (spread' (<~) (slow 64 $ sinerat1)) $ sound $ samples "[bd bd*4, jvbass*8]" (slow 4 $ run 8)), sound "future/1"]

import pattern (atom, run, samples, sine, slow, spread', stack, (<~))
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bd", "bd:1", "bd:2", "bd:3", "bd:4", "bd:5", "bd:6", "bd:7", "future", "jvbass", "jvbass:1", "jvbass:2", "jvbass:3", "jvbass:4", "jvbass:5", "jvbass:6", "jvbass:7"] dsp.superDirt
sig = dsp.orbit 0

pat = let sinerat1 = sine in stack [smash 4 (map atom [1 .. 16]) $ (jux (spread' ((<~) . atom) (slow 64 $ sinerat1)) $ sound $ samples ("[bd bd*4, jvbass*8]") (slow 4 $ run 8)), sound "future/1"]
