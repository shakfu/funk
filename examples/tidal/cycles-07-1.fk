-- Tidal's old/examples/cycles.tidal, # 7.1, ported to funk (README.md):
--
-- d1 $ slow 2 $ spread' striate "[4 2 8 1]/3" $ jux palindrome $ sound "[jvbass*4 jvbass/5*8 ~ jvbass/9*6, drum*2 sn/2 drum/2*6 rave/3]"

import pattern as p
import control (..)
import dsp as d

-- where scripts/dirt-samples.py puts Dirt-Samples
dirt = "~/.local/share/funk/Dirt-Samples"

sig = d.kit dirt ["drum", "jvbass", "rave", "sn"]

pat = p.slow 2 $ p.spread' (striate . p.atom) (p.mini "[4 2 8 1]/3") $ jux p.palindrome $ sound "[jvbass*4 [jvbass/5]*8 ~ [jvbass/9]*6, drum*2 sn/2 [drum/2]*6 rave/3]"
