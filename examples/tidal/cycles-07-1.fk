-- Tidal's old/examples/cycles.tidal, # 7.1, ported to funk (README.md):
--
-- d1 $ slow 2 $ spread' striate "[4 2 8 1]/3" $ jux palindrome $ sound "[jvbass*4 jvbass/5*8 ~ jvbass/9*6, drum*2 sn/2 drum/2*6 rave/3]"

import pattern (atom, palindrome, slow, spread')
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["drum", "jvbass", "rave", "sn"] dsp.superDirt
sig = dsp.orbit 0

pat = slow 2 $ spread' (striate . atom) ("[4 2 8 1]/3") $ jux palindrome $ sound "[jvbass*4 [jvbass/5]*8 ~ [jvbass/9]*6, drum*2 sn/2 [drum/2]*6 rave/3]"
