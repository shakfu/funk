-- Tidal's old/examples/cycles.tidal, # 4, ported to funk (README.md):
--
-- d1 $ sound (samples "bd*3 [bd sn]*1/3 [bd*12 bd*6]/3 cp" "[0 2 4]/3") |+| end (slow 5 $ sinewave1) |+| speed ((+1) <$> triwave1)

import pattern (mapP, samples, sine, slow, tri)
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bd", "bd:2", "bd:4", "cp", "cp:2", "cp:4", "sn:2"] dsp.superDirt
sig = dsp.orbit 0

pat = sound (samples ("bd*3 [bd sn]/3 [bd*12 bd*6]/3 cp") ("[0 2 4]/3")) # end (slow 5 $ sine) # speed (mapP (+ 1.0) tri)
