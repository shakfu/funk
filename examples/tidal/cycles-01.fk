-- Tidal's old/examples/cycles.tidal, # 1, ported to funk (README.md):
--
-- d1 $ weave 4 (speed $ (1+) <$> sinewave1) [density 4 $ every 5 ((0.25 <~) . rev) $ striate 16 $ sound"[bd sn/2]/2", sound "bd [~ hc]*3"]
--   |+| speed "3"

import pattern (density, every, mapP, rev, sine, (<~))
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bd", "hc", "sn"] dsp.superDirt
sig = dsp.orbit 0

pat = weave 4.0 (speed $ mapP (1.0 +) sine) [density 4 $ every 5 ((0.25 <~) . rev) $ striate 16 $ sound "[bd sn/2]/2", sound "bd [~ hc]*3"]
  # speed "3"
