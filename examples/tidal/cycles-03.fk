-- Tidal's old/examples/cycles.tidal, # 3, ported to funk (README.md):
--
-- d1 $ whenmod 4 2 rev $ spread' (striate) "[8 3 4, 5]" $ sound "[[nn/6 nn/4, [nn/5 nn/2 nn/3]*1/2]*1/3, kurt/1]"
--
-- Dirt-Samples has no nn, so its events are silent.

import pattern as p
import control (..)
import dsp as d

-- where scripts/dirt-samples.py puts Dirt-Samples
dirt = "~/.local/share/funk/Dirt-Samples"

sig = d.kit dirt ["kurt"]

pat = p.whenmod 4 2 p.rev $ p.spread' (striate . p.atom) (p.mini "[8 3 4, 5]") $ sound "[[nn/6 nn/4, [nn/5 nn/2 nn/3]/2]/3, kurt/1]"
