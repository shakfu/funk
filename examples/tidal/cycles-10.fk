-- Tidal's old/examples/cycles.tidal, # 10, ported to funk (README.md):
--
-- d1 $ density 2 $ jux (iter 32) $ sound "bass3/2 bass3/0" |+| (speed $ every 2 rev  $ "[8 3 4]/3")

import pattern (density, every, iter, rev)
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bass3"] dsp.superDirt
sig = dsp.orbit 0

pat = density 2 $ jux (iter 32) $ sound "bass3/2 bass3/0" # (speed $ every 2 rev $ "[8 3 4]/3")
