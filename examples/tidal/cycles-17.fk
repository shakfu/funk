-- Tidal's old/examples/cycles.tidal, # 17, ported to funk (README.md):
--
-- d1 $ sound (samples "{casio ~ bd*3, bd*2 rm*3, numbers lt [mt sn, lt*3 voodoo] sn bass3*2}" ("{7 2, 3 1 5}")) |+| end rand

import pattern as p
import control (..)
import dsp as d

-- where scripts/dirt-samples.sh puts Dirt-Samples
dirt = "~/.local/share/funk/Dirt-Samples"

-- Tidal's sound, of a pattern of names
soundP :: p.Pattern String -> p.Pattern Controls
soundP pat = grp [mS "s", mF "n"] pat

sig = d.kit dirt ["bass3:1", "bass3:2", "bass3:3", "bass3:5", "bass3:7", "bd:1", "bd:2", "bd:3", "bd:5", "bd:7", "casio:1", "casio:3", "casio:5", "casio:7", "lt:1", "lt:2", "lt:3", "lt:5", "lt:7", "mt:1", "mt:2", "mt:3", "mt:5", "mt:7", "numbers:1", "numbers:2", "numbers:3", "numbers:5", "numbers:7", "rm:1", "rm:2", "rm:3", "rm:5", "rm:7", "sn:1", "sn:2", "sn:3", "sn:5", "sn:7", "voodoo:1", "voodoo:2", "voodoo:3", "voodoo:5", "voodoo:7"]

pat = soundP (p.samples (p.miniS "{casio ~ bd*3, bd*2 rm*3, numbers lt [mt sn, lt*3 voodoo] sn bass3*2}") (p.mini "{7 2, 3 1 5}")) # pF "end" p.rand
