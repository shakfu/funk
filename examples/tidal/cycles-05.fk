-- Tidal's old/examples/cycles.tidal, # 5, ported to funk (README.md):
--
-- d1 $ slow 2 $ stack [spin 6 $ spread' (slow) "3 4 5 2" $ sound "[bd*5 ht*5, [sid/4]*3 lt*2/5 mt*3, [sid/3]*3]"] |+| speed "2"

import pattern (atom, slow, spread', stack)
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bd", "ht", "lt", "mt", "sid"] dsp.superDirt
sig = dsp.orbit 0

pat = slow 2 $ stack [spin 6 $ spread' (slow . atom) ("3 4 5 2") $ sound "[bd*5 ht*5, [sid/4]*3 [lt*2]/5 mt*3, [sid/3]*3]"] # speed "2"
