-- Tidal's old/examples/cycles.tidal, # 5, ported to funk (README.md):
--
-- d1 $ slow 2 $ stack [spin 6 $ spread' (slow) "3 4 5 2" $ sound "[bd*5 ht*5, [sid/4]*3 lt*2/5 mt*3, [sid/3]*3]"] |+| speed "2"

import pattern as p
import control (..)
import dsp as d

-- where scripts/dirt-samples.py puts Dirt-Samples
dirt = "~/.local/share/funk/Dirt-Samples"

sig = d.kit dirt ["bd", "ht", "lt", "mt", "sid"]

pat = p.slow 2 $ p.stack [spin 6 $ p.spread' (p.slow . p.atom) (p.mini "3 4 5 2") $ sound "[bd*5 ht*5, [sid/4]*3 [lt*2]/5 mt*3, [sid/3]*3]"] # speed "2"
