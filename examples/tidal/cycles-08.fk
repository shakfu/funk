-- Tidal's old/examples/cycles.tidal, # 8, ported to funk (README.md):
--
-- d1 $ slow 8 $ every 4 (rev) $ jux (|+| speed "[2,3]") $ spread' striate "[4 3 2, 6]" $ sound (samples "stab*4 sn" $ run 8)

import pattern (atom, every, rev, run, samples, slow, spread')
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["sn:4", "sn:5", "sn:6", "sn:7", "stab", "stab:1", "stab:2", "stab:3"] dsp.superDirt
sig = dsp.orbit 0

pat = slow 8 $ every 4 (rev) $ jux (# speed "[2,3]") $ spread' (striate . atom) ("[4 3 2, 6]") $ sound (samples ("stab*4 sn") $ run 8)
