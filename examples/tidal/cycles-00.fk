-- Tidal's old/examples/cycles.tidal, # 0, ported to funk (README.md):
--
-- d1 $ brak $ let x = "bd [sn [[sn bd] sn]]*1/3" in interlace (sound $ slow 3 $ x) (sound $ every 3 (append "[bd]*6") x)
--   |+| speed "4"

import pattern as p
import control (..)
import dsp as d

-- where scripts/dirt-samples.py puts Dirt-Samples
dirt = "~/.local/share/funk/Dirt-Samples"

sig = d.kit dirt ["bd", "sn"]

pat = p.brak $ let x = p.miniS "bd [sn [[sn bd] sn]]/3" in interlace (sound $ p.slow 3 $ x) (sound $ p.every 3 (p.append ("[bd]*6")) x)
  # speed "4"
