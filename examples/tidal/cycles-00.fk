-- Tidal's old/examples/cycles.tidal, # 0, ported to funk (README.md):
--
-- d1 $ brak $ let x = "bd [sn [[sn bd] sn]]*1/3" in interlace (sound $ slow 3 $ x) (sound $ every 3 (append "[bd]*6") x)
--   |+| speed "4"

import pattern (append, brak, every, miniS, slow)
import control (..)
import dsp

-- where scripts/dirt-samples.py puts Dirt-Samples
dirtSamples = "~/.local/share/funk/Dirt-Samples"

dirt = dsp.loadSoundFiles dirtSamples ["bd", "sn"] dsp.superDirt
sig = dsp.orbit 0

pat = brak $ let x = miniS "bd [sn [[sn bd] sn]]/3" in interlace (sound $ slow 3 $ x) (sound $ every 3 (append ("[bd]*6")) x)
  # speed "4"
