-- regex-redux (Benchmarks Game): regexredux.c's matches and substitutions,
-- with the same library, PCRE2 with its JIT, through foreign imports. The
-- input is read whole with getContents and copied once into C memory;
-- each substitution writes a new buffer, as replace does.
foreign library "pcre2-8"

data Code
data MatchData

-- pcre2_8.h defines the code unit width that pcre2.h needs; Ptr () is C's
-- void *, for its const unsigned char * patterns and subjects
foreign import ccall "pcre2_8.h pcre2_compile" pcre2Compile :: Ptr () -> CSize -> CUInt -> Ptr CInt -> Ptr CSize -> Ptr () ->> Ptr Code
foreign import ccall "pcre2_8.h pcre2_jit_compile" pcre2JitCompile :: Ptr Code -> CUInt ->> CInt
foreign import ccall "pcre2_8.h pcre2_jit_match" pcre2JitMatch :: Ptr Code -> Ptr () -> CSize -> CSize -> CUInt -> Ptr MatchData -> Ptr () ->> CInt
foreign import ccall "pcre2_8.h pcre2_match_data_create" pcre2MatchDataCreate :: CUInt -> Ptr () ->> Ptr MatchData
foreign import ccall "pcre2_8.h pcre2_get_ovector_pointer" pcre2Ovector :: Ptr MatchData ->> Ptr CSize
foreign import ccall "pcre2_8.h pcre2_code_free" pcre2CodeFree :: Ptr Code ->> ()
foreign import ccall "pcre2_8.h PCRE2_JIT_COMPLETE" jitComplete :: CUInt
foreign import ccall "string.h memcpy" copyBytes :: Ptr CChar -> Ptr CChar -> CSize ->> Ptr ()
foreign import ccall "string.h memcpy" copyString :: Ptr CChar -> String -> CSize ->> Ptr ()

data Regex = Regex (Ptr Code) (Ptr MatchData) -- the pattern, and the match data its ovector is read from

compile :: Ptr MatchData -> String ->> Regex
compile md p = alloca (\err -> alloca (\off -> do
  c <- newCString p
  re <- pcre2Compile (castPtr c) (fromIntegral (length p)) 0 err off nullPtr
  free c
  if re == nullPtr then error ("pcre2_compile failed: " ++ p) else do
    pcre2JitCompile re jitComplete
    Regex re md))

-- the first match in s[0..n) from pos, as (start, end), or (-1, -1)
match :: Regex -> Ptr CChar -> Int -> Int ->> (Int, Int)
match (Regex re md) s n pos =
  if pcre2JitMatch re (castPtr s) (fromIntegral n) (fromIntegral pos) 0 md nullPtr < 0 then (-1, -1)
  else case pcre2Ovector md of
    ov -> (fromIntegral (peekByteOff ov 0 :: CSize), fromIntegral (peekByteOff ov 8 :: CSize))

count :: Regex -> Ptr CChar -> Int ->> Int
count re s n = go 0 0
  where go pos k = case match re s n pos of
          (m0, m1) -> if m0 < 0 then k else go m1 (k + 1)

-- s[0..n) with each match of p replaced by r, in a new buffer; its length
subst :: Ptr MatchData -> String -> String -> Ptr CChar -> Int ->> (Ptr CChar, Int)
subst md p r s n = do
  re <- compile md p
  d <- (mallocBytes (div (n * 3) 2 + 16) :: Ptr CChar) -- a replacement is at most 1.5 times what it replaces
  go re d 0 0
  where
    go re d pos len = case match re s n pos of
      (m0, m1) -> if m0 < 0
        then do
          copyBytes (plusPtr d len) (plusPtr s pos) (fromIntegral (n - pos))
          (d, len + n - pos)
        else do
          copyBytes (plusPtr d len) (plusPtr s pos) (fromIntegral (m0 - pos))
          copyString (plusPtr d (len + m0 - pos)) r (fromIntegral (length r))
          go re d m1 (len + m0 - pos + length r)

variants :: [String]
variants = ["agggtaaa|tttaccct", "[cgt]gggtaaa|tttaccc[acg]", "a[act]ggtaaa|tttacc[agt]t", "ag[act]gtaaa|tttac[agt]ct",
            "agg[act]taaa|ttta[agt]cct", "aggg[acg]aaa|ttt[cgt]ccct", "agggt[cgt]aa|tt[acg]accct", "agggta[cgt]a|t[acg]taccct",
            "agggtaa[cgt]|[acg]ttaccct"]

magic :: [(String, String)]
magic = [("tHa[Nt]", "<4>"), ("aND|caN|Ha[DS]|WaS", "<3>"), ("a[NSt]|BY", "<2>"), ("<[^>]*>", "|"), ("\\|[^|][^|]*\\|", "-")]

-- the substitutions in order, each from the last one's buffer; the final length
substAll :: Ptr MatchData -> [(String, String)] -> Ptr CChar -> Int ->> Int
substAll md ps s n = case ps of
  [] -> n
  ((p, r) : rest) -> do
    (d, m) <- subst md p r s n
    free s
    substAll md rest d m

main = do
  input <- getContents ()
  let ilen = length input
  md <- pcre2MatchDataCreate 16 nullPtr
  s <- (mallocBytes (ilen + 1) :: Ptr CChar)
  copyString s input (fromIntegral ilen)
  (seq, clen) <- subst md ">.*\n|\n" "" s ilen
  free s
  mapM_ (\v -> putStrLn (v ++ " " ++ show (count (compile md v) seq clen))) variants
  slen <- substAll md magic seq clen
  putStrLn ("\n" ++ show ilen ++ "\n" ++ show clen ++ "\n" ++ show slen)
