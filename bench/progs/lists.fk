-- map/filter/foldl over fresh lists each round, each list named, so fusion
-- cannot apply: list allocation and GC.
round_ n =
  let xs = enumFromTo 1 n
      ys = filter even xs
      zs = map (* 3) ys
  in sum zs + length xs

rounds k n acc = if k == 0 then acc else rounds (k - 1) n (mod (acc + round_ n) 1000000007)

main = print (rounds 20 (readInt (getLine ())) 0)
