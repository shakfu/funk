-- Word frequencies: generate text, split it into words, sort them, count
-- runs. Packed String building, comparison and splitting.
vocab :: [String]
vocab = ["the", "of", "and", "a", "to", "in", "is", "you", "that", "it", "he", "was", "for", "on", "are", "as", "with", "his", "they", "at"]

rand :: Int -> Int
rand s = mod (s * 1103515245 + 12345) 2147483648

word :: Int -> String
word s = (vocab !! mod s 20) ++ show (mod (div s 20) 37)

seeds :: Int -> Int -> [Int]
seeds n s = if n == 0 then [] else s : seeds (n - 1) (rand s)

-- (distinct words, length of the longest run)
runs :: [String] -> (Int, Int)
runs [] = (0, 0)
runs (w:ws) = go w 1 ws 1 0
  where
    go cur k [] d best = (d, max k best)
    go cur k (x:xs) d best = if x == cur then go cur (k + 1) xs d best else go x 1 xs (d + 1) (max k best)

main =
  let n = readInt (getLine ())
  in print (runs (sort (words (unwords (map word (seeds n 42))))))
