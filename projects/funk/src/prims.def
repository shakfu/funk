/* P(c_name, funk_name, arity, type, kind) -- primitives implemented in rt.c.
   kind, for the optimizer: C cannot fail, has no effect and takes constant
   time; T cannot fail; F may fail; D fails on a zero divisor and S on a
   negative shift, otherwise as C. Running out of heap is not failure here.
   One C function may serve several typed names: the Num, Eq, Ord and Show
   instances for Int, Float and Char in the prelude are built from them. */
P(addi, "primAddInt", 2, "Int -> Int -> Int", C)
P(addf, "primAddFloat", 2, "Float -> Float -> Float", C)
